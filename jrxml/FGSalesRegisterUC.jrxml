<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetails" pageWidth="485" pageHeight="842" columnWidth="475" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="group1" class="java.lang.String">
		<defaultValueExpression><![CDATA["'product_type'"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'01/01/2015'"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'30/12/2100'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'DD/MM/YYYY'"]]></defaultValueExpression>
	</parameter>
	<parameter name="group2" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="group3" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="group4" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="group5" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="company" class="java.lang.String"/>
	<parameter name="salesType" class="java.lang.String">
		<defaultValueExpression><![CDATA["'grossSales'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    ROW_NUMBER() OVER (
        ORDER BY
            group1,
            group2,
            group3,
            group4,
            group5
    ) AS sno,

    SUM(inv_qty)                    AS inv_qty,
    COUNT(*)                        AS pcs,
    TO_DATE($P!{fromDate}, $P!{dateFormat}) AS from_dt,
    TO_DATE($P!{toDate}, $P!{dateFormat}) AS to_dt,
    MAX(currency)                   AS currency,
    MAX(inv_dt)                     AS inv_dt,
    SUM(gross_wt)                   AS gross_wt,
    max(sales_type)                 as sales_type,
    SUM(pure_wt)                    AS pure_wt,
    SUM(stone_wt)                   AS stone_wt,
    0                               AS stone_value,
    ROUND(SUM(sales_value), 2)      AS sales_value,
    MAX(company_id)                 AS company_id,

    group1,
    group2,
    group3,
    group4,
    group5,
    CASE
    WHEN $P!{group5} IS NOT NULL THEN group5
    WHEN $P!{group4} IS NOT NULL THEN group4
    WHEN $P!{group3} IS NOT NULL THEN group3
    WHEN $P!{group2} IS NOT NULL THEN group2
    WHEN $P!{group1} IS NOT NULL THEN group1
    ELSE NULL
END AS summary_value,
CASE
    WHEN COALESCE($P!{group5}, '') <> '' THEN
        CASE $P!{group5}
            WHEN 'company' THEN 'Company'
            WHEN 'customer_name' THEN 'Customer'
            WHEN 'sales_man' THEN 'Sales Man'
            WHEN 'supplier_name' THEN 'Supplier'
            WHEN 'product_type' THEN 'Product Type'
        END

    WHEN COALESCE($P!{group4}, '') <> '' THEN
        CASE $P!{group4}
            WHEN 'company' THEN 'Company'
            WHEN 'customer_name' THEN 'Customer'
            WHEN 'sales_man' THEN 'Sales Man'
            WHEN 'supplier_name' THEN 'Supplier'
            WHEN 'product_type' THEN 'Product Type'
        END

    WHEN COALESCE($P!{group3}, '') <> '' THEN
        CASE $P!{group3}
            WHEN 'company' THEN 'Company'
            WHEN 'customer_name' THEN 'Customer'
            WHEN 'sales_man' THEN 'Sales Man'
            WHEN 'supplier_name' THEN 'Supplier'
            WHEN 'product_type' THEN 'Product Type'
        END

    WHEN COALESCE($P!{group2}, '') <> '' THEN
        CASE $P!{group2}
            WHEN 'company' THEN 'Company'
            WHEN 'customer_name' THEN 'Customer'
            WHEN 'sales_man' THEN 'Sales Man'
            WHEN 'supplier_name' THEN 'Supplier'
            WHEN 'product_type' THEN 'Product Type'
        END

    WHEN COALESCE($P!{group1}, '') <> '' THEN
        CASE $P!{group1}
            WHEN 'company' THEN 'Company'
            WHEN 'customer_name' THEN 'Customer'
            WHEN 'sales_man' THEN 'Sales Man'
            WHEN 'supplier_name' THEN 'Supplier'
            WHEN 'product_type' THEN 'Product Type'
        END
END AS summary_column

FROM
(
    SELECT
        case when $P!{salesType} = 'grossSales' then id.inv_qty
	       when $P!{salesType} = 'netSales' then id.inv_qty - id.ret_qty
	       when $P!{salesType} = 'salesReturn' then id.ret_qty
	    else id.inv_qty end as inv_qty,
        im.inv_dt,
        cu.symbol currency,
        jew.gross_wt,
        CASE
                WHEN $P!{salesType} = 'grossSales' THEN 'Gross Sales'
                WHEN $P!{salesType} = 'netSales' THEN 'Net Sales'
                WHEN $P!{salesType} = 'salesReturn' THEN 'Sales Return'

            END as sales_type,
        (jew.net_wt * metal.impure_to_pure_conv_factor) AS pure_wt,
        (jew.diamond_wt + jew.gemstone_wt)              AS stone_wt,
    CASE
    WHEN im.currency = $P!{currency}
    THEN
        id.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN id.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN id.inv_qty - id.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN id.ret_qty
                ELSE id.inv_qty
            END
        )

    WHEN im.currency = 'USD'
         AND $P!{currency} <> 'USD'
    THEN
        id.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN id.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN id.inv_qty - id.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN id.ret_qty
                ELSE id.inv_qty
            END
        ) * NULLIF(im.exchange_rate, 0)

    WHEN im.currency <> 'USD'
         AND $P!{currency} = 'USD'
    THEN
        id.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN id.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN id.inv_qty - id.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN id.ret_qty
                ELSE id.inv_qty
            END
        ) / NULLIF(im.exchange_rate, 0)

    ELSE
        id.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN id.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN id.inv_qty - id.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN id.ret_qty
                ELSE id.inv_qty
            END
        )
END AS sales_value,

        CASE $P!{group1}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group1,

        CASE $P!{group2}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group2,

        CASE $P!{group3}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group3,

        CASE $P!{group4}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group4,

        CASE $P!{group5}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group5,

        comp.company_id

    FROM tbl_jew_sales_invoice_main im

    INNER JOIN tbl_jew_sales_invoice_det id
        ON im.inv_id = id.inv_id
       AND id.is_deleted = 0

    INNER JOIN tbl_jewellery jew
        ON id.jew_id = jew.jew_id
       AND jew.is_deleted = 0

    LEFT JOIN tbl_lot metal
        ON metal.lot_id = jew.metal_id

    LEFT JOIN tbl_product_type pr
        ON jew.product_type_id = pr.product_type_id

    LEFT JOIN tbl_employee emp
        ON emp.employee_id = im.salesman_id
       AND emp.is_deleted = 0

    LEFT JOIN tbl_currency cu on  $P!{currency} = cu.currency_code

    LEFT JOIN tbl_customer c
        ON im.customer_id = c.customer_id
       AND c.is_deleted = 0

    INNER JOIN tbl_company comp
        ON comp.company_id = im.company_id

    LEFT JOIN
    (
        SELECT DISTINCT ON (det.jew_id)
            det.jew_id,
            sup.supplier_name

        FROM tbl_jew_purchase_invoice_det det

        JOIN tbl_jew_purchase_invoice_main t
            ON t.inv_id = det.inv_id
           AND t.is_deleted = 0

        JOIN tbl_supplier sup
            ON sup.supplier_id = t.supplier_id
           AND sup.is_deleted = 0

        WHERE det.is_deleted = 0

        ORDER BY
            det.jew_id,
            t.inv_id DESC
    ) supplier
        ON supplier.jew_id = id.jew_id

    WHERE im.is_deleted = 0

      AND (
            im.inv_dt >= TO_DATE($P!{fromDate}, $P!{dateFormat})
            OR ' ' = $P!{fromDate}
          )
      AND (
            im.inv_dt <= TO_DATE($P!{toDate}, $P!{dateFormat})
            OR ' ' = $P!{toDate}
          )
      AND im.company_id IN ($P!{company})

) x
where inv_qty > 0

GROUP BY
    group1,
    group2,
    group3,
    group4,
    group5

ORDER BY
    group1,
    group2,
    group3,
    group4,
    group5;]]>
	</queryString>
