<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="WTVSalesRegister" pageWidth="1900" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1860" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5000000000000004"/>
	<property name="ireport.x" value="1263"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["'%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="category" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
abc.inv_id,
max(abc.inv_type) inv_type,
max(abc.category) category,
max(abc.inv_dt) as inv_dt,
max(abc.inv_dt_check) inv_dt_check,
SUM(abc.inv_qty1) AS inv_qty1,
SUM(abc.inv_qty2) AS inv_qty2,
SUM(abc.input_amt) AS Total_net_amt,
coalesce(SUM(abc.igst_amt),0) AS igst_amt,
coalesce(SUM(abc.sgst_amt),0) AS sgst_amt,
coalesce(SUM(abc.cgst_amt),0) AS cgst_amt,
coalesce(SUM(abc.other_chgs),0) AS other_chgs,
COALESCE(
    CASE
        WHEN MAX(abc.category) IN ('SALES', 'MEMO SALES')
        THEN (
            coalesce(SUM(abc.input_amt),0)
            + coalesce(SUM(abc.igst_amt),0)
            + coalesce(SUM(abc.sgst_amt),0)
            + coalesce(SUM(abc.cgst_amt),0)
            + coalesce(SUM(abc.other_chgs),0)
        ) * 1

        WHEN MAX(abc.category) IN ('SALES RETURN', 'MEMO RETURN')
        THEN (
            coalesce(SUM(abc.input_amt),0)
            + coalesce(SUM(abc.igst_amt),0)
            + coalesce(SUM(abc.sgst_amt),0)
            + coalesce(SUM(abc.cgst_amt),0)
            + coalesce(SUM(abc.other_chgs),0)
        ) * -1
    END,
0
) AS total_inv_amt,
MAX(abc.cus_doc_type) AS cus_doc_type,
MAX(abc.inv_type_no) AS inv_type_no,
MAX(abc.inv_due_dt) AS inv_due_dt,
MAX(abc.currency) AS currency,
MAX(abc.exchange_rate) AS exchange_rate,
MAX(abc.reference_no) AS reference_no,
MAX(abc.customer_name) AS customer_name
FROM
(
SELECT
im.inv_id,
im.inv_type,
'SALES' category,
fn_get_customer_invoice_no(im.inv_type, im.inv_id) AS cus_doc_type,
im.inv_type || '-' || im.inv_no AS inv_type_no,
TO_CHAR(im.inv_dt, $P{dateFormat}) AS inv_dt,
im.inv_dt AS inv_dt_check,
TO_CHAR(im.inv_due_dt, $P{dateFormat}) AS inv_due_dt,
im.currency AS currency,
NULLIF(im.exchange_rate, 0) AS exchange_rate,
im.reference_no,
tcus.customer_name,
id.inv_qty1,
id.inv_qty2,
CASE
WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_rate / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_rate * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(id.input_rate / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(id.input_rate,2)
END AS input_rate,
CASE
WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_amt/ NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(id.input_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(id.input_amt,2)
END AS input_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN
$P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.igst_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.igst_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.igst_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.igst_amt,2) END
ELSE 0 END AS igst_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN$P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.sgst_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.sgst_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.sgst_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.sgst_amt,2) END
ELSE 0 END AS sgst_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.cgst_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.cgst_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.cgst_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.cgst_amt,2) END
ELSE 0 END AS cgst_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.other_chgs / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.other_chgs * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.other_chgs / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.other_chgs,2) END
ELSE 0 END AS other_chgs
FROM tbl_sales_invoice_main im
INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
INNER JOIN tbl_sales_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
INNER JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
INNER JOIN tbl_lot prod ON id.lot_id = prod.lot_id
INNER JOIN tbl_commodity tcom ON prod.commodity_id = tcom.commodity_id
INNER JOIN tbl_commodity_group tcomg ON tcom.commodity_group_id = tcomg.commodity_group_id
LEFT JOIN tbl_shape sh ON prod.shape_id = sh.shape_id
LEFT JOIN tbl_cut cut ON prod.cut_id = cut.cut_id
LEFT JOIN tbl_color col ON prod.color_id = col.color_id
LEFT JOIN tbl_clarity cla ON prod.clarity_id = cla.clarity_id
LEFT JOIN tbl_lot_price_det lp ON prod.lot_id = lp.lot_id AND im.company_id = lp.company_id
LEFT JOIN (
SELECT
chgs.inv_id,
SUM(CASE WHEN chgs.plus_minus_flag = 1 THEN chgs.input_amt ELSE 0 END) AS plus_amt,
SUM(CASE WHEN chgs.plus_minus_flag = -1 THEN chgs.input_amt ELSE 0 END) AS minus_amt,
SUM(CASE WHEN lower(chgs.charge_name) like '%igst%' THEN chgs.input_amt ELSE 0 END) AS igst_amt,
SUM(CASE WHEN lower(chgs.charge_name) like '%cgst%' THEN chgs.input_amt ELSE 0 END) AS sgst_amt,
SUM(CASE WHEN lower(chgs.charge_name) like '%sgst%' THEN chgs.input_amt ELSE 0 END) AS cgst_amt,
SUM(
CASE
WHEN lower(chgs.charge_name) NOT LIKE '%sgst%'
AND lower(chgs.charge_name) NOT LIKE '%cgst%'
AND lower(chgs.charge_name) NOT LIKE '%igst%'
THEN chgs.input_amt
ELSE 0
END
) AS other_chgs
FROM tbl_sales_invoice_chgs chgs
WHERE chgs.is_deleted = 0
GROUP BY chgs.inv_id
) inv_chgs ON im.inv_id = inv_chgs.inv_id
LEFT JOIN (
SELECT
pim.company_id,
pid.inv_type,
pid.inv_id,
SUM(pid.paid_amount) AS paid_amount,
MAX(CONCAT_WS(', ', acc.account_name)) AS account_names
FROM tbl_payment_paid_main pim
INNER JOIN tbl_payment_paid_det pid ON pim.payment_id = pid.payment_id AND pid.is_deleted = 0
LEFT JOIN tbl_account acc ON pim.bank_cash_account_id = acc.account_id
WHERE pim.is_deleted = 0
GROUP BY pim.company_id, pid.inv_type, pid.inv_id
) payment ON im.inv_type = payment.inv_type AND im.inv_id = payment.inv_id AND im.company_id = payment.company_id
WHERE im.is_deleted = 0
AND ((im.company_id = $P!{companyId}) OR (-1 = $P!{companyId}))
UNION ALL
SELECT
im.inv_id,
im.inv_type,
'SALES RETURN' category,
fn_get_customer_invoice_no(im.inv_type, im.inv_id) AS cus_doc_type,
im.inv_type || '-' || im.inv_no AS inv_type_no,
TO_CHAR(im.inv_dt, $P{dateFormat}) AS inv_dt,
im.inv_dt AS inv_dt_check,
TO_CHAR(im.inv_due_dt, $P{dateFormat}) AS inv_due_dt,
im.currency AS currency,
NULLIF(im.exchange_rate, 0) AS exchange_rate,
im.reference_no,
tcus.customer_name,
-1 * id.inv_qty1,
-1 * id.inv_qty2,
CASE
WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_rate / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_rate * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(id.input_rate / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(id.input_rate,2)
END AS input_rate,
CASE
WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(id.input_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(id.input_amt,2)
END AS input_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.igst_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.igst_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.igst_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.igst_amt,2) END
ELSE 0 END AS igst_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.sgst_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.sgst_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.sgst_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.sgst_amt,2) END
ELSE 0 END AS sgst_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.cgst_amt / NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.cgst_amt * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.cgst_amt / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.cgst_amt,2) END
ELSE 0 END AS cgst_amt,
CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.other_chgs/ NULLIF(im.exchange_rate, 0)
WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.other_chgs * NULLIF(im.exchange_rate, 0),2)
WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.other_chgs / NULLIF(im.exchange_rate, 0),2)
ELSE ROUND(inv_chgs.other_chgs,2) END
ELSE 0 END AS other_chgs
FROM tbl_sales_return_invoice_main im
INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
INNER JOIN tbl_sales_return_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
INNER JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
INNER JOIN tbl_lot prod ON id.lot_id = prod.lot_id
INNER JOIN tbl_commodity tcom ON prod.commodity_id = tcom.commodity_id
INNER JOIN tbl_commodity_group tcomg ON tcom.commodity_group_id = tcomg.commodity_group_id
LEFT JOIN tbl_shape sh ON prod.shape_id = sh.shape_id
LEFT JOIN tbl_cut cut ON prod.cut_id = cut.cut_id
LEFT JOIN tbl_color col ON prod.color_id = col.color_id
LEFT JOIN tbl_clarity cla ON prod.clarity_id = cla.clarity_id
LEFT JOIN tbl_lot_price_det lp ON prod.lot_id = lp.lot_id AND im.company_id = lp.company_id
LEFT JOIN (
SELECT
chgs.inv_id,
SUM(CASE WHEN chgs.plus_minus_flag = 1 THEN chgs.input_amt ELSE 0 END) AS plus_amt,
SUM(CASE WHEN chgs.plus_minus_flag = -1 THEN chgs.input_amt ELSE 0 END) AS minus_amt,
SUM(CASE WHEN lower(chgs.charge_name) like '%igst%' THEN chgs.input_amt ELSE 0 END) AS igst_amt,
SUM(CASE WHEN lower(chgs.charge_name) like '%cgst%' THEN chgs.input_amt ELSE 0 END) AS sgst_amt,
SUM(CASE WHEN lower(chgs.charge_name) like '%sgst%' THEN chgs.input_amt ELSE 0 END) AS cgst_amt,
SUM(
CASE
WHEN lower(chgs.charge_name) NOT LIKE '%sgst%'
AND lower(chgs.charge_name) NOT LIKE '%cgst%'
AND lower(chgs.charge_name) NOT LIKE '%igst%'
THEN chgs.input_amt
ELSE 0
END
) AS other_chgs
FROM tbl_sales_return_invoice_chgs chgs
WHERE chgs.is_deleted = 0
GROUP BY chgs.inv_id
) inv_chgs ON im.inv_id = inv_chgs.inv_id
WHERE im.is_deleted = 0
AND ((im.company_id = $P!{companyId}) OR (-1 = $P!{companyId}))
UNION ALL
