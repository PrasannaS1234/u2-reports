<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StockReportAsOnDate" pageWidth="1460" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1420" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="rate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'CP'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select res.*, res.inv_qty1 * res.pp_rate pp_amount from (
select
	tx.*,
	case when $P!{rate} = 'CP' then
		round(case
                when currency = coalesce($P!{currency}, 'USD') then round(cost_price,2)
                when currency = 'USD' and coalesce($P!{currency}, 'USD') <> 'USD' then round(cost_price * exchange_rate,2)
                when currency <> 'USD' and coalesce($P!{currency}, 'USD') = 'USD' then round(cost_price / nullif
                (exchange_rate,0), 2)
        end,4)
	 	else fn_rm_pp_wac(product_id,company_id,$P{toDate}, $P{dateFormat},$P!{currency})
	end pp_rate
from (
	select
		tcomp.company_id,
		max(tcomp.company_name) company_name,
		prod.lot_id	product_id,
		max(tcomg.commodity_group_name) commodity_group_name,
		max(tcom.commodity_name) commodity_name,
		max(prod.lot_code) product_no,
		tbin.bin_id,
		max(tbin.bin_name) bin_name,
		nullif(stk.stone_size,'NA') stone_size,
		max(prod.description) description,
		max(prod.measurement_lxb_h) measurement,
		max(sh.shape_name) shape_name,
		max(cut.cut_name) cut_name,
		max(col.color_name) color_name,
		max(cla.clarity_name) clarity_name,
		max(prod.sieve_size) sieve_size,
		max(prod.mm_size) mm_size,
		max(lp.cost_price_code) cost_price_code,
		sum(stk.in_out_flag * stk.qty1) inv_qty1,
		sum(stk.in_out_flag * stk.qty2) inv_qty2,
		max(prod.uom1) uom1,
		max(prod.uom2) uom2,
                    max(nullif(p.parameter_name,'NA')) as grade,
		coalesce(nullif($P!{currency},'-1'),tcomp.default_currency) currency,
		max(lp.cost_price) cost_price,
		max(exch.exchange_rate) exchange_rate
	from
		tbl_lot_stock_trans stk
		inner join tbl_company tcomp on stk.company_id = tcomp.company_id
		inner join tbl_lot prod on stk.lot_id = prod.lot_id
		inner join tbl_bin tbin on stk.bin_id = tbin.bin_id
		inner join tbl_commodity tcom on prod.commodity_id = tcom.commodity_id
		inner join tbl_commodity_group tcomg on tcom.commodity_group_id = tcomg.commodity_group_id
		left join tbl_shape sh on prod.shape_id = sh.shape_id
		left join tbl_cut cut on prod.cut_id = cut.cut_id
		left join tbl_color col on prod.color_id = col.color_id
		left join tbl_clarity cla on prod.clarity_id = cla.clarity_id
                    left join  tbl_global_parameter p on p.parameter_code = prod.grade
	    left join tbl_lot_price_det lp on prod.lot_id = lp.lot_id
	        and stk.company_id = lp.company_id
		left join(
			select fn_get_exchange_rate($P!{loginCompanyId}, $P{toDate}, $P{dateFormat},$P!{currency}) exchange_rate
			from tbl_company tc where  tc.company_id = $P!{loginCompanyId}
		)exch on 1 = 1

	where
		stk.is_deleted = 0
		and stk.inv_dt <= to_date($P{toDate}, $P{dateFormat})
		and (stk.bin_id in ($P!{binId}) or -1 in ($P!{binId}))
		and (prod.commodity_id in ($P!{commodityId}) or -1 in ($P!{commodityId}))
		and (prod.commodity_group_id in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
		and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
		and stk.company_id = $P!{loginCompanyId}
	group by
		tcomp.company_id,
		tbin.bin_id,
		prod.lot_id,
		stk.stone_size
	having
	 (sum(stk.in_out_flag * stk.qty1) <> 0 or
		sum(stk.in_out_flag * stk.qty2) <> 0)
	order by
		tcomp.company_id,
		max(tcom.commodity_group_id),
		max(prod.commodity_id),
                     max(cut.cut_name),
		SUBSTRING(prod.lot_code, '^[A-Za-z]+') ASC,
		CAST(SUBSTRING(prod.lot_code FROM '[0-9]+') AS INTEGER) ASC
)tx) res]]>
	</queryString>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="product_id" class="java.lang.Integer"/>
	<field name="commodity_group_name" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="product_no" class="java.lang.String"/>
	<field name="bin_id" class="java.lang.Integer"/>
	<field name="bin_name" class="java.lang.String"/>
	<field name="stone_size" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="measurement" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="cut_name" class="java.lang.String"/>
	<field name="color_name" class="java.lang.String"/>
	<field name="clarity_name" class="java.lang.String"/>
	<field name="sieve_size" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="cost_price_code" class="java.lang.String"/>
	<field name="inv_qty1" class="java.math.BigDecimal"/>
	<field name="inv_qty2" class="java.math.BigDecimal"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="uom2" class="java.lang.String"/>
	<field name="grade" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="cost_price" class="java.math.BigDecimal"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="pp_rate" class="java.math.BigDecimal"/>
	<field name="pp_amount" class="java.math.BigDecimal"/>
	<variable name="inv_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
	</variable>
	<variable name="inv_qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
	</variable>
	<variable name="v_pp_amount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{pp_amount}]]></variableExpression>
	</variable>
