<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SkuMould" pageWidth="340" pageHeight="450" whenNoDataType="AllSectionsNoDetail" columnWidth="330" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="component" uuid="9f635239-62b1-4650-abc3-41d399b6a2ef">
		<parameter name="skuId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.sku_component_id component_id,
		 j.sku_id sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.sku_id,
		 tsc.total_wt tot_qty,
		 tsc.qty1,
		 tsc.qty2,
		 case when tsc.qty2 > 0 then tsc.total_wt / tsc.qty2 else 0 end per_pc_wt
	FROM
		 tbl_sku_component tsc
		inner join tbl_sku j on tsc.sku_id = j.sku_id
			and j.is_deleted = 0
		inner join tbl_commodity com on tsc.commodity_id = com.commodity_id
		inner join tbl_commodity_group cgr on com.commodity_group_id = cgr.commodity_group_id
	WHERE
		 tsc.is_deleted = 0
		 and (cgr.commodity_group_type like '%DIAMOND%')
		 and j.sku_id = $P!{skuId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(component_id) component_id,
		 max(sku_id) sku_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sku_id sales_order_det_id,
		m.sku_id,
	    generate_series recusrive_level,

		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pcs_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,6) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="sku_id" class="java.lang.Long"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
		<group name="component_id">
			<groupExpression><![CDATA[$F{component_id}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="comp_cs" uuid="781e5f53-350d-4e5e-84fd-c38803564ebc">
		<parameter name="skuId" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.sku_component_id component_id,
		 j.sku_id sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.sku_id,
		 tsc.total_wt tot_qty,
		 tsc.qty1,
		 tsc.qty2,
		 case when tsc.qty2 > 0 then tsc.total_wt / tsc.qty2 else 0 end per_pc_wt
	FROM
		 tbl_sku_component tsc
		inner join tbl_sku j on tsc.sku_id = j.sku_id
			and j.is_deleted = 0
		inner join tbl_commodity com on tsc.commodity_id = com.commodity_id
		inner join tbl_commodity_group cgr on com.commodity_group_id = cgr.commodity_group_id
	WHERE
		 tsc.is_deleted = 0
		 and (cgr.commodity_group_type not like '%DIAMOND%')
		 and j.sku_id = $P!{skuId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(component_id) component_id,
		 max(sku_id) sku_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sku_id sales_order_det_id,
		m.sku_id,
	    generate_series recusrive_level,

		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pcs_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,6) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="sku_id" class="java.lang.Long"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[" "]]></defaultValueExpression>
	</parameter>
	<parameter name="i_sku_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select s.sku_id,
	s.sku_no,
	p.product_type_name,
	ps.product_size,
	s.customer_ref_no,
	m.mould_no,
	m.rack_no,
	m.shop_name,
	pc.cam_wt,
	pc.casting_wt,
    	pc.cad_wt,
	w.wax_wt,
	pc.pipe_weight,
	s.metal_weight shipment_weight,
	sc.tot_qty,
    	sc.qty1,
	sc.qty2,
	round(case when sc.qty2 > 0 then sc.tot_qty / sc.qty2 else 0 end,3) per_pcs_wt,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url,
	pc.screw_weight
from
    tbl_sku s
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
	left join(
		select row_number() over (partition by sm.sku_id order by 1) sno, sm.*
		from tbl_sku_mould sm where sm.is_deleted = 0
	)m on s.sku_id = m.sku_id
		and m.sno = 1
	left join(
		select row_number() over (partition by sw.sku_id order by 1) sno, sw.*
		from tbl_sku_wax sw where sw.is_deleted = 0
	)w on s.sku_id = w.sku_id
		and w.sno = 1
    left join(
		select sjob.sku_id, sum(c.total_wt) tot_qty, sum(c.qty1) qty1, sum(c.qty2) qty2
		 from    tbl_sku sjob
		inner join tbl_sku_component c on sjob.sku_id = c.sku_id
		 where c.is_deleted  = 0
		 and (sjob.sku_id) in ($P!{i_sku_id})
		 group by sjob.sku_id
	)sc on s.sku_id = sc.sku_id
	left join(
			select
			jm.sku_id,
			max(case when upper(dp.process_name) = 'CASTING' then jm.output_weight else 0 end) casting_wt,
			max(case when upper(dp.process_name) = 'CAM' then jm.output_weight else 0 end) cam_wt,
			max(case when upper(dp.process_name) = 'CAD' then jm.output_weight else 0 end) cad_wt,
		    max(case when upper(dp.process_name) = 'PIPE PAIR' then jm.loss_weight else 0 end) pipe_weight,
			max(case when upper(dp.process_name) = 'SCREW' then jm.loss_weight else 0 end) screw_weight
			from tbl_sku_metal_weight_calculation jm
		    inner join tbl_process dp on jm.process_id = dp.process_id
		    where (jm.sku_id) in ($P!{i_sku_id})
		    group by jm.sku_id
    )pc on s.sku_id = pc.sku_id
    left join tbl_product_size ps on s.product_size_id = ps.size_id
where
	s.is_deleted = 0
	and (s.sku_id) in ($P!{i_sku_id})]]>
	</queryString>
