<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RecutRegister" pageWidth="1050" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1010" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="factoryId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	com.company_name,
	tx.*,
	tx.in_out_flag * (tx.issued_qty1 + tx.received_qty1 + tx.broken_qty1 + tx.loss_qty1) total_qty1,
	tx.in_out_flag * (tx.issued_qty2 + tx.received_qty2 + tx.broken_qty2 + tx.loss_qty2) total_qty2
from
(
	select
		t.issue_id,
	    t.company_id,
		t.issue_type||'-'||t.issue_no issue_type_no,
		to_char(t.issue_dt, 'dd/mm/yyyy') issue_dt,
		f.factory_name,
		l.lot_code,
		d.qty1 issued_qty1,
		d.qty2 issued_qty2,
		0 received_qty1,
		0 received_qty2,
		0 broken_qty1,
		0 broken_qty2,
		0 loss_qty1,
		0 loss_qty2,
		1 in_out_flag
	from
		tbl_recut_issue t
		inner join tbl_recut_issue_det d on t.issue_id = d.issue_id
			and d.is_deleted = 0
		inner join tbl_lot l on d.lot_id = l.lot_id
		and (l.commodity_group_id in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
		and (l.commodity_id in ($P!{commodityId}) or -1 in ($P!{commodityId}))
		and (l.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
		inner join tbl_factory f on t.factory_id = f.factory_id
		 and (f.factory_id in ($P!{factoryId}) or -1 in ($P!{factoryId}))
	where
		t.is_deleted = 0
		and t.issue_dt >= to_date($P{fromDate}, $P{dateFormat})
		and t.issue_dt <= to_date($P{toDate}, $P{dateFormat})
	union all
	select
		td.issue_id,
	    tr.company_id,
		tr.receive_type||'-'||tr.receive_no receive_type_no,
		to_char(tr.receive_dt, 'dd/mm/yyyy') issue_dt,
		f.factory_name,
		l.lot_code,
		0 issued_qty1,
		0 issued_qty2,
		td.qty1 received_qty1,
		td.qty2 received_qty2,
		td.broken_qty1,
		td.broken_qty2,
		td.loss_qty1,
		td.loss_qty2,
		-1 in_out_flag
	from
		tbl_recut_receive tr
		inner join tbl_recut_receive_det td on tr.receive_id = td.receive_id
			and td.is_deleted = 0
		inner join tbl_lot l on td.lot_id = l.lot_id
		and (l.commodity_group_id in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
		and (l.commodity_id in ($P!{commodityId}) or -1 in ($P!{commodityId}))
		and (l.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
		inner join tbl_factory f on tr.factory_id = f.factory_id
		and (f.factory_id in ($P!{factoryId}) or -1 in ($P!{factoryId}))
	where
		tr.is_deleted = 0
		and tr.receive_dt >= to_date($P{fromDate}, $P{dateFormat})
		and tr.receive_dt <= to_date($P{toDate}, $P{dateFormat})
)tx
inner join tbl_company com on tx.company_id = com.company_id
order by
	tx.issue_id,
	tx.issue_dt]]>
	</queryString>
