	<columnHeader>
		<band height="25" splitType="Stretch">
			<staticText>
				<reportElement positionType="FixRelativeToBottom" stretchType="RelativeToBandHeight" x="0" y="0" width="73" height="25" uuid="2aff6700-4274-49a2-9558-4d9bb823ae13"/>
				<box leftPadding="4" rightPadding="4">
