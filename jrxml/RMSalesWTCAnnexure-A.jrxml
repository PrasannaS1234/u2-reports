	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="company_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<parameterDescription><![CDATA["E:\\jew-trade-service\\src\\main\\resources\\jrxml\\"]]></parameterDescription>
		<defaultValueExpression><![CDATA["E:\\jew-trade-service\\src\\main\\resources\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
         m.inv_id,
          concat(m.inv_type,'-',m.inv_no) inv_no,
          fn_get_customer_invoice_no(m.inv_type,m.inv_id) cus_doc_type,
          m.terms_conditions,
         tcomp.company_uid,
          to_char(m.inv_dt,'dd/mm/yyyy') inv_dt,
          city.city_name,
          nullif(tcomp.cin_no,'') cin_no,
	tcomp.company_name,
         p.payment_type_name,
          concat(nullif(tcomp.area,''), nullif(tcomp.street,''),',', nullif(tcomp.city,''),'-',nullif(tcomp.pin_code,''),',',nullif(state.state_name,''),',', nullif(c.country_name,'')) add,
          concat('Email : ',tcomp.email,' ') email,
          concat('Ph : ',tcomp.phone_number,' ') phone_number,
          m.inv_type type
from tbl_sales_invoice_main m
     left join tbl_company tcomp on m.company_id = tcomp.company_id
		left join tbl_state state on tcomp.state = state.state_code
        left join tbl_country c on tcomp.country_id = c.country_id
        left join tbl_city city on m.place_of_pickup = city.city_code
        inner join tbl_payment_type p on m.payment_type_id = p.payment_type_id
where
	  m.inv_id = ($P!{i_inv_id})]]>
	</queryString>
