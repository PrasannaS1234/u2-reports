	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	max(tcom.commodity_name) com_name,
	max(sh.shape_name) sh_name,
	max(scomp.mm_size) mm_size,
	round(sum(scomp.tot_qty),3) wt,
	round(sum(scomp.qty2),0)	pcs
from
	tbl_jewellery t1
	inner join tbl_sales_order_det sod on t1.sales_order_det_id = sod.sales_order_det_id
		and sod.is_deleted = 0
	inner join tbl_sales_order_component scomp on sod.sales_order_det_id = scomp.sales_order_det_id
		and t1.sales_order_det_id = scomp.sales_order_det_id
		and t1.sales_order_id = scomp.sales_order_id
	left join tbl_commodity tcom on scomp.commodity_id = tcom.commodity_id
	left join tbl_shape sh on scomp.shape_id = sh.shape_id
where
	t1.jew_id in ($P!{i_inv_id})
group by
	scomp.commodity_id,
	scomp.shape_id,
	scomp.mm_size]]>
	</queryString>
	<field name="com_name" class="java.lang.String"/>
	<field name="sh_name" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="wt" class="java.math.BigDecimal"/>
	<field name="pcs" class="java.math.BigDecimal"/>
