<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DeliveryNote" pageWidth="670" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1" uuid="f2820699-e1b8-44d5-94fe-b9505c485156">
		<parameter name="i_inv_id" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[with w_total_amt as (
select m1.charge_name,m1.input_amt,1 sort_seq from tbl_sales_invoice_chgs m1
where m1.is_deleted = 0
and m1.inv_id in ($P!{i_inv_id})
union all
select 'Total' charge_name,m.total_invoice_amount, 9999999 sort_seq from tbl_sales_invoice_main m
where m.is_deleted = 0
and m.inv_id in ($P!{i_inv_id})
)
select 'Exchange Rate' charge_name,m.exchange_rate amt, 99999999 sort_seq
from tbl_sales_invoice_main m
where m.is_deleted = 0
and m.inv_id in ($P!{i_inv_id})
union all
select 'Balance' charge_name, sum(w.input_amt) +sum(m.exchange_rate) amt , 999999999 sort_seq
from tbl_sales_invoice_main m
inner join w_total_amt w on 1 = 1
where m.is_deleted = 0
and m.inv_id in ($P!{i_inv_id})
order by sort_seq]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
		<field name="sort_seq" class="java.lang.Integer"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by $P!{sortColumn}) sno,
    tmp.*
from
(
select
          row_number() over(order by dt.inv_det_id) srno,
	im.inv_id,
          dt.inv_det_id,
	im.inv_type||im.inv_no invoive_no,
          im.currency,
	im.exchange_rate,
          to_char(im.inv_dt, $P{dateFormat}) invoice_dt,
          to_char(im.inv_due_dt, $P{dateFormat})     invoice_due_dt,
	upper(cmp.company_name) company_name,
	concat(cmp.street,',',cmp.area,',',cmp.city,',',cmp.state,'-',cmp.pin_code,',',cnt.country_name) company_address,
	cus.customer_name customer_name,
	cus.primary_contact_name primary_contact_name,
	cus.primary_contact_no primary_contact_no,
	concat(im.ship_address1,',',im.ship_city,',', im.ship_state,'-',im.ship_pincode ,',',im.ship_country) ship_address1,
	cmg.commodity_group_name,
          lt.lot_code lot_no,
          com.commodity_id,
	lt.mm_size,
	shp.shape_name,
	dt.inv_qty1 carats,
	clr.color_name,
	lt.purity,
          clt.clarity_name,
	cut.cut_name,
	lt.polish,
	lt.symmetry,
	lt.lab_name,
	lt.certificate_no,
	dt.inv_qty2 pcs,
	dt.input_rate,
	dt.input_amt,
          im.exchange_rate
from tbl_sales_invoice_main im
inner join tbl_sales_invoice_det dt on im.inv_id = dt.inv_id
	and dt.is_deleted = 0
inner join tbl_company cmp on im.company_id = cmp.company_id
inner join tbl_country cnt on cmp.country_id = cnt.country_id
inner join tbl_customer cus on im.customer_id = cus.customer_id
inner join tbl_lot lt on lt.lot_id = dt.lot_id
inner join tbl_commodity com on lt.commodity_id = com.commodity_id
inner join tbl_commodity_group cmg on com.commodity_group_id = cmg.commodity_group_id
left join tbl_shape shp on lt.shape_id = shp.shape_id
left join tbl_color clr on lt.color_id = clr.color_id
left join tbl_clarity clt on clt.clarity_id = lt.clarity_id
left join tbl_cut cut on lt.cut_id = cut.cut_id
where
    im.is_deleted = 0
	and im.inv_id in ($P!{i_inv_id})
)tmp
order by $P!{sortColumn}]]>
	</queryString>
