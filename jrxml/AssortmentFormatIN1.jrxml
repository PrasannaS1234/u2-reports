					<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
					<subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "AssortmentFormatIN1_sub1.jasper"]]></subreportExpression>
				</subreport>
			</band>
		</groupHeader>
	</group>
