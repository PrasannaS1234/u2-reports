	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["'TEKFILO'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["'Style Catalogue'"]]></defaultValueExpression>
	</parameter>
	<parameter name="catalogName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="catalogDescription" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
          cm.catalog_name,
	cm.description,
	v.product_name,
	v.product_type_name,
	coalesce(v.product_desc,'') product_desc,
	coalesce(v.dia_qty1,0.000) dia_qty1,
	coalesce(v.dia_qty2,0.000) dia_qty2,
	coalesce(v.cs_qty1,0.000) cs_qty1,
	coalesce(v.cs_qty2,0.000) cs_qty2,
	coalesce(v.metal_wt,0.000) metal_wt,
	v.is_center_stone,
	coalesce(v.karatage,'-') karatage,
	coalesce(v.metal_code,'-') metal_code,
	coalesce(v.product_size, '-') product_size,
          case when cd.category = 'JEWELLERY' then sku.sku_no end as sku_no,
case when v.picture_url is not null and v.picture_url != ''
then concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',v.company_id,'/',lower(cd.category),'/',cd.product_id,v.picture_url)
when cd.category = 'JEWELLERY' and sku.image_url is not null
then concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku','/',sku.sku_id,sku.image_url)
end as image_url
from
	tbl_catalog  cm
	inner join tbl_catalog_det cd on cm.catalog_id = cd.catalog_id
		and cd.is_deleted = 0
	inner join v_catalog_summary v on cd.category = v.category
		and cd.product_id = v.product_id
	left join tbl_jewellery j on cd.product_id = j.jew_id and cd.category = 'JEWELLERY'
	left join tbl_sku sku on j.sku_id = sku.sku_id
where
	cm.is_deleted = 0
	and cm.catalog_id = $P!{id}]]>
	</queryString>
