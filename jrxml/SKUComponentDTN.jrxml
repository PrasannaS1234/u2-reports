	<subDataset name="Metal" uuid="81f57f69-1836-4588-91c8-4242746341f2">
		<parameter name="sku_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
lo.lot_code,
com.commodity_name,
k.karatage_name,
col.color_name,
s.metal_weight
from tbl_sku s
left join tbl_lot lo on s.metal_id = lo.lot_id
left join tbl_commodity com on lo.commodity_id = com.commodity_id
left join tbl_karatage k on lo.karatage_id = k.karatage_id
left join tbl_color col on lo.color_id = col.color_id
where s.sku_id = $P!{sku_id}]]>
		</queryString>
		<field name="lot_code" class="java.lang.String"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="karatage_name" class="java.lang.String"/>
		<field name="color_name" class="java.lang.String"/>
		<field name="metal_weight" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="Metal_summary" uuid="8f16638a-3627-45a4-9efa-cbb86c3d2422">
		<parameter name="sku_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[with w_result_set as (
	select som.sku_id,
	   sum(som.total_wt * 0.2) stone_gm
    from tbl_sku_component som
 left join tbl_commodity cm on som.commodity_id = cm.commodity_id
 left join tbl_shape shp on som.shape_id = shp.shape_id
 left join tbl_color col on som.color_id = col.color_id
 left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
 where
      som.is_deleted = 0
      and som.sku_id = $P!{sku_id}
 group by som.sku_id
)
select
lo.lot_code,
com.commodity_name,
coalesce(k.karatage_code, '') karatage_code,
coalesce(col.color_code,'')  color_code,
s.metal_weight,
(s.metal_weight + rr.stone_gm) gross_wt
from tbl_sku s
inner join  w_result_set rr on s.sku_id = rr.sku_id
left join tbl_lot lo on s.metal_id = lo.lot_id
left join tbl_commodity com on lo.commodity_id = com.commodity_id
left join tbl_karatage k on lo.karatage_id = k.karatage_id
left join tbl_color col on lo.color_id = col.color_id
where s.sku_id = $P!{sku_id}]]>
		</queryString>
		<field name="lot_code" class="java.lang.String"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="karatage_code" class="java.lang.String"/>
		<field name="color_code" class="java.lang.String"/>
		<field name="metal_weight" class="java.math.BigDecimal"/>
		<field name="gross_wt" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="stone_summary" uuid="a5a7efa0-d21a-4f0f-8c0f-e3f0be280cdc">
		<parameter name="sku_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[with w_result_set as (
	select
       cm.commodity_name,
       shp.shape_name,
	col.color_name,
	som.grade,
	   som.sieve_size,
       som.mm_size,
	   som.total_wt,
       som.qty1,
       som.qty2,
	   stp.setting_type_name,
	   case when som.is_center_stone = 1 then 'Yes' else 'No' end cenerStone
  from tbl_sku_component som
 left join tbl_commodity cm on som.commodity_id = cm.commodity_id
 left join tbl_shape shp on som.shape_id = shp.shape_id
 left join tbl_color col on som.color_id = col.color_id
 left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
 where
      som.is_deleted = 0
      and som.sku_id = $P!{sku_id}
)
select
rr.commodity_name,
sum(rr.total_wt) total_wt,
sum(rr.total_wt * 0.2) total_wt_gm,
sum(rr.qty2) total_pcs
from
  w_result_set rr
group by
rr.commodity_name]]>
		</queryString>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="total_wt" class="java.math.BigDecimal"/>
		<field name="total_wt_gm" class="java.math.BigDecimal"/>
		<field name="total_pcs" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="sku_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
	select
	lot.lot_code,
       cm.commodity_name,
       shp.shape_name,
	col.color_name,
	som.grade,
	   som.sieve_size,
       som.mm_size,
	   som.total_wt,
       som.qty1,
       som.qty2,
	   stp.setting_type_name,
	   case when som.is_center_stone = 1 then 'Yes' else 'No' end cenerStone
  from tbl_sku_component som
 left join tbl_commodity cm on som.commodity_id = cm.commodity_id
 left join tbl_shape shp on som.shape_id = shp.shape_id
 left join tbl_color col on som.color_id = col.color_id
  left join tbl_lot lot on som.lot_id = lot.lot_id
 left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
 where
      som.is_deleted = 0
      and som.sku_id = $P!{sku_id}
)
select
rr.*
from
  w_result_set rr]]>
	</queryString>
	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="color_name" class="java.lang.String"/>
	<field name="grade" class="java.lang.String"/>
	<field name="sieve_size" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="total_wt" class="java.math.BigDecimal"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="setting_type_name" class="java.lang.String"/>
	<field name="cenerstone" class="java.lang.String"/>
