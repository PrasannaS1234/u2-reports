<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Debtors" pageWidth="1600" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1560" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="875"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tmp2.*
from
(
select
	tmp.*,
	sum(tmp.include_return_amt) over(partition by tmp.ref_inv_type_id) include_amt
from
(
select
	max(de.company_name)	company_name,
	max(de.inv_type_no)		inv_type_no,
	max(de.currency)		currency,
	max(de.exchange_rate)	exchange_rate,
	max(to_char(de.inv_dt,$P{dateFormat})) inv_dt,
	max(de.reference_no) 	ref_no,
	null	closing_dt,
	null	pn_recv_dt,
	max(to_char(de.inv_due_dt,$P{dateFormat})) inv_due_dt,
	max(de.payment_type_name)	payment_type_name,
	sum(de.plus_minus_flag * de.base_amt)	inv_amt,
	sum(de.plus_minus_flag * de.base_settled_amt)	settled_amt,
	sum(de.plus_minus_flag * de.base_pending_amt) 	pending_amt,
	sum(case when to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt <= 0 then de.plus_minus_flag * de.base_pending_amt else 0 end)	no_due_amt,
	sum(case when to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt > 0 then de.plus_minus_flag * de.base_pending_amt else 0 end)	due_amt,
	max(to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) age_days,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 0 and 30 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	d030,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 31 and 60 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	d3160,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 61 and 90 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	d6190,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 91 and 120 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	d91120,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 121 and 180 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	d121180,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 181 and 365 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	d181365,
	sum(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) > 365 then de.plus_minus_flag * de.base_pending_amt else 0 end ) 	gt365,
	max(de.party_name)	party_name,
	max(de.party_name)  report_grp,
          sum(plus_minus_flag * base_pending_amt) include_return_amt,
	max(concat(de.ref_inv_type,'-',de.ref_inv_id)) ref_inv_type_id,
	max(de.inv_dt) inv_date,
	de.inv_type,
	de.inv_id
from
	v_debtors de
where
	de.trans_dt <= to_date($P{toDate}, $P{dateFormat})
	and (lower(de.party_name) like concat(lower(trim($P!{customerLike})),'%%'))
          and de.company_id in ($P!{companyId})
group by
	de.company_id,
	de.inv_type,
	de.inv_id
having
	sum(de.plus_minus_flag * de.base_amt) -
	sum(de.base_settled_amt) <> 0
) tmp
) tmp2

order by
		report_grp,inv_date,inv_type,inv_id]]>
	</queryString>
