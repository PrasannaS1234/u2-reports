<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LabelSticker" pageWidth="170" pageHeight="93" columnWidth="166" leftMargin="2" rightMargin="2" topMargin="0" bottomMargin="0" isTitleNewPage="true" uuid="b36743b0-36b6-484f-abd8-bbe0d7ea16a2">
	<property name="ireport.zoom" value="5.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	max(t.jew_id) jew_id,
	max(concat(t.jew_type, t.jew_no)) job_type_no,
	bag.bag_id job_id,
	max(concat(bag.bag_type, bag.bag_no)) bag_type_no,
	max(bag.customer_bag_no) customer_bag_order_no,
	max(so.reference_no) customer_ref_no,
 	max(concat(c.customer_name, nullif(concat(' - ',cst.store_name),' - '))) customer_name,
	max(mfi.bag_gross_wt) gross_wt,
	max(bag.customer_bag_order_no) customer_order_no,
    max(lt.lot_code) lot_code,
	round(sum(case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') and ltt.lot_type = 'STONE' then mfc.consumed_qty1 end),3) dia_cts,
	round(sum(case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') and ltt.lot_type = 'STONE' then mfc.consumed_qty2 end),2
) dia_pcs,
	round(sum(case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') and ltt.lot_type = 'STONE' then mfc.consumed_qty1 end),3) cs_cts,
	round(sum(case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') and ltt.lot_type = 'STONE' then mfc.consumed_qty2 end),2) cs_pcs
from
	tbl_jewellery t
	inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
		and bag.is_deleted = 0
	inner join tbl_mfg_factory_invoice_det mfi on mfi.bag_id = bag.bag_id
	    and mfi.is_deleted = 0
	inner join tbl_mfg_factory_invoice_main mf on mfi.inv_id = mf.inv_id
		and mf.is_deleted = 0
    inner join tbl_mfg_factory_invoice_component mfc on mfi.bag_id = mfc.bag_id
	    and mfi.inv_id = mfc.inv_id
		and mf.inv_id = mfc.inv_id
		and mfc.inv_det_id = mfi.inv_det_id
		and mfc.is_deleted = 0
    inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
    inner join tbl_sales_order_det sod on so.sales_order_id = sod.sales_order_id
		and t.sales_order_det_id = sod.sales_order_det_id
    left join tbl_customer c on mf.customer_id = c.customer_id
		and c.is_deleted = 0
    inner join tbl_lot lt on t.metal_id = lt.lot_id
    inner join tbl_lot ltt on mfc.lot_id = ltt.lot_id
    left join tbl_commodity cm ON ltt.commodity_id = cm.commodity_id
	left join tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
    left join tbl_customer_store cst on sod.store_id = cst.store_id
where (mfi.inv_id) in ($P!{i_inv_id})
group by
     bag.bag_id
order by
     bag.bag_id]]>
	</queryString>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="job_type_no" class="java.lang.String"/>
	<field name="job_id" class="java.lang.Integer"/>
	<field name="bag_type_no" class="java.lang.String"/>
	<field name="customer_bag_order_no" class="java.lang.String"/>
	<field name="customer_ref_no" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="gross_wt" class="java.math.BigDecimal"/>
	<field name="customer_order_no" class="java.lang.String"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="dia_cts" class="java.math.BigDecimal"/>
	<field name="dia_pcs" class="java.math.BigDecimal"/>
	<field name="cs_cts" class="java.math.BigDecimal"/>
	<field name="cs_pcs" class="java.math.BigDecimal"/>
