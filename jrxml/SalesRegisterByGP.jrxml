<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesRegisterByGP" pageWidth="2200" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="2160" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'DD/MM/YYYY'"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    tcomp.company_name,
    im.inv_id,
    im.inv_type||'-'||im.inv_no as inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) as inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat}) as inv_due_dt,
    im.currency,
    COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate) exchange_rate,
    im.reference_no,
    tcus.customer_name,
    prod.lot_code,
    id.uom1,
    id.uom2,
    id.lot_description,
    tcomg.commodity_group_name,
    tcom.commodity_name,
    sh.shape_name,
    cut.cut_name,
    col.color_name,
    cla.clarity_name,
    id.inv_qty1,
    id.inv_qty2,

    -- Input Rate with 2-way currency conversion
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.input_rate / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 4)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.input_rate * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 4)
        else id.input_rate
    end as input_rate,

    -- Input Amount with 2-way currency conversion
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.input_amt / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.input_amt * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.input_amt
    end as input_amt,

    id.discount_type,

    -- Discount Value with 2-way currency conversion
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.discount_value / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.discount_value * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.discount_value
    end as discount_value,

    -- Cost Price with 2-way currency conversion
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(lp.cost_price / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(lp.cost_price * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else lp.cost_price
    end as cost_price,

    -- GP Amount and GP Percentage with 2-way conversion
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.input_amt / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate) - round(lp.cost_price / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate),2), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.input_amt * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate) - round(lp.cost_price * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate),2), 2)
        else id.input_amt - lp.cost_price
    end as gp_amt,

    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round((id.input_amt / nullif(im.exchange_rate,0) - round(lp.cost_price / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate),2)) / (id.input_amt / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate)),2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round((id.input_amt * im.exchange_rate - round(lp.cost_price * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate),2)) / (id.input_amt * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate)),2)
        else round((id.input_amt - lp.cost_price) / id.input_amt,2)
    end as gp_pct,

    prod.mm_size,
    lp.cost_price_code

from
    $P!{schema}.tbl_sales_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join $P!{schema}.tbl_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join $P!{schema}.tbl_customer tcus on im.customer_id = tcus.customer_id
    inner join $P!{schema}.tbl_lot prod on id.lot_id = prod.lot_id
    inner join $P!{schema}.tbl_commodity tcom on prod.commodity_id = tcom.commodity_id
    inner join $P!{schema}.tbl_commodity_group tcomg on tcom.commodity_group_id = tcomg.commodity_group_id
    left join $P!{schema}.tbl_shape sh on prod.shape_id = sh.shape_id
    left join $P!{schema}.tbl_cut cut on prod.cut_id = cut.cut_id
    left join $P!{schema}.tbl_color col on prod.color_id = col.color_id
    left join $P!{schema}.tbl_clarity cla on prod.clarity_id = cla.clarity_id
    left join $P!{schema}.tbl_lot_price_det lp on prod.lot_id = lp.lot_id
        and im.company_id = lp.company_id

where
    im.is_deleted = 0
    and im.company_id = $P!{companyId}
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    and (cast(tcus.customer_id as text) in ($P!{customerId}) or '-1' in ($P!{customerId}))
    and (cast(prod.commodity_id as text) in ($P!{commodityId}) or '-1' in ($P!{commodityId}))
    and (cast(prod.commodity_group_id as text) in ($P!{commodityGroupId}) or '-1' in ($P!{commodityGroupId}))
    and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))

order by
    im.inv_dt,
    im.inv_id;]]>
	</queryString>
