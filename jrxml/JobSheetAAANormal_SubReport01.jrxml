<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheet_SubReport01" pageWidth="575" pageHeight="200" columnWidth="575" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="164787d2-0b5e-42a4-8bf7-81dda9657bd8">
	<property name="ireport.zoom" value="1.5026296018031553"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="bagId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="bagQty" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with v_data as
(
	select
		tp.recusrive_level,
		tp.lot_code,
		tp.commodity_name,
		tp.shape_name,
                     tp.cut_name,
		tp.stone_size,
		tp.tot_qty,
                     tp.min_wt,
		tp.qty1,
		tp.qty2,
                     tp.grade,
                     tp.setting_type_name,
		count(*) over(partition by tp.sales_order_id) cnt
	from
	(
		SELECT
			 row_number() over (order by tsc.component_id) recusrive_level,
			 l.lot_code,
			 c.commodity_name,
			 sh.shape_name,
                                ct.cut_name,
			 (case when length(tsc.mm_size) > 0 then tsc.mm_size else tsc.sieve end) stone_size,
			 ($P!{bagQty} * tsc.tot_qty) tot_qty,
			 ($P!{bagQty} * tsc.qty1) qty1,
			 ($P!{bagQty} * tsc.qty2) qty2,
			 tsc.sales_order_id,
                                tsc.grade,
                                tsc.min_wt,
                                s.setting_type_name
		FROM
			 tbl_sales_order_component tsc
			 inner join tbl_sales_order_det tsd on tsc.sales_order_det_id = tsd.sales_order_det_id
				and tsd.is_deleted = 0
			inner join tbl_jewellery j on tsd.sales_order_det_id = j.sales_order_det_id
				and tsd.is_deleted = 0
			inner join tbl_mfg_bag bag on j.jew_id = bag.job_id
			left join tbl_lot l on tsc.lot_id = l.lot_id
			left join tbl_commodity c on tsc.commodity_id  = c.commodity_id
			left join tbl_shape sh on tsc.shape_id = sh.shape_id
                               left join tbl_setting_type s on tsc.setting_type_id = s.setting_type_id
                               left join tbl_cut ct on tsc.cut_id=ct.cut_id
		WHERE
			 tsc.is_deleted = 0
			 and j.job_category = 'Normal'
			 and bag.bag_id = $P!{bagId}
		union all
		SELECT
			 row_number() over (order by tsc.component_id) recusrive_level,
			 l.lot_code,
			 c.commodity_name,
			 sh.shape_name,
                                ct.cut_name,
			 (case when length(tsc.mm_size) > 0 then tsc.mm_size else tsc.sieve end) stone_size,
			 ($P!{bagQty}* tsc.tot_qty) tot_qty,
			 ($P!{bagQty} * tsc.qty1) qty1,
			 ($P!{bagQty} * tsc.qty2) qty2,
			 tsc.repair_order_id sales_order_id,
                                null   min_wt,
                                null     grade,
                                null setting_type_name
		FROM
			 tbl_repair_order_component tsc
			 inner join tbl_repair_order_det tsd on tsc.repair_order_det_id = tsd.repair_order_det_id
				and tsd.is_deleted = 0
			inner join tbl_jewellery j on tsd.repair_order_det_id = j.sales_order_det_id
				and tsd.is_deleted = 0
			inner join tbl_mfg_bag bag on j.jew_id = bag.job_id
			left join tbl_lot l on tsc.lot_id = l.lot_id
			left join tbl_commodity c on tsc.commodity_id  = c.commodity_id
			left join tbl_shape sh on tsc.shape_id = sh.shape_id
                               left join tbl_cut ct on tsc.cut_id=ct.cut_id
		WHERE
			 tsc.is_deleted = 0
			 and j.job_category = 'Repair'
			 and bag.bag_id = $P!{bagId}
	) tp
)
select
	vt.*
from
	v_data vt
where
	recusrive_level between 0 and 5
union all
select
 			0	recusrive_level,
			 null	lot_code,
			 null	commodity_name,
			 null	shape_name,
                                null     cut_name,
			 ''	stone_size,
			 null	tot_qty,
                                null     min_wt,
			 null	qty1,
			 null	qty2,
                                null     grade,
                                null     setting_type_name,
			 0		cnt
from
	(
		select
			coalesce(max(dt.cnt),0) records
		from
			v_data dt
		where
			recusrive_level between 0 and 5
	) rec
	inner join generate_series(0,5-rec.records) on 1 = 1]]>
	</queryString>
	<field name="recusrive_level" class="java.lang.Long"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="cut_name" class="java.lang.String"/>
	<field name="stone_size" class="java.lang.String"/>
	<field name="tot_qty" class="java.math.BigDecimal"/>
	<field name="min_wt" class="java.math.BigDecimal"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="grade" class="java.lang.String"/>
	<field name="setting_type_name" class="java.lang.String"/>
	<field name="cnt" class="java.lang.Long"/>
