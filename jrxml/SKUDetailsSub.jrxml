<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SKUDetailsSub" pageWidth="700" pageHeight="842" columnWidth="700" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="sku_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
	select
       cm.commodity_name,
       shp.shape_name,
	   som.sieve_size,
       som.mm_size,
       som.qty1,
       som.qty2,
	   stp.setting_type_name,
	   case when som.is_center_stone = 1 then 'Yes' else 'No' end cenerStone
  from tbl_sku_component som
 left join tbl_commodity cm on som.commodity_id = cm.commodity_id
 left join tbl_shape shp on som.shape_id = shp.shape_id
 left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
 where
      som.is_deleted = 0
      and som.sku_id = $P!{sku_id}
)
select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
    NULL AS commodity_name,
    NULL AS shape_name,
	NULL AS seive_size,
    NULL AS mm_size,
    NULL AS qty1,
    NULL AS qty2,
	NULL AS setting_type_id,
	NULL AS centerStone
FROM generate_series(1, 5-(select count(*) from w_result_set))]]>
	</queryString>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="sieve_size" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="setting_type_name" class="java.lang.String"/>
	<field name="cenerstone" class="java.lang.String"/>
