	<parameter name="invoiceNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	1 sr_no,
	grp.locationname,
	grp.refno,
	grp.stoneskuname,
	sum(stone_wt) stone_wt,
	sum(stone_pcs) stone_pcs
from
(
select
	1 sr_no,
	im.locationname,
	im.refno,
	im.stoneskuname,
	sum(stone_wt) stone_wt,
	sum(pcs) stone_pcs
from
	tbl_invoice_breakup im
where
	im.is_deleted  = 0
	and im.inv_id = $P!{invId}
group by
	im.locationname,
	im.refno,
	im.stoneskuname,
	im.jobno
) grp
group by
	grp.locationname,
	grp.refno,
	grp.stoneskuname
	order by locationname,refno,stoneskuname]]>
	</queryString>
	<field name="sr_no" class="java.lang.Integer"/>
	<field name="locationname" class="java.lang.String"/>
	<field name="refno" class="java.lang.String"/>
	<field name="stoneskuname" class="java.lang.String"/>
	<field name="stone_wt" class="java.math.BigDecimal"/>
	<field name="stone_pcs" class="java.math.BigDecimal"/>
	<variable name="stone_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{stone_wt}]]></variableExpression>
	</variable>
	<variable name="stone_pcs_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{stone_pcs}]]></variableExpression>
	</variable>
