	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t1.inv_id,
          ROW_NUMBER() OVER (PARTITION BY t1.inv_id ORDER BY t2.inv_det_id ASC) AS sno,
	tcomp.company_name,
	concat(t1.inv_type,'-',t1.inv_no) inv_no,
	to_char(t1.inv_dt, 'DD/MM/YYYY')  inv_dt,
	t1.remarks,
  -- ROUND(t2.rate, 2) rate,
  -- ROUND(t2.amount, 2)  amount,
	tfac.factory_name,
	bag.bag_qty,
	CASE
          WHEN bag.bag_no IS NOT NULL THEN CONCAT(bag.bag_type, bag.bag_no)
          ELSE CONCAT(jew.jew_type, jew.jew_no)
          END AS bag_no,
	lot.lot_code,
	com.commodity_name,
	pt.product_type_name,
	case when t1.issue_return_type = 'BAG' then bag.bag_gross_wt
	else t2.qty1 end as issue_qty1,
	case when t1.issue_return_type = 'BAG' then bag.bag_qty
	else t2.qty2 end as issue_qty2,
	t2.uom1,
	t2.uom2,
	concat(so.sales_order_type,so.sales_order_no) so_no,
CASE
      WHEN coalesce(length(trim(jew.image_url)),0) > 0 THEN
        concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',t1.company_id,'/jewellery/',jew.jew_id,jew.image_url)
else    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',t1.company_id,'/sku/',sku.sku_id,sku.image_url)
     END AS img_url,
 -- sku.sku_no,
	t2.mm_size,
    --coalesce(nullif(t2.stone_size, 'NA'), '') size,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/', $P{tenant}, '/comp', t1.company_id, '/company',tcomp.company_id,tcomp.log_url) AS image_url
from
	tbl_goods_issue_main t1
	inner join tbl_factory tfac on t1.factory_id = tfac.factory_id
	inner join tbl_goods_issue_det t2 on t1.inv_id = t2.inv_id
		and t2.is_deleted = 0
   left join tbl_jewellery jew on t2.jew_id = jew.jew_id
   left join tbl_product_type pt on jew.product_type_id = pt.product_type_id
   left join tbl_mfg_bag bag on t2.bag_id = bag.bag_id
	inner join tbl_company tcomp on t1.company_id = tcomp.company_id
	left join tbl_lot lot on t2.lot_id = lot.lot_id
	left join tbl_commodity com on lot.commodity_id = com.commodity_id
	left join tbl_sales_order_main so on COALESCE(jew.sales_order_id, t2.so_Id) = so.sales_order_id
	left join tbl_sku sku on jew.sku_id = sku.sku_id
where
	t1.is_deleted = 0
	and lot.lot_type = 'METAL'
	and t1.inv_id = $P!{i_inv_id}
	order by t1.inv_id desc;]]>
	</queryString>
