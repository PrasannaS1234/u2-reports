<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JewSalesRegister" pageWidth="850" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="810" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.2078825000000015"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewTypeNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="marketId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="designId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    max(company_name)   company_name,
    max(inv_type_no)    inv_type_no,
    max(inv_dt) inv_dt,
    max(inv_due_dt) inv_due_dt,
    max(currency)   currency,
    max(exchange_rate)  exchange_rate,
    max(reference_no)   reference_no,
    max(customer_name)  customer_name,
    max(salesman_name)  salesman_name,
    max(sku_no)	 sku_no,
    sum((case when inv_type = 'JSRI' then -1 else 1 end) * inv_qty)    inv_qty,
    sum((case when inv_type = 'JSRI' then -1 else 1 end) * input_amt)  input_amt
from
(
    Select
        im.inv_type||'-'||im.inv_no inv_type_no,
        im.inv_dt invoice_dt,
        to_char(im.inv_dt, $P{dateFormat}) inv_dt,
        to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
        im.currency,
        im.exchange_rate,
        im.reference_no,
        emp.first_name||'-'||emp.last_name salesman_name,
        tcus.customer_name,
        concat(prod.jew_type,prod.jew_no) product_no,
        pt.product_type_name,
        mk.market_name,
        col.collection_name,
        prod.design_no,
        prod.sku_no,
        tcomp.company_name,
        id.prod_description,
        id.inv_qty,
        id.uom,
        id.input_rate,
        id.input_amt,
        id.cost_price,
        im.inv_type,
        im.inv_id
    from
        tbl_jew_sales_invoice_main im
        inner join tbl_company tcomp on im.company_id = tcomp.company_id
        inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
            and (id.bin_id in ($P!{binId}) or -1 in ($P!{binId}))
            and id.is_deleted = 0
        inner join tbl_customer tcus on im.customer_id = tcus.customer_id
        inner join tbl_jewellery prod on id.jew_id = prod.jew_id
    	and (prod.jew_id in ($P!{jewId}) or -1 in ($P!{jewId}))
    	and (prod.design_id in ($P!{designId}) or '-1' in ($P!{designId}))
    	and (prod.sku_id in ($P!{skuId}) or -1 in ($P!{skuId}))
        left join tbl_employee emp on im.salesman_id = emp.employee_id
        left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
    	and (pt.product_type_id  in ($P!{productTypeId}) or -1 in ($P!{productTypeId}))
    left join tbl_market mk on prod.market_id = mk.market_id
    	and (mk.market_id in ($P!{marketId}) or -1 in ($P!{marketId}))
    left join tbl_collection col on prod.collection_id = col.collection_id
    	and (col.collection_id in ($P!{collectionId}) or -1 in ($P!{collectionId}))
    where
        im.is_deleted = 0
        and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
        and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
        and (tcus.customer_id  in ($P!{customerId}) or -1 in ($P!{customerId}))
    union all
    Select
        im.inv_type||'-'||im.inv_no inv_type_no,
        im.inv_dt invoice_dt,
        to_char(im.inv_dt, $P{dateFormat}) inv_dt,
        to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
        im.currency,
        im.exchange_rate,
        im.reference_no,
        emp.first_name||'-'||emp.last_name salesman_name,
        tcus.customer_name,
       concat(prod.jew_type,prod.jew_no) product_no,
        pt.product_type_name,
        mk.market_name,
        col.collection_name,
        prod.design_no,
        prod.sku_no,
        tcomp.company_name,
        id.prod_description,
        id.inv_qty,
        id.uom,
        id.input_rate,
        id.input_amt,
        id.cost_price,
        im.inv_type,
        im.inv_id
    from
        tbl_jew_sales_return_invoice_main im
        inner join tbl_company tcomp on im.company_id = tcomp.company_id
        inner join tbl_jew_sales_return_invoice_det id on im.inv_id = id.inv_id
            and (id.bin_id in ($P!{binId}) or -1 in ($P!{binId}))
            and id.is_deleted = 0
        inner join tbl_customer tcus on im.customer_id = tcus.customer_id
        inner join tbl_jewellery prod on id.jew_id = prod.jew_id
        and (prod.jew_id in ($P!{jewId}) or -1 in ($P!{jewId}))
        and (prod.design_id in ($P!{designId}) or '-1' in ($P!{designId}))
        and (prod.sku_id in ($P!{skuId}) or -1 in ($P!{skuId}))
        left join tbl_employee emp on im.salesman_id = emp.employee_id
        left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
        and (pt.product_type_id  in ($P!{productTypeId}) or -1 in ($P!{productTypeId}))
        left join tbl_market mk on prod.market_id = mk.market_id
            and (mk.market_id in ($P!{marketId}) or -1 in ($P!{marketId}))
        left join tbl_collection col on prod.collection_id = col.collection_id
            and (col.collection_id in ($P!{collectionId}) or -1 in ($P!{collectionId}))
    where
        im.is_deleted = 0
        and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
        and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
        and (tcus.customer_id  in ($P!{customerId}) or -1 in ($P!{customerId}))
) res
group by
    res.inv_type,
    res.inv_id
order by
    res.inv_type,
    res.inv_id,
    max(res.invoice_dt)]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
