			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="1211" y="0" width="86" height="30" isPrintWhenDetailOverflows="true" uuid="845216fa-c583-4c49-948e-4bed39104aff"/>
				<box leftPadding="2" rightPadding="2">
					<pen lineWidth="0.5"/>
