<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SODateReference" pageWidth="1500" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1490" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="style1">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{delay_flag}.equals("Delay") ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#FFFFFF" backcolor="#FF0033" fill="Solid" isBlankWhenNull="false" pdfEncoding="Cp1252">
				<pen lineColor="#000000"/>
			</style>
		</conditionalStyle>
	</style>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_bag_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[" "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (order by sm.sales_order_id, sd.sales_order_det_id, t.bag_id) sno,
	t.bag_id,
	concat(t.bag_type,t.bag_no) bag_type_no,
	t.bag_qty,
	case when date(sm.delivery_date) - CURRENT_DATE < 0 then 'Delay' else 'Normal' end delay_flag,
	date(sm.delivery_date) - CURRENT_DATE delay_ageing,
	sm.reference_no so_reference_no,
	COALESCE(nullif(t.customer_bag_no,''), sd.customer_jew_no) customer_bag_no,
	COALESCE(nullif(t.customer_bag_order_no,''), sd.customer_order_no) customer_order_no,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sm.company_id,'/sku/',sku.sku_id,sku.image_url) image_url,
	cus.display_name,
	null image,
	sku.sku_no,
	ps.product_size,
	to_char(sm.sales_order_date, 'dd/MM/yyyy') so_dt,
	to_char(sm.delivery_date, 'dd/MM/yyyy') delivery_dt,
	dept.department_name,
	col.collection_name,
	to_char(sr.cad_confirm_dt, 'dd/MM/yyyy') cad_confirm_dt,
	to_char(sr.gold_receive_dt, 'dd/MM/yyyy') gold_receive_dt,
	to_char(sr.stone_receive_dt, 'dd/MM/yyyy') stone_receive_dt,
	to_char(cr.inv_dt, 'dd/MM/yyyy') casting_dt,
	pc.casting_wt,
	pc.polishing_wt delivery_wt,
	sc.tot_qty dia_wt,
	sc.qty2 dia_pcs
from
	tbl_mfg_bag t
	inner join tbl_jewellery j on t.job_id = j.jew_id
	inner join tbl_sales_order_det sd on j.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	inner join tbl_sales_order_main sm on sd.sales_order_id = sm.sales_order_id
	inner join tbl_customer cus on sm.customer_id = cus.customer_id
	inner join tbl_sku sku on sd.sku_id = sku.sku_id
	inner join tbl_department dept on t.department_id = dept.department_id
	left join tbl_collection col on sku.collection_id = col.collection_id
	left join tbl_sales_order_date_reference sr on sd.sales_order_det_id = sr.sales_order_det_id
		and sr.is_deleted = 0
	left join(
		select cd.bag_id, max(cm.inv_dt) inv_dt from tbl_mfg_casting_receive_det cd
		inner join tbl_mfg_casting_receive cm on cd.inv_id = cm.inv_id
		where cd.is_deleted = 0 group by cd.bag_id
	)cr on t.bag_id = cr.bag_id
	left join(
		select
		jm.sku_id,
		max(case when upper(dp.process_name) = 'CASTING' then jm.output_weight else 0 end) casting_wt,
		max(case when upper(dp.process_name) = 'POLISH' then jm.output_weight else 0 end) polishing_wt,
		max(case when upper(dp.process_name) = 'CAD' then jm.output_weight else 0 end) cad_wt
		from tbl_sku_metal_weight_calculation jm
		inner join tbl_process dp on jm.process_id = dp.process_id
		where jm.is_deleted = 0
		group by jm.sku_id
    )pc on sd.sku_id = pc.sku_id
	left join(
		select sbag.bag_id, round(sum(sbag.bag_qty * c.tot_qty),3) tot_qty, round(sum(sbag.bag_qty * c.qty1),3) qty1,
		 sum(sbag.bag_qty * c.qty2) qty2
		 from    tbl_jewellery sjob
		inner join tbl_mfg_bag sbag on sjob.jew_id = sbag.job_id
		inner join tbl_sales_order_component c on sjob.sales_order_det_id = c.sales_order_det_id
		 where c.is_deleted  = 0
		 group by sbag.bag_id
	)sc on t.bag_id = sc.bag_id
	left join tbl_product_size ps on j.product_size_id = ps.size_id
where t.bag_id in ($P!{i_bag_id})
order by sm.sales_order_id, sd.sales_order_det_id, t.bag_id]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="bag_id" class="java.lang.Integer"/>
	<field name="bag_type_no" class="java.lang.String"/>
	<field name="bag_qty" class="java.math.BigDecimal"/>
	<field name="delay_flag" class="java.lang.String"/>
	<field name="delay_ageing" class="java.lang.Integer"/>
	<field name="so_reference_no" class="java.lang.String"/>
	<field name="customer_bag_no" class="java.lang.String"/>
	<field name="customer_order_no" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="display_name" class="java.lang.String"/>
	<field name="image" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="so_dt" class="java.lang.String"/>
	<field name="delivery_dt" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<field name="collection_name" class="java.lang.String"/>
	<field name="cad_confirm_dt" class="java.lang.String"/>
	<field name="gold_receive_dt" class="java.lang.String"/>
	<field name="stone_receive_dt" class="java.lang.String"/>
	<field name="casting_dt" class="java.lang.String"/>
	<field name="casting_wt" class="java.math.BigDecimal"/>
	<field name="delivery_wt" class="java.math.BigDecimal"/>
	<field name="dia_wt" class="java.math.BigDecimal"/>
	<field name="dia_pcs" class="java.math.BigDecimal"/>
