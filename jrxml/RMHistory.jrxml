<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RMHistory" pageWidth="820" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="780" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tx.in_out_flag * tx.inv_qty1 bal_qty1, tx.in_out_flag * tx.inv_qty2 bal_qty2, tx.*
from
(
	select
		'Opening' inv_type_no,
		to_char(to_date($P{fromDate}, $P{dateFormat}), $P{dateFormat}) inv_dt,
		to_date($P{fromDate}, $P{dateFormat}) det_created_dt,
		t.lot_id,
		t.bin_id,
		max(p.lot_code) lot_code,
		max(b.bin_name) bin_name,
		1 in_out_flag,
		sum(in_out_flag * qty1) inv_qty1,
		sum(in_out_flag * qty2) inv_qty2,
		1	sort_seq,
		'' 	ref_no,
		'' 	slot,
		''	dlot
	from
		tbl_lot_stock_trans t
		inner join tbl_lot p on t.lot_id = p.lot_id
		inner join tbl_bin b on t.bin_id = b.bin_id
	where
		t.is_deleted = 0
		and inv_dt < to_date($P{fromDate}, $P{dateFormat})
	 	and (p.commodity_id in ($P!{commodityId}) or -1 in ($P!{commodityId}))
		and (p.commodity_group_id  in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
		and (p.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
	group by
		t.lot_id,
		t.bin_id
	union all
	select
		t.inv_type||'-'||t.inv_no inv_type_no,
		to_char(t.inv_dt,$P{dateFormat}) inv_dt,
		t.created_dt det_created_dt,
		t.lot_id,
		t.bin_id,
		(p.lot_code) lot_code,
		(b.bin_name) bin_name,
		t.in_out_flag,
		t.in_out_flag * t.qty1 inv_qty1,
		t.in_out_flag * t.qty2 inv_qty2,
		2	sort_seq,
		vim.reference_no ref_no,
		slot.lot_code slot,
		dlot.lot_code dlot
	from
		tbl_lot_stock_trans t
		inner join tbl_lot p on t.lot_id = p.lot_id
		inner join tbl_bin b on t.bin_id = b.bin_id
		left join v_all_invoice_main vim on t.inv_type = vim.inv_type
			and t.inv_id = vim.inv_id
		left join tbl_mixing mix on t.inv_id = mix.mixing_id
			and t.inv_type = mix.mixing_type
			and mix.is_deleted = 0
		left join tbl_mixing_det mix_det on mix.mixing_id = mix_det.mixing_id
			and t.inv_id = mix_det.mixing_id
			and t.inv_det_id = mix_det.mixing_det_id
			and mix_det.is_deleted = 0
		left join tbl_lot slot on mix_det.source_lot_id = slot.lot_id
		left join tbl_lot dlot on mix_det.dest_lot_id = dlot.lot_id
	where
		t.is_deleted = 0
		and (t.inv_dt between to_date($P{fromDate}, $P{dateFormat}) and to_date($P{toDate}, $P{dateFormat}))
		and (p.commodity_id  in ($P!{commodityId}) or -1 in ($P!{commodityId}))
		and (p.commodity_group_id in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
		and (p.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
)tx
order by
	sort_seq,
	bin_name,
	lot_code,
	to_date(inv_dt, $P{dateFormat}),
	det_created_dt]]>
	</queryString>
