	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    t.inv_id,
    ROW_NUMBER() OVER (PARTITION BY t.inv_id ORDER BY det.inv_det_id ASC) AS sno,
    t.inv_dt,
    concat(t.inv_type,' - ',t.inv_no) inv_no,
    t.REFERENCE_no,
    t.remarks,
    t.period,
    factory.factory_name,
    concat(e.first_name,e.last_name) worker_name,
    d.department_name,
    fromd.department_name from_department,
    det.issue_qty1,
    det.issue_qty2,
    det.pure_qty1,
    det.pure_qty2,
    l.lot_code,
    rfactory.factory_name  rfactory,
    k.karatage_name

FROM
    tbl_mfg_refining_issue t
    INNER JOIN tbl_mfg_refining_issue_det det ON t.inv_id = det.inv_id AND det.is_deleted = 0
    LEFT JOIN tbl_factory factory ON factory.factory_id = t.factory_id
    left join tbl_factory rfactory on rfactory.factory_id = t.refining_factory_id
    Left join tbl_employee e on t.employee_id = e.employee_id
    left join tbl_department d on t.department_id = d.department_id
    LEFT JOIN tbl_department fromd on det.from_department_id = fromd.department_id
    left join tbl_lot l on det.lot_id = l.lot_id
    left join tbl_karatage k on det.karatage_id = k.karatage_id
WHERE
    t.is_deleted = 0
    AND t.inv_id = $P!{i_inv_id}
ORDER BY
    det.inv_det_id]]>
	</queryString>
