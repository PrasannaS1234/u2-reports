<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InvoiceHK" pageWidth="825" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="785" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c61a544a-3e23-400a-89f7-2b62d256624e">
	<property name="ireport.zoom" value="1.6500000000000026"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="number_color">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{total_metal_wt}.doubleValue() < 0]]></conditionExpression>
			<style forecolor="#FF0000">
				<pen lineColor="#000000"/>
			</style>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{total_metal_wt}.doubleValue() >= 0]]></conditionExpression>
			<style/>
		</conditionalStyle>
	</style>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\GITHUB\\tekfilo-connectx-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerName" class="java.lang.String">
		<defaultValueExpression><![CDATA["'Simon G'"]]></defaultValueExpression>
	</parameter>
	<parameter name="invGroup" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="invNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	main.inv_no,
	case when lower($P!{customerName}) like 'zeghani%' then 'Zeghani Jewelry Inc'
		when lower($P!{customerName}) like 'dgs%' then 'DGS Enterprise LLC' else 'Simon G Jewelry Inc'
	end customer_name,
	to_char(main.inv_dt,'yyyy-mm-dd')	inv_dt,
	to_char(main.due_dt,'yyyy-mm-dd')	due_dt,
	to_char(main.inv_dt,'yyyy-Mon-dd') price_dt,
	t1.summary_id,
	t1.inv_id,
	t1.jdb_job_sheet,
	t1.customer_jew_no job_no,
	s.sku_no	style_no,
	upper(REGEXP_REPLACE(p.product_type_name , '[^A-Za-z]', '', 'g')) jew_type,
	replace(replace(replace(replace(t1.metal_name,'FSG',''),'SG',''),'D',''),'-','')	metal_name,
	t1.metal_kt,
	t1.total_metal_wt total_metal_wt_old,
	 bag.bag_gross_wt total_metal_wt,
	round(tsumm.met_wt,2) + round((coalesce(tsumm.cs_wt,0)/5),2) + round((coalesce(tsumm.dia_wt,0)/5),2) +
	(case when replace(replace(((string_to_array(t1.cs_cz_desc,'~'))::varchar[])[2],'(',''),')','') like '%CZ%' then coalesce(tsumm.cs_wt,0) else 0 end)	total_metal_wt_desc,
	t1.stone_pcs,
	t1.r5_shape,
	t1.r6_shape,
	t1.r9_shape,
	case when lower($P!{customerName}) like 'zeghani' then t1.r5_shape else t1.r6_shape end shape1_cts,
	case when lower($P!{customerName}) like 'zeghani' then t1.r6_shape else t1.r9_shape end shape2_cts,
	t1.r5_shape + t1.r6_shape + t1.r9_shape tot_dia_cts,
	t1.dia_desc,
	case when replace(replace(((string_to_array(t1.cs_cz_desc,'~'))::varchar[])[2],'(',''),')','') = 'CZ' then null
		else replace(replace(((string_to_array(t1.cs_cz_desc,'~'))::varchar[])[2],'(',''),')','')  end cs_cz_desc,
	t1.parts_desc,
	t1.other_desc,
	t1.gold_loss_pct / 100 gold_loss_pct,
	t1.gold_amount_intl,
	t1.gold_loss_amount_intl,
	t1.gold_plus_loss_amount_intl,
	t1.parts_amount_intl,
	t1.labour_amount_intl,
	t1.dia_amount_intl,
	t1.qty,
	t1.dia_service_chgs_amount_intl,
	round((t1.total_amount_intl * 0.33)/5,0) * 5 total_amount_intl,


	case when main.uom = 'OZ' then '24K Gold Price (100%) US$' || round(main.gold_rate,2) || ' per ounce'
	else '' end metal_24k_desc_lin1,
	case when main.uom = 'OZ' then '18K Gold Price (75.10%) US$' || round((main.gold_rate / 31.1035) * 0.751,2) || ' per gram'
	else '' end metal_18k_desc_lin1,
	case when main.uom = 'OZ' then '22K Gold Price (91.70%) US$' || round((main.gold_rate / 31.1035) * 0.917,2) || ' per gram'
	else '' end metal_22k_desc_lin1,
	case when main.uom = 'OZ' then 'Pt950 Gold Price US$' || round(main.pt_rate,2) || ' per ounce'
	else '' end metal_pt_desc_lin1,

	case when main.uom = 'OZ' then '24K Gold Price (100%)    US$' || round(main.gold_rate / 31.1035,2)  || ' per gram'
	else '' end metal_24k_desc_lin2,
	case when main.uom = 'OZ' then '14K Gold Price (58.60%) US$' || round((main.gold_rate /31.1035) * 0.586,2) || ' per gram'
	else '' end metal_18k_desc_lin2,
	case when main.uom = 'OZ' then 'Pt950 Gold Price    US$' || round(main.pt_rate/31.1035,2) || ' per gram'
	else '' end metal_pt_desc_lin2,
	t1.inv_group inv_group,
	t1.inv_group group_code,
	case when replace(replace(((string_to_array(t1.cs_cz_desc,'~'))::varchar[])[2],'(',''),')','') like '%CZ%' then 1 else null end cz_pcs,
	case when replace(replace(((string_to_array(t1.cs_cz_desc,'~'))::varchar[])[2],'(',''),')','') like '%CZ%' then null when tsumm.cs_wt = 0 then null else tsumm.cs_wt end cs_wt,
	case when tsumm.dia_wt = 0 then null else tsumm.dia_wt end dia_wt,
	case when n_count > 0 and b_count = 0 then 'LINK TYPE of Necklace is OTHER'
		 when n_count = 0 and b_count > 0 then 'LINK TYPE of Bracelet is OTHER'
		 when n_count > 0 and b_count > 0 then 'LINK TYPE of Bracelet or Necklace is OTHER'
	end n_b_desc
FROM
	tbl_invoice_hk_summary t1
	inner join tbl_invoice_hk_main main on t1.inv_id = main.inv_id
	left join tbl_mfg_bag bag on t1.bag_id = bag.bag_id
	left join tbl_jewellery j on bag.job_id= j.jew_id
	left join tbl_sku s on j.sku_id = s.sku_id
	left join tbl_product_type p on s.product_type_id = p.product_type_id
	left join
	(
		select
			br.inv_id,
			br.bag_id,
			round(sum(case when metal_type = 'Z' then pcs else null end),2) cz_pcs,
			round(sum(case when metal_type not in ('D','M','Z') then wt else 0 end),2) cs_wt,
			round(sum(case when metal_type = 'D' then wt else 0 end),2) dia_wt,
			round(sum(case when metal_type = 'M' then wt else 0 end),2) met_wt,
			round(
						max(case when  metal_type = 'M' and (upper(br.commodity) like '%18K%') then 75
							when  metal_type = 'M' and (upper(br.commodity) like '%22K%') then 91.7
							when  metal_type = 'M' and (upper(br.commodity) like '%14K%') then 58.5
							when metal_type = 'M' and (upper(br.commodity) like '%PT950%')  then 90
							when metal_type = 'M' and (upper(br.commodity) like '%PT925%')  then 90
							when metal_type = 'M' and (upper(br.commodity) like '%PT%')  then 90
							else 0	end)
					,2) tot_met_amt,
			count(case when br.jew_type = 'NECKLACE' then 1 else 0 end ) n_count,
			count(case when br.jew_type = 'BRACELET' then 1 else 0 end ) b_count
		from tbl_invoice_hk_breakup br
		where
			inv_id = $P!{invId}
			and br.metal_type not in ('Labour')
			and is_deleted = 0
		group by
			br.inv_id,
			br.bag_id
	) tsumm on t1.inv_id = tsumm.inv_id and t1.bag_id = tsumm.bag_id
	where
	t1.is_deleted = 0
	and t1.inv_id = $P!{invId}
	order by upper(REGEXP_REPLACE(p.product_type_name , '[^A-Za-z]', '', 'g')),s.sku_no,t1.customer_jew_no]]>
	</queryString>
