	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Office Workings\\Report Development\\ireports\\Jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerName" class="java.lang.String">
		<defaultValueExpression><![CDATA["'Simon G'"]]></defaultValueExpression>
	</parameter>
	<parameter name="invGroup" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="invNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    q.*
FROM
(
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY
                t1.inv_id,
                upper(REGEXP_REPLACE(p.product_type_name , '[^A-Za-z]', '', 'g')),
                t1.customer_jew_no
        ) AS sr_no,
        main.inv_no,
        CASE
            WHEN lower ($P!{customerName}) LIKE 'zeghani%' THEN 'Zeghani Jewelry Inc'
            WHEN lower($P!{customerName}) LIKE 'dgs%' THEN 'DGS Enterprise LLC'
            ELSE 'Simon G Jewelry Inc'
        END customer_name,
        to_char(main.inv_dt,'yyyy-mm-dd') inv_dt,
        to_char(main.due_dt,'yyyy-mm-dd') due_dt,
        to_char(main.inv_dt,'yyyy-Mon-dd') price_dt,
        t1.summary_id,
        t1.inv_id,
        t1.bag_type_no bag_no,
        s.sku_no,
        upper(REGEXP_REPLACE(p.product_type_name , '[^A-Za-z]', '', 'g')) product_type,
        s.product_size,
        t1.customer_jew_no customer_job_no,

        CASE
            WHEN lower(t1.metal_kt) = '18k' THEN '18KY'
            WHEN lower(t1.metal_kt) = '14k' THEN '14KY'
            WHEN lower(t1.metal_kt) = '22k' THEN '22KY'
            WHEN lower(t1.metal_kt) = '24k' THEN '24KY'
            WHEN t1.metal_kt = '950' THEN 'PT950'
            ELSE t1.metal_kt
        END metal_kt_display,

        replace(replace(replace(replace(t1.metal_name,'FSG',''),'SG',''),'D',''),'-','') metal_lot,
        t1.metal_kt,
        t1.total_metal_wt net_wt,
        t1.total_metal_wt_desc,

        c.r7_11,
        c.r7plus11,
        c.r9_11,
        c.r9plus11,
        c.pc,
        c.others,
        c.balance_qty2,
        case when main.uom = 'OZ' then '24K Gold Price (100%) US$' || round(main.gold_rate,2) || ' per ounce'
		else '' end metal_24k_desc_lin1,
		case when main.uom = 'OZ' then '18K Gold Price (75.10%) US$' || round((main.gold_rate / 31.1035) * 0.751,2) || ' per gram'
		else '' end metal_18k_desc_lin1,
		case when main.uom = 'OZ' then 'Pt950 Gold Price US$' || round(main.pt_rate,2) || ' per ounce'
		else '' end metal_pt_desc_lin1,

		case when main.uom = 'OZ' then '24K Gold Price (100%)    US$' || round(main.gold_rate / 31.1035,2)  || ' per gram'
		else '' end metal_24k_desc_lin2,
		case when main.uom = 'OZ' then '14K Gold Price (58.60%) US$' || round((main.gold_rate /31.1035) * 0.586,2) || ' per gram'
		else '' end metal_18k_desc_lin2,
		case when main.uom = 'OZ' then 'Pt950 Gold Price    US$' || round(main.pt_rate / 31.1035,2) || ' per gram'
		else '' end metal_pt_desc_lin2,
        CASE
            WHEN t1.metal_kt = '24K' THEN 133.28
            WHEN t1.metal_kt = '18K' THEN 100.09
            WHEN t1.metal_kt = '14K' THEN 78.10
            WHEN t1.metal_kt = 'PT950' THEN 54.24
            ELSE 0
        END metal_rate_usd,

        ROUND(t1.gold_loss_pct , 0) || '%' AS gold_loss_pct,

        ROUND( t1.gold_amount_intl ,0) gold_amount_intl,

        t1.gold_loss_amount_intl,
        t1.gold_plus_loss_amount_intl,
        round(t1.gold_amount_intl * 0.1,0) gold_service_chgs_amount_intl,
        t1.parts_amount_intl,
        t1.labour_amount_intl,

        ROUND(
              COALESCE(c.r7_11,0)     * 605
            + COALESCE(c.r7plus11,0) * 715
            + COALESCE(c.r9_11,0)    * 700
            + COALESCE(c.r9plus11,0) * 790
            + COALESCE(c.pc,0)       * 625
        ) dia_amount_intl,

        bag.bag_qty,

        (
            ROUND( t1.gold_amount_intl ,0)
            + COALESCE(t1.parts_amount_intl,0)
            + COALESCE(t1.labour_amount_intl,0)
            + ROUND(
                  COALESCE(c.r7_11,0)      * 605
                + COALESCE(c.r7plus11,0)  * 715
                + COALESCE(c.r9_11,0)     * 700
                + COALESCE(c.r9plus11,0) * 790
                + COALESCE(c.pc,0)        * 625
              ,0)
        ) unit_price_usd,
         t1.total_amount_intl,
        t1.inv_group inv_group,
        t1.inv_group group_code,
        carr.carrier_name,
        main.tracking_no,
        cua.address1,
        cua.address2,
        concat(cua.city,', ',cua.state,', ',cua.country,' - ',cua.pin_code) address3

    FROM tbl_invoice_hk_summary t1
    INNER JOIN tbl_invoice_hk_main main
        ON t1.inv_id = main.inv_id AND main.is_deleted = 0
    LEFT JOIN tbl_mfg_bag bag
        ON t1.bag_id = bag.bag_id AND bag.is_deleted = 0
    LEFT JOIN (
        SELECT
            bc.bag_id,
            sum(case when com.metal_type='DIAMOND' and lot.group_type='R7-11' then bc.balance_qty1 else 0 end) r7_11,
            sum(case when com.metal_type='DIAMOND' and lot.group_type='R7+11' then bc.balance_qty1 else 0 end) r7plus11,
            sum(case when com.metal_type='DIAMOND' and lot.group_type='R9-11' then bc.balance_qty1 else 0 end) r9_11,
            sum(case when com.metal_type='DIAMOND' and lot.group_type='R9+11' then bc.balance_qty1 else 0 end) r9plus11,
            sum(case when com.metal_type='DIAMOND' and lot.group_type='PC' then bc.balance_qty1 else 0 end) pc,
            SUM(
                CASE
                    WHEN com.metal_type='DIAMOND'
                     AND (lot.group_type IS NULL
                          OR lot.group_type NOT IN ('R7-11','R7+11','R9-11','R9+11','PC'))
                    THEN bc.balance_qty1 ELSE 0
                END
            ) others,
            sum(bc.balance_qty2) balance_qty2
        FROM tbl_mfg_bag_component bc
        LEFT JOIN tbl_lot lot ON bc.lot_id = lot.lot_id AND lot.is_deleted = 0
        LEFT JOIN tbl_commodity com ON lot.commodity_id = com.commodity_id AND com.is_deleted = 0
        WHERE bc.is_deleted = 0
        GROUP BY bc.bag_id
    ) c ON c.bag_id = t1.bag_id
    LEFT JOIN tbl_jewellery j ON bag.job_id = j.jew_id AND j.is_deleted = 0
    LEFT JOIN tbl_sku s ON j.sku_id = s.sku_id AND s.is_deleted = 0
    LEFT JOIN tbl_product_type p ON s.product_type_id = p.product_type_id AND p.is_deleted = 0
    LEFT JOIN tbl_carrier carr ON main.carrier_id = carr.carrier_id AND carr.is_deleted = 0
    LEFT JOIN tbl_customer_address cua ON main.shipping_id = cua.address_id
    WHERE t1.is_deleted = 0
      AND t1.inv_id = ($P!{invId})
) q
ORDER BY q.inv_id, q.product_type, q.customer_job_no;]]>
	</queryString>
