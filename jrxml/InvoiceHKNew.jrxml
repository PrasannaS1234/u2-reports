<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InvoiceHKNew" pageWidth="1545" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1515" leftMargin="10" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c61a544a-3e23-400a-89f7-2b62d256624e">
	<property name="ireport.zoom" value="0.9090909090909133"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="99"/>
	<style name="number_color">
		<conditionalStyle>
			<conditionExpression><![CDATA[]]></conditionExpression>
