<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TrialBalance" pageWidth="900" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="860" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    FINAL_RESULT.ACC_ID ,
    MAX(COMPANY_ID) AS COMPANY_ID,
    MAX(FINAL_RESULT.ACC_DESC)  ACC_DESC,
    MAX(COALESCE(FINAL_RESULT.account_name,' ')) 		ACC_name,
    MAX(COALESCE(FINAL_RESULT.ACC_CODE,' '))  	ACC_CODE,
	MAX(FINAL_RESULT.SCHEDULE_ID) SCHEDULE_ID,
	MAX(COALESCE(FINAL_RESULT.SCHEDULE_NAME,' '))  SCHEDULE_NAME,
	MAX(FINAL_RESULT.GROUP_ID)  GROUP_ID,
	MAX(COALESCE(FINAL_RESULT.GROUP_NAME,' '))  GROUP_NAME,
	MAX(FINAL_RESULT.SUBGROUP_ID)		SUBGROUP_ID,
	MAX(COALESCE(FINAL_RESULT.SUBGROUP_NAME,' ')) 	SUBGROUP_NAME,
	case when SUM(FINAL_RESULT.AMOUNT) >= 0 THEN  abs(SUM(FINAL_RESULT.AMOUNT)) ELSE 0 END  DR_AMOUNT,
	case when SUM(FINAL_RESULT.AMOUNT) < 0 THEN  abs(SUM(FINAL_RESULT.AMOUNT)) ELSE 0 END  CR_AMOUNT
FROM
    (

    SELECT
        TMP_TRIAL_BALANCE.ACC_ID,
        MAX(TMP_TRIAL_BALANCE.COMPANY_ID) AS COMPANY_ID,
    	MAX(ACC.ACCOUNT_NAME) account_name,
    	MAX(ACC.ACCOUNT_CODE) ACC_CODE,
		MAX(ACC.ACCOUNT_NAME) || ' [' ||  MAX(ACC.ACCOUNT_CODE)  ||']' ACC_desc,


		MAX(ST.SCHEDULE_ID) SCHEDULE_ID,
	    MAX(ST.SCHEDULE_NAME) SCHEDULE_NAME,

		MAX(GRP.GROUP_ID)  GROUP_ID,
    	MAX(GRP.GROUP_NAME) GROUP_NAME,

		MAX(SG.SUBGROUP_ID)		SUBGROUP_ID,
    	MAX(SG.SUBGROUP_NAME) 	SUBGROUP_NAME,

    	MAX(ST.SORT_SEQ)  SC_ORDER,
    	MAX(GRP.SORT_SEQ)   GRP_ORDER,
    	MAX(SG.SORT_SEQ)    SG_ORDER,
    	SUM(TMP_TRIAL_BALANCE.AMOUNT) AMOUNT

FROM
(

    SELECT
        PD.ACCOUNT_ID ACC_ID,
 SUM((case when pm.currency = $P!{currency} then pd.amount
			  when pm.currency = 'USD' and $P!{currency} <> 'USD'
			 	then round(pd.amount * COALESCE(fn_get_exchange_rate(pm.company_id,to_char(pm.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',pm.currency),pm.exchange_rate),2)
			  when pm.currency <> 'USD' and $P!{currency} = 'USD'
			 	then round(pd.amount / nullif(COALESCE(fn_get_exchange_rate(pm.company_id,to_char(pm.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',pm.currency),pm.exchange_rate),0),2)
			 else 0 end ) * PD.IN_OUT_FLAG) AMOUNT,
	    MAX(PM.COMPANY_ID) as COMPANY_ID
    FROM
        TBL_ACCOUNT_POSTING_MAIN PM
        INNER JOIN TBL_ACCOUNT_POSTING_DET PD  ON PM.POSTING_ID = PD.POSTING_ID
			AND PD.IS_DELETED = 0
        INNER JOIN TBL_ACCOUNT AC ON PD.ACCOUNT_ID = AC.ACCOUNT_ID
    WHERE
		1 = 1
        and pm.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    GROUP BY
        PD.ACCOUNT_ID

) TMP_TRIAL_BALANCE

    INNER JOIN TBL_ACCOUNT ACC ON TMP_TRIAL_BALANCE.ACC_ID = ACC.ACCOUNT_ID
    INNER JOIN TBL_SUB_GROUP SG ON ACC.SUBGROUP_ID = SG.SUBGROUP_ID
	INNER JOIN TBL_GROUP GRP ON SG.GROUP_ID = GRP.GROUP_ID
	INNER JOIN TBL_SCHEDULE ST ON GRP.SCHEDULE_ID = ST.SCHEDULE_ID
GROUP BY
    TMP_TRIAL_BALANCE.ACC_ID

) FINAL_RESULT
WHERE
    (ABS(FINAL_RESULT.AMOUNT) > 0.1)
    AND  COMPANY_ID = $P{companyId}
GROUP BY
   SCHEDULE_ID,
   GROUP_ID,
   SUBGROUP_ID,
   FINAL_RESULT.ACC_ID
ORDER BY
    MAX(SC_ORDER),
    MAX(GRP_ORDER),
    MAX(SG_ORDER),
    MAX(FINAL_RESULT.ACC_ID)]]>
	</queryString>
