<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="VoucherSingleCur" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="570" leftMargin="20" rightMargin="5" topMargin="20" bottomMargin="20" uuid="a2ddf2c9-fb24-4dd5-8562-d3c2b0789871">
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="reportCode" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["EE-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_type" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="vouStatus" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["LOC"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
  vc.posting_id VOUCHER_ID,
  comp.company_name COMPANY_NAME,
  null  COUNTRY_COMPCODE,
  vc.inv_type || '-' || vc.inv_no VOU_NO ,
  vc.currency CUR_CODE,
  vc.exchange_rate EXCHANGE_RATE,
  'USD' INTL_CUR_CODE,
  comp.default_currency  LOC_CUR_CODE,
  null  THIRD_CUR_CODE,
  null  THIRD_CUR_EXCHANGE_RATE,
  vc.reference_no OFF_REF_NO,
  concat(emp.first_name,' ',emp.last_name) ||' ('|| emp.user_id ||')' vou_entered_by,
  to_char(vc.inv_dt,$P{dateFormat}) VOU_DT,
  to_char(vc.inv_due_dt,$P{dateFormat}) VOU_DUE_DT,
  to_char(vc.created_dt,$P{dateFormat}) VOU_ENTRY_DT,
  'POSTED' VOUCHER_STATUS,
  null LOC_CODE,
  acc.account_name ACC_NAME,
  null  CSC_CODE,
  vc.note1  NARRATION,
  cc2.cost_category_name COST_CATEGORY ,
  cc1.cost_center_name COST_CENTER  ,
  case
    when vcdet.dr_cr = 'D' then vcdet.amount
        else null
  end DEBIT_AMT_INTL_CUR,
  case
    when vcdet.dr_cr = 'D' then vcdet.amount
        else null
  end DEBIT_AMT_LOC_CUR,
  case
    when vcdet.dr_cr = 'D' then vcdet.amount
        else null
  end DEBIT_AMT_TC,
  case
    when vcdet.dr_cr = 'C' then vcdet.amount
        else null
  end CREDIT_AMT_INTL_CUR,
  case
    when vcdet.dr_cr = 'C' then vcdet.amount
        else null
  end CREDIT_AMT_LOC_CUR,
  case
    when vcdet.dr_cr = 'C' then vcdet.amount
        else null
  end CREDIT_AMT_TC ,
   case when vc.currency = 'INR' then
  	initcap(fn_amount_to_words(
abs(
  sum((case when vcdet.in_out_flag = -1 then 0 else 1 end) * vcdet.amount) over (partition by vc.posting_id)
  ),
  vc.currency,
  'Rupees',
  'Paise'
	))
	else

  initcap(spellnumericvalue(abs(
  sum((case when vcdet.in_out_flag = -1 then 0 else 1 end) * vcdet.amount) over (partition by vc.posting_id)
  ),vc.currency)) end  AMOUNTINWORDS
from
  tbl_account_posting_main vc
  inner join tbl_account_posting_det vcdet on vc.posting_id = vcdet.posting_id
    and vcdet.is_deleted = 0
  inner join tbl_account acc on vcdet.account_id = acc.account_id
  inner join tbl_company comp on vc.company_id = comp.company_id
  left join tbl_user emp on vc.created_by = emp.user_id
  left join tbl_cost_center cc1 on vcdet.cost_center_id = cc1.cost_center_id
  left join tbl_cost_category cc2 on vcdet.cost_category_id = cc2.cost_category_id
where
  vc.is_deleted = 0
  and ((vc.inv_type in ($P!{i_inv_type})))
  and (vc.inv_id in ($P!{i_inv_id}) OR -1 in ($P!{i_inv_id}))
order by vc.posting_id,vcdet.in_out_flag desc,amount desc]]>
	</queryString>
