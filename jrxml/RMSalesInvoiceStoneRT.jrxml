				<staticText>
					<reportElement key="staticText-102" mode="Opaque" x="186" y="165" width="50" height="16" forecolor="#000000" backcolor="#CCCCCC" uuid="d0d5a99e-aaa8-493e-9339-1d6d97405729"/>
					<box topPadding="2" leftPadding="2" bottomPadding="2" rightPadding="2">
