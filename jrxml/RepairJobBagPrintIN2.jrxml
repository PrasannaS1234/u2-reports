<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobCardPrint" pageWidth="430" pageHeight="300" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="428" leftMargin="1" rightMargin="1" topMargin="1" bottomMargin="1" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="component_dia" uuid="e8061e66-2d2b-40af-9c95-d4ac0b602427">
		<parameter name="bagId" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.component_id,
		 tsc.repair_order_det_id sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.jew_id,
		 (bag.bag_qty * tsc.tot_qty) tot_qty,
		 (bag.bag_qty * tsc.qty1) qty1,
		 (bag.bag_qty * tsc.qty2) qty2,
		 round((case when tsc.qty2 > 0 then tsc.tot_qty / tsc.qty2 else 0 end),3) per_pc_wt
	FROM
		 tbl_repair_order_component tsc
		 inner join tbl_repair_order_det tsd on tsc.repair_order_det_id = tsd.repair_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_jewellery j on tsd.repair_order_det_id = j.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_mfg_bag bag on j.jew_id = bag.job_id
		inner join tbl_commodity com on tsc.commodity_id = com.commodity_id
		inner join tbl_commodity_group cgr on com.commodity_group_id = cgr.commodity_group_id
	WHERE
		 tsc.is_deleted = 0
		 and (cgr.commodity_group_type like '%DIAMOND%')
		 and bag.bag_id = $P!{bagId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pc_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,1) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
		<group name="component_id">
			<groupExpression><![CDATA[$F{component_id}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="comp_cs" uuid="ac55cc8d-a11d-48d8-ad8c-e76ab1d33efa">
		<parameter name="bagId" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.component_id,
		 tsc.repair_order_det_id sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.jew_id,
		 (bag.bag_qty * tsc.tot_qty) tot_qty,
		 (bag.bag_qty * tsc.qty1) qty1,
		 (bag.bag_qty * tsc.qty2) qty2,
		 round((case when tsc.qty2 > 0 then tsc.tot_qty / tsc.qty2 else 0 end),3) per_pc_wt
	FROM
		 tbl_repair_order_component tsc
		 inner join tbl_repair_order_det tsd on tsc.repair_order_det_id = tsd.repair_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_jewellery j on tsd.repair_order_det_id = j.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_mfg_bag bag on j.jew_id = bag.job_id
		inner join tbl_commodity com on tsc.commodity_id = com.commodity_id
		inner join tbl_commodity_group cgr on com.commodity_group_id = cgr.commodity_group_id
	WHERE
		 tsc.is_deleted = 0
		 and (cgr.commodity_group_type not like '%DIAMOND%')
		 and bag.bag_id = $P!{bagId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pc_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,1) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="i_bag_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	bag.bag_id,
	bag.bag_qty,
	concat(bag.bag_type, bag.bag_no) bag_type_no,
	s.sku_no,
	SO.ORDER_TYPE,
	p.product_type_name,
	so.reference_no,
	sd.customer_sku_no customer_ref_no,
	sd.customer_jew_no customer_bag_no,
	sd.customer_order_no customer_order_no,
    concat(so.repair_order_type,'-',so.repair_order_no) so_no,
	c.display_name customer_name,
	sd.customer_order_no,
	to_char(so.delivery_date, 'dd-Mon-yyyy') delivery_date,
	to_char(so.repair_order_date, 'dd-Mon-yyyy') sales_order_date,
	ps.product_size,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url,
	t.metal_weight,
	rc.gross_wt,
	sd.prod_remarks
from
	tbl_jewellery t
	inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
		and bag.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
	inner join tbl_repair_order_main so on t.sales_order_id = so.repair_order_id
	inner join tbl_repair_order_det sd on so.repair_order_id = sd.repair_order_id
		and t.sales_order_det_id = sd.repair_order_det_id
		and sd.is_deleted = 0
	left join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	left join (
		select
			id.bag_id,
			round(sum(case when ic.uom1 = 'GM' then ic.qty1 when ic.uom2 = 'GM' then ic.qty2 * 0.2 else 0 end),3) gross_wt
		from
			tbl_mfg_bag_rm_issue_receive i
			inner join tbl_mfg_bag_rm_issue_receive_det id on i.inv_id = id.inv_id
				and id.is_deleted = 0
			inner join tbl_mfg_bag_rm_issue_receive_component ic on id.inv_det_id = ic.inv_det_id
				and ic.is_deleted = 0
		where i.inv_type = 'RBRMI'
			and (id.bag_id in ($P!{i_bag_id}))
		group by id.bag_id
	)rc on bag.bag_id = rc.bag_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
 (bag.bag_id ) in ($P!{i_bag_id})
 AND t.job_category = 'Repair']]>
	</queryString>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="job_type_no" class="java.lang.String"/>
	<field name="bag_id" class="java.lang.Integer"/>
	<field name="bag_qty" class="java.math.BigDecimal"/>
	<field name="bag_type_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="order_type" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="customer_ref_no" class="java.lang.String"/>
	<field name="customer_bag_no" class="java.lang.String"/>
	<field name="customer_order_no" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="delivery_date" class="java.lang.String"/>
	<field name="sales_order_date" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="metal_weight" class="java.math.BigDecimal"/>
	<field name="gross_wt" class="java.math.BigDecimal"/>
	<field name="prod_remarks" class="java.lang.String"/>
