<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKK" pageWidth="1050" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="1040" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="0.9313819845887326"/>
	<property name="ireport.x" value="183"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select

          t.inv_id,
	company.company_name,
	concat(t.inv_type,t.inv_no) inv_no,
	f.factory_name,
	dep.department_name,
          t.remarks,
          concat(bag.bag_type,bag.bag_no) bag_no,
          concat(job.jew_type,job.jew_no) job_no,
          lot.lot_code,
          det.bag_qty,
          case when comp.stone_size = 'NA' then '' else comp.stone_size end as stone_size,
          sku.sku_no,
          comp.exchange_qty1,
          comp.exchange_qty2,
         comp.broken_qty1,
         comp.broken_qty2,
          comp.loss_qty1,
          comp.loss_qty2,
         comp.return_qty1,
         comp.return_qty2,
         concat(emp.first_name,' ',emp.last_name ) employee,
         t.created_dt

from
    tbl_mfg_bag_stone_exchange t
    inner join tbl_mfg_bag_stone_exchange_det det on det.inv_id = t.inv_id
    left join tbl_mfg_bag_stone_exchange_component comp on  comp.inv_det_id = det.inv_det_id
    inner join tbl_company company on t.company_id = company.company_id
    inner join tbl_factory f on t.factory_id = f.factory_id
    inner join tbl_department dep on t.department_id = dep.department_id
    left join tbl_mfg_bag bag on det.bag_id = bag.bag_id
    left join tbl_sku sku on bag.sku_id = sku.sku_id
    left join tbl_jewellery job on bag.job_id = job.jew_id
    left join tbl_lot lot on comp.lot_id = lot.lot_id
    left join tbl_employee emp on comp.employee_id = emp.employee_id

where
    t.is_deleted = 0
    AND t.inv_id = $P!{i_inv_id}
order by
     det.inv_det_id]]>
	</queryString>
