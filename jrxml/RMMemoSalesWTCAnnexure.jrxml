	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="company_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tcomp.company_name,
          tcomp.cin_no,
          concat(nullif(tcomp.area,''), nullif(tcomp.street,''),',', nullif(tcomp.city,''),'-',nullif(tcomp.pin_code,''),',',nullif(state.state_name,''),',', nullif(c.country_name,'')) add,
          concat('Email : ',tcomp.email,' ') email,
          concat('Ph : ',tcomp.phone_number,' ') phone_number
from tbl_company tcomp
        left join tbl_country c on tcomp.country_id = c.country_id
        left join tbl_state state on tcomp.state = state.state_code
where
	tcomp.company_id =  ($P!{company_id})]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="cin_no" class="java.lang.String"/>
	<field name="add" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="phone_number" class="java.lang.String"/>
