<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CastingMouldIssue" pageWidth="670" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
           tcomp.company_name company_name,
	 im.inv_id,
	 im.inv_type||'-'||im.inv_no invoiceNo,
            to_char(im.inv_dt, $P{dateFormat}) inv_dt,
	 im.currency,
	 im.remarks,
	 im.party_type,
	 im.party_id,
	 par.customer_name,
	 dp.department_name,
	 fr.factory_name,
	 lot.lot_code,
	 id.issue_against,
	 lot.lot_code,
	 bin.bin_name,
	 id.qty1,
	 id.qty2,
	 id.amount,
	 id.pure_qty1,
	 id.pure_qty2
from tbl_mfg_casting_mould_issue im
inner join tbl_mfg_casting_mould_issue_det id on im.inv_id = id.inv_id
	and id.is_deleted = 0
inner join v_party_details par on im.party_id = par.party_id
    and lower(im.party_type) = lower(par.party_type)
inner join tbl_factory fr on im.factory_id = fr.factory_id
inner join tbl_department dp on im.department_id = dp.department_id
inner join tbl_company tcomp on im.company_id = tcomp.company_id
inner join tbl_lot lot on id.lot_id = lot.lot_id
inner join tbl_bin bin on id.bin_id = bin.bin_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})]]>
	</queryString>
