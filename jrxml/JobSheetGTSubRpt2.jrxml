<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKKSubRpt" pageWidth="571" pageHeight="842" columnWidth="571" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="sales_order_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    sc.sales_order_det_id,
    STRING_AGG(sc.note, ', ' ORDER BY sc.note) AS note
FROM tbl_sales_order_prod_note sc
WHERE sc.is_deleted = 0
  AND sc.sales_order_det_id IN ($P!{sales_order_det_id})
GROUP BY sc.sales_order_det_id]]>
	</queryString>
	<field name="sales_order_det_id" class="java.lang.Integer"/>
	<field name="note" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="12" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="571" height="12" uuid="776c1ac7-ae4a-4a00-b9f6-6f2c5290e7f0"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial Unicode MS" size="8" pdfFontName="STSong-Light" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{note}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
