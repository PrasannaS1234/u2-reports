	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="designNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="displayCurrency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    res.*
from
(
Select
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    emp.first_name||'-'||emp.last_name salesman_name,
    tcus.customer_name,
    concat(prod.jew_type,prod.jew_no) product_no,
    pt.product_type_name,
    mk.market_name,
    col.collection_name,
    prod.design_no,
    prod.sku_no,
    tcomp.company_name,
    id.prod_description,
    id.inv_qty,
    id.uom,
    id.input_rate,
    id.input_amt,
    (fn_get_exchange_rate_amount(im.company_id,to_char(im.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',im.currency,$P!{displayCurrency},id.input_rate)) disp_input_rate,
    (fn_get_exchange_rate_amount(im.company_id,to_char(im.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',im.currency,$P!{displayCurrency},id.input_amt)) disp_input_amt,
    id.discount_type,
    id.discount_value,
    id.cost_price,
    im.inv_type,
    im.inv_id,
    id.inv_det_id
from
    tbl_jew_sales_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_customer tcus on im.customer_id = tcus.customer_id
    and (lower(tcus.customer_name) like concat(trim(lower($P!{customerLike})),'%%'))
    inner join tbl_jewellery prod on id.jew_id = prod.jew_id
    and (prod.design_no  in ($P!{designNo}) or ' ' in ($P!{designNo}))
    and (prod.sku_no  in ($P!{skuNo}) or ' ' in ($P!{skuNo}))
    and (concat(prod.jew_type,prod.jew_no) in ($P!{jewTypeNo}) or ' ' in ($P!{jewTypeNo}))
    and (prod.collection_id  in ($P!{collectionId}) or -1 in ($P!{collectionId}))
    and (prod.product_type_id  in ($P!{productTypeId}) or -1 in ($P!{productTypeId}))
    and (prod.market_id  in ($P!{marketId}) or -1 in ($P!{marketId}))
    left join tbl_employee emp on im.salesman_id = emp.employee_id
left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
left join tbl_market mk on prod.market_id = mk.market_id
left join tbl_collection col on prod.collection_id = col.collection_id
where
    im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
union all
Select
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    emp.first_name||'-'||emp.last_name salesman_name,
    tcus.customer_name,
    concat(prod.jew_type,prod.jew_no) product_no,
    pt.product_type_name,
    mk.market_name,
    col.collection_name,
    prod.design_no,
    prod.sku_no,
    tcomp.company_name,
    id.prod_description,
    -id.inv_qty inv_qty,
    id.uom,
    -1 * id.input_rate,
    -1 * id.input_amt,
    -1 * (fn_get_exchange_rate_amount(im.company_id,to_char(im.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',im.currency,$P!{displayCurrency},id.input_rate)) disp_input_rate,
    -1 * (fn_get_exchange_rate_amount(im.company_id,to_char(im.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',im.currency,$P!{displayCurrency},id.input_amt)) disp_input_amt,
    id.discount_type,
    id.discount_value,
    -id.cost_price cost_price,
    im.inv_type,
    im.inv_id,
    id.inv_det_id
from
    tbl_jew_sales_return_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_jew_sales_return_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_customer tcus on im.customer_id = tcus.customer_id
    and (lower(tcus.customer_name) like concat(trim(lower($P!{customerLike})),'%%'))
    inner join tbl_jewellery prod on id.jew_id = prod.jew_id
    and (prod.design_no  in ($P!{designNo}) or ' ' in ($P!{designNo}))
    and (prod.sku_no  in ($P!{skuNo}) or ' ' in ($P!{skuNo}))
    and (concat(prod.jew_type,prod.jew_no) in ($P!{jewTypeNo}) or ' ' in ($P!{jewTypeNo}))
    and (prod.collection_id  in ($P!{collectionId}) or -1 in ($P!{collectionId}))
    and (prod.product_type_id  in ($P!{productTypeId}) or -1 in ($P!{productTypeId}))
    and (prod.market_id  in ($P!{marketId}) or -1 in ($P!{marketId}))
    left join tbl_employee emp on im.salesman_id = emp.employee_id
left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
left join tbl_market mk on prod.market_id = mk.market_id
left join tbl_collection col on prod.collection_id = col.collection_id
where
    im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
) res order by  res.currency,res.inv_dt,res.inv_type,res.inv_id,res.inv_det_id]]>
	</queryString>
