	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<parameter name="pcs" class="java.math.BigDecimal"/>
		<parameter name="cts" class="java.math.BigDecimal"/>
		<parameter name="amt" class="java.math.BigDecimal"/>
		<parameter name="carrier" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{carrier}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITH dm AS (
    SELECT
        generate_series(1, 1000) AS srno
),
dt AS (
    SELECT
        row_number() OVER (ORDER BY im.inv_id) AS srno,
        hsn.hsn_code AS hsn_code,
        state.state_code AS state_code,
        c.carrier_type AS carrier_type,
        id.input_rate AS total_rate,
        id.input_amt AS total_amount,
        id.lot_description AS lot_desc,
        id.inv_qty1 AS total_qty1,
        id.inv_qty2 AS total_qty2
    FROM
        tbl_memo_sales_return_invoice_main im
        INNER JOIN tbl_memo_sales_return_invoice_det id ON im.inv_id = id.inv_id
        INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
        LEFT JOIN tbl_carrier c ON im.carrier_id = c.carrier_id
        LEFT JOIN tbl_hsn_code hsn ON im.hsn_code_id = hsn.hsn_code_id
        LEFT JOIN tbl_state state ON tcomp.state = state.state_code
    WHERE
        im.is_deleted = 0
        and id.is_deleted = 0
        AND im.inv_id in ($P!{invId})
)
SELECT
    ROW_NUMBER() OVER (ORDER BY COALESCE(dt.hsn_code, '') ) AS srno,
    dt.hsn_code,
    dt.state_code,
    dt.carrier_type,
    SUM(dt.total_rate) AS total_rate,
    SUM(dt.total_amount) AS total_amount,
    SUM(dt.total_qty1) AS total_qty1,
    SUM(dt.total_qty2) AS total_qty2
FROM
    dt
GROUP BY
    dt.hsn_code,
    dt.state_code,
    dt.carrier_type;]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="hsn_code" class="java.lang.String"/>
		<field name="state_code" class="java.lang.String"/>
		<field name="carrier_type" class="java.lang.String"/>
		<field name="total_rate" class="java.math.BigDecimal"/>
		<field name="total_amount" class="java.math.BigDecimal"/>
		<field name="total_qty1" class="java.math.BigDecimal"/>
		<field name="total_qty2" class="java.math.BigDecimal"/>
		<variable name="pcs" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{total_qty2}]]></variableExpression>
		</variable>
		<variable name="cts" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{total_qty1}]]></variableExpression>
		</variable>
		<variable name="total_amount" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="table_charges" uuid="fefc3636-7416-43ec-a53c-50f24d04e7c8">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
  sal_chg.charge_name,
  ROUND(sal_chg.input_amt * sal_chg.plus_minus_flag, 2) AS amt,
  0 sort_seq
FROM
  tbl_memo_sales_return_invoice_chgs sal_chg
  INNER JOIN tbl_memo_sales_invoice_main im ON sal_chg.inv_id = im.inv_id
WHERE
  sal_chg.is_deleted = 0
  AND sal_chg.inv_id IN ($P!{invId})
  and sal_chg.input_amt > 0
Union all
SELECT
  'Total Invoice Amount' charge_name,
  ROUND(im1.total_invoice_net_amount, 2) AS amt,
  1 sort_seq
FROM
  tbl_memo_sales_return_invoice_main im1
WHERE
  im1.is_deleted = 0
  AND im1.inv_id IN ($P!{invId})
ORDER BY
  sort_seq;]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
		<field name="sort_seq" class="java.lang.Integer"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="invType" class="java.lang.String">
		<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["E:\\jew-trade-service\\src\\main\\resources\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="bank_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	max(tcomp.company_name) company_name,
          fn_get_customer_invoice_no(max(im.inv_type),max(im.inv_id)) cus_doc_type,
	max(im.inv_id) inv_id,
	max(im.inv_type) inv_type,
	max(im.note) note,
          max(im.remarks) remarks,
          max(state.state_code) state_code,
	max(im.inv_type||'-'||im.inv_no) inv_type_no,
	to_char(max(im.inv_dt), 'dd/mm/yyyy') inv_dt,
	to_char(max(im.inv_due_dt), 'dd/mm/yyyy')     inv_due_dt,
	max(im.currency) currency,
           concat(concat('Ref.Cons No : ',fn_get_customer_invoice_no(max(memo.inv_type),max(memo.inv_id))),' / Dt: ',
          to_char(max(memo.inv_dt), 'DD/MM/YYYY'),' / Total Qty : ',
          ROUND(max(memo.total_invoice_qty1),3), ' / Total Value : ',
          case when max(memo.currency) = 'INR' then
            ROUND(max(memo.total_invoice_amount)*max(memo.exchange_rate),2)
            else ROUND(max(memo.total_invoice_amount),2) end) memo_detail,
	max(im.exchange_rate) exchange_rate,
	max(COALESCE(im.reference_no,'')) reference_no,
	max(tcus.customer_name) customer_name,
          max(tcus.email) cus_email,
	COALESCE(max(im.bill_address1),'') bill_addr1,
	COALESCE(max(im.bill_address2),'') bill_addr2,
	COALESCE(max(im.bill_country),'') bill_country,
	COALESCE(max(im.bill_state),'') bill_state,
	COALESCE(max(im.bill_city),'') bill_city,
	COALESCE(max(im.bill_street),'') bill_street,
	COALESCE(max(im.bill_pincode),'') bill_pincode,
	COALESCE(max(im.bill_website),'') bill_website,
	COALESCE(max(im.bill_phone_no),'') bill_phone_no,
	COALESCE(max(im.bill_fax_no),'') bill_fax_no,
	COALESCE(max(im.bill_mobile_no),'') bill_mobile_no,
	COALESCE(max(im.ship_address1),'') ship_addr1,
	COALESCE(max(im.ship_address2),'') ship_addr2,
	COALESCE(max(im.ship_country),'') ship_country,
	COALESCE(max(im.ship_state),'') ship_state,
	COALESCE(max(im.ship_city),'') ship_city,
	COALESCE(max(im.ship_street),'') ship_street,
	COALESCE(max(im.ship_pincode),'') ship_pincode,
	COALESCE(max(im.ship_website),'') ship_website,
	COALESCE(max(im.ship_phone_no),'') ship_phone_no,
	COALESCE(max(im.ship_fax_no),'') ship_fax_no,
	COALESCE(max(im.ship_mobile_no),'') ship_mobile_no,
	COALESCE(max(tcomp.state),'') comp_state,
	COALESCE(max(tcomp.city),'') comp_city,
	COALESCE(max(tcomp.street),'') comp_street,
	COALESCE(max(tcomp.area),'') comp_area,
	COALESCE(max(tcomp.pin_code),'') comp_pin,
	COALESCE(max(tcomp.email),'') comp_email,
	COALESCE(max(tcomp.phone_number),'') comp_phone_number,
	COALESCE(max(tcomp.mobile_no),'') comp_mobile_no,
	COALESCE(max(tcomp.website),'') comp_website,
	COALESCE(max(tcomp.reg_number),'') comp_pan,
	COALESCE(max(tcomp.tax_number),'') comp_gstn,
	COALESCE(max(tcomp.fax_no),'') comp_fax ,
	COALESCE(max(tcomp.company_name),'') ||','||COALESCE(max(tcomp.street),'') || ',' || COALESCE(max(tcomp.area),'') || ',' ||
	COALESCE(max(tcomp.city),'') || ' - ' || COALESCE(max(tcomp.pin_code),'') ||',' ||
	COALESCE(max(tcomp.state),'') || ', ' || '' address,
	COALESCE(max(tcomp.company_name),'') addressLine1,
	COALESCE(max(tcomp.street),'') addressLine2,
	COALESCE(max(tcomp.area),'') addressLine3,
	COALESCE(max(tcomp.city),'') addressLine4,
	COALESCE(max(tcomp.pin_code),'') addressLine5,
	COALESCE(max(state.state_name),'') addressLine6,
COALESCE(max(ct.country_name),'') addressLine7,
	COALESCE(max(tcus.pan_number),'') cus_pan,
	COALESCE(max(tcus.gst_number),'') cus_gstn,
          max(im.terms_conditions) terms,
          max(im.total_invoice_qty1) qty1,
          max(im.total_invoice_qty2) qty2,
          ROUND(MAX(im.total_invoice_amount),2) total_amt,
           Round(max(im.total_invoice_net_amount),2) net_total_amt,
          max(im.total_charge_plus_amount) plus_amt,
          max(im.total_charge_minus_amount) minus_amt,
	'Tel: ' ||  COALESCE(max(tcomp.phone_number),'')  addressLine8,
          COUNT(id.inv_det_id) AS detail_row_count,
          max(COALESCE(im.cargo_no,'')) cargo_no,
          max(st.shipment_type_name) consignee,
          max(c.carrier_remarks) carrier,
          max(im.source_port) src_port,
max(pt.payment_type_name) payment_type,
          max(tc.city_name)transit_via,
          max(dc.city_name) des_city,
          max(pc.city_name) pickup_city,
          COALESCE(max(im.tin_box_no),'') tin_box_no,
          ROUND(max(im.total_gross_wt),3) total_gross_wt,
          COALESCE(max(hsn.hsn_code),'') hsn_code,
          max(COALESCE(cargoparam.parameter_name,'')) carge_type,
          max(origin.parameter_name) origin,
          max(COALESCE(ic.insurance_company_name,''))insurance_company,
          max(COALESCE(bank.bank_name,'')) bank_name,
          max(COALESCE(bank.bank_account_number,'')) acc_no,
          max(COALESCE(bank.beneficiary_name,'')) beneficiary,
          max(COALESCE(bank.wire_transfer,'')) swift_code,
	max(COALESCE(bank.bank_address,'')) bank_add,
          max(COALESCE(bank.ifsc_code,'')) ifsc_code,
           max(COALESCE(bank.bank_name,'')) b1,
          max(COALESCE(bank.bank_account_number,'')) b2,
          max(COALESCE(bank.beneficiary_name,'')) b3,
	max(COALESCE(bank.bank_address,'')) b4,
          max(COALESCE(bank.ifsc_code,'')) b5,
COALESCE(max(tcomp.pan_no),'') comp_pan_no,
		  COALESCE(max(tcomp.gst_no),'') comp_gst_no,
		  COALESCE(max(tcomp.cin_no),'') comp_cin_no,
		  COALESCE(max(tcomp.ie_code_no),'') comp_ie_code_no,
		  COALESCE(max(bank.ad_code),'') bank_ad_code,
	fn_amount_to_words(
    ((MAX(im.total_invoice_amount) ) + COALESCE(MAX(tax.total_tax_amount),0)),
    'USD'::varchar,'Dollars','Cents'
) AS amount_in_words_dollor,
          amount_in_indian_words(ROUND(MAX(im.total_invoice_amount)/nullif(max(im.exchange_rate),0)+ COALESCE(MAX(tax.total_tax_amount),0), 2)/nullif(im.exchange_rate,0)) AS amount_in_words_rs,
         ROUND(
    (MAX(im.total_invoice_amount) / NULLIF(MAX(im.exchange_rate),0)) +
    (COALESCE(MAX(tax.total_tax_amount),0) / NULLIF(MAX(im.exchange_rate),0)),
    2
) AS grand_total_amt,
max(im.ship_consignee)  ship_consignee,
		  max(im.bill_consignee) bill_consignee,
COALESCE(max(im.ship_contact_no),'') ship_contact_no,
		  COALESCE(max(im.ship_contact_person),'') ship_contact_person,
		  COALESCE(max(im.ship_email_id),'') ship_email_id,
		  COALESCE(max(im.bill_contact_no),'') bill_contact_no,
		  COALESCE(max(im.bill_contact_person),'') bill_contact_person,
		  COALESCE(max(im.bill_email_id),'') bill_email_id,
max(c.carrier_name) carrier_name,
max(c.carrier_type) carrier_type
from
	tbl_memo_sales_return_invoice_main im
	inner join tbl_company tcomp on im.company_id = tcomp.company_id
          left join tbl_state state on tcomp.state = state.state_code
	inner join tbl_memo_sales_return_invoice_det id on im.inv_id = id.inv_id
		and id.is_deleted = 0
	inner join tbl_customer tcus on im.customer_id = tcus.customer_id
          left join tbl_country ct on tcomp.country_id = ct.country_id
           left join tbl_shipment_type st on im.shipment_type_id = st.shipment_type_id
           left join tbl_carrier c on im.carrier_id = c.carrier_id
           left join tbl_hsn_code hsn on im.hsn_code_id = hsn.hsn_code_id
           left join tbl_global_parameter cargoparam on im.cargo_type_code = cargoparam.parameter_code
           left join tbl_global_parameter origin on im.origin_code = origin.parameter_code
           left join tbl_insurance_company ic on im.insurance_company_id = ic.insurance_company_id
           left join tbl_city tc on im.transit_via = tc.city_code
           left join tbl_city dc on im.destination_port = dc.city_code
           left join tbl_city pc on im.place_of_pickup = dc.city_code
           left join tbl_company_bank bank on ($P!{bank_id}) = bank.map_id
           left join tbl_payment_type pt on im.payment_type_id = pt.payment_type_id
           left join tbl_memo_sales_invoice_main memo on id.ref_inv_id = memo.inv_id
	left join(
		select
			sal_chg.inv_id,
			sum(sal_chg.plus_minus_flag * sal_chg.input_amt) total_tax_amount
		from
			tbl_memo_sales_return_invoice_chgs sal_chg
		where
			sal_chg.is_deleted = 0
			and sal_chg.inv_id in ($P!{i_inv_id})
		group by
			sal_chg.inv_id
	)tax on im.inv_id = tax.inv_id
where
	im.is_deleted = 0
	and im.inv_id in ($P!{i_inv_id})
group by
	im.inv_id,
	im.inv_type]]>
	</queryString>
