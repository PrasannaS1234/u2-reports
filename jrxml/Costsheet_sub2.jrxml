<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ProformaSalesInvoiceCostsheet_subreport1" pageWidth="456" pageHeight="802" columnWidth="456" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="76111d11-bc33-4a99-a86b-c6967d8684c0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="inv_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
sum(gold_wt) as gold_wt,
sum(silver_wt) as silver_wt,
sum(gold_loss_wt) as gold_loss_wt,
sum(silver_loss_wt) as silver_los_wt,
sum(dia_wt) as dia_wt,
sum(stone_wt) as stone_wt,
sum(labor_qty) + sum(alloy_qty) + sum(cad_qty) as labour_total
from
(
	-- Component Details
SELECT
		sum(CASE when lot.lot_type = 'METAL' and pc.consumed_qty1 > 0 and UPPER(com.commodity_name)
		like '%GOLD%' then pc.consumed_qty1 end ) as gold_wt,
		sum(CASE when lot.lot_type = 'METAL' and pc.consumed_qty1 > 0 and UPPER(com.commodity_name)
		like '%SILVER%' then pc.consumed_qty1 end) as silver_wt,
		sum(CASE when lot.lot_type = 'METAL' and pc.consumed_qty1 > 0 and UPPER(com.commodity_name)
		like '%GOLD%' then pc.loss_qty1 end ) as gold_loss_wt,
		sum(CASE when lot.lot_type = 'METAL' and pc.consumed_qty1 > 0 and UPPER(com.commodity_name)
		like '%SILVER%' then pc.loss_qty1 end) as silver_loss_wt,
	    sum(CASE WHEN pc.consumed_qty1 > 0 and lot.lot_type = 'STONE' and com.metal_type = 'DIAMOND'
	    then pc.consumed_qty1 end) as dia_wt,
	    sum(CASE WHEN pc.consumed_qty1 > 0 and lot.lot_type = 'STONE' and com.metal_type != 'DIAMOND'
	    then pc.consumed_qty1 end) as stone_wt,
		 0 cad_qty,
		 0 alloy_qty,
		 0 labor_qty
    FROM tbl_proforma_factory_invoice_component pc
    JOIN tbl_lot lot
        ON pc.lot_id = lot.lot_id
       AND lot.is_deleted = 0
    JOIN tbl_commodity com
        ON lot.commodity_id = com.commodity_id
       AND com.is_deleted = 0
    WHERE pc.is_deleted = 0
      AND pc.inv_det_id = $P!{inv_det_id}
    GROUP BY com.commodity_name
union all
--Labour BreakUp Details
SELECT
    0 gold_wt,
	0 silver_wt,
	0 gold_loss_wt,
	0 silver_loss_wt,
	0 dia_wt,
	0 stone_wt,
	case when UPPER(pro.process_name) like '%CAD%' then pl.qty end  as cad_qty,
	case when UPPER(pro.process_name) like '%ALLOY%' then pl.qty  end as alloy_qty,
    case when UPPER(pro.process_name) not like '%ALLOY%' and  UPPER(pro.process_name) not like '%CAD%' then pl.qty end as labor_qty
FROM tbl_proforma_factory_invoice_labour pl
LEFT JOIN tbl_process pro
    ON pl.process_id = pro.process_id
WHERE pl.is_deleted = 0
  AND pl.inv_det_id = $P!{inv_det_id}
)tmp]]>
	</queryString>
	<field name="gold_wt" class="java.math.BigDecimal"/>
	<field name="silver_wt" class="java.math.BigDecimal"/>
	<field name="gold_loss_wt" class="java.math.BigDecimal"/>
	<field name="silver_los_wt" class="java.math.BigDecimal"/>
	<field name="dia_wt" class="java.math.BigDecimal"/>
	<field name="stone_wt" class="java.math.BigDecimal"/>
	<field name="labour_total" class="java.math.BigDecimal"/>
