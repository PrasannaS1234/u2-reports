<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GoodsIssueNote" pageWidth="895" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="835" leftMargin="50" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.inv_id,
	concat(t.inv_type,'-',t.inv_no) inv_type_no,
	c.display_name customer_name,
	t.reference_no,
	dept.department_name,
	to_char(t.created_dt, 'dd/mm/yyyy HH24:mi AM') created_dt,
	row_number() over (partition by t.inv_id order by t.inv_id, d.inv_det_id) sno,
	concat(bag.bag_type,bag.bag_no) bag_type_no,
	case when row_number() over (partition by t.inv_id, bag.bag_id order by t.inv_id, d.inv_det_id) = 1 then
bag.bag_qty else null end bag_qty,
	d.customer_lot_no customer_bag_no,
	sm.reference_no so_reference_no,
	concat(j.jew_type,j.jew_no) jew_type_no,
	d.receipt_qty1 qty1,
	d.receipt_qty2 qty2,
	l.uom1,
	l.uom2
from
	tbl_mfg_goods_receipt t
	inner join tbl_mfg_goods_receipt_det d on t.inv_id = d.inv_id
		and d.is_deleted = 0
	inner join tbl_lot l on d.lot_id = l.lot_id
	left join tbl_customer c on t.customer_id = c.customer_id
	inner join tbl_department dept on t.department_id = dept.department_id
	left join tbl_jewellery j on d.job_id = j.jew_id
	left join tbl_sales_order_main sm on j.sales_order_id = sm.sales_order_id
	left join tbl_mfg_bag bag on d.customer_lot_no = bag.customer_bag_no
	   and j.jew_id = bag.job_id
where
	t.is_deleted = 0
	and t.inv_id = $P!{i_inv_id}
order by
	t.inv_id,
	d.inv_det_id]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<field name="created_dt" class="java.lang.String"/>
	<field name="sno" class="java.lang.Long"/>
	<field name="bag_type_no" class="java.lang.String"/>
	<field name="bag_qty" class="java.math.BigDecimal"/>
	<field name="customer_bag_no" class="java.lang.String"/>
	<field name="so_reference_no" class="java.lang.String"/>
	<field name="jew_type_no" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="uom2" class="java.lang.String"/>
	<variable name="qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty1}]]></variableExpression>
	</variable>
	<variable name="qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty2}]]></variableExpression>
	</variable>
	<variable name="bag_qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{bag_qty}]]></variableExpression>
	</variable>
