<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="WTVSalesRegister" pageWidth="2350" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="2310" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="5"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["'%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    abc.*
FROM
(
    ----------------------------------------------------------------
    -- SALES INVOICE
    ----------------------------------------------------------------
    SELECT
        tcomp.company_name,
        im.inv_id,
        fn_get_customer_invoice_no(im.inv_type, im.inv_id) AS cus_doc_type,
        im.inv_type || '-' || im.inv_no AS inv_type_no,
        TO_CHAR(im.inv_dt, $P{dateFormat}) AS inv_dt,
        TO_CHAR(im.inv_due_dt, $P{dateFormat}) AS inv_due_dt,
        im.currency AS currency,
        COALESCE(im.exchange_rate,1) AS exchange_rate,
        im.reference_no,
        tcus.customer_name,
        prod.lot_code,
        id.uom1,
        id.uom2,
        id.lot_description,
        tcomg.commodity_group_name,
        tcom.commodity_name,
        sh.shape_name,
        cut.cut_name,
        col.color_name,
        cla.clarity_name,
        id.inv_qty1,
        id.inv_qty2,

        -- Input Rate
        CASE
            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_rate / COALESCE(im.exchange_rate,1)
            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_rate * COALESCE(im.exchange_rate,1),2)
            WHEN im.currency <> $P!{currency} THEN ROUND(id.input_rate / COALESCE(im.exchange_rate,1),2)
            ELSE ROUND(id.input_rate,2)
        END AS input_rate,

        -- Input Amount
        CASE
            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_amt / COALESCE(im.exchange_rate,1)
            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_amt * COALESCE(im.exchange_rate,1),2)
            WHEN im.currency <> $P!{currency} THEN ROUND(id.input_amt / COALESCE(im.exchange_rate,1),2)
            ELSE ROUND(id.input_amt,2)
        END AS input_amt,

        id.discount_type,
        id.discount_value,

        -- Cost Price
        CASE
            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN lp.cost_price / COALESCE(im.exchange_rate,1)
            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(lp.cost_price * COALESCE(im.exchange_rate,1),2)
            WHEN im.currency <> $P!{currency} THEN ROUND(lp.cost_price / COALESCE(im.exchange_rate,1),2)
            ELSE ROUND(lp.cost_price,2)
        END AS cost_price,

        prod.mm_size,
        lp.cost_price_code,
        id.inv_det_id,

        CASE
            WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN payment.account_names
            ELSE NULL
        END AS account_names,

        id.ref_inv_type_no,

        -- Other Charges
        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.plus_amt / COALESCE(im.exchange_rate,1)
			     WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.plus_amt * COALESCE(im.exchange_rate,1),2)
				 WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.plus_amt / COALESCE(im.exchange_rate,1),2)
                 ELSE ROUND(inv_chgs.plus_amt,2) END
        ELSE 0 END AS plus_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.minus_amt / COALESCE(im.exchange_rate,1)
                 WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.minus_amt * COALESCE(im.exchange_rate,1),2)
				 WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.minus_amt / COALESCE(im.exchange_rate,1),2)
                 ELSE ROUND(inv_chgs.minus_amt,2) END
        ELSE 0 END AS minus_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.igst_amt / COALESCE(im.exchange_rate,1)
                 WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.igst_amt * COALESCE(im.exchange_rate,1),2)
				 WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.igst_amt / COALESCE(im.exchange_rate,1),2)
                 ELSE ROUND(inv_chgs.igst_amt,2) END
        ELSE 0 END AS igst_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.sgst_amt / COALESCE(im.exchange_rate,1)
                 WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.sgst_amt * COALESCE(im.exchange_rate,1),2)
				 WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.sgst_amt / COALESCE(im.exchange_rate,1),2)
                 ELSE ROUND(inv_chgs.sgst_amt,2) END
        ELSE 0 END AS sgst_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.cgst_amt / COALESCE(im.exchange_rate,1)
                 WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.cgst_amt * COALESCE(im.exchange_rate,1),2)
				 WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.cgst_amt / COALESCE(im.exchange_rate,1),2)
                 ELSE ROUND(inv_chgs.cgst_amt,2) END
        ELSE 0 END AS cgst_amt,

        -- Paid Amount including other charges
        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN (payment.paid_amount + inv_chgs.plus_amt - inv_chgs.minus_amt + inv_chgs.igst_amt + inv_chgs.sgst_amt + inv_chgs.cgst_amt) / COALESCE(im.exchange_rate,1)
                 WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND((payment.paid_amount + inv_chgs.plus_amt - inv_chgs.minus_amt + inv_chgs.igst_amt + inv_chgs.sgst_amt + inv_chgs.cgst_amt) * COALESCE(im.exchange_rate,1),2)
				 WHEN im.currency <> $P!{currency} THEN ROUND((payment.paid_amount + inv_chgs.plus_amt - inv_chgs.minus_amt + inv_chgs.igst_amt + inv_chgs.sgst_amt + inv_chgs.cgst_amt) / COALESCE(im.exchange_rate,1),2)
				 ELSE ROUND((payment.paid_amount + inv_chgs.plus_amt - inv_chgs.minus_amt + inv_chgs.igst_amt + inv_chgs.sgst_amt + inv_chgs.cgst_amt),2) END
        ELSE 0 END AS paid_amount

    FROM tbl_sales_invoice_main im
    INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
    INNER JOIN tbl_sales_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
    INNER JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
    INNER JOIN tbl_lot prod ON id.lot_id = prod.lot_id
    INNER JOIN tbl_commodity tcom ON prod.commodity_id = tcom.commodity_id
    INNER JOIN tbl_commodity_group tcomg ON tcom.commodity_group_id = tcomg.commodity_group_id
    LEFT JOIN tbl_shape sh ON prod.shape_id = sh.shape_id
    LEFT JOIN tbl_cut cut ON prod.cut_id = cut.cut_id
    LEFT JOIN tbl_color col ON prod.color_id = col.color_id
    LEFT JOIN tbl_clarity cla ON prod.clarity_id = cla.clarity_id
    LEFT JOIN tbl_lot_price_det lp ON prod.lot_id = lp.lot_id AND im.company_id = lp.company_id
    LEFT JOIN (
        SELECT
            chgs.inv_id,
            SUM(CASE WHEN chgs.plus_minus_flag = 1 THEN chgs.input_amt ELSE 0 END) AS plus_amt,
            SUM(CASE WHEN chgs.plus_minus_flag = -1 THEN chgs.input_amt ELSE 0 END) AS minus_amt,
            SUM(CASE WHEN lower(chgs.charge_name) like '%igst%' THEN chgs.input_amt ELSE 0 END) AS igst_amt,
            SUM(CASE WHEN lower(chgs.charge_name) like '%cgst%' THEN chgs.input_amt ELSE 0 END) AS sgst_amt,
            SUM(CASE WHEN lower(chgs.charge_name) like '%sgst%' THEN chgs.input_amt ELSE 0 END) AS cgst_amt
        FROM tbl_sales_invoice_chgs chgs
        WHERE chgs.is_deleted = 0
        GROUP BY chgs.inv_id
    ) inv_chgs ON im.inv_id = inv_chgs.inv_id
    LEFT JOIN (
        SELECT
            pim.company_id,
            pid.inv_type,
            pid.inv_id,
            SUM(pid.paid_amount) AS paid_amount,
            MAX(CONCAT_WS(', ', acc.account_name)) AS account_names
        FROM tbl_payment_paid_main pim
        INNER JOIN tbl_payment_paid_det pid ON pim.payment_id = pid.payment_id AND pid.is_deleted = 0
        LEFT JOIN tbl_account acc ON pim.bank_cash_account_id = acc.account_id
        WHERE pim.is_deleted = 0
        GROUP BY pim.company_id, pid.inv_type, pid.inv_id
    ) payment ON im.inv_type = payment.inv_type AND im.inv_id = payment.inv_id AND im.company_id = payment.company_id

    WHERE im.is_deleted = 0
      AND im.inv_dt BETWEEN TO_DATE($P{fromDate}, $P{dateFormat}) AND TO_DATE($P{toDate}, $P{dateFormat})
      AND ((im.company_id = $P!{companyId}) OR (-1 = $P!{companyId}))

    ----------------------------------------------------------------
    -- SALES RETURN INVOICE
    ----------------------------------------------------------------
    UNION ALL
    SELECT
        tcomp.company_name,
        im.inv_id,
fn_get_customer_invoice_no(im.inv_type, im.inv_id) AS cus_doc_type,
        im.inv_type || '-' || im.inv_no AS inv_type_no,
        TO_CHAR(im.inv_dt, $P{dateFormat}) AS inv_dt,
        TO_CHAR(im.inv_due_dt, $P{dateFormat}) AS inv_due_dt,
        im.currency AS currency,
        COALESCE(im.exchange_rate,1) AS exchange_rate,
        im.reference_no,
        tcus.customer_name,
        prod.lot_code,
        id.uom1,
        id.uom2,
        id.lot_description,
        tcomg.commodity_group_name,
        tcom.commodity_name,
        sh.shape_name,
        cut.cut_name,
        col.color_name,
        cla.clarity_name,
        -1 * id.inv_qty1,
        -1 * id.inv_qty2,

        -- Input Rate
        -1 * CASE
            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_rate / COALESCE(im.exchange_rate,1)
            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_rate * COALESCE(im.exchange_rate,1),2)
            WHEN im.currency <> $P!{currency} THEN ROUND(id.input_rate / COALESCE(im.exchange_rate,1),2)
            ELSE ROUND(id.input_rate,2)
        END AS input_rate,

        -- Input Amount
        -1 * CASE
            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN id.input_amt / COALESCE(im.exchange_rate,1)
            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(id.input_amt * COALESCE(im.exchange_rate,1),2)
            WHEN im.currency <> $P!{currency} THEN ROUND(id.input_amt / COALESCE(im.exchange_rate,1),2)
            ELSE ROUND(id.input_amt,2)
        END AS input_amt,

        id.discount_type,
        id.discount_value,

        -- Cost Price
        -1 * CASE
            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN lp.cost_price / COALESCE(im.exchange_rate,1)
            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(lp.cost_price * COALESCE(im.exchange_rate,1),2)
            WHEN im.currency <> $P!{currency} THEN ROUND(lp.cost_price / COALESCE(im.exchange_rate,1),2)
            ELSE ROUND(lp.cost_price,2)
        END AS cost_price,

        prod.mm_size,
        lp.cost_price_code,
        id.inv_det_id,
        NULL AS account_names,
        id.ref_inv_type_no,

        -- Other Charges
        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            -1 * CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.plus_amt / COALESCE(im.exchange_rate,1)
			          WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.plus_amt * COALESCE(im.exchange_rate,1),2)
					  WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.plus_amt / COALESCE(im.exchange_rate,1),2)
					  ELSE ROUND(inv_chgs.plus_amt,2) END
        ELSE 0 END AS plus_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            -1 * CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.minus_amt / COALESCE(im.exchange_rate,1)
			          WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.minus_amt * COALESCE(im.exchange_rate,1),2)
					  WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.minus_amt / COALESCE(im.exchange_rate,1),2)
					  ELSE ROUND(inv_chgs.minus_amt,2) END
        ELSE 0 END AS minus_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            -1 * CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.igst_amt / COALESCE(im.exchange_rate,1)
                      WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.igst_amt * COALESCE(im.exchange_rate,1),2)
					  WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.igst_amt / COALESCE(im.exchange_rate,1),2)
					  ELSE ROUND(inv_chgs.igst_amt,2) END
        ELSE 0 END AS igst_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            -1 * CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.sgst_amt / COALESCE(im.exchange_rate,1)
                      WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.sgst_amt * COALESCE(im.exchange_rate,1),2)
					  WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.sgst_amt / COALESCE(im.exchange_rate,1),2)
					  ELSE ROUND(inv_chgs.sgst_amt,2) END
        ELSE 0 END AS sgst_amt,

        CASE WHEN ROW_NUMBER() OVER(PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) = 1 THEN
            -1 * CASE WHEN $P!{currency} = 'USD' AND im.currency <> 'USD' THEN inv_chgs.cgst_amt / COALESCE(im.exchange_rate,1)
                      WHEN $P!{currency} <> 'USD' AND im.currency = 'USD' THEN ROUND(inv_chgs.cgst_amt * COALESCE(im.exchange_rate,1),2)
					  WHEN im.currency <> $P!{currency} THEN ROUND(inv_chgs.cgst_amt / COALESCE(im.exchange_rate,1),2)
					  ELSE ROUND(inv_chgs.cgst_amt,2) END
        ELSE 0 END AS cgst_amt,

        NULL AS paid_amount

    FROM tbl_sales_return_invoice_main im
    INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
    INNER JOIN tbl_sales_return_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
    INNER JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
    INNER JOIN tbl_lot prod ON id.lot_id = prod.lot_id
    INNER JOIN tbl_commodity tcom ON prod.commodity_id = tcom.commodity_id
    INNER JOIN tbl_commodity_group tcomg ON tcom.commodity_group_id = tcomg.commodity_group_id
    LEFT JOIN tbl_shape sh ON prod.shape_id = sh.shape_id
    LEFT JOIN tbl_cut cut ON prod.cut_id = cut.cut_id
    LEFT JOIN tbl_color col ON prod.color_id = col.color_id
    LEFT JOIN tbl_clarity cla ON prod.clarity_id = cla.clarity_id
    LEFT JOIN tbl_lot_price_det lp ON prod.lot_id = lp.lot_id AND im.company_id = lp.company_id
    LEFT JOIN (
        SELECT
            chgs.inv_id,
            SUM(CASE WHEN chgs.plus_minus_flag = 1 THEN chgs.input_amt ELSE 0 END) AS plus_amt,
            SUM(CASE WHEN chgs.plus_minus_flag = -1 THEN chgs.input_amt ELSE 0 END) AS minus_amt,
            SUM(CASE WHEN lower(chgs.charge_name) like '%igst%' THEN chgs.input_amt ELSE 0 END) AS igst_amt,
            SUM(CASE WHEN lower(chgs.charge_name) like '%cgst%' THEN chgs.input_amt ELSE 0 END) AS sgst_amt,
            SUM(CASE WHEN lower(chgs.charge_name) like '%sgst%' THEN chgs.input_amt ELSE 0 END) AS cgst_amt
        FROM tbl_sales_return_invoice_chgs chgs
        WHERE chgs.is_deleted = 0
        GROUP BY chgs.inv_id
    ) inv_chgs ON im.inv_id = inv_chgs.inv_id

    WHERE im.is_deleted = 0
      AND im.inv_dt BETWEEN TO_DATE($P{fromDate}, $P{dateFormat}) AND TO_DATE($P{toDate}, $P{dateFormat})
      AND ((im.company_id = $P!{companyId}) OR (-1 = $P!{companyId}))

) abc
ORDER BY
    abc.inv_type_no,
    abc.inv_id,
    abc.inv_det_id,
    abc.inv_dt;]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="cus_doc_type" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="inv_due_dt" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="uom2" class="java.lang.String"/>
	<field name="lot_description" class="java.lang.String"/>
	<field name="commodity_group_name" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="cut_name" class="java.lang.String"/>
	<field name="color_name" class="java.lang.String"/>
	<field name="clarity_name" class="java.lang.String"/>
	<field name="inv_qty1" class="java.math.BigDecimal"/>
	<field name="inv_qty2" class="java.math.BigDecimal"/>
	<field name="input_rate" class="java.math.BigDecimal"/>
	<field name="input_amt" class="java.math.BigDecimal"/>
	<field name="discount_type" class="java.lang.String"/>
	<field name="discount_value" class="java.math.BigDecimal"/>
	<field name="cost_price" class="java.math.BigDecimal"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="cost_price_code" class="java.lang.String"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="account_names" class="java.lang.String"/>
	<field name="ref_inv_type_no" class="java.lang.String"/>
	<field name="plus_amt" class="java.math.BigDecimal"/>
	<field name="minus_amt" class="java.math.BigDecimal"/>
	<field name="igst_amt" class="java.math.BigDecimal"/>
	<field name="sgst_amt" class="java.math.BigDecimal"/>
	<field name="cgst_amt" class="java.math.BigDecimal"/>
	<field name="paid_amount" class="java.math.BigDecimal"/>
	<variable name="inv_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
	</variable>
	<variable name="inv_qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
	</variable>
	<variable name="input_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
	</variable>
	<variable name="cost_price_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cost_price}]]></variableExpression>
	</variable>
	<variable name="paid_amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{paid_amount}]]></variableExpression>
	</variable>
	<variable name="plus_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{plus_amt}]]></variableExpression>
