<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetPrint" pageWidth="581" pageHeight="850" whenNoDataType="AllSectionsNoDetail" columnWidth="571" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="0.826446280991736"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\Users\\DELL\\Documents\\Office Workings\\Report Development\\ireports\\Jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-mm-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH old_jew AS (
    SELECT distinct t1.sku_id
    FROM tbl_jewellery t1
    WHERE t1.sales_order_id IN ($P!{i_inv_id} )
),
order_info AS (
    SELECT
        t1.sku_id,
        MAX(t1.jew_type || t1.jew_no) || ',' ||
        MAX(ps.product_size) || ',' ||
        MAX(t1.metal1 || ':' || ROUND(t1.metal_weight, 3)) || ',' ||
        MAX(ROUND(qty)::text) || ' PC' ||

        CASE
            WHEN SUM(CASE WHEN COALESCE(com.metal_type, 'DIAMOND') = 'DIAMOND' THEN total_qty1 ELSE 0 END) > 0
            THEN ', ' ||
                COALESCE(STRING_AGG(
                    CASE WHEN COALESCE(com.metal_type, 'DIAMOND') = 'DIAMOND' THEN lot.lot_code END, ', '
                ), '') || ' ' ||
                ROUND(SUM(CASE WHEN COALESCE(com.metal_type, 'DIAMOND') = 'DIAMOND' THEN total_qty1 ELSE 0 END),3)::text || ' CT ' ||
                ROUND(SUM(CASE WHEN COALESCE(com.metal_type, 'DIAMOND') = 'DIAMOND' THEN total_qty2 ELSE 0 END),0)::text || ' PCS'
            ELSE ''
        END ||

        CASE
            WHEN SUM(CASE WHEN COALESCE(com.metal_type, 'GEMSTONE') = 'GEMSTONE' THEN total_qty1 ELSE 0 END) > 0
            THEN ', ' ||
                COALESCE(STRING_AGG(
                    CASE WHEN COALESCE(com.metal_type, 'GEMSTONE') = 'GEMSTONE' THEN lot.lot_code END, ', '
                ), '') || ' ' ||
                ROUND(SUM(CASE WHEN COALESCE(com.metal_type, 'GEMSTONE') = 'GEMSTONE' THEN total_qty1 ELSE 0 END),3)::text || ' CT ' ||
                ROUND(SUM(CASE WHEN COALESCE(com.metal_type, 'GEMSTONE') = 'GEMSTONE' THEN total_qty2 ELSE 0 END),0)::text || ' PCS'
            ELSE ''
        END AS jew_summary
    FROM
        old_jew ol
        INNER JOIN tbl_jewellery t1 ON ol.sku_id = t1.sku_id
        INNER JOIN tbl_jewellery_component jc ON t1.jew_id = jc.jew_id AND jc.is_deleted = 0
        INNER JOIN tbl_lot lot ON jc.lot_id = lot.lot_id
        INNER JOIN tbl_commodity com ON jc.commodity_id = com.commodity_id
        LEFT JOIN tbl_product_size ps ON t1.product_size_id = ps.size_id
    WHERE
        t1.jew_id = (
            SELECT MAX(jew_id)
            FROM tbl_jewellery l1
            INNER JOIN old_jew l2 ON l1.sku_id = l2.sku_id
            WHERE is_deleted = 0
        )
    GROUP BY t1.jew_id
)
select
	max(comp.company_name) company_name,
	t.jew_id,
          max(sd.sales_order_det_id) sales_order_det_id,
	max(concat(t.jew_type, t.jew_no)) job_type_no,
    max(concat(so.sales_order_type,so.sales_order_no)) so_no,
	max(s.sku_no) sku_no,
	max(t.factory_ref_no) factory_ref_no,
    max(des.design_no) design_no,
	max(p.product_type_name) product_type_name,
	max(c.customer_name) customer_name,
	max(sd.customer_order_no) customer_order_no,
	max(t.qty) qty,
	max(sd.customer_jew_no) customer_jew_no,
	max(so.reference_no) reference_no,
	max(tsc.dia_wt||' CT  '||tsc.dia_pcs||' PCS') diamond_remarks,
	max(tsc.cs_wt||' CT  '||tsc.cs_pcs||' PCS') gemstone_remarks,
	max(sd.metal_wt) metal_wt,
	max(to_char(so.delivery_date, $P{dateFormat})) delivery_date,
	max(to_char(so.sales_order_date, $P{dateFormat})) sales_order_date,
          max(to_char(so.shipment_date, $P{dateFormat})) shipped_date,
	max(ps.product_size) product_size,
	max(t.metal_weight) metal_weight,
	max(t.metal1) metal1,
max(s.description) description,
	max(t.stamping_details) stamping_details,
          max(tscn.note) prod_description, max(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url)) image_url,

	max(fac.factory_name) factory_name,
	max(s.uom) uom,
	max(concat(u.first_name,' ', u.last_name)) issued_by,
	max(sd.color_code) color_code,
	max(so.gold_rate) gold_rate,
	max(skum.mould_nos) mould_nos,
MAX(of.jew_summary) AS jew_summary,
max(sd.gold_loss_pct) gold_loss_pct,
 max(mlt.description) metal_lot_desc,
 max(case when sd.is_need_to_take_photo = 1 then '影相' else ' ' end)  is_photo_req
from
	tbl_jewellery t
	inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
	inner join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	left join(
		select
			sc.sales_order_det_id,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'DIAMOND' then tot_qty else 0 end),3) dia_wt,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'DIAMOND' then qty2 else 0 end),0) dia_pcs,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'GEMSTONE' then tot_qty else 0 end),3) cs_wt,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'GEMSTONE' then qty2 else 0 end),0) cs_pcs
		from
			tbl_sales_order_component sc
			inner join tbl_commodity com on sc.commodity_id = com.commodity_id
		where
			sc.is_deleted = 0
		group by
			sc.sales_order_det_id
	)tsc on sd.sales_order_det_id = tsc.sales_order_det_id
	left join(
		select
			sc.sales_order_det_id,
			string_agg(sc.note,', ') note
		from
			tbl_sales_order_prod_note sc
		where
			sc.is_deleted = 0
		group by
			sc.sales_order_det_id
	)tscn on sd.sales_order_det_id = tscn.sales_order_det_id
	inner join tbl_sku s on t.sku_id = s.sku_id
	left join tbl_design des on s.design_id = des.design_id
          left join
	(
		select sku_id,string_agg(mould_no, ',') AS mould_nos from tbl_sku_mould skm where is_deleted = 0 group by sku_id
	) skum on skum.sku_id = s.sku_id
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	left join tbl_factory fac on so.factory_id = fac.factory_id
	left join tbl_user u on so.created_by = u.user_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
          left join tbl_lot mlt on t.metal1 = mlt.lot_code
          LEFT JOIN order_info of ON 1 = 1
where
	(so.sales_order_id) in ($P!{i_inv_id} )
           and t.is_deleted = 0
group by
	t.jew_id
order by
	 t.jew_id]]>
	</queryString>
