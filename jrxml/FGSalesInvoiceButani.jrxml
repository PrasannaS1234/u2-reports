	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<parameter name="tenant" class="java.lang.String">
			<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select row_number() over (order by  id.inv_det_id) srno,
    im.inv_id,
    jt.jew_no product_no,
    im.currency,
    id.prod_description,
    id.inv_qty,
    id.input_rate,
    id.input_amt,
    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',im.company_id,'/sku/',s.sku_id,s.image_url) img_url
from
    tbl_jew_sales_invoice_main im
    inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
	inner join tbl_jewellery jt on id.jew_id = jt.jew_id
	left join tbl_sku s on jt.sku_id = s.sku_id
where
    im.is_deleted = 0
    and im.inv_id = $P!{i_inv_id}]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="product_no" class="java.lang.String"/>
		<field name="currency" class="java.lang.String"/>
		<field name="prod_description" class="java.lang.String"/>
		<field name="inv_qty" class="java.math.BigDecimal"/>
		<field name="input_rate" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<field name="img_url" class="java.lang.String"/>
		<variable name="QTY" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty}]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="f2523445-e3c7-4637-a9da-0e96129f78c0">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
        0 sort_seq,
        case when sal_chg.plus_minus_flag = -1 then concat(sal_chg.charge_name,'(-)') else sal_chg.charge_name end charge_name,
        sal_chg.input_amt amount
    from
        tbl_jew_sales_invoice_chgs sal_chg
    where
        sal_chg.is_deleted = 0
        and sal_chg.inv_id = $P!{i_inv_id}
    union all
    select
        1 sort_seq,
        'Total',
        im.total_invoice_net_amount total_invoice_amount
    from
        tbl_jew_sales_invoice_main im
    where
        im.is_deleted = 0
        and im.inv_id = $P!{i_inv_id}
     order by
        sort_seq]]>
		</queryString>
		<field name="sort_seq" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    tcomp.display_name company_name,
    concat(coalesce(tcomp.street,''),coalesce(tcomp.area,''),coalesce(tcomp.city,'')
       ,coalesce(tcomp.state,'')) company_add,
    tcomp.phone_number,
    tcomp.fax_no,
    tcomp.email,
    id.prod_description,
    coalesce(set_main.jew_set_id::text, 'J'||j.jew_id::text) as group_key,
    (im.inv_id) inv_id,
    im.inv_type inv_type,
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, 'dd/mm/yyyy') inv_dt,
    im.currency currency,
    inv_due_dt due_date,
    pyt.payment_type_name payment_term,
    tsup.customer_name customer_name,
    coalesce(im.bill_address1,'') bill_addr1,
    coalesce(im.bill_address2,'') bill_addr2,
    coalesce(im.bill_country,'') bill_country,
    coalesce(im.bill_state,'') bill_state,
    coalesce(im.bill_city,'') bill_city,
    coalesce(im.bill_street,'') bill_street,
    coalesce(im.bill_pincode,'') bill_pincode,
    coalesce(im.bill_phone_no,'') bill_tel,
    coalesce(im.bill_fax_no,'') bill_fax,
    --fn_amount_to_words(im.total_invoice_amount,im.currency::text,''::varchar,''::varchar) amount_in_words,
    spellnumericvalue(im.total_invoice_amount,im.currency::text)amount_in_words,
	j.jew_no,
	sku.sku_no,
	prd.product_type_name,
	metal.lot_code as metal,
	j.product_size,
	j.gross_wt,
	jc.dia_wt,
	jc.pearl_wt,
	jc.p_stone_wt,
	set.jew_set_id,
          j.qty,
          id.input_rate,
          id.input_rate * id.inv_qty as amount,
    case
    when set_main.jew_set_id is not null and set_main.image_url is not null then
        concat(
            '/home/ubuntu/tekfilo/jewtrade/uploads/',
            $P{tenant},
            'comp',
            set_main.company_id,
            '/jewset/',
            set_main.jew_set_id,
            set_main.image_url
        )
   when j.image_url is not null then
         concat(
            '/home/ubuntu/tekfilo/jewtrade/uploads/',
            $P{tenant},
            'comp',
            j.company_id,
            '/jewellery/',
            j.jew_id,
            j.image_url
        )
   when sku.image_url is not null then
         concat(
            '/home/ubuntu/tekfilo/jewtrade/uploads/',
            $P{tenant},
            'comp',
            sku.company_id,
            '/sku/',
            sku.sku_id,
            sku.image_url
        )
    else null
end as image_url,
    case when set.jew_set_id is not null then 'true' else 'false' end as set_total

from
    tbl_jew_sales_invoice_main im
	inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id and id.is_deleted = 0
	inner join tbl_jewellery j on j.jew_id = id.jew_id
	inner join tbl_sku sku on j.sku_id = sku.sku_id
	inner join tbl_product_type prd on prd.product_type_id = j.product_type_id
	left join tbl_lot metal on metal.lot_id = j.metal_id
	left join tbl_jew_set_det set on set.jew_id = j.jew_id
          left join tbl_jew_set set_main on set.jew_set_id = set_main.jew_set_id
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    left join tbl_state st on tcomp.state = st.state_code
    left join tbl_country tcountry on tcomp.country_id = tcountry.country_id
    inner join tbl_customer tsup on im.customer_id = tsup.customer_id
	inner join tbl_payment_type pyt on im.payment_type_id = pyt.payment_type_id
	left join tbl_company_bank cmbnk on tcomp.company_id = cmbnk.company_id
	    and cmbnk.is_default = 1
	left join (
	  select
		  jew_id,
		  sum(case when c.metal_type = 'DIAMOND' then jc.consumed_qty1 else 0 end) as dia_wt,
		  sum(case when c.metal_type = 'PEARL' AND cg.commodity_group_type = 'COLORSTONE' then jc.consumed_qty1 else 0 end) as pearl_wt,
		  sum(case when c.metal_type != 'PEARL' AND cg.commodity_group_type = 'COLORSTONE' then jc.consumed_qty1 else 0 end) as p_stone_wt
	 from tbl_jewellery_component jc
		left join tbl_commodity c on c.commodity_id = jc.commodity_id
		inner join tbl_commodity_group cg on cg.commodity_group_id = c.commodity_group_id
	 where jc.is_deleted = 0
	 group by jew_id
	)jc on jc.jew_id = j.jew_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
order by
set.jew_set_id,
id.prod_description]]>
	</queryString>
