<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGImportExportSu-Raj" pageWidth="680" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="670" leftMargin="5" rightMargin="5" topMargin="10" bottomMargin="10" uuid="34c3672d-ea2d-4d85-ac60-f253552ef34b">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    ROW_NUMBER() OVER (
        PARTITION BY m.inv_id
        ORDER BY d.inv_det_id
    ) AS serial_no,

    m.inv_id,
    j.jew_id,
m.reference_no,
    c.company_name,
    c.street company_address,
    c.area company_location,
    cus.customer_name,
    cus_add.line1,
    cus_add.line2,
    cus_add.line3,
    cus_add.line4,
    cus_add.line5,
    cus_add.line6,
    spellnumericvalue((d.input_amt),m.currency) as amount_words,

    m.currency,
    TO_CHAR(m.inv_dt, 'FMMonth DD, YYYY') invoice_dt,
    concat(m.inv_type,'-',m.inv_no) system_inv_no,
    m.reference_no export_inv_no,
    carr.carrier_name through,
    d.reference_no import_entry_no,
    k.karatage_name karatage,
    pr.product_type_name product,

    d.inv_qty as pcs,
    d.input_rate price_per_pcs,
    round(d.inv_qty * d.input_rate,3) amt,
    m.tin_box_no,
    cur.symbol,

    round(SUM(j.gross_wt) OVER (),3) AS tot_net_wt_pcs,
    round(SUM(d.inv_qty * d.input_rate) OVER (),2) AS tot_amt,

    fn_amount_to_words(
    FLOOR(ROUND(SUM(d.inv_qty * ROUND(d.input_rate,2)) OVER (), 2)),
        ''::varchar,
        '',
        ''
    ) || ' only.' AS inv_total_words,
    jcom.dia_wt * d.inv_qty  as dia_wt,
    jcom.dia_pcs * d.inv_qty as dia_pcs,
    jcom.stone_wt * d.inv_qty stone_wt,
    jcom.stone_pcs * d.inv_qty as stone_pcs,
    jcom.net_wt * d.inv_qty as net_wt,
    ((((jcom.dia_wt  + jcom.stone_wt ) / 5) +  jcom.net_wt) * d.inv_qty) as gross_wt,
    concat(j.jew_type,j.jew_no) as jewel_no
from tbl_jew_sales_invoice_main m

inner join tbl_jew_sales_invoice_det d
    on m.inv_id = d.inv_id
   and d.is_deleted = 0

left join (
    select
        currency_code,
        max(symbol) symbol
    from tbl_currency
    group by currency_code
) cur
    on m.currency = cur.currency_code

inner join tbl_company c
    on m.company_id = c.company_id

inner join tbl_customer cus
    on m.customer_id = cus.customer_id

inner join tbl_jewellery j
    on d.jew_id = j.jew_id

inner join tbl_sku sku
    on j.sku_id = sku.sku_id

inner join tbl_product_type pr
    on sku.product_type_id = pr.product_type_id

left join tbl_lot mlot
    on j.metal_id = mlot.lot_id

left join tbl_karatage k
    on mlot.karatage_id = k.karatage_id

left join tbl_carrier carr
    on m.carrier_id = carr.carrier_id

left join (
    select
        a.customer_id,
        a.address1 line1,
        a.address2 line2,
        concat(a.city,', ', a.state,', ',a.country) line3,
        concat('TEL: ',a.primary_contact_no) line4,
        concat('FAX: ', a.email ) line5,
        concat('Contact Person: -',a.primary_contact_name) line6
    from tbl_customer_address a
    where a.is_deleted = 0
      and a.address_type = 'Billing'
) cus_add
    on cus.customer_id = cus_add.customer_id

left join (
    select
        comp.jew_id,
       max(det.inv_id) inv_id,
        sum(
            case
                when c.metal_type = 'DIAMOND'
                     and lot.lot_type = 'STONE'
                then comp.consumed_qty1
            end
        ) as dia_wt,

        sum(
            case
                when c.metal_type != 'DIAMOND'
                     and lot.lot_type = 'STONE'
                then comp.consumed_qty1
            end
        ) as stone_wt,

        sum(
            case
                when c.metal_type = 'DIAMOND'
                     and lot.lot_type = 'STONE'
                then comp.consumed_qty2
            end
        ) as dia_pcs,

        sum(
            case
                when c.metal_type != 'DIAMOND'
                     and lot.lot_type = 'STONE'
                then comp.consumed_qty2
            end
        ) as stone_pcs,
        max(j.gross_wt) gross_wt,
        sum(
            case
                when lot.lot_type = 'METAL'
                then comp.consumed_qty1
            end
        ) as net_wt
    from tbl_jewellery_component comp

    inner join tbl_jew_sales_invoice_det det
        on det.jew_id = comp.jew_id
       and det.is_deleted = 0
    left join tbl_jew_purchase_invoice_jewel_detail j on j.inv_det_id = det.inv_det_id and j.is_deleted = 0
    left join tbl_lot lot
        on lot.lot_id = comp.lot_id

    inner join tbl_commodity c
        on lot.commodity_id = c.commodity_id

    where comp.is_deleted = 0

    group by comp.jew_id
) jcom
    on jcom.jew_id = j.jew_id
   and jcom.inv_id = d.inv_id

where 1 = 1
  and m.inv_id in ($P!{i_inv_id})

order by
    m.inv_id,
    d.reference_no;]]>
	</queryString>
