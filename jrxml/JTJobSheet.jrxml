	</parameter>
	<queryString>
		<![CDATA[select
	jt.jew_id,
	tcomp.company_name,
	concat(tcomp.street,', ',tcomp.area,', ',tcomp.state,', ',st.state_name,', ',tcountry.country_name) comp_address,
	COALESCE(tcomp.phone_number,'') phone_number,
	COALESCE(tcomp.fax_no,'') fax_no,
	COALESCE(tcomp.email,'') email,
	concat(jt.jew_type,jt.jew_no) job_no,
	tcus.customer_name,
	to_char(so.delivery_date,'dd/MM/yyyy') del_dt,
	concat(so.sales_order_type,'-',so.sales_order_no) so_no,
	sku.sku_no style_no,
	pt.product_type_name,
	sod.customer_jew_no cus_job_no,
	sod.customer_order_no cus_order_no,
	tfac.factory_name fac_name,
	ps.product_size,
	round(jt.qty,0) qty,
	jt.uom,
	null	quality,
	null	gemstone,
	sod.stamping_remarks,
	null	special_finish,
	sod.prod_remarks,
	null	barcode,
	null	qrcode,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',jt.company_id,'/sku/',jt.sku_id,sku.image_url)	image_url,
	jt.metal_weight,
	tlot.lot_code,
	sps.sp_name,
	fnd.fnd_name,
	dq.dia_qlity,
	cq.cs_qlity
from
	tbl_jewellery jt
	inner join tbl_company tcomp on jt.company_id = tcomp.company_id
	left join tbl_product_size ps on jt.product_size_id = ps.size_id
	left join tbl_state st on tcomp.state = st.state_code
	left join tbl_country tcountry on tcomp.country_id = tcountry.country_id
	left join tbl_sales_order_main so on jt.sales_order_id = so.sales_order_id
	left join tbl_sales_order_det sod on jt.sales_order_det_id = sod.sales_order_det_id
		and jt.sales_order_id = sod.sales_order_id
		and so.sales_order_id = sod.sales_order_id
	left join tbl_customer tcus on so.customer_id = tcus.customer_id
	left join tbl_sku sku on jt.sku_id = sku.sku_id
	left join tbl_product_type pt on jt.product_type_id = pt.product_type_id
	left join tbl_factory tfac on jt.factory_id = tfac.factory_id
	left join tbl_lot tlot on sod.metal_id = tlot.lot_id
	left join
		(
select
	sp.sales_order_id,
	sp.sales_order_det_id,
	string_agg(f.name,',') as sp_name
 from tbl_sales_order_special_finish sp
inner join tbl_special_finish f on sp.special_finish_id = f.special_finish_id
where sp.is_deleted = 0
group by
	sp.sales_order_id,
	sp.sales_order_det_id
		)sps on jt.sales_order_id = sps.sales_order_id and jt.sales_order_det_id = sps.sales_order_det_id
	left join (
select
	spf.sales_order_id,
	spf.sales_order_det_id,
	string_agg(spf.finding_name,',') as fnd_name
 from tbl_sales_order_finding spf
where spf.is_deleted = 0
group by
	spf.sales_order_id,
	spf.sales_order_det_id
		) fnd on jt.sales_order_id = fnd.sales_order_id and jt.sales_order_det_id = fnd.sales_order_det_id
	left join (
select
	sc.sales_order_id,
	sc.sales_order_det_id,
	string_agg(clr.clarity_name,',') as dia_qlity
 from tbl_sales_order_component sc
 inner join tbl_commodity tcom on sc.commodity_id = tcom.commodity_id
 inner join tbl_commodity_group cg on tcom.commodity_group_id = cg.commodity_group_id
 	and cg.commodity_group_type not in ('COLORSTONE','METAL','OTHERS')
  left join tbl_clarity clr on sc.clarity_id = clr.clarity_id
where sc.is_deleted = 0
group by
	sc.sales_order_id,
	sc.sales_order_det_id
		) dq on jt.sales_order_id = dq.sales_order_id and jt.sales_order_det_id = dq.sales_order_det_id
	left join (
select
	sc.sales_order_id,
	sc.sales_order_det_id,
	string_agg(clr.clarity_name,',') as cs_qlity
 from tbl_sales_order_component sc
 inner join tbl_commodity tcom on sc.commodity_id = tcom.commodity_id
 inner join tbl_commodity_group cg on tcom.commodity_group_id = cg.commodity_group_id
 	and cg.commodity_group_type  in ('COLORSTONE')
  left join tbl_clarity clr on sc.clarity_id = clr.clarity_id
where sc.is_deleted = 0
group by
	sc.sales_order_id,
	sc.sales_order_det_id
		) cq on jt.sales_order_id = cq.sales_order_id and jt.sales_order_det_id = cq.sales_order_det_id
where
	jt.is_deleted = 0
	and jt.jew_id in ($P!{i_inv_id})]]>
	</queryString>
