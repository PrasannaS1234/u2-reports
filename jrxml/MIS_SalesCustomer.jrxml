<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MISSalesCustomer" pageWidth="1368" pageHeight="595" orientation="Landscape" columnWidth="1328" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'dd/MM/yyyy'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tcus.customer_id,
    im.currency,
	max(tcus.display_name)	customer_code,
	max(tcus.customer_name)	customer_name,
	sum(id.inv_qty1)	sold_qty1,
	sum(0)	ret_qty1,
	sum(id.inv_qty1) - sum(0)	net_qty1,
	sum(id.inv_qty2) sold_qty2,
	sum(0)	ret_qty2,
	sum(id.input_amt)	sold_amt,
	sum(0)	ret_amt,
	sum(id.input_amt) - sum(0)	net_amt,
	sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end) sales_discount,
	sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end) ret_discount,
	sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end) -

	sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end) net_discount,
	sum(id.cost_price) sold_cost,
	sum(id.input_amt) - sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end) gross_sales_amt,

	sum(0)	- sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end) gross_ret_amt,

	(sum(id.input_amt) - sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end)) -
	(sum(0)	- sum(case
		when id.discount_type = 'PCT' then id.input_amt	* coalesce(id.discount_value,0) / 100
		else id.discount_value
	end)) total_sales_amt,
	round(sum(id.input_amt) - sum(id.cost_price), 2) margin_amt,
	round((sum(id.input_amt) - sum(id.cost_price)) / nullif(sum(id.input_amt),0),2) margin_pct
from
	tbl_sales_invoice_main im
	inner join tbl_company tcomp on im.company_id = tcomp.company_id
	inner join tbl_sales_invoice_det id on im.inv_id = id.inv_id
		and id.is_deleted = 0
	inner join tbl_customer tcus on im.customer_id = tcus.customer_id
	inner join tbl_lot prod on id.lot_id = prod.lot_id
where
	im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
	and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
group by
	tcus.customer_id,im.currency
order by tcus.customer_id,im.currency]]>
	</queryString>
