	</parameter>
	<queryString>
		<![CDATA[select
ROW_NUMBER() OVER (ORDER BY det.inv_det_id) AS s_no,
m.inv_id,
concat(m.inv_type,'-',m.inv_no) as inv_no,
m.inv_dt,
m.currency,
m.remarks,
m.reference_no,
lot.lot_code,
case when det.stone_size != 'NA' then det.stone_size else '' end as stone_size,
bin.bin_name,
det.qty1,
det.uom1,
det.qty2,
det.input_rate,
det.input_amt,
cus.customer_name
from tbl_rm_goods_inward m
inner join tbl_rm_goods_inward_det det on m.inv_id = det.inv_id and det.is_deleted = 0
inner join tbl_bin bin on det.bin_id = bin.bin_id
inner join tbl_lot lot on det.lot_id = lot.lot_id
left join tbl_customer cus on m.customer_id = cus.customer_id

where m.is_deleted = 0
and m.inv_id = $P!{i_inv_id}]]>
	</queryString>
	<field name="s_no" class="java.lang.Long"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.sql.Date"/>
	<field name="currency" class="java.lang.String"/>
	<field name="remarks" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="stone_size" class="java.lang.String"/>
	<field name="bin_name" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="input_rate" class="java.math.BigDecimal"/>
	<field name="input_amt" class="java.math.BigDecimal"/>
	<field name="customer_name" class="java.lang.String"/>
	<variable name="total_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty1}]]></variableExpression>
	</variable>
	<variable name="total_pcs" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty2}]]></variableExpression>
	</variable>
	<variable name="total_amt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
	</variable>
