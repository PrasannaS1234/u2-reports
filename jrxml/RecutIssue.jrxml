<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKK" pageWidth="378" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="368" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
          t.issue_id,
	comp.company_name,
	concat(t.issue_type,'-',t.issue_no) issue_no,
          t.issue_dt,
          t.recut_type,
          t.person_name,
          t.description,
          lot.lot_code,
          case when det.stone_size = 'NA' then '' else det.stone_size end as size,
          ROUND(det.qty1, 4) AS qty1,
          det.qty2,
          fac.factory_name
from
    tbl_recut_issue t
    inner join tbl_recut_issue_det det on t.issue_id = det.issue_id and det.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
    left join tbl_lot lot on det.lot_id = lot.lot_id
    left join tbl_factory fac on t.factory_id = fac.factory_id


where
      t.is_deleted = 0
    and t.issue_id = $P!{i_inv_id}
order by
  det.issue_det_id]]>
	</queryString>
	<field name="issue_id" class="java.lang.Integer"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="issue_no" class="java.lang.String"/>
	<field name="issue_dt" class="java.sql.Date"/>
	<field name="recut_type" class="java.lang.String"/>
