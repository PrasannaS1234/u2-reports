<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGSalesInvoiceFormat4" pageWidth="670" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1" uuid="f2820699-e1b8-44d5-94fe-b9505c485156">
		<parameter name="i_inv_id" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[with w_total_amt as (
select m1.charge_name,m1.input_amt,1 sort_seq from tbl_sales_invoice_chgs m1
where m1.is_deleted = 0
and m1.inv_id in ($P!{i_inv_id})
union all
select 'Total' charge_name,m.total_invoice_amount, 9999999 sort_seq from tbl_sales_invoice_main m
where m.is_deleted = 0
and m.inv_id in ($P!{i_inv_id})
)
select 'Exchange Rate' charge_name,m.exchange_rate amt, 99999999 sort_seq
from tbl_sales_invoice_main m
where m.is_deleted = 0
and m.inv_id in ($P!{i_inv_id})
union all
select 'Balance' charge_name, sum(w.input_amt) +sum(m.exchange_rate) amt , 999999999 sort_seq
from tbl_sales_invoice_main m
inner join w_total_amt w on 1 = 1
where m.is_deleted = 0
and m.inv_id in ($P!{i_inv_id})
order by sort_seq]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
		<field name="sort_seq" class="java.lang.Integer"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by dt.jew_id) srno,
	im.inv_id,
	max(im.inv_type||im.inv_no) invoive_no,
    max(im.currency) currency,
	max(im.exchange_rate) exchange_rate,
    max(to_char(im.inv_dt, $P{dateFormat})) invoice_dt,
    max(to_char(im.inv_due_dt, $P{dateFormat}))     invoice_due_dt,
    max(jt.jew_type||jt.jew_no) jew_no,
	upper(max(cmp.company_name)) company_name,
	max(concat(cmp.street,',',cmp.area)) company_address1,
	max(concat(cmp.city,',',cmp.state,'-',cmp.pin_code,',',cnt.country_name)) company_address2,
	max(concat('Tel : ',cmp.phone_number,' ','Fax :',cmp.fax_no)) company_address3,
	max(cus.customer_name) customer_name,
	max(im.ship_address1) ship_address1,
	max(concat(im.ship_city,',',im.ship_state,'-',im.ship_pincode)) ship_address2,
	max(im.ship_country) ship_address3,
	max(im.bill_address1) bill_address1,
	max(concat(im.bill_city,',',im.bill_state,'-',im.bill_pincode)) bill_address2,
	max(im.bill_country) bill_address3,
	max(dt.prod_description) prod_description,
	max(dt.inv_qty) inv_qty,
	max(lt.lot_code) metal_lot,
	round(max(dt.input_rate),2) input_rate,
	round(max(dt.input_amt),2) input_amt,
	sum(case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') then jc.total_qty1 else 0 end) dia_qty,
	sum(case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL') then jc.total_qty1 else 0 end) cs_qty,
	sum(case when cmg.commodity_group_type in ('METAL') then jc.total_qty1 else 0 end) metal_qty,
	round(max(jt.cost_price),2) tag_price,
max(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)) image_url
from tbl_jew_sales_invoice_main im
inner join tbl_jew_sales_invoice_det dt on im.inv_id = dt.inv_id
	and dt.is_deleted = 0
inner join tbl_jewellery jt on dt.jew_id =jt.jew_id
inner join tbl_sku sku on jt.sku_id = sku.sku_id
inner join tbl_company cmp on im.company_id = cmp.company_id
inner join tbl_country cnt on cmp.country_id = cnt.country_id
inner join tbl_customer cus on im.customer_id = cus.customer_id
left join tbl_jewellery_component jc on jt.jew_id =jc.jew_id
LEFT JOIN tbl_commodity cm ON jc.commodity_id = cm.commodity_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
left join tbl_lot lt on jt.metal_id = lt.lot_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
group by
    im.inv_id,
    dt.jew_id]]>
	</queryString>
