	<queryString>
		<![CDATA[select
ROW_NUMBER() OVER (ORDER BY d.inv_det_id) AS sno,
m.inv_id,
concat(m.inv_type,'-',m.inv_no) inv_no,
m.reference_no,
m.inv_dt,
f.factory_name,
dep.department_name,
e.first_name,
concat(tre.inv_type,'-',tre.inv_no) wax_tree_no,
lot.lot_code main_lot,
l.lot_code,
b.bin_name,
d.issue_qty1,
d.issue_qty2,
round(d.issue_qty1/ m.issue_wt*100,2) issue_percent,
m.remarks,
l.impure_to_pure_conv_factor,
case when  com.commodity_name <> 'ALLOY'  AND com.METAL_TYPE <> 'OTHERS' then (d.issue_qty1 * l.impure_to_pure_conv_factor) else 0 end  pure_24k,
case when com.metal_type = 'OTHERS' then (d.issue_qty1*l.impure_to_pure_conv_factor) else (d.issue_qty1 -(d.issue_qty1 * l.impure_to_pure_conv_factor)) end as alloy
from tbl_mfg_casting_issue m
inner join tbl_mfg_casting_issue_det d on m.inv_id = d.inv_id
and d.is_deleted =0
left join tbl_factory f on m.factory_id = f.factory_id
and f.is_deleted =0
left join tbl_department dep on m.department_id = dep.department_id
and d.is_deleted = 0
left join tbl_employee e on m.employee_id = e.employee_id
and e.is_deleted = 0
left join tbl_mfg_wax_tree tre on m.wax_tree_id = tre.inv_id
and tre.is_deleted =0
left join tbl_lot lot on m.main_lot_id = lot.lot_id
left join tbl_lot l on d.lot_id = l.lot_id
left join tbl_commodity com on l.commodity_id = com.commodity_id
left join tbl_bin b on d.bin_id = b.bin_id
and b.is_deleted =0
where
m.inv_id = $P!{i_inv_id};]]>
	</queryString>
