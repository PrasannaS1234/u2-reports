	<property name="ireport.zoom" value="1.098075000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="accountName" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	 t.invoiceNo,
	 to_char(t.inv_dt,'dd/mm/yyyy') inv_dt,
           t.currency,
	 t.exchange_rate,
	 t.account_name,
	 t.bill_no,
	 to_char(t.bill_dt,'dd/mm/yyyy') bill_dt,
	 to_char(t.bill_due_dt,'dd/mm/yyyy') bill_due_dt,
	 t.amount,
	 t.settled_amount,
           t.amount - t.settled_amount balance_amount
from
	v_account_creditors as t
where
	(t.amount - t.settled_amount) > 0
	and t.inv_dt <= to_date($P{toDate}, $P{dateFormat})
	and (lower(t.account_name) like concat(lower(trim($P!{accountName})),'%%'))
order by
    t.seq,t.inv_dt;]]>
	</queryString>
	<field name="invoiceno" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="account_name" class="java.lang.String"/>
	<field name="bill_no" class="java.lang.String"/>
	<field name="bill_dt" class="java.lang.String"/>
	<field name="bill_due_dt" class="java.lang.String"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="settled_amount" class="java.math.BigDecimal"/>
	<field name="balance_amount" class="java.math.BigDecimal"/>
	<variable name="amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="settled_amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{settled_amount}]]></variableExpression>
	</variable>
	<variable name="balance_amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_amount}]]></variableExpression>
	</variable>
