<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGPurchaseInvoicewithImageSuraj" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="575" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="9ad6d883-1638-4ddd-b4d4-9debcc20f6c2">
	<property name="ireport.zoom" value="1.2100000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1" uuid="b6d6bac8-dbc8-426e-a60e-44634517d6c0">
		<parameter name="invId" class="java.lang.String"/>
		<queryString>
			<![CDATA[select

			max(chgs.charge_name) charge_name,
			sum(chgs.plus_minus_flag * case when 0 < 0 then -1 else 1 end * chgs.input_amt) othamt
		from
			tbl_jew_sales_invoice_chgs chgs
		where
			1 = 1
			and chgs.inv_id =  $P!{invId}
			and chgs.is_deleted = 0
		group by
			chgs.inv_id,
			chgs.charge_id
		 having sum(chgs.plus_minus_flag * chgs.input_amt) <> 0]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="othamt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\Tekfilo\\jasper-reports\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with base as(
SELECT
    ROW_NUMBER() OVER (PARTITION BY im.inv_id ORDER BY id.inv_det_id ASC) AS sno,
	im.inv_id,
    id.inv_det_id,
    tcomp.company_name AS company_name,
    COALESCE(
        NULLIF(fn_get_customer_invoice_no(im.inv_type, im.inv_id), ''),
        concat(im.inv_type, '-', im.inv_no)) AS inv_type_no,
    TO_CHAR(im.inv_dt, COALESCE(tcomp.date_format, 'dd/MM/yyyy')) AS inv_dt,
	tcus.display_name customer_dis_name,
          tcus.customer_name customer_name,
	addr.country,
    addr.state,
    addr.ph_no,
    im.reference_no,
    to_char(im.inv_due_dt, COALESCE(tcomp.date_format, 'dd/MM/yyyy'))inv_due_dt,
    TO_CHAR(im.created_dt, 'HH:MI:SSPM') AS tme,
	concat(emp.first_name,' ',emp.last_name) as sales_man,
    concat(prp.first_name,' ',prp.last_name) as prepare_by,
	COALESCE(NULLIF(id.prod_description, ''), pt.product_type_name) AS description,
	CONCAT(j.jew_type, j.jew_no) AS jew_no,
    c.currency_code,
    s.sku_no,
    metal.impure_to_pure_conv_factor purity,
    j.gross_wt,
    j.net_wt,
    id.inv_qty,
    id.input_rate as rate_per_gms,
	(id.inv_qty * id.input_rate) total_value_usd,
    im.total_invoice_net_amount,
	payment.received_amount,
    case
  when coalesce(length(trim(j.image_url)),0) > 0 then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',j.company_id,'/jewellery/',j.jew_id,j.image_url)
		else concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url)
	end image_url,
    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo,
ps.product_size,
case
                when metal.lot_type = 'METAL'
                then metal.lot_code
            end as metal,
lab.lab,
j.jew_id

FROM tbl_jew_sales_invoice_main im
INNER JOIN tbl_jew_sales_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
left join tbl_currency c on im.currency = c.currency_code
and c.is_deleted = 0
INNER JOIN tbl_jewellery j ON id.jew_id = j.jew_id AND j.is_deleted = 0

LEFT JOIN (
        SELECT DISTINCT ON (jc.jew_id)
               jc.jew_id,
               jc.pp_rate,
               l.impure_to_pure_conv_factor AS purity
        FROM tbl_jewellery_component jc
        LEFT JOIN tbl_lot l
            ON jc.lot_id = l.lot_id
           AND l.is_deleted = 0
and l.lot_type = 'METAL'
        ORDER BY jc.jew_id
    ) tj ON j.jew_id = tj.jew_id


left join (
select jew_id,
max(lab_name) lab
from tbl_jewel_certificate
where is_deleted =0
group by jew_id) lab on j.jew_id = lab.jew_id

left join tbl_product_type pt on j.product_type_id = pt.product_type_id and pt.is_deleted =0
left join tbl_product_size ps on ps.size_id = j.product_size_id
LEFT JOIN tbl_employee emp on emp.employee_id = im.salesman_id and emp.is_deleted = 0
left join tbl_user prp on im.created_by = prp.user_id and prp.is_deleted=0
INNER JOIN tbl_sku s ON j.sku_id = s.sku_id and s.is_deleted = 0
LEFT JOIN tbl_lot metal ON j.metal_id = metal.lot_id AND metal.is_deleted = 0
LEFT JOIN tbl_country tcou ON tcomp.country_id = tcou.country_id
LEFT JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
LEFT JOIN (
    SELECT DISTINCT ON (a.customer_id)
        a.customer_id,
        a.country,
        a.state,
        a.primary_contact_no ph_no
    FROM tbl_customer_address a
    WHERE a.is_deleted = 0
      AND a.default_address = 1
    ORDER BY a.customer_id, a.address_id DESC
) addr
    ON addr.customer_id = tcus.customer_id
left join (
	select
		p.inv_id,
		sum(p.received_amount) as received_amount
		from tbl_payment_received_det p
		inner join tbl_payment_received_main pm on p.payment_id = pm.payment_id
		and pm.is_deleted =0
		where p.is_deleted = 0
		group by p.inv_id
	)payment on payment.inv_id = im.inv_id
LEFT JOIN tbl_payment_type pyt ON im.payment_type_id = pyt.payment_type_id
WHERE im.is_deleted = 0
AND im.inv_id IN ($P!{i_inv_id})
ORDER BY id.inv_det_id ASC
)
SELECT
    base.*,
    MAX(base.total_invoice_net_amount) OVER (PARTITION BY base.inv_id) AS inv_total_usd,
	ROUND(TRUNC((max(base.total_invoice_net_amount) OVER (PARTITION BY base.inv_id)), 0),2)  AS inv_total_usd_roundoff,
    ROUND((max(base.total_invoice_net_amount) OVER (PARTITION BY base.inv_id)) - TRUNC((max(base.total_invoice_net_amount) OVER (PARTITION BY base.inv_id)), 0), 2)   AS amount_decimal,
   COALESCE(
    fn_amount_to_words(
        FLOOR(
            max(base.total_invoice_net_amount) OVER (PARTITION BY base.inv_id)
        ),
        ''::varchar,
        '',
        ''
    ) || ' only',
    ''
) AS inv_total_words
FROM base
ORDER BY base.inv_id, base.sno;]]>
	</queryString>
