	<field name="amount_decimal" class="java.math.BigDecimal"/>
	<field name="inv_total_words" class="java.lang.String"/>
	<variable name="gross_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="net_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{net_wt}]]></variableExpression>
	</variable>
	<variable name="inv_qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty}]]></variableExpression>
	</variable>
	<variable name="sales_price_tot" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_value_usd}]]></variableExpression>
	</variable>
