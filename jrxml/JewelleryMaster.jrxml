	</parameter>
	<parameter name="mm_size" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="dia_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="dia_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="cs_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="cs_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="met_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="met_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="sku_nos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="product_type_Ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodity_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="job_nos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by jlt.jew_id) sno,
    jlt.jew_id,
    max(concat(jlt.jew_type,jlt.jew_no)) job_no,
    max(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)) image_url,
    max(sku.sku_no) sku_no,
    max(pt.product_type_name) product_type_name,
    max(sku.factory_ref_no) factory_ref_no,
    max(fac.factory_name) factory_name,
    max(cmp.company_name) company_name,
    sum(jlt.cost_price) cost_price
from
    tbl_jewellery jlt
    inner join tbl_sku sku on jlt.sku_id = sku.sku_id
    inner join tbl_product_type pt on sku.product_type_id = pt.product_type_id
    inner join tbl_company cmp on sku.company_id = cmp.company_id
    left join tbl_factory fac on sku.factory_id = fac.factory_id
    left join tbl_jewellery_component jltc on jltc.jew_id = jlt.jew_id
    left join tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
    left join tbl_shape shp ON jltc.shape_id = shp.shape_id
    left join tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
where
    jlt.is_deleted = 0
    and jltc.is_deleted = 0
    and (concat(jlt.jew_type,jlt.jew_no) in ($P!{job_nos}) or ' ' in ($P!{job_nos}))
    and (sku.sku_no in ($P!{sku_nos}) or ' ' in ($P!{sku_nos}))
	and (sku.product_type_id in ($P!{product_type_Ids}) or - 1 in ($P!{product_type_Ids}))
	and (jltc.commodity_id in ($P!{commodity_ids}) or - 1 in ($P!{commodity_ids}))
	and (jltc.shape_id in ($P!{shape_ids}) or - 1 in ($P!{shape_ids}))
	and (jltc.mm_size in ($P!{mm_size}) or ' ' in ($P!{mm_size}))
	and (jltc.sieve_size in ($P!{sieve_size}) or ' ' in ($P!{sieve_size}))
	and ((case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') then jltc.total_qty1 else $P!{dia_wt_from} end) >= -1 or -1 = ($P!{dia_wt_from}))
	and ((case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') then jltc.total_qty1 else $P!{dia_wt_from} end) <= -1 or -1 = ($P!{dia_wt_to}))
	and ((case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL') then jltc.total_qty1 else $P!{cs_wt_from} end) >= -1 or -1 = ($P!{cs_wt_from}))
	and ((case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL') then jltc.total_qty1 else $P!{cs_wt_from} end) <= -1 or -1 = ($P!{cs_wt_to}))
	and ((case when cmg.commodity_group_type in ('METAL') then jltc.total_qty1 else $P!{met_wt_from} end) >= -1 or -1 = ($P!{met_wt_from}))
	and ((case when cmg.commodity_group_type in ('METAL') then jltc.total_qty1 else $P!{met_wt_to} end) <= -1 or -1 = ($P!{met_wt_to}))
group by
   jlt.jew_id
order by
   jlt.jew_id]]>
	</queryString>
