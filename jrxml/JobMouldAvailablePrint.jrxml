				<staticText>
					<reportElement stretchType="RelativeToTallestObject" x="916" y="60" width="50" height="20" isPrintWhenDetailOverflows="true" uuid="5fee5d81-4cd4-438c-ab8f-20c7b74a8bc0"/>
					<box leftPadding="2" rightPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
