<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobCADPrint" pageWidth="1350" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1340" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="157"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="component" uuid="93dc6e20-dc0c-4fd2-bfc7-81dc648e8986">
		<parameter name="jobid" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.component_id,
		 tsc.sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.jew_id,
		 tsc.tot_qty,
		 tsc.qty1,
		 tsc.qty2,
		 round(case when tsc.qty2 > 0 then tsc.tot_qty / tsc.qty2 else 0 end,3) per_pc_wt
	FROM
		 tbl_sales_order_component tsc
		 inner join tbl_sales_order_det tsd on tsc.sales_order_det_id = tsd.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_jewellery j on tsd.sales_order_det_id = j.sales_order_det_id
			and tsd.is_deleted = 0
	WHERE
		 tsc.is_deleted = 0
		 and j.jew_id = $P!{jobid}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pc_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,9) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
		<group name="component_id">
			<groupExpression><![CDATA[$F{component_id}]]></groupExpression>
		</group>
		<group name="sales_order_det_id">
			<groupExpression><![CDATA[$F{sales_order_det_id}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_job_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[" "]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select job.jew_id,
	s.sku_id,
	COALESCE(nullif(concat(bag.bag_type,bag.bag_no),''), concat(job.jew_type,job.jew_no)) bag_type_no,
	COALESCE(bag.bag_qty, job.qty) bag_qty,
	s.sku_no,
	s.customer_ref_no,
	comp.company_name,
	to_char(CURRENT_DATE, 'dd/Month/yyyy') print_time,
	p.product_type_name,
	ps.product_size,
	COALESCE(COALESCE(bag.customer_bag_order_no,sod.customer_order_no),'') customer_order_no,
	COALESCE(som.reference_no, '') reference_no,
	m.mould_no,
	m.rack_no,
	m.shop_name,
	coll.collection_name,
	pc.cam_wt,
	pc.casting_wt,
    pc.cad_wt,
	swj.wax_wt,
	round(bag.bag_qty * (COALESCE(swj.wax_wt,0)),3) total_wax_wt,
    round((bag.bag_qty * (COALESCE(swj.wax_wt,0))) * 18,3) gold_wt,
	sod.metal_wt shipment_weight,
	srw.screw_no,
	null br_rack_no,
	null br_mould_no,
	0 br_wax_wt,
	0 br_gold_wt,
	sc.tot_qty,
    sc.qty1,
	sc.qty2,
	round(case when sc.qty2 > 0 then sc.tot_qty / sc.qty2 else 0 end,3) per_pcs_wt,
	m.screw_weight,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url,
	wax_stock.bal_qty
from
    tbl_jewellery job
    left join tbl_mfg_bag bag on job.jew_id = bag.job_id
    inner join tbl_sales_order_det sod on job.sales_order_det_id = sod.sales_order_det_id
	inner join tbl_sales_order_main som on sod.sales_order_id = som.sales_order_id
    inner join tbl_company comp on job.company_id = comp.company_id
    inner join tbl_sku s on job.sku_id = s.sku_id
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
    left join tbl_collection coll on s.collection_id = coll.collection_id
	left join tbl_sku_mould m on s.sku_id = m.sku_id
		and m.is_deleted  = 0
	left join tbl_screw srw on sod.screw_id = srw.screw_id
		and srw.is_deleted = 0
	left join(
		select sjob.jew_id, sum(sw.wax_wt) wax_wt
		 from    tbl_jewellery sjob
		inner join tbl_sku_wax sw on sjob.sku_id = sw.sku_id
		 where sw.is_deleted  = 0
		 and (sjob.jew_id) in ($P!{i_job_id})
		 group by sjob.jew_id
	)swj on job.jew_id = swj.jew_id
    left join(
		select sjob.jew_id, sum(c.tot_qty) tot_qty, sum(c.qty1) qty1, sum(c.qty2) qty2
		 from    tbl_jewellery sjob
		inner join tbl_sales_order_component c on sjob.sales_order_det_id = c.sales_order_det_id
		 where c.is_deleted  = 0
		 and (sjob.jew_id) in ($P!{i_job_id})
		 group by sjob.jew_id
	)sc on job.jew_id = sc.jew_id
	left join(
			select
			jm.job_id,
			max(case when upper(dp.process_name) = 'CASTING' then jm.output_weight else 0 end) casting_wt,
			max(case when upper(dp.process_name) = 'CAM' then jm.output_weight else 0 end) cam_wt,
			max(case when upper(dp.process_name) = 'CAD' then jm.output_weight else 0 end) cad_wt
		 	from tbl_mfg_job_metal_weight_calculation jm
		    inner join tbl_process dp on jm.process_id = dp.process_id
		    where (jm.job_id) in ($P!{i_job_id})
		    group by jm.job_id
    )pc on job.jew_id = pc.job_id
	left join (
		select sku_id, sum(in_qty - out_qty) bal_qty from (
		select sku_id, sum(wax_pcs) in_qty, 0 out_qty from tbl_mfg_wax_inward
		where is_deleted = 0
		group by sku_id
		union all
		select sku_id, 0 in_qty, sum(wax_pcs) out_qty from tbl_mfg_wax_outward
		where is_deleted = 0
		group by sku_id
		)tx group by sku_id
	)wax_stock on s.sku_id = wax_stock.sku_id
	left join tbl_product_size ps on job.product_size_id = ps.size_id
where
	s.is_deleted = 0
	and (job.jew_id) in ($P!{i_job_id})]]>
	</queryString>
