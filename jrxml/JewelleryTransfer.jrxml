	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  ROW_NUMBER() OVER (ORDER BY d.transfer_det_id) AS s_no,
  concat(t.transfer_type,t.transfer_no) as transfer_no,
  t.reference_no,
  t.transfer_dt,
  t.status,
  t.description,
  t.remarks,
  t.system_remarks,
  concat(j.jew_type,j.jew_no) as jew_no,
  concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo,
  d.qty,
  d.uom,
  1 pc,
  s.sku_no,
  case when d.remarks is not null then d.remarks
  else j.description end AS det_remarks,
  prd.product_type_name,
  d.system_remarks AS det_system_remarks,
  source_bin.bin_name AS source_bin_name,
  dest_bin.bin_name AS dest_bin_name,
  concat(prp.first_name,' ',prp.last_name) as prepare_by,
case when j.image_url is not null  and j.image_url != '' then
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',j.company_id,'/jewellery/',j.jew_id,j.image_url)
when s.image_url is not null then concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) end as image_url
FROM
  tbl_jew_bin_transfer t
  JOIN tbl_jew_bin_transfer_det d ON t.transfer_id = d.transfer_id and d.is_deleted = 0
  LEFT JOIN tbl_bin source_bin ON d.source_bin_id = source_bin.bin_id
  LEFT JOIN tbl_bin dest_bin ON d.dest_bin_id = dest_bin.bin_id
  inner join tbl_jewellery j on d.jew_id = j.jew_id
  left join tbl_product_type prd on j.product_type_id = prd.product_type_id
  inner join tbl_sku s on j.sku_id = s.sku_id
  INNER JOIN tbl_company tcomp ON t.company_id = tcomp.company_id
  left join tbl_user prp on t.created_by = prp.user_id and prp.is_deleted=0
where t.transfer_id = $P!{i_inv_id}
and t.is_deleted = 0]]>
	</queryString>
