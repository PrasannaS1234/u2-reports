<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MaterialDemand" pageWidth="670" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
m.inv_id,
concat(m.inv_type,'-',m.inv_no) invTypNo,
to_char(m.inv_date, $P{dateFormat}) order_date,
to_char(m.delivery_date, $P{dateFormat}) delivery_date,
sup.supplier_name,
cmd.commodity_name,
shp.shape_name,
d.sieve,
d.mm_size,
clr.color_name,
clt.clarity_name,
d.qty1,
d.qty2
from tbl_material_demand_main m
inner join tbl_material_demand_det d on m.inv_id =d.inv_id
     and d.is_deleted = 0
left join tbl_supplier sup on m.supplier_id = sup.supplier_id
left join tbl_commodity cmd on d.commodity_id = cmd.commodity_id
left join tbl_shape shp on d.shape_id = shp.shape_id
left join tbl_color clr on d.color_id = clr.color_id
left join tbl_clarity clt on clt.clarity_id = d.clarity_id
where
     m.inv_id in ($P!{i_inv_id})
     and m.is_deleted = 0]]>
	</queryString>
