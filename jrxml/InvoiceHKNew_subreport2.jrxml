	<field name="diamond_group" class="java.lang.String"/>
	<field name="r7_11" class="java.math.BigDecimal"/>
	<field name="r7plus11" class="java.math.BigDecimal"/>
	<field name="r9_11" class="java.math.BigDecimal"/>
	<field name="r9plus11" class="java.math.BigDecimal"/>
	<field name="pc" class="java.math.BigDecimal"/>
	<field name="uom" class="java.lang.String"/>
