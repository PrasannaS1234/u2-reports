<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InvoiceHKNew_subreport2" pageWidth="150" pageHeight="842" columnWidth="150" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="40377b25-57dd-4a81-9f0f-dab7fb64342f">
	<property name="ireport.zoom" value="2.1435888100000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    t1.inv_id,
    lot.group_type                         AS diamond_group,
	sum(case when com.metal_type = 'DIAMOND' and lot.group_type = 'R7-11'  then c.balance_qty1 else 0 end) as r7_11,
        sum(case when com.metal_type = 'DIAMOND' and lot.group_type = 'R7+11'  then c.balance_qty1 else 0 end) as r7plus11,
        sum(case when com.metal_type = 'DIAMOND' and lot.group_type = 'R9-11'  then c.balance_qty1 else 0 end) as r9_11,
        sum(case when com.metal_type = 'DIAMOND' and lot.group_type = 'R9+11'  then c.balance_qty1 else 0 end) as r9plus11,
        sum(case when com.metal_type = 'DIAMOND' and lot.group_type = 'PC'     then c.balance_qty1 else 0 end) as pc,
    max(c.uom1)                              AS uom
    FROM tbl_invoice_hk_summary t1
    left join tbl_mfg_bag bag on t1.bag_id = bag.bag_id
	and bag.is_deleted = 0
	left join tbl_mfg_bag_component c on c.bag_id = bag.bag_id
	and c.is_deleted =0
	left join tbl_lot lot on c.lot_id = lot.lot_id
	and lot.is_deleted =0
	left join tbl_commodity com on lot.commodity_id = com.commodity_id
	and com.is_deleted = 0
WHERE com.metal_type = 'DIAMOND'
and t1.inv_id in ($P!{invId})
GROUP BY
    lot.group_type,
    t1.inv_id
ORDER BY
    lot.group_type]]>
	</queryString>
