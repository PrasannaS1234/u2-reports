<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HKDeliveryNoteSummary" pageWidth="785" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="785" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c61a544a-3e23-400a-89f7-2b62d256624e">
	<property name="ireport.zoom" value="1.5000000000000024"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="number_color">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{total_metal_wt}.doubleValue() < 0]]></conditionExpression>
			<style forecolor="#FF0000">
				<pen lineColor="#000000"/>
			</style>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{total_metal_wt}.doubleValue() >= 0]]></conditionExpression>
			<style/>
		</conditionalStyle>
	</style>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\GITHUB\\tekfilo-connectx-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerName" class="java.lang.String">
		<defaultValueExpression><![CDATA["'Simon G'"]]></defaultValueExpression>
	</parameter>
	<parameter name="invGroup" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewType" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over() sr_no,
	max(case
		    when kt_22_count > 0 and kt_18_count > 0 and kt_14_count > 0 then '22K & 14K & 18K Diamond Jewellery'
			when kt_22_count > 0 and kt_18_count > 0 and kt_14_count = 0 then '22K & 18K Diamond Jewellery'
			when kt_22_count > 0 and kt_18_count = 0 and kt_14_count > 0 then '22K & 14K Diamond Jewellery'
			when kt_18_count > 0 and kt_14_count > 0 then '14K & 18K Diamond Jewellery'
			when kt_18_count > 0 and kt_14_count = 0 then '18K Diamond Jewellery'
			when kt_18_count = 0 and kt_14_count > 0 then '14K Diamond Jewellery'
			when kt_22_count > 0 and kt_18_count = 0 and kt_14_count = 0 then '22K Diamond Jewellery'
	 	else concat(summ.metal_kt,' ','Diamond Jewellery')
	 end) c1,
	 --concat('Harmonized Code 7113 1911',' ','Tariff Code 7113.19.5090') c2,
	 max(case
			when kt_18_count > 0 and kt_14_count > 0 then concat('Harmonized Code 7113 1911',' ','Tariff Code 7113.19.5090')
			when kt_18_count > 0 and kt_14_count = 0 then concat('Harmonized Code 7113 1911',' ','Tariff Code 7113.19.5090')
			when kt_18_count = 0 and kt_14_count > 0 then concat('Harmonized Code 7113 1911',' ','Tariff Code 7113.19.5090')
	 	else concat('Harmonized Code 7113 1921',' ','Tariff Code 7113.19.5090')
	 end) c2,
	 round(sum(tsumm.tot_met_wt),2)	c3,
	 sum(summ.qty)	c4,
	 sum(total_amount_intl)	c5
from
(
	SELECT
		t2.inv_id,
		t1.bag_id,
		max(case
			when (upper(t1.commodity) like '%18K%')  then '18K'
			when (upper(t1.commodity) like '%14K%')  then '14K'
			when (upper(t1.commodity) like '%22K%')  then '22K'
			when (upper(t1.commodity) like '%PT950%')  then 'PT950'
			when (upper(t1.commodity) like '%PT925%')  then 'PT925'
			when (upper(t1.commodity) like '%PT%')  then 'PT950'
			when (upper(t1.commodity) like '%SIL950%') then 'SIL950'
			when (upper(t1.commodity) like '%SIL925%')  then 'SIL925'
			when (upper(t1.commodity) like '%SIL%')   then 'SIL950'
			else t1.commodity
		end) metal_kt,
		max(case
			when (upper(t1.commodity) like '%18K%')  then 1
			else 0
		end) kt_18_count,
		max(case
			when (upper(t1.commodity) like '%14K%')  then 1
			else 0
		end) kt_14_count,
		max(case
			when (upper(t1.commodity) like '%22K%')  then 1
			else 0
		end) kt_22_count,
		round((max(t2.total_amount_intl) * 0.33) / 5,0) * 5 total_amount_intl,
		max(t2.qty) qty
	FROM
		tbl_invoice_hk_breakup t1
		inner join tbl_invoice_hk_summary t2 on t1.inv_id = t2.inv_id
			and t1.bag_id = t2.bag_id
	where
		t1.is_deleted = 0
		and t1.inv_id = $P!{invId}
		and t1.metal_type = 'M'
	group by
		t2.inv_id,
		t1.bag_id
) summ
left join
(
	select
		br.inv_id,
		br.bag_id,
		round(sum(case when metal_type = 'M' then wt
			 when metal_type not in ('Labour','Z','M') then wt * 0.2
			else 0 end),2) tot_met_wt
	from tbl_invoice_hk_breakup br
			inner join tbl_invoice_hk_summary t2 on br.inv_id = t2.inv_id
			and br.bag_id = t2.bag_id
			and t2.is_deleted = 0
	where
		br.inv_id = $P!{invId}
		and br.metal_type not in ('Labour','Z')
		and br.is_deleted = 0
	group by
		br.inv_id,
		br.bag_id
) tsumm on summ.inv_id = tsumm.inv_id and
		summ.bag_id = tsumm.bag_id
group by
	summ.metal_kt]]>
	</queryString>
	<field name="sr_no" class="java.lang.Long"/>
	<field name="c1" class="java.lang.String"/>
	<field name="c2" class="java.lang.String"/>
	<field name="c3" class="java.math.BigDecimal"/>
	<field name="c4" class="java.math.BigDecimal"/>
	<field name="c5" class="java.math.BigDecimal"/>
