<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Cost_sheet" pageWidth="1312" pageHeight="842" columnWidth="1302" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.1269722013523664"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\Tekfilo\\jasper-reports\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY psm.inv_id) AS sno,
    pfd.inv_det_id,
	jew.jew_id,
    psm.customer_id,
    psm.currency,
    max(pfm.reference_no) reference_no,
    MAX(psd.inv_qty) AS inv_qty,
    STRING_AGG(DISTINCT lot.lot_code, ' + ') AS lot_code,
    max(sku.sku_no) sku_no,
    MAX(t.company_name) AS company_name,
    STRING_AGG(
        DISTINCT CONCAT(
            CASE WHEN lot.lot_type = 'STONE' THEN lot.lot_code ELSE '' END,
            '/',
            COALESCE(cut.cut_code, ''),
            '/',
            COALESCE(shape.shape_code, ''),
            '*',
            COALESCE(lot.mm_size, '')
        ),
        ', '
    ) AS tag_details,

    -- pick one valid image
       max(CASE
      WHEN coalesce(length(trim(jew.image_url)),0) > 0 THEN
        concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',t.company_id,'/jewellery/',jew.jew_id,jew.image_url)
     else
        concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',t.company_id,'/sku/',sku.sku_id,sku.image_url)
     END) AS img_url
FROM tbl_jew_proforma_sales_invoice_main psm
inner join tbl_jew_proforma_sales_invoice_det psd on psm.inv_id = psd.inv_id and psd.is_deleted = 0
INNER JOIN tbl_proforma_factory_invoice_det pfd ON psd.jew_id = pfd.jew_id AND pfd.is_deleted = 0
INNER JOIN tbl_proforma_factory_invoice_component pfc on pfd.inv_det_id = pfc.inv_det_id
inner join tbl_proforma_factory_invoice_main pfm on pfd.inv_id = pfm.inv_id
LEFT JOIN tbl_jewellery jew
    ON psd.jew_id = jew.jew_id AND jew.is_deleted = 0
LEFT JOIN tbl_lot lot ON pfc.lot_id = lot.lot_id AND lot.lot_type = 'METAL'
LEFT JOIN tbl_cut cut ON lot.cut_id = cut.cut_id AND cut.is_deleted = 0
	LEFT JOIN tbl_shape shape
    ON lot.shape_id = shape.shape_id AND shape.is_deleted = 0
LEFT JOIN tbl_sku sku
    ON jew.sku_id = sku.sku_id AND sku.is_deleted = 0
LEFT JOIN tbl_commodity com
    ON lot.commodity_id = com.commodity_id AND com.is_deleted = 0
LEFT JOIN tbl_company t
    ON psm.company_id = t.company_id AND t.is_deleted = 0

WHERE psm.inv_id = $P!{i_inv_id}

GROUP BY
    pfm.inv_id,
    psm.inv_id,
    pfd.inv_det_id,
    jew.jew_id
ORDER BY pfm.inv_id;]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="customer_id" class="java.lang.Integer"/>
	<field name="currency" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="inv_qty" class="java.math.BigDecimal"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="tag_details" class="java.lang.String"/>
	<field name="img_url" class="java.lang.String"/>
	<variable name="qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[]]></variableExpression>
	</variable>
