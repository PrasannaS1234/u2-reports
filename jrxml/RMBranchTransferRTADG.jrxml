	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.transfer_id,
	row_number() over (partition by t.transfer_id order by com.commodity_name asc,shape.shape_name asc,det.mm_size asc)sno,
	concat(t.transfer_type,'-',t.transfer_no) inv_type_no,
	to_char(t.transfer_dt,'dd/MM/yyyy') inv_dt,
	sb.display_name from_company_name,
	concat(sb.street,',',sb.area) from_area,
	concat(sb.city,',',sb.state,',',sbc.country_name,',',sb.pin_code) from_city,
	concat('Phone: ',sb.phone_number,'  Fax: ', sb.fax_no) from_phone_no,
          concat(det.qty1,' ',det.uom1) qty1uom,
	db.company_name to_company_name,
	concat(db.street,',',db.area) to_area,
	concat(db.city,',',db.state,',',dbc.country_name,',',db.pin_code) to_city,
	concat('Phone: ',db.phone_number,'  Fax: ', db.fax_no) to_no,
	b.bin_name,
	lot.lot_code,
          NULLIF(det.stone_size, 'NA') size,
          NULLIF(det.mm_size, 'NA') mm_size,
          NULLIF(det.sieve_size, 'NA') sieve_size,
          NULLIF(shape.shape_name, 'NA') shap,
	com.commodity_name,
	det.description,
	det.qty1,
          det.uom1,
	det.qty2,
          det.input_amt,
	t.remarks,
          t.reference_no,
          f.factory_name,
          case when det.uom1 = 'GM' then det.qty1 else 0 end as qty_gm,
          case when det.uom1 = 'CT' then det.qty1 else 0 end as qty_ct

from
	tbl_rm_branch_transfer t
	inner join tbl_rm_branch_transfer_det det on t.transfer_id = det.transfer_id
		and det.is_deleted = 0
	inner join tbl_bin b on t.source_bin_id = b.bin_id
	inner join tbl_company db on t.dest_branch_id = db.company_id
	inner join tbl_lot lot on det.lot_id = lot.lot_id
	inner join tbl_commodity com on lot.commodity_id = com.commodity_id
	inner join tbl_company sb on t.company_id = sb.company_id
	left join tbl_country sbc on sb.country_id = sbc.country_id
	left join tbl_country dbc on db.country_id = dbc.country_id
          left join tbl_shape shape on lot.shape_id = shape.shape_id
          left join tbl_factory f on t.factory_id = f.factory_id
where
	t.is_deleted = 0
	and t.transfer_id = $P!{i_inv_id}
order by
          com.commodity_name asc,
          shape.shape_name asc,
	det.mm_size asc]]>
	</queryString>
