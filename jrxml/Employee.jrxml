	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tcomp.company_name,
	e.employee_id,
	e.first_name,
	e.middle_name,
	e.last_name,
	e.nick_name,
	d.department_name,
	e.designation,
	e.gender,
	e.contact_no,
	to_char(e.resign_dt,$P{dateFormat}) resign_dt,
	case when e.is_locked = 0 then 'Active' else 'Inactive' end status
from tbl_employee e
inner join tbl_company tcomp on e.company_id = tcomp.company_id
left join tbl_department d on e.department_id = d.department_id
	and (cast(d.department_id as text) in ($P!{departmentId}) or '-1' in ($P!{departmentId}))
where
	e.is_deleted = 0
	and (cast(e.company_id as text) in ($P!{companyId}) or '-1' in ($P!{companyId}))
order by
	tcomp.company_id,
	e.employee_id]]>
	</queryString>
