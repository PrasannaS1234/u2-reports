<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetPrint" pageWidth="595" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="575" leftMargin="10" rightMargin="10" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.7715610000000015"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="411"/>
	<style name="style1">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{job_category}.equals( "Normal" ) ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#3333FF">
				<pen lineColor="#000000"/>
			</style>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{job_category}.equals( "Repair" ) ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#FF0033">
				<pen lineColor="#000000"/>
			</style>
		</conditionalStyle>
	</style>
	<parameter name="i_bag_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-mm-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_bag_No" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="i_bag_qty" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tx.* from (
select
	comp.company_name,
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	bag.bag_id,
	bag.bag_qty,
	($P!{i_bag_No}) bag_type_no,
	s.sku_no,
	p.product_type_name,
	c.customer_name,
	sd.customer_order_no,
	sd.customer_jew_no,
	so.reference_no,
          so.sales_order_type||so.sales_order_no so_no,
	sd.diamond_remarks,
	sd.gemstone_remarks,
	sd.metal_wt,
	to_char(so.delivery_date, $P{dateFormat}) delivery_date,
	to_char(so.sales_order_date, $P{dateFormat}) sales_order_date,
	ps.product_size,
	t.metal_weight,
	t.metal1,
	t.stamping_details,
	sd.prod_remarks prod_description,
	case
		when sd.image_url is null or sd.image_url = ' ' or sd.image_url = '' then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url)
else
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/salesorder/',sd.sales_order_det_id,sd.image_url)
	end	image_url,
	lot.lot_code,
	round(jc.total_qty1,3) total_qty1,
	fac.factory_name,
	t.job_category,
	lot.uom1,
	s.uom
from
	tbl_jewellery t
	inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
	inner join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	left join(
		select
			sc.sales_order_det_id,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'DIAMOND' then tot_qty else 0 end),3) dia_wt,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'DIAMOND' then qty2 else 0 end),0) dia_pcs,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'GEMSTONE' then tot_qty else 0 end),3) cs_wt,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'GEMSTONE' then qty2 else 0 end),0) cs_pcs
		from
			tbl_sales_order_component sc
			inner join tbl_commodity com on sc.commodity_id = com.commodity_id
		where
			sc.is_deleted = 0
		group by
			sc.sales_order_det_id
	)tsc on sd.sales_order_det_id = tsc.sales_order_det_id
	left join(
		select
			sc.sales_order_det_id,
			string_agg(sc.note,', ') note
		from
			tbl_sales_order_prod_note sc
		where
			sc.is_deleted = 0
		group by
			sc.sales_order_det_id
	)tscn on sd.sales_order_det_id = tscn.sales_order_det_id
	inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
		and bag.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	left join tbl_jewellery_component jc on t.jew_id = jc.jew_id
		and jc.is_deleted = 0
	left join tbl_lot lot on jc.lot_id = lot.lot_id
	left join tbl_factory fac on so.factory_id = fac.factory_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
	t.job_category = 'Normal'
	and (bag.bag_id) in ($P!{i_bag_id})
union all
select
	comp.company_name,
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	bag.bag_id,
	bag.bag_qty,
	concat(bag.bag_type, bag.bag_no) bag_type_no,
	s.sku_no,
	p.product_type_name,
	c.customer_name,
	sd.customer_order_no,
	sd.customer_jew_no,
	so.reference_no,
          so.repair_order_type||so.repair_order_no so_no,
	tsc.dia_wt||' CT  '||tsc.dia_pcs||' PCS' diamond_remarks,
	tsc.cs_wt||' CT  '||tsc.cs_pcs||' PCS' gemstone_remarks,
	sd.metal_wt,
	to_char(so.delivery_date, $P{dateFormat}) delivery_date,
	to_char(so.repair_order_date, $P{dateFormat}) sales_order_date,
	ps.product_size,
	t.metal_weight,
	t.metal1,
	t.stamping_details,
	sd.prod_remarks prod_description,
	case
		when sd.image_url is null or sd.image_url = ' ' or sd.image_url = '' then
                     concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url)
                      else
		 concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/repairorder/',sd.repair_order_det_id,sd.image_url)
	end	image_url,
	lot.lot_code,
	round(jc.total_qty1,3) total_qty1,
	fac.factory_name,
	t.job_category,
	lot.uom1,
	s.uom
from
	tbl_jewellery t
	inner join tbl_repair_order_main so on t.sales_order_id = so.repair_order_id
	inner join tbl_repair_order_det sd on so.repair_order_id = sd.repair_order_id
		and t.sales_order_det_id = sd.repair_order_det_id
		and sd.is_deleted = 0
	left join(
		select
			sc.repair_order_det_id,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'DIAMOND' then tot_qty else 0 end),3) dia_wt,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'DIAMOND' then qty2 else 0 end),0) dia_pcs,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'GEMSTONE' then tot_qty else 0 end),3) cs_wt,
			round(sum(case when COALESCE(com.metal_type,'DIAMOND') = 'GEMSTONE' then qty2 else 0 end),0) cs_pcs
		from
			tbl_repair_order_component sc
			inner join tbl_commodity com on sc.commodity_id = com.commodity_id
		where
			sc.is_deleted = 0
		group by
			sc.repair_order_det_id
	)tsc on sd.repair_order_det_id = tsc.repair_order_det_id
	inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
		and bag.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	left join tbl_jewellery_component jc on t.jew_id = jc.jew_id
		and jc.is_deleted = 0
	left join tbl_lot lot on jc.lot_id = lot.lot_id
	left join tbl_factory fac on so.factory_id = fac.factory_id
	left join tbl_user u on so.created_by = u.user_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
	t.job_category = 'Repair'
           AND ( $P!{i_bag_id} IS NULL OR bag.bag_id IN ($P!{i_bag_id}) )
)tx
order by tx.bag_id]]>
	</queryString>
