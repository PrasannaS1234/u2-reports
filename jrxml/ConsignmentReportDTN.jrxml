					<font fontName="Arial" isBold="true" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="33" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="cc315626-e9a5-44e9-8ff4-d8c9fc386e20"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="true" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[Acknowledgement of ensured as per condition below for as per due day]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="49" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="4b9dd158-ccc3-4a92-83ae-4bb360ae3637"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="false" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[1) The goods remain our sole property and you only hold them in trust for us.]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="65" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="42063450-4f34-4525-bad2-bb64d3222d09"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="false" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[2) You will not sell or pledge or mortgage or hypothecate the said goods or otherwise deal withthem in any]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="97" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="0a050664-b4e7-4c3e-b2cd-22e33b4772d8"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="false" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[3) The said goods will be returned to us forthwith on demand.]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="113" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="b4c78a7d-06d0-4fd8-9200-eb3fc92a0bbd"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="false" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[4) The goods, while in your custody, will be held at your sole responsibility, risk and cost in all respect.]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="129" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="241a4ef7-9be8-46dc-bca2-60b58d6502a2"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="false" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[5) You should take utmost care and safety while returning the goods.]]></text>
			</staticText>
			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="0" y="81" width="500" height="16" isPrintWhenDetailOverflows="true" uuid="379b6c05-4d78-4e58-9543-93eb4a3fd184"/>
				<box leftPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" isBold="false" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[    manner what so ever which is prejudicial to our rights and interest.]]></text>
			</staticText>
