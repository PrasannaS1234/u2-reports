	<field name="pcs" class="java.math.BigDecimal"/>
	<field name="input_rate" class="java.math.BigDecimal"/>
	<field name="input_amt" class="java.math.BigDecimal"/>
	<field name="commodity_name" class="java.lang.String"/>
	<variable name="input_amt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="BAG" calculation="Sum">
		<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
	</variable>
	<variable name="pcs_1" class="java.math.BigDecimal" resetType="Group" resetGroup="BAG" calculation="Sum">
		<variableExpression><![CDATA[$F{pcs}]]></variableExpression>
	</variable>
	<variable name="carats_1" class="java.math.BigDecimal" resetType="Group" resetGroup="BAG" calculation="Sum">
		<variableExpression><![CDATA[$F{carats}]]></variableExpression>
	</variable>
	<group name="BAG" keepTogether="true">
		<groupExpression><![CDATA[$F{inv_id}]]></groupExpression>
	</group>
