<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Consignment" pageWidth="670" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
          row_number() over(order by dt.inv_det_id) srno,
	im.inv_id,
	im.inv_type||im.inv_no invoive_no,
          to_char(im.inv_dt, $P{dateFormat}) invoice_dt,
          to_char(im.inv_due_dt, $P{dateFormat})     invoice_due_dt,
	upper(cmp.display_name) company_name,
	concat(cmp.street,',',cmp.area,',',cmp.city,',',cmp.state,'-',cmp.pin_code,',',cnt.country_name) company_address,
	cus.customer_name customer_name,
	cus.primary_contact_name primary_contact_name,
	cus.primary_contact_no primary_contact_no,
	concat(im.ship_address1,',',im.ship_city,',', im.ship_state,'-',im.ship_pincode ,',',im.ship_country) ship_address1,
	cmg.commodity_group_name,
          lt.lot_code,
	lt.mm_size,
	shp.shape_code,
	dt.inv_qty1 carats,
	clr.color_name,
	lt.purity,
          clt.clarity_name,
	cut.cut_name,
	lt.polish,
	lt.symmetry,
	lt.lab_name,
	lt.certificate_no,
	dt.inv_qty2 pcs,
	dt.input_rate,
	dt.input_amt,
           com.commodity_name
from tbl_memo_sales_invoice_main im
inner join tbl_memo_sales_invoice_det dt on im.inv_id = dt.inv_id
	and dt.is_deleted = 0
inner join tbl_company cmp on im.company_id = cmp.company_id
inner join tbl_country cnt on cmp.country_id = cnt.country_id
inner join tbl_customer cus on im.customer_id = cus.customer_id
inner join tbl_lot lt on lt.lot_id = dt.lot_id
inner join tbl_commodity com on lt.commodity_id = com.commodity_id
inner join tbl_commodity_group cmg on com.commodity_group_id = cmg.commodity_group_id
left join tbl_shape shp on lt.shape_id = shp.shape_id
left join tbl_color clr on lt.color_id = clr.color_id
left join tbl_clarity clt on clt.clarity_id = lt.clarity_id
left join tbl_cut cut on lt.cut_id = cut.cut_id
where
    im.is_deleted = 0
	and im.inv_id in ($P!{i_inv_id})]]>
	</queryString>
	<field name="srno" class="java.lang.Long"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="invoive_no" class="java.lang.String"/>
	<field name="invoice_dt" class="java.lang.String"/>
	<field name="invoice_due_dt" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="company_address" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="primary_contact_name" class="java.lang.String"/>
	<field name="primary_contact_no" class="java.lang.String"/>
	<field name="ship_address1" class="java.lang.String"/>
	<field name="commodity_group_name" class="java.lang.String"/>
