	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["45"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["E:\\jasper-reports\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	m.inv_id AS inv_id,
	CONCAT(max(m.inv_type),'-',max(m.inv_no)) AS demand_no,
          m.inv_date,
	STRING_AGG(DISTINCT CONCAT(sm.sales_order_type,'-',sm.sales_order_no), ',') AS so_no
FROM tbl_material_demand_main m
INNER JOIN tbl_material_demand_det d
	ON m.inv_id = d.inv_id
	AND d.is_deleted = 0

LEFT JOIN tbl_sales_order_main sm
	ON d.so_id = sm.sales_order_id

WHERE m.is_deleted = 0
	AND m.inv_id IN ($P!{i_inv_id})

GROUP BY
	m.inv_id
ORDER BY
	m.inv_id;]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="demand_no" class="java.lang.String"/>
	<field name="inv_date" class="java.sql.Date"/>
	<field name="so_no" class="java.lang.String"/>
	<group name="Sku">
		<groupExpression><![CDATA[]]></groupExpression>
	</group>
