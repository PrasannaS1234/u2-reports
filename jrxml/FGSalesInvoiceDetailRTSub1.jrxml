<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobWorkDetailsRTSub1" pageWidth="800" pageHeight="842" columnWidth="800" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="277"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
SELECT
    comp_data.jew_id,
    comp_data.stone_wt * d.inv_qty  AS stone_wt,
    comp_data.stone_rate * (NULLIF(comp_data.stone_wt, 0)* d.inv_qty) AS stone_amount,
    comp_data.stone_rate,
    lot_code,
    commodity_name,
    stone_pcs * d.inv_qty as stone_pcs,
    shape_name,
    comp_data.master_lot,
    comp_data.mm_size

FROM tbl_jew_sales_invoice_det d
left join
(
    SELECT
        comp.jew_id,
	    comp.lot_id,
	    sum(det.inv_qty) as inv_qty,
        SUM(
            CASE
                WHEN lot.lot_type = 'STONE'
                    THEN comp.consumed_qty1 * comp.pp_rate
                ELSE 0
            END
        ) / nullif(sum(comp.consumed_qty1),0) AS stone_rate,
	  case when max(lot.lot_type) = 'STONE' then sum(
	   CASE
                WHEN lot.lot_type = 'STONE'
                    THEN comp.consumed_qty1
                ELSE 0
            END
	  )/ nullif(sum(det.inv_qty),0) end as stone_wt,
	 case when max(lot.lot_type) = 'STONE' then sum(
	   CASE
                WHEN lot.lot_type = 'STONE'
                    THEN comp.consumed_qty2
                ELSE 0
            END
	  )/ nullif(sum(det.inv_qty),0) end as stone_pcs,
	  max(lot.lot_code) as lot_code,
	 max(c.commodity_name) as commodity_name,
	 max(s.shape_name) as shape_name,
           max(mlot.lot_code) as master_lot,
           max(comp.mm_size) as mm_size
    FROM
        tbl_factory_invoice_component comp
        INNER JOIN tbl_factory_invoice_det det
            ON comp.inv_det_id = det.inv_det_id
        INNER JOIN tbl_lot lot
            ON comp.lot_id = lot.lot_id
	    INNER JOIN tbl_commodity c on lot.commodity_id = c.commodity_id
	    Left Join tbl_shape s on lot.shape_id = s.shape_id
	    LEFT join tbl_lot mlot on lot.master_lot_id = mlot.lot_id

    WHERE
        det.is_deleted = 0
	     and lot.lot_type = 'STONE'
	  and upper(c.metal_type) != 'DIAMOND'

    GROUP BY
        comp.jew_id,comp.lot_id,comp.stone_size

) comp_data on comp_data.jew_id = d.jew_id
where d.inv_det_id = $P!{i_inv_det_id} and d.is_deleted = 0
)

select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
   NULL as jew_id,
   NULL AS stone_wt,
   NULL AS stone_rate,
   NULL AS stone_amount,
   NULL AS lot_code,
   NULL AS commodity_name,
   NULL AS stone_pcs,
   NULL AS shape_name,
   NULL as master_lot,
   NULL AS mm_size
FROM generate_series(1, 5-(select count(*) from w_result_set));]]>
	</queryString>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="stone_wt" class="java.math.BigDecimal"/>
	<field name="stone_amount" class="java.math.BigDecimal"/>
	<field name="stone_rate" class="java.math.BigDecimal"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="stone_pcs" class="java.math.BigDecimal"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="master_lot" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
