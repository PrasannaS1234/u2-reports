				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[The Manager,]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="120" width="554" height="16" uuid="222e0fb9-4048-4e84-bcb9-ce1fb5765c2b"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{bank_name}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="136" width="554" height="16" uuid="36e12400-e670-4943-b7c3-51da9d511df9"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
