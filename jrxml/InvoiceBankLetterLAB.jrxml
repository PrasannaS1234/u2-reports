			</textField>
			<textField>
				<reportElement x="0" y="173" width="554" height="15" uuid="50719acd-46cc-45c3-86a0-8983352d2dbc"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="188" width="554" height="15" uuid="2215ddc1-c99a-4206-b1d0-d22c818a41fa"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Dear Sir/ Madam,"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="203" width="554" height="10" uuid="e480a80c-2021-4681-9977-7b38af166037"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="213" width="554" height="43" uuid="61b79a6b-87ac-4302-83d9-ec84dcf3a9e9"/>
				<box topPadding="1" leftPadding="2" bottomPadding="1" rightPadding="2"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["We would like to inform you that we are exporting laboratory grown cut and polished diamonds on consignment basis in terms of para 4.53 of FTP & Para 4.93 of HBP 2015-20 under the Invoice number "+$F{cus_doc_type}+" and Invoice Date : "+ $F{inv_dt} +" ,Total Carats :"+$F{qty1} +" valuing US$ "+$F{total_amt_usd}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="256" width="554" height="20" uuid="0060d580-832c-4f8b-9818-6823382d6a94"/>
				<textElement markup="none">
					<font isBold="true" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA["IEC CODE :"+$F{comp_ie_code_no}+"; ISSUE DATE :"+$F{comp_iec_date}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="276" width="554" height="20" uuid="999b3eb2-1c1c-4ad8-a149-a66201cb0840"/>
				<textElement verticalAlignment="Middle">
					<font isBold="true" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA["We undertake that:-"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="296" width="554" height="20" uuid="389a1731-e95b-4592-902a-a1228f894dee"/>
				<textElement verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["i) We shall produce relative Bill of Entry within one month of re-import into India of the unsold items."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="316" width="554" height="30" uuid="c7ee0ae0-37be-4879-9d5f-c30b2375a9de"/>
				<textElement verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["ii) The sale proceeds of the items sold shall be repatriated to India in accordance with the Foreign Exchange Management (Realization, Repatriation, and Surrender of Foreign Exchange) Regulations, 2000."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="346" width="554" height="30" uuid="6cbb65b4-369f-4d2c-b318-293c5c9bc65e"/>
				<textElement verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["iii) We shall report to the AD Category - I banks the method of disposal of all items exported, as well as the repatriation of proceeds to India."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="376" width="554" height="16" isPrintWhenDetailOverflows="true" uuid="71b4ac63-c9ff-4849-9854-72404aab58c9"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["iv) Door to Door  Insurance Covered By "+$F{carrier}+ " in INDIA."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="392" width="554" height="16" isPrintWhenDetailOverflows="true" uuid="834afc76-803e-460f-9969-b8719372696e"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["v) UnSold Goods will be re-imported on the expiry of 180 days from the date of export."]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="408" width="554" height="16" isPrintWhenDetailOverflows="true" uuid="1d2fb8f3-c2ae-4dce-9015-a4e8ce9897af"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["vi) We undertake to provide Insurance certificate and Transport document evidencing Insurance and Freight being arranged in"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="0" width="554" height="42" uuid="ca6e088c-45d7-4dbe-806e-775de68c40f8"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[]]></text>
			</staticText>
			<textField>
				<reportElement x="303" y="424" width="251" height="16" uuid="4bcb15cb-77f7-49a0-b71a-4dd6848e15cd"/>
				<textElement verticalAlignment="Middle">
					<font size="9" isBold="true" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Invoice No " +$F{cus_doc_type} +" Dt. "+$F{inv_dt}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="424" width="303" height="16" isPrintWhenDetailOverflows="true" uuid="896e3e5e-04f5-4758-90fb-42bac679572e"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["India for consignment shipment under Invoice / Delivery Challan ."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="440" width="554" height="18" uuid="3b036caf-33d0-40b8-bb61-b8dfbb20f5a3"/>
				<textFieldExpression><![CDATA[" as per Regulatory guidelines."]]></textFieldExpression>
			</textField>
