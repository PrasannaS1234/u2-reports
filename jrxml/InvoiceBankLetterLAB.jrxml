				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[EXPORT UNDER CONSIGNMENT BASIS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="84" width="39" height="20" uuid="d6fd313f-9da5-44ba-9f42-bac08cd88b10"/>
				<textElement>
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[TO,]]></text>
