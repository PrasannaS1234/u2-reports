<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SkuMould" pageWidth="340" pageHeight="430" whenNoDataType="AllSectionsNoDetail" columnWidth="330" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="component" uuid="9f635239-62b1-4650-abc3-41d399b6a2ef">
		<parameter name="jobId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.component_id,
		 tsc.sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.jew_id,
		 tsc.tot_qty,
		 tsc.qty1,
		 tsc.qty2,
		 case when tsc.qty2 > 0 then tsc.tot_qty / tsc.qty2 else 0 end per_pc_wt
	FROM
		 tbl_sales_order_component tsc
		 inner join tbl_sales_order_det tsd on tsc.sales_order_det_id = tsd.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_jewellery j on tsd.sales_order_det_id = j.sales_order_det_id
			and tsd.is_deleted = 0
	WHERE
		 tsc.is_deleted = 0
		 and j.jew_id = $P!{jobId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pcs_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,7) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
		<group name="component_id">
			<groupExpression><![CDATA[$F{component_id}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[" "]]></defaultValueExpression>
	</parameter>
	<parameter name="i_job_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select job.jew_id job_id,
	s.sku_id,
	s.sku_no,
	p.product_type_name,
	ps.product_size,
	m.mould_no,
	m.rack_no,
	m.shop_name,
	pc.cam_wt,
	pc.casting_wt,
    pc.cad_wt,
	job.metal_weight shipment_weight,
	sc.tot_qty,
          sc.qty1,
	sc.qty2,
	round(case when sc.qty2 > 0 then sc.tot_qty / sc.qty2 else 0 end,3) per_pcs_wt,
	m.screw_weight,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url
from
    tbl_jewellery job
    inner join tbl_sku s on job.sku_id = s.sku_id
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
	left join tbl_sku_mould m on s.sku_id = m.sku_id
		and m.is_deleted  = 0
    left join(
	select sjob.jew_id, sum(c.tot_qty) tot_qty, sum(c.qty1) qty1, sum(c.qty2) qty2
	 from    tbl_jewellery sjob
	inner join tbl_sales_order_component c on sjob.sales_order_det_id = c.sales_order_det_id
	 where c.is_deleted  = 0
	 and (sjob.jew_id) in ($P!{i_job_id})
     group by sjob.jew_id
	)sc on job.jew_id = sc.jew_id
	left join(
			select
			jm.job_id,
			max(case when upper(dp.process_name) = 'CASTING' then jm.output_weight else 0 end) casting_wt,
			max(case when upper(dp.process_name) = 'CAM' then jm.output_weight else 0 end) cam_wt,
			max(case when upper(dp.process_name) = 'CAD' then jm.output_weight else 0 end) cad_wt
		 	from tbl_mfg_job_metal_weight_calculation jm
		    inner join tbl_process dp on jm.process_id = dp.process_id
		    where (jm.job_id) in ($P!{i_job_id})
		    group by jm.job_id
    )pc on job.jew_id = pc.job_id
    left join tbl_product_size ps on job.product_size_id = ps.size_id
where
	s.is_deleted = 0
	and (job.jew_id) in ($P!{i_job_id})]]>
	</queryString>
