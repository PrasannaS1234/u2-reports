				<staticText>
					<reportElement key="staticText-108" mode="Transparent" x="221" y="13" width="110" height="16" forecolor="#000000" backcolor="#473427" uuid="bca3b628-4854-478c-a5f0-846ea6578989"/>
					<box leftPadding="2" rightPadding="2">
						<topPen lineWidth="0.5"/>
