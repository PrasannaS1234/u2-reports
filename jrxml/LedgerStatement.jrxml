	<subDataset name="Opening Balance" uuid="838ef377-8381-45c6-b937-95cb5177ee28">
		<parameter name="fromDate" class="java.lang.String">
			<defaultValueExpression><![CDATA["01/05/2026"]]></defaultValueExpression>
		</parameter>
		<parameter name="accountId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="dateFormat" class="java.lang.String">
			<defaultValueExpression><![CDATA["dd/mm/yyyy"]]></defaultValueExpression>
		</parameter>
		<parameter name="currency" class="java.lang.String">
			<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITH bal AS
(
    SELECT
        CASE
            WHEN TRIM(lower($P!{currency})) LIKE 'usd' THEN
                SUM(
                    CASE
                        WHEN d.dr_cr = 'D' THEN d.amount_usd
                        WHEN d.dr_cr = 'C' THEN -d.amount_usd
                    END
                )
            WHEN TRIM(lower($P!{currency})) <> 'usd' THEN
                SUM(
                    CASE
                        WHEN d.dr_cr = 'D' THEN d.amount
                        WHEN d.dr_cr = 'C' THEN -d.amount
                    END
                )
        END AS net_amt
    FROM tbl_account_posting_main m
    INNER JOIN tbl_account_posting_det d
        ON d.posting_id = m.posting_id
       AND d.is_deleted = 0
    INNER JOIN tbl_account ac
        ON ac.account_id = d.account_id
    WHERE
        m.is_deleted = 0
        AND ac.account_id = $P!{accountId}
        AND m.inv_dt < TO_DATE($P{fromDate}, $P{dateFormat})
)

SELECT
    CASE
        WHEN net_amt >= 0 THEN net_amt
        ELSE NULL
    END AS debit_amt,

    CASE
        WHEN net_amt < 0 THEN ABS(net_amt)
        ELSE NULL
    END AS credit_amt,

    TO_DATE($P{fromDate}, $P{dateFormat}) AS date

FROM bal;]]>
		</queryString>
		<field name="debit_amt" class="java.math.BigDecimal"/>
		<field name="credit_amt" class="java.math.BigDecimal"/>
		<field name="date" class="java.sql.Date"/>
	</subDataset>
	<subDataset name="Closing Balance" uuid="c0896559-fe99-4bd1-bcfa-b7e0613698ef">
		<parameter name="toDate" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="account_id" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="dateFormat" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="currency" class="java.lang.String">
			<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
CASE WHEN $P{currency}= 'USD' THEN
  case when (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount_usd * 1 WHEN d.dr_cr = 'C' THEN d.amount_usd * -1 END)) >= 0
  then (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount_usd * 1 WHEN d.dr_cr = 'C' THEN d.amount_usd * -1 END)) else null end
  ELSE
  case when (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount * 1 WHEN d.dr_cr = 'C' THEN d.amount * -1 END)) >= 0
  then (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount * 1 WHEN d.dr_cr = 'C' THEN d.amount * -1 END)) else null end
  END AS debit_amt,


  CASE WHEN $P{currency}= 'USD' THEN
  case when (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount_usd * 1 WHEN d.dr_cr = 'C' THEN d.amount_usd * -1 END)) < 0
  then (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount_usd * 1 WHEN d.dr_cr = 'C' THEN d.amount_usd * -1 END)*-1) else null end
  ELSE
  case when (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount * 1 WHEN d.dr_cr = 'C' THEN d.amount * -1 END)) < 0
  then (sum(CASE WHEN d.dr_cr = 'D' THEN d.amount * 1 WHEN d.dr_cr = 'C' THEN d.amount * -1 END)*-1)
  else null end
  end AS credit_amt,

 to_date($P{toDate},$P{dateFormat}) as date

FROM tbl_account_posting_main m
INNER JOIN tbl_account_posting_det d
    ON d.posting_id = m.posting_id
   AND d.is_deleted = 0
INNER JOIN tbl_account ac
    ON ac.account_id = d.account_id
WHERE
  m.is_deleted = 0
  AND m.inv_dt <= to_date($P{toDate},$P{dateFormat})
  AND ac.account_id = $P!{account_id}]]>
		</queryString>
		<field name="debit_amt" class="java.math.BigDecimal"/>
		<field name="credit_amt" class="java.math.BigDecimal"/>
		<field name="date" class="java.sql.Date"/>
	</subDataset>
	<subDataset name="OTHER BANKS" uuid="e1747b28-69ee-412d-9ebc-cbc8d1c5e759">
		<parameter name="postingId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="accountId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="currency" class="java.lang.String">
			<defaultValueExpression><![CDATA["'INR'"]]></defaultValueExpression>
		</parameter>
		<parameter name="companyId" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    d.account_id,
    max(ac.account_name) account_name,

    case
    when $P!{currency} != 'USD' then
        sum(case when d.dr_cr = 'D'  and d.amount > 0 then d.amount else null end)
    else
        sum(case when d.dr_cr = 'D' and d.amount_usd > 0 then d.amount_usd else null end)
    end as debit_amt,

    case when
        (
            case when $P!{currency} != 'USD' then
                sum(case when d.dr_cr = 'D' then d.amount else null end)
            else
                sum(case when d.dr_cr = 'D' then d.amount_usd else null end)
            end
        ) <> 0
    then 'Dr'
    end as dr,

    case when $P!{currency} != 'USD' then
        sum(case when d.dr_cr = 'C' and d.amount > 0 then  d.amount else null end)
    else
        sum(case when d.dr_cr = 'C'  and d.amount_usd > 0  then d.amount_usd else null end)
    end as credit_amt,

    case when
        (
            case when $P!{currency} = 'USD' then
                sum(case when d.dr_cr = 'C' then d.amount_usd else null end)
            else
                sum(case when d.dr_cr = 'C' then d.amount else null end)
            end
        ) <> 0
    then 'Cr'
    end as cr

from tbl_account_posting_main m
inner join tbl_account_posting_det d
    on d.posting_id = m.posting_id
    and d.is_deleted = 0
inner join tbl_account ac
    on ac.account_id = d.account_id

where
    m.company_id = $P!{companyId}
    and m.is_deleted = 0
    and m.posting_id = $P!{postingId}
    and ac.account_id != $P!{accountId}

group by
    d.account_id;]]>
		</queryString>
		<field name="account_id" class="java.lang.Integer"/>
		<field name="account_name" class="java.lang.String"/>
		<field name="debit_amt" class="java.math.BigDecimal"/>
		<field name="dr" class="java.lang.String"/>
		<field name="credit_amt" class="java.math.BigDecimal"/>
		<field name="cr" class="java.lang.String"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["E:\\jasper-reports\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'22/12/2025'"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'22/12/2025'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="accountId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'dd/mm/yyyy'"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    MAX(m.inv_dt)                                         AS inv_dt,
    MAX(m.inv_type)                                       AS inv_type,
    COALESCE(NULLIF(fn_get_customer_invoice_no(inv_type, inv_id), ''), concat(inv_type, '-', inv_no)) as inv_no,
    MAX(ac.account_name)                                  AS acc_name,
    MAX(ac.account_id)                                    AS acc_id,
    MAX(comp.display_name)                                AS company_name,
    MAX(m.posting_id)                                     AS posting_id,
    CONCAT(
        COALESCE(MAX(comp.street), ''), ' , ',
        COALESCE(MAX(comp.area),   '')
    )                                                     AS add1,
    CONCAT(
        COALESCE(MAX(comp.city), ''), ' , ',
        COALESCE(MAX(comp.state), '')
    )                                                     AS add2,
    CONCAT('E-Mail : ', MAX(comp.email))                  AS email,
   CASE
    WHEN $P!{currency} ='USD'
    THEN SUM(CASE WHEN d.dr_cr = 'D' and d.amount_usd > 0 THEN d.amount_usd ELSE null END)
    ELSE SUM(CASE WHEN d.dr_cr = 'D' and d.amount > 0 THEN d.amount ELSE null END)
    END AS debit_amt,
    CASE
    WHEN $P!{currency} ='USD'
    THEN SUM(CASE WHEN d.dr_cr = 'C' and  d.amount_usd > 0 THEN d.amount_usd ELSE null END)
	ELSE SUM(CASE WHEN d.dr_cr = 'C' and d.amount > 0 THEN d.amount ELSE null END)
	END AS credit_amt,
    to_date($P!{toDate},$P!{dateFormat}) as toDate,
    to_date($P!{fromDate},$P!{dateFormat}) fromDate,
    COALESCE(sum(opn.opening_debit), 0)                        AS opening_debit,

    COALESCE(sum(opn.opening_credit), 0)                       AS opening_credit,
    'Dr' as dr,
    'Cr' as cr,
    $P!{currency} as currency,
    max(d.narration) as narration
FROM tbl_account_posting_main m
INNER JOIN tbl_account_posting_det d
    ON d.posting_id = m.posting_id
   AND d.is_deleted = 0
INNER JOIN tbl_account ac
    ON ac.account_id = d.account_id
INNER JOIN tbl_company comp
    ON comp.company_id = m.company_id
LEFT JOIN (
    SELECT
        d.account_id,

        CASE
            WHEN SUM(
                CASE
                    WHEN d.dr_cr = 'D' THEN d.amount
                    WHEN d.dr_cr = 'C' THEN -d.amount
                END
            ) >= 0
            THEN SUM(
                CASE
                    WHEN d.dr_cr = 'D' THEN d.amount
                    WHEN d.dr_cr = 'C' THEN -d.amount
                END
            )
        END AS opening_debit,

        CASE
            WHEN SUM(
                CASE
                    WHEN d.dr_cr = 'D' THEN d.amount
                    WHEN d.dr_cr = 'C' THEN -d.amount
                END
            ) < 0
            THEN ABS(SUM(
                CASE
                    WHEN d.dr_cr = 'D' THEN d.amount
                    WHEN d.dr_cr = 'C' THEN -d.amount
                END
            ))
        END AS opening_credit

    FROM tbl_account_posting_main m
    INNER JOIN tbl_account_posting_det d
           ON d.posting_id = m.posting_id
          AND d.is_deleted = 0
    WHERE m.is_deleted = 0
      AND m.inv_dt < to_date($P!{fromDate},$P!{dateFormat})
      AND m.company_id = $P!{companyId}
    GROUP BY d.account_id
) opn
ON opn.account_id = ac.account_id
WHERE m.company_id = $P!{companyId}
  AND m.is_deleted = 0
  AND ac.account_id = $P!{accountId}
  AND m.inv_dt >= to_date($P!{fromDate},$P!{dateFormat})
  AND m.inv_dt <= to_date($P!{toDate},$P!{dateFormat})
GROUP BY
    m.posting_id
ORDER BY
    m.inv_dt]]>
	</queryString>
	<field name="inv_dt" class="java.sql.Date"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="inv_no" class="java.lang.String"/>
	<field name="acc_name" class="java.lang.String"/>
	<field name="acc_id" class="java.lang.Integer"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="posting_id" class="java.lang.Integer"/>
	<field name="add1" class="java.lang.String"/>
	<field name="add2" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="debit_amt" class="java.math.BigDecimal"/>
	<field name="credit_amt" class="java.math.BigDecimal"/>
	<field name="todate" class="java.sql.Date"/>
	<field name="fromdate" class="java.sql.Date"/>
	<field name="opening_debit" class="java.math.BigDecimal"/>
	<field name="opening_credit" class="java.math.BigDecimal"/>
	<field name="dr" class="java.lang.String"/>
	<field name="cr" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="narration" class="java.lang.String"/>
	<variable name="total_debit" class="java.lang.Number" calculation="Sum">
		<variableExpression><![CDATA[$F{opening_debit}]]></variableExpression>
	</variable>
	<variable name="total_credit" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{opening_credit}]]></variableExpression>
	</variable>
	<group name="Invoice" isStartNewPage="true">
		<groupHeader>
			<band height="21">
