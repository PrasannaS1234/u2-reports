<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CertificateTrueLove" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a3b71617-a723-40a8-b69a-57aaf2514290">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="FRONT_END_URL" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_input_nos" class="java.lang.String">
		<defaultValueExpression><![CDATA["'LP000024'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'tenanthi2b1g'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[4]]></defaultValueExpression>
	</parameter>
	<parameter name="i_guest_name" class="java.lang.String"/>
	<parameter name="i_inv_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	upper(sku.category)	prod_desc,
	upper(COALESCE(concat(jew.jew_type,jew.jew_no), sku.sku_no))	model_no,
	upper(tcomp.shapes) dia_shape,
	upper(concat(j.white_diamond_wt,', ',coalesce(nullif(j.color_diamond_wt,''),j.color_stone_wt)))	dia_weight,
	upper(j.diamond_clarity)	color_clarity,
	upper(tlot.lot_code) 	metal_type,
	round((coalesce(j.tag_price,0)),0) price,
	$P!{i_guest_name} guest_name,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',j.company_id,'/cert_desires_header.jpg') header_img,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',j.company_id,'/cert_desires_body.jpg') body_img,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)	image_url,
	j.printing_id
from
	tbl_label_printing j
	inner join tbl_sku sku on j.sku_id = sku.sku_id
	left join tbl_jewellery jew on j.jew_id = jew.jew_id
	left join tbl_lot tlot on j.metal_id = tlot.lot_id
	left join
		(
			select
				comp.sku_id,
				(string_agg(distinct sh.shape_name, ',')) as shapes
			from
				tbl_sku_component comp
				inner join tbl_commodity tcom on comp.commodity_id = tcom.commodity_id
				inner join tbl_commodity_group cg on tcom.commodity_group_id = cg.commodity_group_id
					and cg.commodity_group_type not in ('COLORSTONE','METAL','LABOUR','FG_COST','TOTAL_COST')
				left join tbl_shape sh on comp.shape_id = sh.shape_id
			where
				comp.is_deleted = 0
			group by
				comp.sku_id
		) tcomp on j.sku_id = tcomp.sku_id
where
	j.is_deleted = 0
	and (j.printing_id) in ($P!{i_inv_id})]]>
	</queryString>
