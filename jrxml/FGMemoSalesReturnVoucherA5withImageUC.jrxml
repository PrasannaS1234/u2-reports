	<field name="purity" class="java.math.BigDecimal"/>
	<field name="gross_wt" class="java.math.BigDecimal"/>
	<field name="rate_per_gms" class="java.math.BigDecimal"/>
	<field name="total_value_usd" class="java.math.BigDecimal"/>
	<field name="total_invoice_net_amount" class="java.math.BigDecimal"/>
	<field name="received_amount" class="java.math.BigDecimal"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="comp_logo" class="java.lang.String"/>
	<field name="inv_total_usd" class="java.math.BigDecimal"/>
	<field name="inv_total_usd_roundoff" class="java.math.BigDecimal"/>
	<field name="amount_decimal" class="java.math.BigDecimal"/>
	<field name="inv_total_words" class="java.lang.String"/>
	<variable name="gross_tot" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="total_value" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_value_usd}]]></variableExpression>
	</variable>
