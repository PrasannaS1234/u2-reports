	<queryString>
		<![CDATA[SELECT
    combined_data.inv_id,
    combined_data.display_name || '-' || combined_data.commodity_name AS supplier_commodity,
    combined_data.display_name AS supplier,
    combined_data.inv_type || '-' || combined_data.inv_no AS inv_no,
    combined_data.inv_dt,
    MAX(main.reference_no) AS reference_no,
    MAX(main.remarks) AS remarks,
    MAX(sa.supplier_name) AS supplier_name,
    MAX(f.factory_name) AS factory_name,
    MAX(d.department_name) AS department_name,
    MAX(combined_data.sales_order_no) AS sales_order_no,
    MAX(UPPER(comp.company_name)) AS comp_off_name,
    MAX(CONCAT(comp.street, ',', comp.area)) AS comp_area,
    MAX(CONCAT(comp.city, ',', UPPER(st.state_name), ',', UPPER(tc.country_name), ' - ', comp.pin_code)) AS comp_state_name,
    combined_data.bag_type_no,
    combined_data.customer_bag_no,
    combined_data.sku_no,
    combined_data.lot_code,
    combined_data.commodity_name,
    SUM(CASE WHEN combined_data.ctype = 'Mounting' THEN combined_data.qty1 END) AS Mounting,
    SUM(CASE WHEN combined_data.ctype = 'RM' THEN combined_data.qty1 END) AS RM,
    SUM(CASE WHEN combined_data.ctype = 'Loss' THEN combined_data.qty1 END) AS Loss,
    COALESCE(SUM(CASE WHEN combined_data.ctype = 'Mounting' THEN combined_data.qty1 END), 0) +
    COALESCE(SUM(CASE WHEN combined_data.ctype = 'RM' THEN combined_data.qty1 END), 0) +
    COALESCE(SUM(CASE WHEN combined_data.ctype = 'Loss' THEN combined_data.qty1 END), 0) AS Total,
    ROUND(
        COALESCE(SUM(CASE WHEN combined_data.ctype = 'Mounting' THEN combined_data.pure_wt END), 0) +
        COALESCE(SUM(CASE WHEN combined_data.ctype = 'RM' THEN combined_data.pure_wt END), 0) +
        COALESCE(SUM(CASE WHEN combined_data.ctype = 'Loss' THEN combined_data.pure_wt END), 0), 2
    ) AS pure_wt
FROM (
    SELECT
        rm.inv_id,
        sup.display_name,
        'Mounting' AS ctype,
        rm.inv_type,
        rm.inv_no,
        rm.inv_dt,
        bg.bag_type_no,
        bg.customer_bag_no,
        sku.sku_no,
        so.sales_order_type || '-' || so.sales_order_no AS sales_order_no,
        cm.commodity_name,
        l.lot_code,
        rc.qty1,
        rc.qty1 * l.impure_to_pure_conv_factor AS pure_wt
    FROM
        tbl_mfg_casting_mould_receipt rm
        INNER JOIN tbl_mfg_casting_mould_receipt_det rd ON rm.inv_id = rd.inv_id AND rd.is_deleted = 0
        INNER JOIN tbl_mfg_bag bg ON rd.bag_id = bg.bag_id
        INNER JOIN tbl_mfg_casting_mould_receipt_component rc ON rd.inv_det_id = rc.inv_det_id AND rc.is_deleted = 0
        INNER JOIN tbl_lot l ON rc.lot_id = l.lot_id
        LEFT JOIN tbl_sku sku ON bg.sku_id = sku.sku_id
        LEFT JOIN tbl_jewellery jew ON bg.job_id = jew.jew_id
        LEFT JOIN tbl_sales_order_main so ON jew.sales_order_id = so.sales_order_id
        INNER JOIN tbl_commodity cm ON l.commodity_id = cm.commodity_id
        INNER JOIN tbl_supplier sup ON rm.supplier_id = sup.supplier_id
    WHERE rm.is_deleted = 0

    UNION ALL

    SELECT
        rm.inv_id,
        sup.display_name,
        'Loss' AS ctype,
        rm.inv_type,
        rm.inv_no,
        rm.inv_dt,
        bg.bag_type_no,
        bg.customer_bag_no,
        sku.sku_no,
        so.sales_order_type || '-' || so.sales_order_no AS sales_order_no,
        cm.commodity_name,
        l.lot_code,
        rc.al_wt AS qty1,
        rc.al_wt * l.impure_to_pure_conv_factor AS pure_wt
    FROM
        tbl_mfg_casting_mould_receipt rm
        INNER JOIN tbl_mfg_casting_mould_receipt_det rd ON rm.inv_id = rd.inv_id AND rd.is_deleted = 0
        INNER JOIN tbl_mfg_bag bg ON rd.bag_id = bg.bag_id
        INNER JOIN tbl_mfg_casting_mould_receipt_component rc ON rd.inv_det_id = rc.inv_det_id AND rc.is_deleted = 0
        INNER JOIN tbl_lot l ON rc.lot_id = l.lot_id
        LEFT JOIN tbl_sku sku ON bg.sku_id = sku.sku_id
        LEFT JOIN tbl_jewellery jew ON bg.job_id = jew.jew_id
        LEFT JOIN tbl_sales_order_main so ON jew.sales_order_id = so.sales_order_id
        INNER JOIN tbl_commodity cm ON l.commodity_id = cm.commodity_id
        INNER JOIN tbl_supplier sup ON rm.supplier_id = sup.supplier_id
    WHERE rm.is_deleted = 0 AND rc.al_wt <> 0

    UNION ALL

    SELECT
        rm.inv_id,
        sup.display_name,
        'RM' AS ctype,
        rm.inv_type,
        rm.inv_no,
        rm.inv_dt,
        NULL,
        NULL,
        NULL,
        NULL AS sales_order_no,
        cm.commodity_name,
        l.lot_code,
        rf.qty1,
        rf.qty1 * l.impure_to_pure_conv_factor AS pure_wt
    FROM
        tbl_mfg_casting_mould_receipt rm
        INNER JOIN tbl_mfg_casting_mould_receipt_finding_det rf ON rm.inv_id = rf.inv_id AND rf.is_deleted = 0
        INNER JOIN tbl_lot l ON rf.lot_id = l.lot_id
        INNER JOIN tbl_commodity cm ON l.commodity_id = cm.commodity_id
        INNER JOIN tbl_supplier sup ON rm.supplier_id = sup.supplier_id
    WHERE rm.is_deleted = 0

    UNION ALL

    SELECT
        rm.inv_id,
        sup.display_name,
        'Loss' AS ctype,
        rm.inv_type,
        rm.inv_no,
        rm.inv_dt,
        NULL,
        NULL,
        NULL,
        NULL AS sales_order_no,
        cm.commodity_name,
        l.lot_code,
        al.qty1,
        al.qty1 * l.impure_to_pure_conv_factor AS pure_wt
    FROM
        tbl_mfg_casting_mould_receipt rm
        INNER JOIN tbl_mfg_casting_mould_receipt_allow_loss al ON rm.inv_id = al.inv_id AND al.is_deleted = 0
        INNER JOIN tbl_lot l ON al.lot_id = l.lot_id
        INNER JOIN tbl_commodity cm ON l.commodity_id = cm.commodity_id
        INNER JOIN tbl_supplier sup ON rm.supplier_id = sup.supplier_id
    WHERE rm.is_deleted = 0
) AS combined_data
INNER JOIN tbl_mfg_casting_mould_receipt main ON combined_data.inv_id = main.inv_id
INNER JOIN tbl_supplier sa ON main.supplier_id = sa.supplier_id
INNER JOIN tbl_factory f ON main.factory_id = f.factory_id
INNER JOIN tbl_department d ON main.department_id = d.department_id
INNER JOIN tbl_company comp ON main.company_id = comp.company_id
LEFT JOIN tbl_country tc ON comp.country_id = tc.country_id
LEFT JOIN tbl_state st ON comp.state = st.state_code
WHERE combined_data.inv_id = $P!{i_inv_id}
GROUP BY
    combined_data.inv_id,
    combined_data.display_name,
    combined_data.inv_type,
    combined_data.inv_no,
    combined_data.inv_dt,
    combined_data.bag_type_no,
    combined_data.customer_bag_no,
    combined_data.sku_no,
    combined_data.lot_code,
    combined_data.commodity_name
ORDER BY
    combined_data.display_name,
    combined_data.inv_type,
    combined_data.inv_no,
    combined_data.inv_dt,
    combined_data.bag_type_no,
    combined_data.customer_bag_no,
    combined_data.sku_no,
    combined_data.commodity_name,
    combined_data.lot_code;
]]>
	</queryString>
