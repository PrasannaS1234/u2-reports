<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StoneDemand" pageWidth="859" pageHeight="842" columnWidth="849" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="217"/>
	<property name="ireport.y" value="0"/>
	<parameter name="soNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'01/02/2022'"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'01/02/2022'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityIds" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGrpIds" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
     max(lot.lot_code) lot_code,
     max(cm.commodity_name) commodity_name,
     max(shp.shape_name) shape_name,
     max(col.color_name) color_name,
     max(socm.sieve) sieve,
     max(socm.mm_size) mm_size,
     max(clt.clarity_name) clarity_name,
     sum(sod.qty * (socm.qty1 * socm.qty2)) cts,
     sum(sod.qty * socm.qty2) pcs,
     max(cmp.company_name) company_name
from
    tbl_sales_order_main som
    inner join tbl_sales_order_det sod on som.sales_order_id = sod.sales_order_id
       and sod.is_deleted = 0
    inner join tbl_sales_order_component socm on sod.sales_order_det_id = socm.sales_order_det_id
       and socm.is_deleted = 0
    inner join tbl_customer cs on som.customer_id = cs.customer_id
    left join tbl_lot lot on socm.lot_Id = lot.lot_id
    inner join tbl_commodity cm on socm.commodity_id = cm.commodity_id
    inner join tbl_shape shp on socm.shape_id = shp.shape_id
    inner join tbl_company cmp on som.company_id = cmp.company_id
    left join tbl_color col on socm.color_id = col.color_id
    left join tbl_clarity clt on socm.clarity_id = clt.clarity_id
where
    som.is_deleted = 0
    and (som.sales_order_no in ($P!{soNos}) or ' ' in ($P!{soNos}))
    and som.sales_order_date >= to_date($P!{fromDate},$P{dateFormat})
    and som.sales_order_date <= to_date($P!{toDate},$P{dateFormat})
    and (cm.commodity_id in ($P!{commodityIds}) or -1 in ($P!{commodityIds}))
    and (cm.commodity_group_id in ($P!{commodityGrpIds}) or -1 in ($P!{commodityGrpIds}))
    and lower(cs.customer_name) like '%'||lower(trim($P!{customerLike}))||'%'
group by
    (lot.lot_code),
    (cm.commodity_name),
    (shp.shape_name),
    (col.color_name),
    (socm.sieve),
    (socm.mm_size)
     ]]>
	</queryString>
	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="color_name" class="java.lang.String"/>
	<field name="sieve" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="clarity_name" class="java.lang.String"/>
	<field name="cts" class="java.math.BigDecimal"/>
	<field name="pcs" class="java.math.BigDecimal"/>
	<field name="company_name" class="java.lang.String"/>
	<variable name="cts_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cts}]]></variableExpression>
	</variable>
	<variable name="pcs_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{pcs}]]></variableExpression>
	</variable>
