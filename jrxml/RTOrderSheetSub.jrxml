<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetailsSub" pageWidth="566" pageHeight="842" columnWidth="566" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_so_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITh v_comp AS (
	select
		component_id,
		row_number() over (order by 1) recusrive_level,
		id.commodity_id,
		(comm.commodity_name) commodity_name,
		(sh.shape_name) shape_name,
		(id.mm_size) mm_size,
		(id.sieve) sieve,
		(lot.lot_code) grade,
		(id.tot_qty) qty1,
		(id.qty2) qty2,
		(id.tot_qty * j.qty) total_wt
	from
		tbl_sales_order_component id
		inner join tbl_sales_order_det sd on id.sales_order_det_id = sd.sales_order_det_id
	inner join tbl_jewellery j on sd.sales_order_det_id = j.sales_order_det_id
		and j.job_category = 'Normal'
		left join tbl_lot lot on id.lot_id = lot.lot_id
		inner join tbl_commodity comm on id.commodity_id = comm.commodity_id
		left join tbl_shape sh on id.shape_id = sh.shape_id
		left join tbl_color cl on id.color_id = cl.color_id
	where
		id.is_deleted = 0
		and id.sales_order_det_id in ($P!{i_so_det_id})
	order by
		 component_id
 ),
 v_max as (
	 select max(recusrive_level) recusrive_level,
	 max(component_id) component_id
	 from v_comp
 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		recusrive_level,
		0 commodity_id,
		null commodity_name,
		null shape_name,
		null mm_size,
		null sieve,
		null grade,
		nullif(0,0) qty1,
		nullif(0,0) qty2,
		nullif(0,0) total_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,7) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
	</queryString>
	<field name="component_id" class="java.lang.Long"/>
	<field name="recusrive_level" class="java.lang.Long"/>
	<field name="commodity_id" class="java.lang.Integer"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="sieve" class="java.lang.String"/>
	<field name="grade" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="total_wt" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
