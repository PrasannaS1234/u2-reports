<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RMTransfer" pageWidth="760" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="740" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
rm.inv_id,
rm.inv_type || '-' || rm.inv_no AS inv_type_no,
TO_CHAR(rm.inv_dt, 'DD-MM-YYYY') AS inv_dt,
rm.issue_return_type,
f.factory_name from_factory,
ft.factory_name to_factory,
d.department_name from_department,
dt.department_name to_department,
e.first_name from_employee,
et.first_name to_employee,
rd.transfer_qty1 qty1,
rd.transfer_qty2 qty2,
rd.stone_size stock_size,
l.lot_code,
b.bin_name,
c.company_name,
rm.remarks
from tbl_mfg_rm_transfer rm
inner join tbl_mfg_rm_transfer_det rd on rm.inv_id = rd.inv_id
and rd.is_deleted = 0
left join tbl_factory f on rm.from_factory_id = f.factory_id
and f.is_deleted = 0
left join tbl_department d on rm.from_department_id = d.department_id
and d.is_deleted = 0
left join tbl_employee e on rm.from_employee_id = e.employee_id
and e.is_deleted = 0
left join tbl_factory ft on rm.to_factory_id = ft.factory_id
and ft.is_deleted = 0
left join tbl_department dt on rm.to_department_id = dt.department_id
and dt.is_deleted = 0
left join tbl_employee et on rm.to_employee_id = et.employee_id
and e.is_deleted = 0
left join tbl_lot l on rd.lot_id = l.lot_id
and l.is_deleted = 0
left join tbl_bin b on rd.bin_id = b.bin_id
and b.is_deleted = 0
left join tbl_company c on rm.company_id = c.company_id
and  c.is_deleted = 0
where rm.inv_id in ($P!{i_inv_id})
order by rm.inv_id]]>
	</queryString>
