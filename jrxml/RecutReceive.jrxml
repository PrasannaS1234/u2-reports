<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKK" pageWidth="760" pageHeight="595" whenNoDataType="AllSectionsNoDetail" columnWidth="750" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
          t.receive_id,
	comp.company_name,
	concat(t.receive_type,'-',t.receive_no) receive_no,
          t.receive_dt,
          t.reference_no,
          t.recut_type,
          t.description,
          lot.lot_code,
          case when det.stone_size = 'NA' then '' else det.stone_size end as size,
          ROUND(det.qty1, 4) AS qty1,
          det.qty2,
          fac.factory_name,
          det.broken_qty1,
          det.broken_qty2,
          det.loss_qty1,
          det.loss_qty2,
          issue_lot.lot_code issue_lot,
          concat(issuemain.issue_type,'-',issuemain.issue_no) issue_no
from
    tbl_recut_receive t
    inner join tbl_recut_receive_det det on t.receive_id = det.receive_id and det.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
    left join tbl_lot lot on det.lot_id = lot.lot_id
    left join tbl_factory fac on t.factory_id = fac.factory_id
    left join tbl_recut_issue_det issue on det.issue_det_id = issue.issue_det_id
    left join tbl_lot issue_lot on issue.lot_id = issue_lot.lot_id
    left join tbl_recut_issue issuemain on det.issue_id = issuemain.issue_id

where
      t.is_deleted = 0
    and t.receive_id = $P!{i_inv_id}
order by
det.issue_det_id]]>
	</queryString>
