	<subDataset name="dataset1" uuid="f2820699-e1b8-44d5-94fe-b9505c485156">
		<parameter name="i_inv_id" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select inv_id, charge_name, (plus_minus_flag * input_amt) amt from tbl_jew_memo_sales_invoice_chgs cg where is_deleted = 0
AND INV_ID = $P!{i_inv_id}
order by cg.charge_id]]>
		</queryString>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_qty_param" class="java.lang.String"/>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select  row_number() over(order by $P!{sortColumn}) srno,tmp.* from (
select
	dt.inv_det_id,
	im.inv_id,
	(im.inv_type||im.inv_no) invoive_no,
    (im.currency) currency,
    prd.product_type_name,
	(im.exchange_rate) exchange_rate,
    (to_char(im.inv_dt, $P{dateFormat})) invoice_dt,
    pty.payment_type_name    invoice_due_dt,
    (jt.jew_type||jt.jew_no) jew_no,
    sku.sku_no,
	upper((cmp.company_name)) company_name,
	(concat(cmp.street,',',cmp.area)) company_address1,
	(concat(cmp.city,',',cmp.state,'-',cmp.pin_code,',',cnt.country_name)) company_address2,
	(concat('Tel : ',cmp.phone_number,' ','Fax :',cmp.fax_no)) company_address3,
	(cus.customer_name) customer_name,
	(im.ship_address1) ship_address1,
	(concat(im.ship_city,',',im.ship_state,'-',im.ship_pincode)) ship_address2,
	(im.ship_country) ship_address3,
	(im.bill_address1) bill_address1,
	(concat(im.bill_city,',',im.bill_state,'-',im.bill_pincode)) bill_address2,
	(im.bill_country) bill_address3,
	(dt.prod_description) prod_description,
	(case when $P!{i_qty_param} = 'ALL' then dt.inv_qty
		 when $P!{i_qty_param} = 'PENDING' then dt.inv_qty - dt.conf_qty - dt.ret_qty
		 else dt.inv_qty
		end) inv_qty,
	(lt.lot_code) metal_lot,
	round((dt.input_rate),2) input_rate,
	round((dt.input_amt),2) input_amt,
	coalesce(lp.white_diamond_wt,'') dia_qty,
	coalesce(lp.color_diamond_wt,'') cs_qty,
	coalesce(lp.metal_wt,0) metal_qty,
	coalesce(chgs.chgs_amt,0) chgs_amt,
	sum(dt.input_amt) over (partition by im.inv_id order by im.inv_id) + coalesce(chgs.chgs_amt,0) total_amount,
	(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)) image_url,
	coalesce(lp.tag_price,0) tag_price
from
	tbl_jew_memo_sales_invoice_main im
	inner join tbl_jew_memo_sales_invoice_det dt on im.inv_id = dt.inv_id
		and dt.is_deleted = 0
		and (dt.inv_qty - dt.ret_qty - dt.conf_qty >= (case when $P!{i_qty_param} = 'PENDING' then 1 else 0 end ))
	inner join tbl_jewellery jt on dt.jew_id =jt.jew_id
	inner join tbl_sku sku on jt.sku_id = sku.sku_id
	inner join tbl_product_type prd on sku.product_type_id = prd.product_type_id
	inner join tbl_company cmp on im.company_id = cmp.company_id
	inner join tbl_country cnt on cmp.country_id = cnt.country_id
	inner join tbl_customer cus on im.customer_id = cus.customer_id
         left join(
		select inv_id, sum(plus_minus_flag * input_amt) chgs_amt from tbl_jew_memo_sales_invoice_chgs cg where is_deleted = 0
		group by inv_id
	)chgs on dt.inv_id = chgs.inv_id
	left join (
		select row_number() over (partition by lab.sku_id order by lab.printing_id desc) sno,
		lab.*
		from tbl_label_printing lab where lab.is_deleted = 0
	)lp on sku.sku_id = lp.sku_id
		and lp.sno = 1
	left join tbl_lot lt on lp.metal_id = lt.lot_id
	left join tbl_payment_type pty on im.payment_type_id = pty.payment_type_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
)tmp
order by $P!{sortColumn}]]>
	</queryString>
	<field name="srno" class="java.lang.Long"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="invoive_no" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="invoice_dt" class="java.lang.String"/>
	<field name="invoice_due_dt" class="java.lang.String"/>
