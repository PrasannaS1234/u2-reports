	<field name="bill_address3" class="java.lang.String"/>
	<field name="prod_description" class="java.lang.String"/>
	<field name="inv_qty" class="java.math.BigDecimal"/>
	<field name="metal_lot" class="java.lang.String"/>
	<field name="input_rate" class="java.math.BigDecimal"/>
	<field name="input_amt" class="java.math.BigDecimal"/>
	<field name="dia_qty" class="java.lang.String"/>
	<field name="cs_qty" class="java.lang.String"/>
	<field name="metal_qty" class="java.math.BigDecimal"/>
	<field name="chgs_amt" class="java.math.BigDecimal"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="tag_price" class="java.math.BigDecimal"/>
	<variable name="input_amt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="BAG" calculation="Sum">
		<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
	</variable>
	<variable name="carats_1" class="java.math.BigDecimal" resetType="Group" resetGroup="BAG" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty}]]></variableExpression>
	</variable>
	<variable name="v_thb" class="java.math.BigDecimal">
		<variableExpression><![CDATA[new BigDecimal($V{input_amt_1}.doubleValue()*$V{v_thb}.doubleValue())]]></variableExpression>
	</variable>
