<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Design" pageWidth="2400" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="2360" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.207882500000005"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="departmentId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="marketId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="designNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewTypeNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tcomp.company_name,
	tcus.customer_name,
	so.order_type,
	to_char(so.sales_order_date,$P{dateFormat}) so_dt,
	to_char(so.delivery_date,$P{dateFormat}) delivery_dt,
	concat(so.sales_order_type,'-',so.sales_order_no) so_no,
	so.status,
	jt.status	prod_status,
	sku.sku_no,
	d.design_no,
	met.lot_code,
	sod.qty,
	jt.finv_qty mfg_qty,
	0	ship_qty,
	sod.qty - 0 pend_qty,
	case when jt.jew_id is not null then trim(concat(jt.jew_type,jt.jew_no)) end  jewel_no,
	fac.factory_name,
  	sod.customer_order_no,
	sod.customer_sku_no,
	sod.customer_jew_no,
	sod.stamping_remarks,
	sod.prod_remarks,
	sod.diamond_remarks,
	sod.gemstone_remarks
from
	tbl_sales_order_main so
	inner join tbl_sales_order_det sod on so.sales_order_id = sod.sales_order_id
		and sod.is_deleted = 0
	inner join tbl_company tcomp on so.company_id = tcomp.company_id
	left join tbl_customer tcus on so.customer_id = tcus.customer_id
	left join tbl_sku sku on sod.sku_id = sku.sku_id
		and (sku.sku_no  in ($P!{skuNo}) or ' ' in ($P!{skuNo}))
		and (sku.market_id  in ($P!{marketId}) or -1 in ($P!{marketId}))
	left join tbl_design d on sku.design_id = d.design_id
		and (d.design_no  in ($P!{designNo}) or ' ' in ($P!{designNo}))
	left join tbl_lot met on sod.metal_id = met.lot_id
	left join tbl_jewellery jt on sod.sales_order_det_id = jt.sales_order_det_id
	    and (concat(jt.jew_type,jt.jew_no) in ($P!{jewTypeNo}) or ' ' in ($P!{jewTypeNo}))
	left join tbl_factory fac on jt.factory_id = fac.factory_id
where
	so.is_deleted = 0
	and so.sales_order_date between  to_date($P{fromDate}, $P{dateFormat}) and  to_date($P{toDate}, $P{dateFormat})
order by
	so.company_id,
	so.sales_order_date]]>
	</queryString>
