<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Design" pageWidth="1900" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1860" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.2078825000000044"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="departmentId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="marketId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tcomp.company_name,
	d.design_no,
	to_char(d.created_dt,$P{dateFormat}) design_dt,
	to_char(d.created_dt,'Month')	design_month,
	concat(EXTRACT(DAY FROM current_date - d.created_dt),' Days') AS design_age,
	pt.product_type_name,
	ps.product_size,
	d.uom,
	trim(concat(e.first_name,' ', e.last_name)) designer,
	col.collection_name,
	tcus.customer_name,
	mt.market_name,
	fac.factory_name,
	d.description,
	lot.lot_code metal,
	d.metal_weight,
	d.category,
	d.family,
	d.stamping_remarks,
	d.prod_remarks
from
tbl_design d
left join tbl_product_type pt on d.product_type_id = pt.product_type_id
	and (cast(pt.product_type_id as text) in ($P!{productTypeId}) or '-1' in ($P!{productTypeId}))
left join tbl_product_size ps on d.product_size_id = ps.size_id
left join tbl_market mt on d.market_id = mt.market_id
	and (cast(mt.market_id as text) in ($P!{marketId}) or '-1' in ($P!{marketId}))
left join tbl_employee e on d.designer_id = e.employee_id
left join tbl_factory fac on d.factory_id = fac.factory_id
inner join tbl_company tcomp on d.company_id = tcomp.company_id
left join tbl_lot lot on d.metal_id = lot.lot_id
left join tbl_customer tcus on d.customer_id = tcus.customer_id
	and (cast(tcus.customer_id as text) in ($P!{customerId}) or '-1' in ($P!{customerId}))
left join tbl_collection col on d.collection_id = col.collection_id
	and (cast(col.collection_id as text) in ($P!{collectionId}) or '-1' in ($P!{collectionId}))
where
	(cast(d.company_id as text) in ($P!{companyId}) or '-1' in ($P!{companyId}))
	and d.created_dt between  to_date($P{fromDate}, $P{dateFormat}) and  to_date($P{toDate}, $P{dateFormat})
order by
	d.company_id,
	d.created_dt asc]]>
	</queryString>
