<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetails" pageWidth="2750" pageHeight="842" columnWidth="2740" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.1269722013523664"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["D:\\Office Workings\\Report Development\\ireports\\Jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["d.commodity_type asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over () as sno,
    d.*
from (
    select
        t.inv_id,
        d.jew_id as inv_det_id,
        max(concat(t.inv_type||'-'||t.inv_no)) as inv_type_no,
max(t.inv_dt)inv_dt,
max(c.customer_name)customer_name,
max(t.rate_type)rate_type,
max(t.currency) currency,
max(t.exchange_rate) exchange_rate,
max(t.gold_rate) gold_rate_main,
max(t.platinum_rate)platinum_rate,
max(t.silver_rate)silver_rate,
	max(t.reference_no)reference_no,
	max(t.remarks)note,
        max(concat(j.jew_type,j.jew_no)) as job_no,
        max(od.so_no) as so_no,
        max(od.sod_no) as sod_no,
        max(sku.sku_no) as sku_no,
 max(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)) as image_url,
        max(pr.product_type_name) as product_type_name,
        max(lot1.lot_code) as metal_code1,
        max(ps.product_size) as product_size,
	    MAX(com.metal_type) as commodity_type,
        case when MAX(UPPER(com.metal_type)) LIKE '%GOLD%' THEN  sum(COALESCE(net.net_wt,0)) end AS gold_net_wt,
case when MAX(UPPER(com.metal_type))  like '%SILVER%' THEN  sum(COALESCE(net.net_wt,0)) end  AS silver_net_wt,
        sum(d.qty) as qty,
        sum(COALESCE(net.gross_wt,0)) as gross_wt,
        sum(COALESCE(net.net_wt,0)) as net_wt,

        sum(net.stone_qty1) as stone_qty1,
        sum(net.stone_qty2) as stone_qty2,
        sum(net.stone_amt) as stone_amt,
        sum(net.side_stone_qty1) as side_stone_qty1,
        sum(net.side_stone_qty2) as side_stone_qty2,
        sum(net.side_stone_amt) as side_stone_amt,
        sum(net.gold_rate) / sum(net.net_wt) gold_rate,
        sum(net.gold_amt) as gold_amt,
        max(net.metal_amt)metal_amt,
        sum(COALESCE(lab.amount,0)) as labour,
        sum(COALESCE(net.stone_amount,0)) as stone_amount,
	    (max(net.gold_amt) + sum(COALESCE(lab.amount,0)) +  sum(COALESCE(net.stone_amount,0))
        ) AS total_amount
    from tbl_jew_packing_list_main t
    inner join tbl_jew_packing_list_det d
        on t.inv_id = d.inv_id and d.is_deleted = 0
inner join tbl_customer c on t.customer_id = c.customer_id
and c.is_deleted =0
    inner join tbl_jewellery j
        on d.jew_id = j.jew_id

    left join (
        select
            concat(so.sales_order_type,'-',so.sales_order_no) so_no,
            concat(sod.sales_order_det_type,'-',sod.sales_order_det_no) sod_no,
            j.jew_id,
            'Normal' job_category
        from tbl_jewellery j
        left join tbl_sales_order_main so
            on so.sales_order_id = j.sales_order_id and so.is_deleted = 0
        left join tbl_sales_order_det sod
            on j.sales_order_det_id = sod.sales_order_det_id and sod.is_deleted = 0
        where j.is_deleted = 0 and job_category = 'Normal'

        union all

        select
            concat(so.repair_order_type,'-',so.repair_order_no) so_no,
            ' ' as sod_no,
            j.jew_id,
            'Repair' job_category
        from tbl_jewellery j
        inner join tbl_repair_order_main so
            on so.repair_order_id = j.sales_order_id
        inner join tbl_repair_order_det sod
            on sod.repair_order_det_id = j.sales_order_det_id
        where j.is_deleted = 0 and job_category = 'Repair'
    ) od
        on od.jew_id = j.jew_id and j.job_category = od.job_category

    inner join tbl_sku sku on j.sku_id = sku.sku_id
    inner join tbl_product_type pr on sku.product_type_id = pr.product_type_id
    left join tbl_lot lot1 on j.metal_id = lot1.lot_id
	left join tbl_commodity com on lot1.commodity_id = com.commodity_id
    left join tbl_product_size ps on j.product_size_id = ps.size_id

    left join (
        select
comp.inv_det_id,
            sum(case when lot.lot_type = 'METAL' then comp.consumed_wt else 0 end) net_wt,
            round(sum(case
                when lot.lot_type = 'METAL' then comp.consumed_wt
                when lot.lot_type = 'STONE' then comp.consumed_wt * 0.2
                else 0 end),3) gross_wt,
		sum((case when lot.lot_type = 'METAL' then comp.consumed_wt else 0 end) *
                (case when lot.lot_type = 'METAL' then comp.sales_rate_local else 0 end)) gold_rate,
            sum((case when lot.lot_type = 'METAL' then comp.total_wt else 0 end) *
                (case when lot.lot_type = 'METAL' then comp.sales_rate_local else 0 end)) gold_amt,
            sum(case when lot.lot_type = 'METAL' then comp.sales_rate_local else 0 end) metal_rate,
		            sum(case when lot.lot_type = 'METAL' then comp.sales_amount_local else 0 end) metal_amt,
            round(sum(case when lot.lot_type = 'STONE' then comp.consumed_wt * comp.sales_rate_local else 0 end),2) stone_amount,

            SUM(case when lot.lot_type = 'STONE' AND upper(com.metal_type) <> 'DIAMOND' then comp.consumed_wt END) stone_qty1,
            SUM(case when lot.lot_type = 'STONE' AND upper(com.metal_type) <> 'DIAMOND' then comp.consumed_pcs END) stone_qty2,
            SUM(case when lot.lot_type = 'STONE' AND upper(com.metal_type) <> 'DIAMOND' then round(comp.consumed_wt * comp.sales_rate_local,2) END) stone_amt,

            SUM(case when lot.lot_type = 'STONE' AND upper(com.metal_type) = 'DIAMOND' then comp.consumed_wt END) side_stone_qty1,
            SUM(case when lot.lot_type = 'STONE' AND upper(com.metal_type) = 'DIAMOND' then comp.consumed_pcs END) side_stone_qty2,
            SUM(case when lot.lot_type = 'STONE' AND upper(com.metal_type) = 'DIAMOND' then round(comp.consumed_wt * comp.sales_rate_local,2) END) side_stone_amt

        from tbl_jew_packing_list_component comp
        inner join tbl_lot lot on comp.lot_id = lot.lot_id
        inner join tbl_commodity com on lot.commodity_id = com.commodity_id
        where comp.is_deleted = 0
        group by comp.inv_det_id
    ) net on d.inv_det_id = net.inv_det_id

    left join (
        select la.inv_det_id, sum(la.sales_amount_local) amount
        from tbl_jew_packing_list_process_labor la
        where la.is_deleted = 0
        group by la.inv_det_id
    ) lab on d.inv_det_id = lab.inv_det_id

    where t.is_deleted = 0
      and t.inv_id in ($P!{i_inv_id})

    group by t.inv_id, d.jew_id
) d

order by $P!{sortColumn}
]]>
	</queryString>
