<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CertifiedDIAStockReport" pageWidth="1825" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1785" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="rate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'CP'"]]></defaultValueExpression>
	</parameter>
	<parameter name="carat_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="carat_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="shape_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="cut_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="color_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="clarity_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="mm_size" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="certificate_no" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="carat_qty" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select res.*, res.inv_qty1 * res.pp_rate pp_amount from (
select
	tx.*,
 	fn_rm_pp_wac(product_id,company_id,$P{toDate}, $P{dateFormat},$P{currency}) pp_rate
from (
select
		max(tcomp.company_id) company_id,
		max(tcomp.company_name) company_name,
		prod.lot_id	product_id,
		max(tcomg.commodity_group_name) commodity_group_name,
		max(tcom.commodity_name) commodity_name,
		max(prod.lot_code) product_no,
		max(tbin.bin_id) bin_id,
		max(tbin.bin_name) bin_name,
		max(prod.description) description,
		max(prod.measurement_lxb_h) measurement,
		max(sh.shape_name) shape_name,
		max(cut.cut_name) cut_name,
		max(col.color_name) color_name,
		max(cla.clarity_name) clarity_name,
		max(prod.sieve_size) sieve_size,
		max(prod.mm_size) mm_size,
		sum(stk.in_out_flag * stk.qty1) inv_qty1,
		max(prod.fluorescence) fluorescence,
		max(prod.ratio) ratio,
		max(prod.depth) depth,
		max(prod.table_description) table_description,
		max(prod.polish) polish,
		max(prod.symmetry) symmetry,
		max(prod.cutlet) cutlet,
		max(prod.gradle) gradle,
		max(prod.rapaport_price) rapaport_price,
		max(prod.discount) discount,
		max(prod.rapaport_price * (prod.discount/100)) discount_price,
		max(prod.lab_name) lab_name,
		max(prod.certificate_no) certificate_no
	from
		tbl_lot_stock_trans stk
		inner join tbl_company tcomp on stk.company_id = tcomp.company_id
		inner join tbl_lot prod on stk.lot_id = prod.lot_id
		inner join tbl_bin tbin on stk.bin_id = tbin.bin_id
		inner join tbl_commodity tcom on prod.commodity_id = tcom.commodity_id
		inner join tbl_commodity_group tcomg on tcom.commodity_group_id = tcomg.commodity_group_id
		    and tcomg.commodity_group_type like ('%CERT%')
		left join tbl_shape sh on prod.shape_id = sh.shape_id
		left join tbl_cut cut on prod.cut_id = cut.cut_id
		left join tbl_color col on prod.color_id = col.color_id
		left join tbl_clarity cla on prod.clarity_id = cla.clarity_id
	where
		stk.is_deleted = 0
		and (prod.commodity_id in ($P!{commodityId}) or -1 in ($P!{commodityId}))
		and (prod.commodity_group_id in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
		and (prod.shape_id in ($P!{shape_ids}) or - 1 in ($P!{shape_ids}))
		and (prod.cut_id in ($P!{cut_ids}) or - 1 in ($P!{cut_ids}))
		and (prod.color_id in ($P!{color_ids}) or - 1 in ($P!{color_ids}))
		and (prod.clarity_id in ($P!{clarity_ids}) or - 1 in ($P!{clarity_ids}))
                     and (stk.qty1 in ($P!{carat_qty}) or - 1 in ($P!{carat_qty}))
        and (prod.mm_size in ($P!{mm_size}) or ' ' in ($P!{mm_size}))
		and (prod.certificate_no in ($P!{certificate_no}) or ' ' in ($P!{certificate_no}))
		and (prod.carat_weight >= $P!{carat_wt_from} or - 1 = ($P!{carat_wt_from}))
        and (prod.carat_weight <= $P!{carat_wt_to} or - 1 = ($P!{carat_wt_to}))
	group by
		prod.lot_id
	having
	 (sum(stk.in_out_flag * stk.qty1) <> 0 or
		sum(stk.in_out_flag * stk.qty2) <> 0)
	order by
		commodity_name,
		shape_name,
		cut_name,
		color_name,
		clarity_name,
		lab_name) tx ) res]]>
	</queryString>
