	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[Select
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    emp.first_name||'-'||emp.last_name salesman_name,
    tcus.customer_name,
    concat(prod.jew_type,prod.jew_no) product_no,
    pt.product_type_name,
    mk.market_name,
    col.collection_name,
    prod.design_no,
    prod.sku_no,
    tcomp.company_name,
    id.prod_description,
    id.inv_qty,
    id.uom,
    id.input_rate,
    id.input_amt,
    id.discount_type,
    id.discount_value,
    id.cost_price,
    id.input_amt - id.cost_price gp_amt,
    round(case when id.input_amt > 0 then ((id.input_amt - id.cost_price) / id.input_amt) * 100 else 0 end,2) gp_pct

from
    $P!{schema}.tbl_jew_sales_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join $P!{schema}.tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
        and (cast(id.bin_id as text) in ($P!{binId}) or '-1' in ($P!{binId}))
        and id.is_deleted = 0
    inner join $P!{schema}.tbl_customer tcus on im.customer_id = tcus.customer_id
    inner join $P!{schema}.tbl_jewellery prod on id.jew_id = prod.jew_id
	and (cast(prod.jew_id as text) in ($P!{jewId}) or '-1' in ($P!{jewId}))
	and (cast(prod.design_id as text) in ($P!{designId}) or '-1' in ($P!{designId}))
	and (cast(prod.sku_id as text) in ($P!{skuId}) or '-1' in ($P!{skuId}))
    left join $P!{schema}.tbl_employee emp on im.salesman_id = emp.employee_id
left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
	and (cast(pt.product_type_id as text) in ($P!{productTypeId}) or '-1' in ($P!{productTypeId}))
left join tbl_market mk on prod.market_id = mk.market_id
	and (cast(mk.market_id as text) in ($P!{marketId}) or '-1' in ($P!{marketId}))
left join tbl_collection col on prod.collection_id = col.collection_id
	and (cast(col.collection_id as text) in ($P!{collectionId}) or '-1' in ($P!{collectionId}))
where
    im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    and (cast(tcus.customer_id as text) in ($P!{customerId}) or '-1' in ($P!{customerId}))
Order by
im.inv_dt,
im.inv_id]]>
	</queryString>
