					<box leftPadding="2" rightPadding="2"/>
					<imageExpression><![CDATA[$F{image_url}]]></imageExpression>
				</image>
			</frame>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="37" height="90" isPrintWhenDetailOverflows="true" uuid="1b6485b6-0a80-4df0-a932-9ccdef6e3179"/>
				<box>
					<topPen lineWidth="0.5"/>
