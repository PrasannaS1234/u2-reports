<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetails" pageWidth="1370" pageHeight="842" columnWidth="1360" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
       row_number() over(order by sod.sales_Order_det_id) sno,
       som.sales_Order_id,
       sod.sales_Order_det_id,
       som.sales_order_type || '-' || som.sales_order_no order_no,
       to_char(som.sales_order_date, 'dd/mm/yyyy') order_dt,
       to_char(som.delivery_date, 'dd/mm/yyyy') delivery_date,
       cs.customer_name,
       fac.factory_name,
       sku.sku_no,
       ps.product_size,
       sku.factory_ref_no,
       pt.product_type_name,
       sod.customer_jew_no,
       ps.product_size,
       jlt.qty qty,
       p.parameter_name,
       sod.stamping_remarks,
       sod.prod_remarks,
       jlt.jew_type||jlt.jew_no jobno,       concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url) image_url,
       spfn.sp_name,
       round(sod.metal_wt,1) metal_wt,
       lot.lot_code metal_lot,
       lot.uom1,
       cmp.company_name,
       case
        when coalesce(finv.qty1, 0) = 0 then 'PENDING'
        when (jlt.qty - finv.qty1) = 0 then 'INVOICED'
        else concat(('PARTIAL '),'(',ROUND(finv.qty1,2),')')
        end as status
  from tbl_sales_order_main som
 inner join tbl_customer cs on som.customer_id = cs.customer_id
 inner join tbl_factory fac on som.factory_id = fac.factory_id
 inner join tbl_sales_order_det sod on som.sales_order_id = sod.sales_order_id
   and sod.is_deleted = 0
 inner join tbl_sku sku on sod.sku_id = sku.sku_id
   and sku.is_deleted = 0
 inner join tbl_product_type pt on sku.product_type_id = pt.product_type_id
   and pt.is_deleted = 0
 left join tbl_jewellery jlt on sod.sales_order_det_id = jlt.sales_order_det_id and jlt.is_deleted = 0
 inner join tbl_company cmp on som.company_id = cmp.company_id
 left join tbl_lot lot on sod.metal_id = lot.lot_id
 left join tbl_global_parameter p on  p.parameter_group = 'CATEGORY' and sku.category = p.parameter_code
     and p.is_deleted = 0
 left join tbl_product_size ps on sod.product_size_id = ps.size_id
   and ps.is_deleted = 0
left join (
    select
        jew_id,
        SUM(inv_qty) AS qty1
    from
        tbl_factory_invoice_det finv
    where
        finv.is_deleted = 0
    group by
        finv.jew_id
) finv on finv.jew_id = jlt.jew_id

 left join
     (
	select
	     sspf.sales_order_det_id,
	     max(sspf.sales_order_id) sales_order_id,
	     string_agg(distinct sp.name,',') sp_name
	from
	    tbl_sales_order_special_finish sspf
	    inner join tbl_special_finish sp on sspf.special_finish_id = sp.special_finish_id
	where
	    sspf.sales_order_id in ($P!{i_inv_id})
	    and sspf.is_deleted = 0
	    and sp.is_deleted = 0
	group by
	    sspf.sales_order_det_id
      ) spfn on spfn.sales_order_det_id = sod.sales_order_det_id
 where
      som.is_deleted = 0
      and som.sales_order_id in ($P!{i_inv_id})]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="sales_order_id" class="java.lang.Integer"/>
	<field name="sales_order_det_id" class="java.lang.Integer"/>
	<field name="order_no" class="java.lang.String"/>
	<field name="order_dt" class="java.lang.String"/>
	<field name="delivery_date" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="factory_ref_no" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="customer_jew_no" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="parameter_name" class="java.lang.String"/>
