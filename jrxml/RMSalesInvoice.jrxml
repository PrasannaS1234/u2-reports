	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<parameter name="sortColumn" class="java.lang.String">
			<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    row_number() over(order by $P!{sortColumn}) sno,
    tmp.*
from
(
with dt as (
select row_number() over (order by  id.inv_det_id) srno,
    id.inv_id,
id.inv_det_id,
    id.lot_description lot_no,
com.commodity_id,
    id.mm_size,
    id.inv_qty1,
    id.input_rate,
    id.input_amt
from
    tbl_sales_invoice_det id
    inner join tbl_lot lot on id.lot_id = lot.lot_id
left join tbl_commodity com on lot.commodity_id = com.commodity_id
where
    id.is_deleted = 0
    and id.inv_id = $P!{i_inv_id}),
dm as
(
select  generate_series(1,1000) srno
)
select
dt.*
from
dm left join dt on dm.srno = dt.srno
where
(dt.srno is not null or dm.srno <= 2
)
)tmp
order by $P!{sortColumn}]]>
		</queryString>
		<field name="sno" class="java.lang.Long"/>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="inv_det_id" class="java.lang.Integer"/>
		<field name="lot_no" class="java.lang.String"/>
		<field name="commodity_id" class="java.lang.Integer"/>
		<field name="mm_size" class="java.lang.String"/>
		<field name="inv_qty1" class="java.math.BigDecimal"/>
		<field name="input_rate" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<variable name="QTY" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="ae07db0d-4235-4eb6-9024-6e785feda5e3">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
        0 sort_seq,
        sal_chg.charge_name,
        sal_chg.plus_minus_flag * input_amt amount
    from
        tbl_sales_invoice_chgs sal_chg
    where
        sal_chg.is_deleted = 0
        and sal_chg.inv_id = $P!{i_inv_id}
   /* union all
    select
        1 sort_seq,
        'Total',
        im.total_invoice_amount
    from
        tbl_sales_invoice_main im
    where
        im.is_deleted = 0
        and im.inv_id = $P!{i_inv_id}*/
     order by
        sort_seq]]>
		</queryString>
		<field name="sort_seq" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by $P!{sortColumn}) sno,
    tmp.*
from
(
select
    max(tcomp.company_name) company_name,
    max(im.inv_id) inv_id,
max(id.inv_det_id)inv_det_id,
    max(im.inv_type) inv_type,
    max(im.inv_type||'-'||im.inv_no) inv_type_no,
    to_char(max(im.inv_dt), max(coalesce(tcomp.date_format,'dd/MM/yyyy'))) inv_dt,
    max(im.currency) currency,
max(lot.lot_code)lot_no,
max(com.commodity_id)commodity_id,
	max(pyt.payment_type_name) payment_term,
    max(tsup.customer_name) customer_name,
    max(coalesce(im.bill_address1,'')) bill_addr1,
    max(coalesce(im.bill_address2,'')) bill_addr2,
    max(coalesce(im.bill_country,'')) bill_country,
    max(coalesce(im.bill_state,'')) bill_state,
    max(coalesce(im.bill_city,'')) bill_city,
    max(coalesce(im.bill_street,'')) bill_street,
    max(coalesce(im.bill_pincode,'')) bill_pincode,
    (max(coalesce(tcomp.street,''))) address1,
    (max(coalesce(tcomp.area,''))) address2,
    (max(coalesce(tcomp.city,'')) || ', ' || max(coalesce(tcomp.state,'')) || ' ' || max(coalesce(tcomp.pin_code,'')) ||
	 ', ' || max(coalesce(tcou.country_name,''))
    ) address3,
    max(tcomp.email) comp_email,
    max(phone_number) comp_phone_no,
    max(tcomp.website) comp_website,
    max(coalesce(tcomp.payment_address,'')) payment_address,
    max(coalesce(im.terms_conditions,'')) terms_conditions,
    max(im.total_invoice_amount) grossAmount,
    max(cmbnk.beneficiary_name) benificiary_name,
    max(cmbnk.bank_name) bank_name,
    max(cmbnk.bank_account_number) bank_account_number,
    max(cmbnk.ifsc_code) ifsc_code,
    max(cmbnk.routing) routing,
    max(cmbnk.bank_address) bank_address,
    upper(spellnumericvalue(max(im.total_invoice_net_amount),max(im.currency))) amount_in_words,
     concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo,
    (case when max(tcomp.log_url) is not null then true else false end) logo_print,
   case when max(im.total_charge_plus_amount) + max(im.total_charge_minus_amount) > 0 then 1 else 0 end show_chgs,
   max(im.total_invoice_net_amount) tot_amt,
   max(im.total_invoice_qty1) tot_qty1,
   max(im.total_invoice_qty2) tot_qty2,
   max(cmbnk.wire_transfer) wire_transfer
from
    tbl_sales_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
left join tbl_country tcou on tcomp.country_id= tcou.country_id
    inner join tbl_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
left join tbl_lot lot on id.lot_id = lot.lot_id
left join tbl_commodity com on lot.commodity_id = com.commodity_id
    inner join tbl_customer tsup on im.customer_id = tsup.customer_id
	inner join tbl_payment_type pyt on im.payment_type_id = pyt.payment_type_id
	left join tbl_company_bank cmbnk on tcomp.company_id = cmbnk.company_id
	    and cmbnk.is_default = 1
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
group by
    tcomp.company_id,
    im.inv_id,
    im.inv_type
)tmp

order by $P!{sortColumn}]]>
	</queryString>
