	<field name="uom2" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="shape" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="size" class="java.lang.String"/>
	<variable name="qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty1}]]></variableExpression>
	</variable>
	<variable name="qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty2}]]></variableExpression>
	</variable>
	<variable name="amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[new java.math.BigDecimal(String.format("%.2f", $F{amount}))]]></variableExpression>
	</variable>
