<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GoodsIssueNote" pageWidth="1055" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1030" leftMargin="15" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t1.inv_id,
	tcomp.company_name,
	concat(tcomp.street,', ',tcomp.area,', ',tcomp.state,', ',st.state_name,', ',tcountry.country_name) comp_address,
	COALESCE(tcomp.phone_number,'') phone_number,
	COALESCE(tcomp.fax_no,'') fax_no,
	COALESCE(tcomp.email,'') email,
	concat(t1.inv_type,'-',t1.inv_no) inv_no,
	to_char(t1.inv_dt, $P{dateFormat})  inv_dt,
	t1.remarks,
          ROUND(t2.rate, 2) rate,
          ROUND(t2.amount, 2)  amount,
	tfac.factory_name,
	CASE
          WHEN bag.bag_no IS NOT NULL THEN CONCAT(bag.bag_type, bag.bag_no)
          ELSE CONCAT(jew.jew_type, jew.jew_no)
          END AS jew_no,
	lot.lot_code,
	com.commodity_name,
	concat(COALESCE(sh.shape_name,''), ' ', COALESCE(lot.mm_size,''),' ',COALESCE(clr.color_name,''),' ',COALESCE(q.clarity_name,''),' ',COALESCE(lot.lab_name,''),' ',COALESCE(lot.certificate_no,'')) lot_desc,
	t2.qty1,
	t2.qty2,
	t2.uom1,
	t2.uom2,
	concat(so.sales_order_type,so.sales_order_no) so_no,
          CASE WHEN t2.shape_id IS NULL THEN sh.shape_name ELSE sh1.shape_name END AS shape,
	sku.sku_no,
	t2.mm_size,
         coalesce(nullif(t2.stone_size, 'NA'), '') size
from
	tbl_goods_issue_main t1
	inner join tbl_factory tfac on t1.factory_id = tfac.factory_id
	inner join tbl_goods_issue_det t2 on t1.inv_id = t2.inv_id
		and t2.is_deleted = 0
	left join tbl_jewellery jew on t2.jew_id = jew.jew_id
          left join tbl_mfg_bag bag on t2.bag_id = bag.bag_id
	inner join tbl_company tcomp on t1.company_id = tcomp.company_id
	left join tbl_state st on tcomp.state = st.state_code
	left join tbl_country tcountry on tcomp.country_id = tcountry.country_id
	left join tbl_lot lot on t2.lot_id = lot.lot_id
	left join tbl_commodity com on lot.commodity_id = com.commodity_id
	left join tbl_shape sh on lot.shape_id = sh.shape_id
          left join tbl_shape sh1 on t2.shape_id = sh1.shape_id
	left join tbl_color clr on lot.color_id = clr.color_id
	left join tbl_clarity q on lot.clarity_id = q.clarity_id
	left join tbl_sales_order_main so on COALESCE(jew.sales_order_id, t2.so_Id) = so.sales_order_id
	left join tbl_sku sku on jew.sku_id = sku.sku_id
where
	t1.is_deleted = 0
	and t1.inv_id = $P!{i_inv_id}]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="comp_address" class="java.lang.String"/>
	<field name="phone_number" class="java.lang.String"/>
