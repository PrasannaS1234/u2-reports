				<reportElement key="staticText-104" stretchType="RelativeToTallestObject" mode="Transparent" x="522" y="142" width="59" height="16" isPrintWhenDetailOverflows="true" forecolor="#008083" backcolor="#473427" uuid="7b509976-65dd-4d04-aae4-091a5f11c566"/>
