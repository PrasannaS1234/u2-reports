	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
ROW_NUMBER() OVER (ORDER BY d.inv_det_id) AS sno,
m.inv_id,
concat(m.inv_type,'-',m.inv_no) inv_no,
m.inv_det inv_dt,
ff.factory_name from_factory,
ft.factory_name to_factory,
fd.department_name,
m.issue_return_type,
m.remarks,
b.bag_type||b.bag_no bag_no,
d.bag_qty,
jew.jew_type||jew.jew_no jew_no,
sku.sku_no,
pt.product_type_name,
d.bag_gross_wt,
d.bag_metal_wt,
d.bag_net_wt,
d.bag_stone_wt,
d.bag_stone_pcs,
tcomp.company_name,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant}, 'comp', tcomp.company_id, '/company/',tcomp.company_id,tcomp.log_url) AS logo_url,
CASE
      WHEN coalesce(length(trim(jew.image_url)),0) > 0 THEN
        concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',jew.company_id,'/jewellery/',jew.jew_id,jew.image_url)
else    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)
     END AS img_url
from tbl_factory_issue m
inner join tbl_factory_issue_det d on m.inv_id = d.inv_id
and d.is_deleted = 0
left join tbl_factory ff on m.from_factory_id = ff.factory_id
and ff.is_deleted = 0
left join tbl_factory ft on m.to_factory_id =  ft.factory_id
and ft.is_deleted =0
left join tbl_department fd on m.from_department_id = fd.department_id
and fd.is_deleted =0
left join tbl_mfg_bag b on d.bag_id = b.bag_id
and b.is_deleted = 0
inner join tbl_company tcomp on m.company_id = tcomp.company_id
left join tbl_jewellery jew on d.jew_id = jew.jew_id
left join tbl_sku sku on jew.sku_id = sku.sku_id
left join tbl_product_type pt on sku.product_type_id = pt.product_type_id
where m.inv_id =$P!{i_inv_id}]]>
	</queryString>
