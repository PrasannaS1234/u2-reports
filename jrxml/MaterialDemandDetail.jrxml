<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MaterialDemand" pageWidth="871" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="861" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	m.inv_id,
	concat(m.inv_type,'-',m.inv_no) demand_no,
	to_char(m.inv_date, $P{dateFormat}) order_date,
	to_char(m.delivery_date, $P{dateFormat}) delivery_date,
	COALESCE(sup.supplier_name,dc.company_name) demand_supplier,
	concat(sm.sales_order_type,'-',sm.sales_order_no) so_no,
	d.so_id,
	sm.reference_no,
	sku.sku_no,
	sd.qty,
	l.lot_code,
	com.commodity_name,
	sh.shape_name,
	col.color_name,
	d.mm_size,
	d.sieve,
	d.grade,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url) image_url,
	cla.clarity_name,
	sc.tot_qty pc_qty1,
	sc.qty2 pc_qty2,
	d.qty1 qty1,
	d.qty2 qty2
from
	tbl_material_demand_main m
	inner join tbl_material_demand_det d on m.inv_id = d.inv_id
	and d.is_deleted = 0
	inner join tbl_commodity com on d.commodity_id = com.commodity_id
	left join tbl_sales_order_main sm on d.so_id = sm.sales_order_id
	left join tbl_sales_order_component sc on d.sales_order_component_id = sc.component_id
	and sc.is_deleted = 0
	and sm.sales_order_id = sc.sales_order_id
	left join tbl_sales_order_det sd on sc.sales_order_det_id = sd.sales_order_det_id
	and sd.is_deleted = 0
	and sm.sales_order_id = sd.sales_order_id
	left join tbl_sku sku on sd.sku_id = sku.sku_id
	left join tbl_lot l on sc.lot_id = l.lot_id
	left join tbl_shape sh on sc.shape_id = sh.shape_id
	left join tbl_color col on sc.color_id = col.color_id
	left join tbl_supplier sup on m.supplier_id = sup.supplier_id
	left join tbl_company dc on m.dest_branch_id = dc.company_id
	left join tbl_clarity cla on d.clarity_id = cla.clarity_id
where
 	m.is_deleted = 0
    and m.inv_id in ($P!{i_inv_id})
order by
	m.inv_id,
	d.so_id,
	sd.sales_order_id,
	d.inv_det_id]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="demand_no" class="java.lang.String"/>
	<field name="order_date" class="java.lang.String"/>
	<field name="delivery_date" class="java.lang.String"/>
	<field name="demand_supplier" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="so_id" class="java.lang.Integer"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
