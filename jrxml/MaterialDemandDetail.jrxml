	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="color_name" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="sieve" class="java.lang.String"/>
	<field name="grade" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="clarity_name" class="java.lang.String"/>
	<field name="pc_qty1" class="java.math.BigDecimal"/>
	<field name="pc_qty2" class="java.math.BigDecimal"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<variable name="qty1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="DemandID" calculation="Sum">
		<variableExpression><![CDATA[$F{qty1}]]></variableExpression>
	</variable>
	<variable name="qty2_1" class="java.math.BigDecimal" resetType="Group" resetGroup="DemandID" calculation="Sum">
		<variableExpression><![CDATA[$F{qty2}]]></variableExpression>
	</variable>
