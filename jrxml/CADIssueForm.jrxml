<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CADIssueForm" pageWidth="810" pageHeight="1400" columnWidth="770" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="584ec8c6-ce5d-471c-b198-86606c8bbffe">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_cad_order_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (order by m.inv_id, d.inv_det_id) sno,
	comp.company_name,
	'address' address,
	m.inv_id,
	concat(m.inv_type,'-',m.inv_no) cad_iss_no,
	m.inv_date,
	f.factory_name designer,
	m.remarks,
	d.cad_no,
	de.design_no,
	de.category,
	l.lot_code metal_code,
	p.product_type_name,
	ps.product_size,
	d.remarks,
	d.instruction,
	com.commodity_name,
	sh.shape_name,
	col.color_name,
	cut.cut_name,
	c.mm_size,
	c.tot_qty,
	c.qty2,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',de.company_id,'/sku/',de.design_id,de.image_url) image_url
from
	tbl_cad_order_main m
	inner join tbl_cad_order_det d on m.inv_id = d.inv_id
		and d.is_deleted = 0
	inner join tbl_cad_order_component c on d.inv_det_id = c.inv_det_id
		and c.is_deleted = 0
	inner join tbl_factory f on m.factory_id = f.factory_id
	inner join tbl_design de on d.design_id = de.design_id
	inner join tbl_product_type p on d.product_type_id = p.product_type_id
	inner join tbl_lot l on d.metal_id = l.lot_id
	inner join tbl_commodity com on c.commodity_id = com.commodity_id
	inner join tbl_shape sh on c.shape_id = sh.shape_id
	inner join tbl_company comp on m.company_id = comp.company_id
	left join tbl_cut cut on c.cut_id = cut.cut_id
	left join tbl_color col on c.color_id = col.color_id
	left join tbl_clarity cla on c.clarity_id = cla.clarity_id
	left join tbl_product_size ps on d.product_size_id = ps.size_id
where
	m.inv_id = $P!{i_cad_order_id}
order by m.inv_id, d.inv_det_id]]>
	</queryString>
