	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["E:\\jew-trade-service\\src\\main\\resources\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    t.inv_id,
    ROW_NUMBER() OVER (PARTITION BY t.inv_id ORDER BY det.inv_det_id ASC) AS sno,
    t.inv_dt,
    concat(t.inv_type,' - ',t.inv_no) inv_no,
    t.REFERENCE_no,
    t.remarks,
    factory.factory_name,
    rfactory.factory_name rfactory,
    concat(e.first_name,e.last_name) worker_name,
    d.department_name,
    det.receive_qty1,
    det.receive_qty2,
    det.receive_pure_qty1,
    det.receive_pure_qty2,
    det.loss_pure_qty1,
    det.loss_pure_qty2,
    l.lot_code,
    det.rate_per_gm,
    (det.rate_per_gm * det.receive_qty1) amount,
    concat(issue.inv_type, issue.inv_no) issue_no,
     (
        SELECT COUNT(*)
        FROM tbl_mfg_refining_receive_alloy_det a
        WHERE a.inv_id = t.inv_id and a.is_deleted = 0
    ) AS alloy_count


FROM
    tbl_mfg_refining_receive t
    left JOIN tbl_mfg_refining_receive_det det ON t.inv_id = det.inv_id AND det.is_deleted = 0
    LEFT JOIN tbl_factory factory ON factory.factory_id = t.factory_id
    left join tbl_factory rfactory on rfactory.factory_id = t.refining_factory_id
    Left join tbl_employee e on t.employee_id = e.employee_id
    LEFT JOIN tbl_department d on t.department_id = d.department_id
    left join tbl_lot l on det.lot_id = l.lot_id
    left join tbl_mfg_refining_issue issue on det.issue_inv_id = issue.inv_id

WHERE
    t.is_deleted = 0
    AND t.inv_id = $P!{i_inv_id}

ORDER BY
    det.inv_det_id]]>
	</queryString>
