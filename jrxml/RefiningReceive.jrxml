	<subDataset name="Table Dataset 1" uuid="77246d03-c1c6-49df-9cde-48f9ebfa370f">
		<parameter name="inv_id" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
    ROW_NUMBER() OVER () AS sno,
    lot_code,
    receive_qty1,
    receive_qty2
FROM (
    SELECT
        lot.lot_code,
        a.receive_qty1,
        a.receive_qty2
    FROM tbl_mfg_refining_receive_alloy_det a
    LEFT JOIN tbl_lot lot
        ON a.lot_id = lot.lot_id
    WHERE a.inv_id = $P!{inv_id}

) x;]]>
		</queryString>
		<field name="sno" class="java.lang.Long"/>
		<field name="lot_code" class="java.lang.String"/>
		<field name="receive_qty1" class="java.math.BigDecimal"/>
		<field name="receive_qty2" class="java.math.BigDecimal"/>
		<variable name="total_wt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{receive_qty1}]]></variableExpression>
		</variable>
		<variable name="total_pcs" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{receive_qty2}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
