<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderConfirmation" pageWidth="520" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="495" leftMargin="15" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.650000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	so.sales_order_id,
	tcomp.company_name,
	concat(tcomp.street,', ',tcomp.area,', ',tcomp.state,', ',st.state_name,', ',tcountry.country_name) comp_address,
	tcomp.phone_number,
	tcomp.fax_no,
	tcomp.email,
	tcus.customer_name,
	tcus.display_name,
	ad.address1,
	ad.address2,
	ad.address3,
	tcus.phone_no,
	concat(so.sales_order_type,'-',so.sales_order_no)	so_no,
	to_char(so.sales_order_date,'dd/MM/YYYY') so_dt,
	so.reference_no,
	'' crn,
	to_char(so.delivery_date,'dd/MM/YYYY') delivery_dt,
	'' hallmark,
	1	sr,
	''	sod_no,
	concat(jt.jew_type,jt.jew_no)	jew_no,
	sku.sku_no,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',so.company_id,'/sku/',sku.sku_id,sku.image_url)	image_url,
	lot.lot_code alloy,
	'' grade,
	sod.qty,
	ps.product_size,
	sod.prod_remarks,
	row_number() over(order by sod.sales_order_det_id asc) sr_no
from
tbl_sales_order_main so
inner join tbl_sales_order_det sod on so.sales_order_id = sod.sales_order_id
	and sod.is_deleted= 0
inner join tbl_sku sku on sod.sku_id = sku.sku_id
left join tbl_product_size ps on sod.product_size_id = ps.size_id
left join tbl_jewellery jt on sod.sales_order_det_id = jt.sales_order_det_id
inner join tbl_company tcomp on so.company_id = tcomp.company_id
left join tbl_state st on tcomp.state = st.state_code
left join tbl_country tcountry on tcomp.country_id = tcountry.country_id
left join tbl_lot lot on sod.metal_id = lot.lot_id
inner join tbl_customer tcus on so.customer_id = tcus.customer_id
left join
(
		select
			addr.customer_id,
			max(concat(addr.address1,', ', addr.address2,', ',addr.state)) address1,
			max(addr.pin_code)	address2,
			max(addr.country)	address3
		from
			tbl_customer_address addr
		where
			addr.is_deleted = 0
			and addr.default_address = 1
			and addr.address_type = 'Billing'
		group by
			addr.customer_id
) ad on tcus.customer_id = ad.customer_id
where
	so.sales_order_id = $P!{i_inv_id}]]>
	</queryString>
