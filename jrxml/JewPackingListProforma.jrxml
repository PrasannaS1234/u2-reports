	<field name="scontact_code" class="java.lang.String"/>
	<field name="scontact_phone" class="java.lang.String"/>
	<field name="scontact_name" class="java.lang.String"/>
	<field name="scontact_mobile" class="java.lang.String"/>
	<field name="scontact_fax" class="java.lang.String"/>
	<field name="scontact_email" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
