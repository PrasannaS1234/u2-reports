<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PACKINGLIST" pageWidth="2260" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="2220" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.3286707500000088"/>
	<property name="ireport.x" value="529"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_qty_param" class="java.lang.String">
		<defaultValueExpression><![CDATA["'ALL'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_type" class="java.lang.String">
		<defaultValueExpression><![CDATA["'JSI'"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["sku_no desc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
     row_number() over(order by $P!{sortColumn}) sr_no,
     tmp.*
from
(
select
    det.inv_det_id,
    row_number() over(order by det.inv_det_id) sr_no,
    ma.inv_type||'_'||ma.inv_no main_qr_code,
    ma.inv_id,
    ma.inv_no,
    ma.inv_type,
    concat(ma.inv_type,'-',ma.inv_no) inv_type_no,
    ma.salesman_id salesman_emp_id,
    ma.reference_no off_ref_no,
    to_char(ma.inv_dt,$P{dateFormat}) inv_dt,
    ma.currency	cur_code,
    ma.exchange_rate conv_rate,
    pt.payment_type_name payment_type,
    ma.inv_due_days,
    ma.inv_due_months,
    ma.inv_due_dt,
    cont.jew_no,
	concat(cont.jew_type,cont.jew_no) job_type_no,
    jt.product_type_name as product_type_name,
	sty.sku_no  	sku_no,
    det.uom,

(case
	  when $P!{i_qty_param} = 'PENDING' then ((det.inv_qty - det.ret_qty - det.conf_qty))
	  else (round(det.inv_qty,0)) end ) inv_qty,
	det.input_rate rate,
	round((case
	  when $P!{i_qty_param} = 'PENDING' then ((det.inv_qty - det.ret_qty - det.conf_qty))
	  else (round(det.inv_qty,0)) end ) * det.input_rate,2) amt,
    coalesce(ma.bill_street,'') bstreet,
    coalesce(ma.bill_address1,'') barea1,
    coalesce(ma.bill_address2,'') barea,
    coalesce(ma.bill_city,'') bcity,
    coalesce(ma.bill_pincode,'') bcity_pin,
    coalesce(ma.bill_state,'') bstate,
    coalesce(ma.bill_country,'') bcountry,
    coalesce(ma.bill_phone_no,'') bcontact_code,
    coalesce(ma.bill_phone_no,'') bcontact_phone,
    '' bcontact_name,
    coalesce(ma.bill_phone_no,'') bcontact_mobile,
    coalesce(ma.bill_fax_no,'') bcontact_fax,
    '' bcontact_email,
     ma.bill_address1,
     ma.bill_address2,
     concat(ma.bill_country,' ',ma.bill_state,' ',ma.bill_pincode) bill_address3,
     ma.ship_address1,
     ma.ship_address2,
     concat(ma.ship_country,' ',ma.ship_state,' ',ma.ship_pincode) ship_address3,
    coalesce(ma.ship_street,'') sstreet,
    coalesce(ma.ship_address1,'') sarea1,
    coalesce(ma.ship_address2,'') sarea,
    coalesce(ma.ship_city,' ') scity,
    coalesce(ma.ship_pincode,' ') scity_pin,
    coalesce(ma.ship_state,' ') sstate,
    coalesce(ma.ship_country,' ') scountry,
    coalesce(ma.ship_phone_no,' ') scontact_code,
    coalesce(ma.ship_phone_no,' ') scontact_phone,
    ' ' scontact_name,
    coalesce(ma.ship_phone_no,' ') scontact_mobile,
    coalesce(ma.bill_fax_no,' ') scontact_fax,
    ' ' scontact_email,
    coalesce(det.prod_description,sty.description) description,
    concat(pod.sales_order_type,'-',pod.sales_order_no) po_no,
    emp.first_name||' '||emp.last_name orderby,
    pd.customer_name 	cus_name,
    pd.display_name 	cus_code,
    ma.remarks,
    pt.payment_type_name payment_type,
    upper(comp.company_name) comp_off_name,
    CONCAT(comp.area,',',comp.street) comp_area,
    concat(comp.city,',',upper(st.state_name),',',upper(tc.country_name)) comp_state_name,
    concat('Tel:',comp.phone_number,' Fax:',comp.fax_no) comp_contact,
    comp.street,
    comp.website,
    pd.customer_id party_id,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/','''''','comp',sty.company_id,'/sku/',sty.sku_id,sty.image_url)	image_url,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/','''''','comp',comp.company_id,'/company/',comp.company_id,comp.log_url)	comp_logo,
	(round(coalesce(tcomp.total_gross_weight,0),3)) total_weight,
	(round(coalesce(tcomp.dia_weight,0),3)) dia_wt,
	(round(coalesce(tcomp.dia_pcs,0),0)) dia_pcs,
	(round(coalesce(tcomp.cs_weight,0),3)) cs_wt,
	(round(coalesce(tcomp.cs_pcs,0),0)) cs_pcs,
	(round(coalesce(tcomp.met_wt,0),3)) met_wt,
	tcomp.metal_code met_code,
	tcomp.metal_kt	met_kt
from
    tbl_jew_proforma_sales_invoice_main ma
    inner join tbl_jew_proforma_sales_invoice_det det on ma.inv_id = det.inv_id
		and det.is_deleted = 0
		and (det.inv_qty - det.ret_qty - det.conf_qty >= (case when $P!{i_qty_param} = 'PENDING' then 1 else 0 end ))
    inner join tbl_customer pd on ma.customer_id = pd.customer_id
    inner join tbl_jewellery cont on det.jew_id = cont.jew_id
	left join tbl_sales_order_det sdsd on cont.sales_order_det_id = sdsd.sales_order_det_id
    left join tbl_sku sty on cont.sku_id = sty.sku_id
    left join tbl_payment_type pt on ma.payment_type_id = pt.payment_type_id
    left join tbl_sales_order_main pod on cont.sales_order_id = pod.sales_order_id
    left join tbl_employee emp on pd.salesman_id = emp.employee_id
    inner join tbl_company comp on ma.company_id = comp.company_id
    LEFT JOIN tbl_country tc ON comp.country_id = tc.country_id
    left join tbl_state st on comp.state = st.state_code
    left join tbl_product_type jt on cont.product_type_id = jt.product_type_id
    left join tbl_lot t9 on cont.metal_id = t9.lot_id
    left join
	(
		select
			jc.jew_id,
			round(sum(case when tcg.commodity_group_type = 'METAL' then jc.consumed_qty1 else jc.consumed_qty1 * 0.2 end),3) total_gross_weight,
			round(sum(case when tcg.commodity_group_type not in ('COLORSTONE','METAL') then jc.consumed_qty1 else 0 end),3) dia_weight,
			round(sum(case when tcg.commodity_group_type not in ('COLORSTONE','METAL') then jc.consumed_qty2 else 0 end),0) dia_pcs,
			round(sum(case when tcg.commodity_group_type in ('COLORSTONE') then jc.consumed_qty1 else 0 end),3) cs_weight,
			round(sum(case when tcg.commodity_group_type in ('COLORSTONE') then jc.consumed_qty1 else 0 end),0) cs_pcs,
			round(sum(case when tcg.commodity_group_type in ('METAL') then jc.consumed_qty1 else 0 end),3) met_wt,
			max(case when tcg.commodity_group_type in ('METAL') then tlot.lot_code else null end) metal_code,
			max(case when tcg.commodity_group_type in ('METAL') then kt.karatage_name else null end) metal_kt
		from
			tbl_jewellery_component jc
			left join tbl_lot tlot on jc.lot_id = tlot.lot_id
			left join tbl_karatage kt on tlot.karatage_id = kt.karatage_id
			left join tbl_commodity tcom on jc.commodity_id = tcom.commodity_id
			left join tbl_commodity_group tcg on tcom.commodity_group_id = tcg.commodity_group_id
		where
			jc.is_deleted = 0
			and jc.commodity_id <> 27
		group by
			jc.jew_id
	) tcomp on det.jew_id = tcomp.jew_id
where
    ma.inv_id = $P!{i_inv_id}
    and ma.inv_type = $P!{i_inv_type}
    and ma.is_deleted = 0
union all
select
    det.inv_det_id,
    row_number() over(order by det.inv_det_id) sr_no,
    ma.inv_type||'_'||ma.inv_no main_qr_code,
    ma.inv_id,
    ma.inv_no,
    ma.inv_type,
    concat(ma.inv_type,'-',ma.inv_no) inv_type_no,
    ma.salesman_id salesman_emp_id,
    ma.reference_no off_ref_no,
    to_char(ma.inv_dt,$P{dateFormat}) inv_dt,
    ma.currency	cur_code,
    ma.exchange_rate conv_rate,
    pt.payment_type_name payment_type,
    ma.inv_due_days,
    ma.inv_due_months,
    ma.inv_due_dt,
    cont.jew_no,
	concat(cont.jew_type,cont.jew_no) job_type_no,
    jt.product_type_name as product_type_name,
	sty.sku_no  	style_no,
    det.uom,
    det.inv_qty - det.ret_qty - det.conf_qty inv_qty,
    det.input_rate rate,
    (det.inv_qty - det.ret_qty - det.conf_qty) * det.input_rate amt,
    coalesce(ma.bill_street,'') bstreet,
    coalesce(ma.bill_address1,'') barea1,
    coalesce(ma.bill_address2,'') barea,
    coalesce(ma.bill_city,'') bcity,
    coalesce(ma.bill_pincode,'') bcity_pin,
    coalesce(ma.bill_state,'') bstate,
    coalesce(ma.bill_country,'') bcountry,
    coalesce(ma.bill_phone_no,'') bcontact_code,
    coalesce(ma.bill_phone_no,'') bcontact_phone,
    '' bcontact_name,
    coalesce(ma.bill_phone_no,'') bcontact_mobile,
    coalesce(ma.bill_fax_no,'') bcontact_fax,
    '' bcontact_email,
     ma.bill_address1,
     ma.bill_address2,
     concat(ma.bill_country,' ',ma.bill_state,' ',ma.bill_pincode) bill_address3,
     ma.ship_address1,
     ma.ship_address2,
     concat(ma.ship_country,' ',ma.ship_state,' ',ma.ship_pincode) ship_address3,
    coalesce(ma.ship_street,'') sstreet,
    coalesce(ma.ship_address1,'') sarea1,
    coalesce(ma.ship_address2,'') sarea,
    coalesce(ma.ship_city,' ') scity,
    coalesce(ma.ship_pincode,' ') scity_pin,
    coalesce(ma.ship_state,' ') sstate,
    coalesce(ma.ship_country,' ') scountry,
    coalesce(ma.ship_phone_no,' ') scontact_code,
    coalesce(ma.ship_phone_no,' ') scontact_phone,
    ' ' scontact_name,
    coalesce(ma.ship_phone_no,' ') scontact_mobile,
    coalesce(ma.bill_fax_no,' ') scontact_fax,
    ' ' scontact_email,
    coalesce(det.prod_description,sty.description) description,
    concat(pod.sales_order_type,'-',pod.sales_order_no) po_no,
    emp.first_name||' '||emp.last_name orderby,
    pd.customer_name 	cus_name,
    pd.display_name 	cus_code,
    ma.remarks,
    pt.payment_type_name payment_type,
    upper(comp.company_name) comp_off_name,
    CONCAT(comp.area,',',comp.street) comp_area,
    concat(comp.city,',',upper(st.state_name),',',upper(tc.country_name)) comp_state_name,
    concat('Tel:',comp.phone_number,' Fax:',comp.fax_no) comp_contact,
    comp.street,
    comp.website,
    pd.customer_id party_id,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/','''''','comp',sty.company_id,'/sku/',sty.sku_id,sty.image_url)	image_url,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/','''''','comp',comp.company_id,'/company/',comp.company_id,comp.log_url)	comp_logo,
	(round(coalesce(tcomp.total_gross_weight,0),3)) total_weight,
	(round(coalesce(tcomp.dia_weight,0),3)) dia_wt,
	(round(coalesce(tcomp.dia_pcs,0),0)) dia_pcs,
	(round(coalesce(tcomp.cs_weight,0),3)) cs_wt,
	(round(coalesce(tcomp.cs_pcs,0),0)) cs_pcs,
	(round(coalesce(tcomp.met_wt,0),3)) met_wt,
	tcomp.metal_code met_code,
	tcomp.metal_kt	met_kt
from
    tbl_jew_sales_invoice_main ma
    inner join tbl_jew_sales_invoice_det det on ma.inv_id = det.inv_id
		and det.is_deleted = 0
		and (det.inv_qty - det.ret_qty - det.conf_qty >= (case when $P!{i_qty_param} = 'PENDING' then 1 else 0 end ))
    inner join tbl_customer pd on ma.customer_id = pd.customer_id
    inner join tbl_jewellery cont on det.jew_id = cont.jew_id
	left join tbl_sales_order_det sdsd on cont.sales_order_det_id = sdsd.sales_order_det_id
    left join tbl_sku sty on cont.sku_id = sty.sku_id
    left join tbl_payment_type pt on ma.payment_type_id = pt.payment_type_id
    left join tbl_sales_order_main pod on cont.sales_order_id = pod.sales_order_id
    left join tbl_employee emp on pd.salesman_id = emp.employee_id
    inner join tbl_company comp on ma.company_id = comp.company_id
    LEFT JOIN tbl_country tc ON comp.country_id = tc.country_id
    left join tbl_state st on comp.state = st.state_code
    left join tbl_product_type jt on cont.product_type_id = jt.product_type_id
    left join tbl_lot t9 on cont.metal_id = t9.lot_id
    left join
	(
		select
			jc.jew_id,
			round(sum(case when tcg.commodity_group_type = 'METAL' then jc.consumed_qty1 else jc.consumed_qty1 * 0.2 end),3) total_gross_weight,
			round(sum(case when tcg.commodity_group_type not in ('COLORSTONE','METAL') then jc.consumed_qty1 else 0 end),3) dia_weight,
			round(sum(case when tcg.commodity_group_type not in ('COLORSTONE','METAL') then jc.consumed_qty2 else 0 end),0) dia_pcs,
			round(sum(case when tcg.commodity_group_type in ('COLORSTONE') then jc.consumed_qty1 else 0 end),3) cs_weight,
			round(sum(case when tcg.commodity_group_type in ('COLORSTONE') then jc.consumed_qty1 else 0 end),0) cs_pcs,
			round(sum(case when tcg.commodity_group_type in ('METAL') then jc.consumed_qty1 else 0 end),3) met_wt,
			max(case when tcg.commodity_group_type in ('METAL') then tlot.lot_code else null end) metal_code,
			max(case when tcg.commodity_group_type in ('METAL') then kt.karatage_name else null end) metal_kt
		from
			tbl_jewellery_component jc
			left join tbl_lot tlot on jc.lot_id = tlot.lot_id
			left join tbl_karatage kt on tlot.karatage_id = kt.karatage_id
			left join tbl_commodity tcom on jc.commodity_id = tcom.commodity_id
			left join tbl_commodity_group tcg on tcom.commodity_group_id = tcg.commodity_group_id
		where
			jc.is_deleted = 0
			and jc.commodity_id <> 27
		group by
			jc.jew_id
	) tcomp on det.jew_id = tcomp.jew_id
where
    ma.inv_id = $P!{i_inv_id}
    and ma.inv_type = $P!{i_inv_type}
    and ma.is_deleted = 0
) tmp
order by $P!{sortColumn}]]>
	</queryString>
	<field name="sr_no" class="java.lang.Long"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="main_qr_code" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_no" class="java.lang.String"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
