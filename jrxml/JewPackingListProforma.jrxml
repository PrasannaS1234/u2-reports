	<field name="dia_wt" class="java.math.BigDecimal"/>
	<field name="dia_pcs" class="java.math.BigDecimal"/>
	<field name="cs_wt" class="java.math.BigDecimal"/>
	<field name="cs_pcs" class="java.math.BigDecimal"/>
	<field name="met_wt" class="java.math.BigDecimal"/>
	<field name="met_code" class="java.lang.String"/>
	<field name="met_kt" class="java.lang.String"/>
	<variable name="inv_qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty}]]></variableExpression>
	</variable>
	<variable name="input_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{amt}]]></variableExpression>
	</variable>
	<variable name="met_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{met_wt}]]></variableExpression>
	</variable>
	<variable name="cs_pcs_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cs_pcs}]]></variableExpression>
	</variable>
	<variable name="dia_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{dia_wt}]]></variableExpression>
	</variable>
	<variable name="dia_pcs_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{dia_pcs}]]></variableExpression>
	</variable>
	<variable name="cs_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cs_wt}]]></variableExpression>
	</variable>
	<variable name="total_weight_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_weight}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="127" splitType="Stretch">
			<textField>
				<reportElement positionType="FixRelativeToBottom" stretchType="RelativeToBandHeight" x="0" y="0" width="1001" height="22" forecolor="#000000" uuid="225d5cd6-92b0-4ec5-be7d-091fd8f027e2"/>
				<box>
					<pen lineColor="#000000"/>
					<topPen lineColor="#000000"/>
					<leftPen lineColor="#000000"/>
					<bottomPen lineColor="#000000"/>
					<rightPen lineColor="#000000"/>
