<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RMMemoSalesInvoiceDeliveryChallan_subreport1" pageWidth="594" pageHeight="842" columnWidth="564" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="88ac9fd1-ed7b-42c0-81b9-2065444fdf18">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
          ROW_NUMBER() OVER (PARTITION BY im.inv_id ORDER BY im.inv_id, id.inv_det_id) AS sno,
	tcomp.company_name,
	im.inv_id,
	im.inv_type,
	im.note,
	im.remarks,
          fn_get_customer_invoice_no(im.inv_type,im.inv_id) cus_doc_type,
	im.inv_type || '-' || im.inv_no AS inv_type_no,
	TO_CHAR(im.inv_dt, 'dd/mm/yyyy') AS inv_dt,
	TO_CHAR(im.inv_due_dt, 'dd/mm/yyyy') AS inv_due_dt,
	im.currency,
	im.exchange_rate,
	COALESCE(im.reference_no, '') AS reference_no,
	tcus.customer_name,
	COALESCE(im.bill_address1, '') AS bill_addr1,
	COALESCE(im.bill_address2, '') AS bill_addr2,
	COALESCE(im.bill_country, '') AS bill_country,
	COALESCE(im.bill_state, '') AS bill_state,
	COALESCE(im.bill_city, '') AS bill_city,
	COALESCE(im.bill_street, '') AS bill_street,
	COALESCE(im.bill_pincode, '') AS bill_pincode,
	COALESCE(im.bill_website, '') AS bill_website,
	COALESCE(im.bill_phone_no, '') AS bill_phone_no,
	COALESCE(im.bill_fax_no, '') AS bill_fax_no,
	COALESCE(im.bill_mobile_no, '') AS bill_mobile_no,
	COALESCE(im.ship_address1, '') AS ship_addr1,
	COALESCE(im.ship_address2, '') AS ship_addr2,
	COALESCE(im.ship_country, '') AS ship_country,
	COALESCE(im.ship_state, '') AS ship_state,
	COALESCE(im.ship_city, '') AS ship_city,
	COALESCE(im.ship_street, '') AS ship_street,
	COALESCE(im.ship_pincode, '') AS ship_pincode,
	COALESCE(im.ship_website, '') AS ship_website,
	COALESCE(im.ship_phone_no, '') AS ship_phone_no,
	COALESCE(im.ship_fax_no, '') AS ship_fax_no,
	COALESCE(im.ship_mobile_no, '') AS ship_mobile_no,
	COALESCE(tcomp.state, '') AS comp_state,
	COALESCE(tcomp.city, '') AS comp_city,
	COALESCE(tcomp.street, '') AS comp_street,
	COALESCE(tcomp.area, '') AS comp_area,
	COALESCE(tcomp.pin_code, '') AS comp_pin,
	COALESCE(tcomp.email, '') AS comp_email,
	COALESCE(tcomp.phone_number, '') AS comp_phone_number,
	COALESCE(tcomp.mobile_no, '') AS comp_mobile_no,
	COALESCE(tcomp.website, '') AS comp_website,
	COALESCE(tcomp.reg_number, '') AS comp_pan,
	COALESCE(tcomp.tax_number, '') AS comp_gstn,
	COALESCE(tcomp.fax_no, '') AS comp_fax,
	COALESCE(tcomp.company_name, '') || ',' ||
	COALESCE(tcomp.street, '') || ',' ||
	COALESCE(tcomp.area, '') || ',' ||
	COALESCE(tcomp.city, '') || ' - ' ||
	COALESCE(tcomp.pin_code, '') || ',' ||
	COALESCE(state.state_name, '') || ', '||COALESCE(c.country_name, '') AS address,
	tcomp.company_name AS addressLine1,
	tcomp.street AS addressLine2,
	tcomp.area AS addressLine3,
	tcomp.city AS addressLine4,
	tcomp.pin_code AS addressLine5,
	COALESCE(state.state_name, '') || ', '||COALESCE(c.country_name, '') AS addressLine6,
	lot.lot_code,
          lot.remarks1,
          id.input_amt AS amount,
	id.input_rate AS rate,
	lot.certificate_no AS certificate,
	lot.lab_name AS lab,
	shape.shape_name AS shape,
	color.color_name AS color,
	cl.clarity_name AS clarity,
	ROUND(id.inv_qty1,3) AS qty1,
	ROUND(id.inv_qty2,0) AS qty2,
          lot.mm_size,
          concat_ws(
    'X',
    ROUND(CASE WHEN lot.meas_length::text ~ '^[0-9.]+$' THEN lot.meas_length::numeric END, 2)::text,
    ROUND(CASE WHEN lot.meas_width::text  ~ '^[0-9.]+$' THEN lot.meas_width::numeric  END, 2)::text,
    ROUND(CASE WHEN lot.depth::text       ~ '^[0-9.]+$' THEN lot.depth::numeric       END, 2)::text
) AS measure,
TO_CHAR(rm.customer_order_date, 'dd/mm/yyyy') AS cus_ref_dt,
	rm.purchase_det_remarks,
          im.ship_consignee,
COALESCE((im.ship_contact_no),'') ship_contact_no,
		  COALESCE((im.ship_contact_person),'') ship_contact_person,
		  COALESCE((im.ship_email_id),'') ship_email_id
FROM
	tbl_memo_sales_return_invoice_main im
	INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
	INNER JOIN tbl_memo_sales_return_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
	INNER JOIN tbl_lot lot ON id.lot_id = lot.lot_id
	LEFT JOIN tbl_shape shape ON lot.shape_id = shape.shape_id
	LEFT JOIN tbl_color color ON lot.color_id = color.color_id
	LEFT JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
	LEFT JOIN tbl_clarity cl ON lot.clarity_id = cl.clarity_id
         left join tbl_state state on tcomp.state = state.state_code
        left join tbl_country c on tcomp.country_id = c.country_id
          left join (select pdet.lot_id,max(pdet.customer_order_date) AS customer_order_date,
	max(pdet.purchase_det_remarks) purchase_det_remarks from
	tbl_purchase_invoice_det_ref pdet where
	    pdet.is_deleted = 0 group by pdet.lot_id) rm on id.lot_id = rm.lot_id
WHERE
	im.is_deleted = 0
	AND im.inv_id IN ($P!{i_inv_id})
ORDER BY im.inv_id, id.inv_det_id]]>
	</queryString>
