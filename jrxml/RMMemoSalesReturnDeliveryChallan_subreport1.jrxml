			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="20" height="22" backcolor="#F7F7F7" uuid="d13e4619-836f-4df9-ac9f-83516d0ad28c"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>
