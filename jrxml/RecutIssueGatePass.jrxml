	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    t.issue_id inv_id,
    ROW_NUMBER() OVER (PARTITION BY t.issue_id ORDER BY det.issue_det_id ASC) AS sno,
    t.issue_dt,
    concat(t.issue_type,' - ',t.issue_no) inv_no,
    t.remarks,
    factory.factory_name,
    det.qty1 as issue_qty1,
    det.qty2 as issue_qty2,
    l.lot_code,
	t.recut_type,
	t.person_name,
	t.description as requirements,
    det.uom1,
    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant} , 'comp', t.company_id, '/company/',comp.company_id,comp.log_url) AS image_url
FROM
    tbl_recut_issue t
    INNER JOIN tbl_recut_issue_det det ON t.issue_id = det.issue_id
	AND det.is_deleted = 0
    LEFT JOIN tbl_factory factory ON t.factory_id = factory.factory_id
    and factory.is_deleted =0
    LEFT JOIN tbl_lot l ON det.lot_id = l.lot_id
    and l.is_deleted =0
    LEFT JOIN tbl_company comp ON t.company_id = comp.company_id
	and comp.is_deleted =0
WHERE
    t.is_deleted = 0
    AND t.issue_id = $P!{i_inv_id}
ORDER BY
    det.issue_det_id;]]>
	</queryString>
