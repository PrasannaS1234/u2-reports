			<staticText>
				<reportElement key="staticText-28" mode="Opaque" x="76" y="48" width="76" height="36" backcolor="#CCCCCC" uuid="bac299f2-e2a1-4a17-bf6d-6e78af4e8e72"/>
				<box leftPadding="2" rightPadding="2">
