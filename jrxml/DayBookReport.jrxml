<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DayBookReport" pageWidth="1660" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="1645" leftMargin="15" rightMargin="0" topMargin="20" bottomMargin="20" uuid="6342c141-22f1-4b78-8dfc-ff6a5dcd20ff">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="accountCode" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'01/02/2022'"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'01/02/2042'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'DD/MM/YYYY'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="invType" class="java.lang.String">
		<defaultValueExpression><![CDATA["'JV'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    max(vou.inv_no) voucher_no,
    max(vou.reference_no) off_ref_no,
    max(vou.inv_type || '-' || vou.inv_id) voucher,
    to_char(max(vou.inv_dt), $P!{dateFormat}) vou_dt,
    vou.inv_type,
    max(vou.inv_no) vou_no,
    max(vou.note1) narration,

    -- Debit amount
    SUM(
        CASE
            WHEN vou_det.dr_cr = 'D' THEN
                CASE
                    WHEN $P!{currency} = vou.currency
                        THEN vou_det.amount
                    WHEN $P!{currency} = 'USD' AND vou.currency <> 'USD'
                        THEN vou_det.amount * coalesce(vou.exchange_rate,1)
                    WHEN $P!{currency} <> 'USD' AND vou.currency = 'USD'
                        THEN vou_det.amount / nullif(vou.exchange_rate,0)
                    ELSE vou_det.amount
                END
        END
    ) AS d_amt,

    -- Credit amount
    SUM(
        CASE
            WHEN vou_det.dr_cr = 'C' THEN
                CASE
                    WHEN $P!{currency} = vou.currency
                        THEN vou_det.amount
                    WHEN $P!{currency} = 'USD' AND vou.currency <> 'USD'
                        THEN vou_det.amount * coalesce(vou.exchange_rate,1)
                    WHEN $P!{currency} <> 'USD' AND vou.currency = 'USD'
                        THEN vou_det.amount / nullif(vou.exchange_rate,0)
                    ELSE vou_det.amount
                END
        END
    ) AS c_amt,

    vou_det.dr_cr deb_cre,
    max(acc.account_code) acc_code,
    max(acc.account_name) acc_name,
    max(acc.account_name || ' (' || acc.account_code || ')') account_name,

    max(emp.first_name) || ' [' || max(vou.created_by) || ']' created_by,
    to_char(max(vou.created_dt),'DD-Mon-yyyy HH:MI:SS AM') created_dt,

    case
        when max(vou.modified_by) is not null
        then max(emp1.first_name) || ' [' || max(vou.modified_by) || ']'
    end updated_by,

    to_char(max(vou.modified_dt),'DD-Mon-yyyy HH:MI:SS AM') updated_dt,
    max(cc.cost_category_name) cost_category_name,
    max(coc.cost_center_name) cost_center_name

from tbl_account_posting_main vou

inner join tbl_account_posting_det vou_det
    on vou.posting_id = vou_det.posting_id
    and vou_det.is_deleted = 0

inner join tbl_account acc
    on vou_det.account_id = acc.account_id
    and acc.is_deleted = 0

left join tbl_user emp on vou.created_by = emp.user_id
left join tbl_user emp1 on vou.modified_by = emp1.user_id

left join tbl_cost_category cc
    on vou_det.cost_category_id = cc.cost_category_id
    and cc.is_deleted = 0

left join tbl_cost_center coc
    on vou_det.cost_center_id = coc.cost_center_id
    and coc.is_deleted = 0

where
    vou.is_deleted = 0
    and (vou.inv_dt >= to_date($P!{fromDate}, $P!{dateFormat}) or ' ' = $P!{fromDate})
    and (vou.inv_dt <= to_date($P!{toDate}, $P!{dateFormat}) or ' ' = $P!{toDate})
    and (vou.inv_type in ($P!{invType}) or ' ' in ($P!{invType}))

group by
    vou.inv_type,
    vou.inv_id,
    vou_det.dr_cr,
    vou_det.account_id,
    vou_det.cost_category_id,
    vou_det.cost_center_id,
    vou.inv_dt

having sum(vou_det.amount) <> 0

order by
    vou.inv_dt,
    vou.inv_type,
    vou.inv_id,
    vou_det.dr_cr desc]]>
	</queryString>
