	<queryString>
		<![CDATA[select
	schedule_id,
	schedule_name,
	grp_id,
    groupp,
    sub_grp_id,
    sub_group,
    columnGroup location_code,
	schedule_order,
    group_order,
    subgroup_order,
    plus_minus_flag,
    case
        when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_curr_yr < 0 then abs(tmp.amt_curr_yr)
        when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_curr_yr >= 0 then  -1 * tmp.amt_curr_yr
        else tmp.amt_curr_yr
      end amt_curr_yr,
    case
            when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_prev_yr < 0 then abs(tmp.amt_prev_yr)
            when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_prev_yr >= 0 then  -1 * tmp.amt_prev_yr
            else tmp.amt_prev_yr
          end amt_prev_yr,
    sum((tmp.plus_minus_flag) * case
        when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_curr_yr < 0 then abs(tmp.amt_curr_yr)
        when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_curr_yr >= 0 then  -1 * tmp.amt_curr_yr
        else tmp.amt_curr_yr
      end) over () tot_amt_curr_yr,
    sum((tmp.plus_minus_flag) * case
            when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_prev_yr < 0 then abs(tmp.amt_prev_yr)
            when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_prev_yr >= 0 then  -1 * tmp.amt_prev_yr
            else tmp.amt_prev_yr
          end) over() tot_amt_prev_yr,
    sum((tmp.plus_minus_flag) * case
        when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_curr_yr < 0 then abs(tmp.amt_curr_yr)
        when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_curr_yr >= 0 then  -1 * tmp.amt_curr_yr
        else tmp.amt_curr_yr
      end) over (partition by columnGroup) loc_tot_amt_curr_yr,
    sum((tmp.plus_minus_flag) * case
            when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_prev_yr < 0 then abs(tmp.amt_prev_yr)
            when tmp.subgroup_balance_type = 'CREDIT' and tmp.amt_prev_yr >= 0 then  -1 * tmp.amt_prev_yr
            else tmp.amt_prev_yr
          end) over(partition by columnGroup) loc_tot_amt_prev_yr
from
(
select
	max(st.schedule_id)	schedule_id,
	max(st.schedule_name)	schedule_name,
    max(grp.group_id) grp_id,
    max(grp.group_name) groupp,
    max(sg.subgroup_id) sub_grp_id,
    max(sg.subgroup_name) sub_group,
    max(st.sort_seq)	schedule_order,
	max(grp.sort_seq) group_order,
    max(sg.sort_seq) subgroup_order,
    max(sg.subgroup_balance_type) subgroup_balance_type,
    max(sg.plus_minus_flag) plus_minus_flag,
     sum(case
    when m.inv_dt >= to_date('01/04/2021','dd/MM/yyyy')
		 and m.inv_dt <= to_date('31/03/2022','dd/MM/yyyy')
        then d.in_out_flag * d.amount
    else 0 end) amt_curr_yr,
    sum(case
    when m.inv_dt >= to_date('01/04/2020','dd/MM/yyyy')
		and m.inv_dt <= to_date('31/03/2021','dd/MM/yyyy')
        then d.in_out_flag * d.amount
    else 0 end) amt_prev_yr,
    max(tcomp.company_name) columnGroup
from
    tbl_account_posting_main m
    inner join tbl_account_posting_det d on m.posting_id = d.posting_id
		and d.is_deleted = 0
    inner join tbl_account a on d.account_id = a.account_id
    inner join tbl_sub_group sg on a.subgroup_id = sg.subgroup_id
	inner join tbl_group grp on sg.group_id = grp.group_id
	inner join tbl_schedule st on grp.schedule_id = st.schedule_id
	inner join tbl_company tcomp on m.company_id = tcomp.company_id
where
     m.inv_type <> 'CL'
    and (st.schedule_nature = 'MFG')
    and m.is_deleted = 0
group by
	st.schedule_id,
    grp.group_id,
    sg.subgroup_id,
	tcomp.company_id
having
    trunc(sum(case
			  when m.inv_dt >= to_date('01/04/2020','dd/MM/yyyy')
			  and m.inv_dt <= to_date('31/03/2022','dd/MM/yyyy')
        then d.in_out_flag * d.amount
    else 0 end),2) <> 0
 )tmp
order by
    schedule_order,
    group_order,
    subgroup_order]]>
	</queryString>
	<field name="schedule_id" class="java.lang.Integer"/>
	<field name="schedule_name" class="java.lang.String"/>
	<field name="grp_id" class="java.lang.Integer"/>
