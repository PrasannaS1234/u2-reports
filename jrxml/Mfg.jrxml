	<field name="subgroup_order" class="java.lang.Integer"/>
	<field name="plus_minus_flag" class="java.lang.Integer"/>
	<field name="amt_curr_yr" class="java.math.BigDecimal"/>
	<field name="amt_prev_yr" class="java.math.BigDecimal"/>
	<field name="tot_amt_curr_yr" class="java.math.BigDecimal"/>
	<field name="tot_amt_prev_yr" class="java.math.BigDecimal"/>
	<field name="loc_tot_amt_curr_yr" class="java.math.BigDecimal"/>
	<field name="loc_tot_amt_prev_yr" class="java.math.BigDecimal"/>
