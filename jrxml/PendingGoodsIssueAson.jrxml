<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JewSalesRegister" pageWidth="900" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="860" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="marketId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="factoryId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    im.inv_id,
    im.inv_type||'-'||im.inv_no inv_type_no,
	im.issue_return_type,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    tfac.factory_name factory_name,
	concat(jt.jew_type,jt.jew_no)	jew_no,
	concat(so.sales_order_type,'-',so.sales_order_no) so_no,
    prod.lot_code product_no,
    tcomp.company_name,
    (id.qty1 - id.finv_total_qty1 - id.return_qty1 - id.finv_return_qty1) inv_qty1,
    id.uom1,
    (id.qty2 - id.finv_total_qty2 - id.return_qty2 - id.finv_return_qty2) inv_qty2,
    id.uom2
from
	tbl_goods_issue_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_goods_issue_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
	inner join tbl_factory tfac on im.factory_id = tfac.factory_id
		and (tfac.factory_id in ($P!{factoryId}) or '-1' in ($P!{factoryId}))
    inner join tbl_lot prod on id.lot_id = prod.lot_id
	left join tbl_jewellery jt on id.jew_id = jt.jew_id
	left join tbl_sales_order_main so on id.so_id = so.sales_order_id
where
    im.is_deleted = 0
    and ((id.qty1 - id.finv_total_qty1 - id.return_qty1) <> 0
		 or (id.qty2 - id.finv_total_qty2 - id.return_qty2) <> 0)
	and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    and (prod.commodity_id  in ($P!{commodityId}) or '-1' in ($P!{commodityId}))
    and (prod.commodity_group_id  in ($P!{commodityGroupId}) or '-1' in ($P!{commodityGroupId}))
    and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
order by
	im.inv_dt,
	im.inv_id]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="issue_return_type" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="jew_no" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="product_no" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="inv_qty1" class="java.math.BigDecimal"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="inv_qty2" class="java.math.BigDecimal"/>
	<field name="uom2" class="java.lang.String"/>
	<variable name="inv_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
	</variable>
	<variable name="inv_qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
	</variable>
