	<variable name="gross_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="purity_wt" class="java.math.BigDecimal" calculation="Sum">
