				<reportElement x="25" y="0" width="70" height="18" isPrintWhenDetailOverflows="true" uuid="bc8a05b6-38c1-4072-8cd3-b968072b9627"/>
				<box leftPadding="2" rightPadding="2">
					<topPen lineWidth="0.0"/>
