	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_det_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<parameter name="currency" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
    id.commodity_id,
    max(concat(cl.color_name,' ',comm.commodity_name)) commodity_name,
    max(sh.shape_name) shape_name,
    max(id.mm_size) mm_size,
	max(id.sieve) sieve,
    sum(id.qty1) qty1,
    sum(id.qty2) qty2
from
    tbl_sales_order_component id
    left join tbl_lot lot on id.lot_id = lot.lot_id
    inner join tbl_commodity comm on id.commodity_id = comm.commodity_id
    left join tbl_shape sh on lot.shape_id = sh.shape_id
	left join tbl_color cl on id.color_id = cl.color_id
where
    id.is_deleted = 0
    and id.sales_order_det_id in ($P!{i_inv_det_id})
group by
	id.commodity_id
order by
     commodity_id]]>
		</queryString>
		<field name="commodity_id" class="java.lang.Integer"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="mm_size" class="java.lang.String"/>
		<field name="sieve" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\Admin\\Desktop\\TK Rpt\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    so.sales_order_id,
   sd.sales_order_det_id,
    row_number() over(order by sd.sales_order_det_id) sno,
    comp.company_name,
	concat(comp.street, comp.area, comp.city, comp.state, '-', comp.pin_code) comp_address,
	concat(t.jew_type, t.jew_no) job_type_no,
	concat(so.sales_order_type,'-',so.sales_order_no) sales_order_no,
	sd.customer_order_no,
	s.sku_no,
	s.customer_ref_no sku_crn,
	p.product_type_name,
	c.customer_name,
	so.reference_no so_ref_no,
	concat(u.first_name,' ',u.last_name) so_created_by,
	to_char(so.delivery_date, 'dd-Mon-yyyy') delivery_date,
	to_char(so.sales_order_date, 'dd-Mon-yyyy') sales_order_date,
	ps.product_size,
	t.qty,
	t.metal_weight,
	k.karatage_name,
	t.metal1,
	t.stamping_details,
    	cd.cad_no,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url,
	t.prod_description,
	t.remarks,
	sd.prod_remarks,
	sd.stamping_remarks,
	coalesce(so.bill_address1,'') bill_addr1,
    coalesce(so.bill_address2,'') bill_addr2,
    coalesce(so.bill_country,'') bill_country,
    coalesce(so.bill_state,'') bill_state,
    coalesce(so.bill_city,'') bill_city,
    coalesce(so.bill_street,'') bill_street,
    coalesce(so.bill_pincode,'') bill_pincode,
	coalesce(so.ship_address1,'') ship_addr1,
    coalesce(so.ship_address2,'') ship_addr2,
    coalesce(so.ship_country,'') ship_country,
    coalesce(so.ship_state,'') ship_state,
    coalesce(so.ship_city,'') ship_city,
    coalesce(so.ship_street,'') ship_street,
    coalesce(so.ship_pincode,'') ship_pincode
from
	tbl_jewellery t
	inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
	inner join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
    left join tbl_cad_order_det cd on sd.cad_order_det_id = cd.inv_det_id
	    and cd.is_deleted = 0
	left join tbl_user u on so.created_by = u.user_id
	left join tbl_lot lot on t.metal1 = lot.lot_code
	left join tbl_karatage k on lot.karatage_id = k.karatage_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
    so.sales_order_id in ($P!{i_inv_id})
order by
    so.sales_order_id,
    sd.sales_order_det_id]]>
	</queryString>
	<field name="sales_order_id" class="java.lang.Integer"/>
	<field name="sales_order_det_id" class="java.lang.Integer"/>
	<field name="sno" class="java.lang.Long"/>
	<field name="company_name" class="java.lang.String"/>
