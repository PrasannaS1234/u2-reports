<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKKSubRpt" pageWidth="554" pageHeight="842" columnWidth="554" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="jew_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
select
	t.jew_id,
	soc.qty2,
	lot.lot_code,
	cm.description
from
	tbl_jewellery t
	inner join tbl_sales_order_det sd on t.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
    inner join tbl_sales_order_component soc on t.sales_order_det_id = soc.sales_order_det_id
	    and soc.sales_order_id = sd.sales_order_id
	    and soc.is_deleted = 0
	inner join tbl_lot lot on soc.lot_id = lot.lot_id
	inner join tbl_commodity cm on soc.commodity_id = cm.commodity_id
where
   t.jew_id in ($P!{jew_id})
	and t.is_deleted = 0
order by
	 t.jew_id,soc.component_id
)
select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
	NULL AS jew_id,
	NULL AS qty2,
    NULL AS lot_code,
    NULL AS description
FROM generate_series(1, 32-(select count(*) from w_result_set))]]>
	</queryString>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
