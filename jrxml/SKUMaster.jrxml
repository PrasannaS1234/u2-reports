<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SkUMaster" pageWidth="2220" pageHeight="842" columnWidth="2210" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="751"/>
	<property name="ireport.y" value="0"/>
	<parameter name="sku_nos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="imgReq" class="java.lang.String"/>
	<parameter name="product_type_Ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="category" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="collection_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodity_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="factory_ref_nos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="shape_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="sieve_size" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="mm_size" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="dia_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="dia_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="cs_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="cs_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="met_wt_from" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="met_wt_to" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by sku.sku_id) sno,
    sku.sku_id,
    max(sku.sku_no) sku_no,
    max(pt.product_type_name) product_type_name,
    max(sku.category) category,
    max(cl.collection_name) collection_name,
    max(lot.lot_code) metal_lot,
    max(sku.metal_weight) metal_weight,
    max(sku.description) description,
    max(sku.factory_ref_no) factory_ref_no,
    max(fac.factory_name) factory_name,
    max(sku.reference_no) reference_no,
    max(sku.set_no) set_no,
    max(cmp.company_name) company_name,    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',max(sku.company_id),'/sku/',max(sku.sku_id),max(sku.image_url)) image_url
from
     tbl_sku sku
     inner join tbl_product_type pt on sku.product_type_id = pt.product_type_id
     inner join tbl_collection cl on sku.collection_id = cl.collection_id
     inner join tbl_lot lot on sku.metal_id = lot.lot_id
     inner join tbl_factory fac on sku.factory_id = fac.factory_id
     inner join tbl_company cmp on sku.company_id = cmp.company_id
     inner join tbl_sku_component scmp on sku.sku_id = scmp.sku_id
          and scmp.is_deleted = 0
     inner join tbl_commodity com on scmp.commodity_id = com.commodity_id
     inner join tbl_commodity_group cmg on com.commodity_group_id =cmg.commodity_group_id
where
     (sku.sku_no in ($P!{sku_nos}) or ' ' in ($P!{sku_nos}))
     and (sku.product_type_id in ($P!{product_type_Ids}) or - 1 in ($P!{product_type_Ids}))
     and (sku.category in ($P!{category}) or ' ' in ($P!{category}))
     and (sku.collection_id in ($P!{collection_ids}) or - 1 in ($P!{collection_ids}))
     and (sku.factory_ref_no in ($P!{factory_ref_nos}) or ' ' in ($P!{factory_ref_nos}))
     and (scmp.commodity_id in ($P!{commodity_ids}) or - 1 in ($P!{commodity_ids}))
     and (scmp.shape_id in ($P!{shape_ids}) or - 1 in ($P!{shape_ids}))
     and (scmp.mm_size in ($P!{mm_size}) or ' ' in ($P!{mm_size}))
     and (scmp.sieve_size in ($P!{sieve_size}) or ' ' in ($P!{sieve_size}))
     and ((case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') then scmp.qty1 else $P!{dia_wt_from} end) >= -1 or -1 = ($P!{dia_wt_from}))
     and ((case when cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND') then scmp.qty1 else $P!{dia_wt_from} end) <= -1 or -1 = ($P!{dia_wt_to}))
     and ((case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL') then scmp.qty1 else $P!{cs_wt_from} end) >= -1 or -1 = ($P!{cs_wt_from}))
     and ((case when cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL') then scmp.qty1 else $P!{cs_wt_from} end) <= -1 or -1 = ($P!{cs_wt_to}))
     and (sku.metal_weight >= $P!{met_wt_from} or - 1 = ($P!{met_wt_from}))
     and (sku.metal_weight <= $P!{met_wt_to} or - 1 = ($P!{met_wt_to}))
group by
    sku.sku_id
order by
    sku.sku_id]]>
	</queryString>
