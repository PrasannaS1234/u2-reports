<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InvoiceSummaryReport" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7dceb035-974d-45e9-becb-4256f064a838">
	<property name="ireport.zoom" value="1.4641000000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with v_master_data as (
select
	im.inv_id,
	im.inv_no,
	im.inv_dt,
	im.currency,
	im.exchange_rate,
	im.gold_rate,
	im.pt_rate,
	im.silver_rate,
	im.customer_name,
	isum.style_no,
	isum.job_no,
	isum.cref,
	isum.items,
	isum.metal,
	isum.total_gross_wt,
	isum.cust_metal_wt,
	isum.our_metal_wt,
	isum.non_metal_wt,
	isum.summary_id,
	isum.total_setting_amount,
	isum.total_handling_amount,
	isum.total_metal_amount,
	isum.total_metal_labour_amount,
          isum.total_amount,
          sum(isum.total_amount) over() grand_total,
	row_number() over(order by isum.style_no) sr_no
from
	tbl_invoice_main im
	inner join tbl_invoice_summary isum on im.inv_id = isum.inv_id
		and isum.is_deleted = 0
where
	im.is_deleted = 0
	and im.inv_id = $P!{invId}
)
select
	abc.*,
	concat(abc.mainseq, abc.seq,'',abc.cgrp) cgrp_new
from
(
	select
		md.*,
		concat('Cust Dia ',shape_name, ' Wt') cgrp,
		wt	cvalue,
		'A'   mainseq,
		'A'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'CUST_DIAMOND'
	union all
	select
		md.*,
		concat('Cust Dia ',shape_name, ' PCS') cgrp,
		pcs	cvalue,
		'A'	mainseq,
		'AA'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'CUST_DIAMOND'
	union all
	select
		md.*,
		concat('Cust CS ',shape_name, ' Wt') cgrp,
		wt	cvalue,
		'B'	mainseq,
		'B'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'CUST_CS'
	union all
	select
		md.*,
		concat('Cust CS ',shape_name,' PCS') cgrp,
		pcs	cvalue,
		'B'	mainseq,
		'BB'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'CUST_CS'
	union all
	select
		md.*,
		concat('U Dia ',shape_name, ' Wt') cgrp,
		wt	cvalue,
		'C'	mainseq,
		'C'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'OUR_DIAMOND'
	union all
	select
		md.*,
		concat('U Dia ',shape_name, ' PCS') cgrp,
		pcs	cvalue,
		'C'	mainseq,
		'CC'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'OUR_DIAMOND'
	union all
	select
		md.*,
		concat('U CS ',shape_name, ' Wt') cgrp,
		wt	cvalue,
		'D'	mainseq,
		'D'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'OUR_CS'
	union all
	select
		md.*,
		concat('U CS ',shape_name, ' PCS') cgrp,
		pcs	cvalue,
		'D'	mainseq,
		'DD'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_stone cust_dia on md.summary_id = cust_dia.summary_id
			and stone_belongs = 'OUR_CS'
	union all
	select
		md.*,
		'Setting Labour' cgrp,
		md.total_setting_amount  cvalue,
		'E'	mainseq,
		'E'   seq
	from
		v_master_data md
	union all
	select
		md.*,
		'Handling Labor' cgrp,
		md.total_handling_amount  cvalue,
		'F'	mainseq,
		'F'   seq
	from
		v_master_data md
	union all
	select
		md.*,
		'Metal Labor' cgrp,
		md.total_metal_labour_amount  cvalue,
		'G'	mainseq,
		'G'   seq
	from
		v_master_data md
	union all
	select
		md.*,
		chgs.charge_name cgrp,
		chgs.amount  cvalue,
		'H'	mainseq,
		'H'   seq
	from
		v_master_data md
		inner join tbl_invoice_summary_charges chgs on md.summary_id = chgs.summary_id
			and chgs.is_deleted = 0
			and chgs.amount > 0
	union all
	select
		md.*,
		'GoldCost' cgrp,
		md.total_metal_amount  cvalue,
		'I'		mainseq,
		'I'   seq
	from
		v_master_data md
) abc order by abc.sr_no,abc.mainseq, abc.seq]]>
	</queryString>
