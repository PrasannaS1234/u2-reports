<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TrialBalance" pageWidth="1280" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="1240" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="2.5937424601000028"/>
	<property name="ireport.x" value="2306"/>
	<property name="ireport.y" value="112"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
        FINAL_RESULT.ACC_ID,
        MAX(FINAL_RESULT.ACC_DESC) ACC_DESC,
        MAX(COALESCE(FINAL_RESULT.ACCOUNT_NAME,' ')) ACC_NAME,
        MAX(COALESCE(FINAL_RESULT.ACC_CODE,' ')) ACC_CODE,
        MAX(FINAL_RESULT.SCHEDULE_ID) SCHEDULE_ID,
        MAX(COALESCE(FINAL_RESULT.SCHEDULE_NAME,' ')) SCHEDULE_NAME,
        MAX(FINAL_RESULT.GROUP_ID) GROUP_ID,
        MAX(COALESCE(FINAL_RESULT.GROUP_NAME,' ')) GROUP_NAME,
        MAX(FINAL_RESULT.SUBGROUP_ID) SUBGROUP_ID,
        MAX(COALESCE(FINAL_RESULT.SUBGROUP_NAME,' ')) SUBGROUP_NAME,

        CASE
            WHEN SUM(FINAL_RESULT.AMOUNT_LOCAL) >= 0
            THEN ABS(SUM(FINAL_RESULT.AMOUNT_LOCAL))
            ELSE 0
        END AS DR_AMOUNT_LOCAL,

        CASE
            WHEN SUM(FINAL_RESULT.AMOUNT_LOCAL) < 0
            THEN ABS(SUM(FINAL_RESULT.AMOUNT_LOCAL))
            ELSE 0
        END AS CR_AMOUNT_LOCAL,

        CASE
            WHEN SUM(FINAL_RESULT.AMOUNT_INTL) >= 0
            THEN ABS(SUM(FINAL_RESULT.AMOUNT_INTL))
            ELSE 0
        END AS DR_AMOUNT_INTL,

        CASE
            WHEN SUM(FINAL_RESULT.AMOUNT_INTL) < 0
            THEN ABS(SUM(FINAL_RESULT.AMOUNT_INTL))
            ELSE 0
        END AS CR_AMOUNT_INTL,

        MAX(FINAL_RESULT.COMPANY_ID) COMPANY_ID,
        MAX(FINAL_RESULT.CURRENCY)CURRENCY

    FROM
    (
        SELECT
            TMP_TRIAL_BALANCE.ACC_ID,
            MAX(TMP_TRIAL_BALANCE.COMPANY_ID) COMPANY_ID,

            MAX(ACC.ACCOUNT_NAME) ACCOUNT_NAME,
            MAX(ACC.ACCOUNT_CODE) ACC_CODE,
            MAX(ACC.ACCOUNT_NAME) || ' [' || MAX(ACC.ACCOUNT_CODE) || ']' ACC_DESC,

            MAX(ST.SCHEDULE_ID) SCHEDULE_ID,
            MAX(ST.SCHEDULE_NAME) SCHEDULE_NAME,

            MAX(GRP.GROUP_ID) GROUP_ID,
            MAX(GRP.GROUP_NAME) GROUP_NAME,

            MAX(SG.SUBGROUP_ID) SUBGROUP_ID,
            MAX(SG.SUBGROUP_NAME) SUBGROUP_NAME,

            MAX(ST.SORT_SEQ) SC_ORDER,
            MAX(GRP.SORT_SEQ) GRP_ORDER,
            MAX(SG.SORT_SEQ) SG_ORDER,

            SUM(TMP_TRIAL_BALANCE.AMOUNT_LOCAL) AMOUNT_LOCAL,
            SUM(TMP_TRIAL_BALANCE.AMOUNT_USD) AMOUNT_INTL,
            MAX(ACC.CURRENCY_CODE)CURRENCY

        FROM
        (
            SELECT
                PD.ACCOUNT_ID ACC_ID,
                SUM(PD.AMOUNT * PD.IN_OUT_FLAG) AMOUNT_LOCAL,
                SUM(PD.AMOUNT_USD * PD.IN_OUT_FLAG) AMOUNT_USD,
                PM.COMPANY_ID

            FROM TBL_ACCOUNT_POSTING_MAIN PM

            left JOIN TBL_ACCOUNT_POSTING_DET PD
                ON PM.POSTING_ID = PD.POSTING_ID
                AND PD.IS_DELETED = 0

            left JOIN TBL_ACCOUNT AC
                ON PD.ACCOUNT_ID = AC.ACCOUNT_ID

            WHERE
                PM.INV_DT <= to_date($P{toDate}, $P{dateFormat})
                AND PM.COMPANY_ID = $P!{companyId}

            GROUP BY
                PD.ACCOUNT_ID,
                PM.COMPANY_ID

        ) TMP_TRIAL_BALANCE

        LEFT JOIN TBL_ACCOUNT ACC
            ON TMP_TRIAL_BALANCE.ACC_ID = ACC.ACCOUNT_ID

        LEFT JOIN TBL_SUB_GROUP SG
            ON ACC.SUBGROUP_ID = SG.SUBGROUP_ID

        LEFT JOIN TBL_GROUP GRP
            ON SG.GROUP_ID = GRP.GROUP_ID

        LEFT JOIN TBL_SCHEDULE ST
            ON GRP.SCHEDULE_ID = ST.SCHEDULE_ID

        GROUP BY
            TMP_TRIAL_BALANCE.ACC_ID

    ) FINAL_RESULT
    GROUP BY
        SCHEDULE_ID,
        GROUP_ID,
        SUBGROUP_ID,
        FINAL_RESULT.ACC_ID]]>
	</queryString>
