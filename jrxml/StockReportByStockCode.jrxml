<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StockReportByStockCode" pageWidth="650" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="610" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="departmentId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (partition by grp order by grp, stock_code) sno,
	tx.grp,
	tx.company_name,
	tx.factory_name,
	tx.department_name,
	tx.lot_code,
	tx.stock_code,
	tx.job_no,
	tx.bag_no,
	sum(tx.qty1) qty1,
	sum(tx.qty2) qty2
from (
select
coalesce(nullif(concat(j.jew_type,j.jew_no,bag.bag_type,bag.bag_no),''), coalesce(l.custom_no, l.lot_code))  grp,
c.company_name,
f.factory_name,
d.department_name,
l.lot_code,
coalesce(l.custom_no, l.lot_code) stock_code,
b.bin_name,
concat(j.jew_type,j.jew_no) job_no,
bag.bag_id,
concat(bag.bag_type,bag.bag_no) bag_no,
t.qty1,
t.qty2
from
(
	select row_number() over (order by 1) sno, tx.*,
coalesce(case when row_number() over (partition by tx.bag_id order by 1) = 1 then (round(bg.bag_qty,0)) else 0 end,0) bag_qty
from (
select
	t.company_id,
	t.factory_id,
	t.department_id,
	t.employee_id,
	t.lot_id,
	t.bin_id,
	t.stone_size,
	t.job_id,
	t.bag_id,
	t.sales_order_id,
	sum(t.in_out_flag * t.qty1) qty1,
	sum(t.in_out_flag * t.qty2) qty2
from
	tbl_mfg_lot_stock_trans t
where
	t.is_deleted = 0
	and t.inv_dt <= to_date($P{toDate}, $P{dateFormat})
	and t.department_id in ($P!{departmentId})
	and t.bin_id in ($P!{binId})
group by
	t.company_id,
	t.factory_id,
	t.department_id,
	t.employee_id,
	t.lot_id,
	t.bin_id,
	t.stone_size,
	t.job_id,
	t.sales_order_id,
	t.bag_id
having
	sum(t.in_out_flag * t.qty1) <> 0
)tx
LEFT JOIN tbl_mfg_bag bg on tx.bag_id = bg.bag_id
) t
inner join tbl_company c on t.company_id = c.company_id
inner join tbl_factory f on t.factory_id = f.factory_id
inner join tbl_department d on t.department_id = d.department_id
inner join tbl_employee e on t.employee_id = e.employee_id
inner join tbl_lot l on t.lot_id = l.lot_id
inner join tbl_commodity comm on l.commodity_id = comm.commodity_id
inner join tbl_bin b on t.bin_id = b.bin_id
and b.bin_type not in ('RECUT_ISSUE','BROKEN_BIN','NET_LOSS_BIN','DUST_BIN','RECUT_LOSS_BIN',
					   'GROSS_LOSS_BIN','REFINING_BIN','LOSS_BIN','GROSS_LOSS_BIN_OLD')
left join tbl_jewellery j on t.job_id = j.jew_id
left join tbl_mfg_bag bag on t.bag_id = bag.bag_id
left join tbl_sku s on bag.sku_id = s.sku_id
where 1 = 1
and
(qty1 > 0)
and t.company_id in ($P!{loginCompanyId})
order by
t.factory_id,
t.department_id,
t.job_id,
t.bag_id,
coalesce(l.custom_no, l.lot_code),
t.lot_id,
t.stone_size
)tx

where
	tx.bag_id not in (select bag_id from tbl_mfg_factory_invoice_det where is_deleted = 0)
group by
tx.grp,
tx.company_name,
tx.factory_name,
tx.department_name,
tx.lot_code,
tx.stock_code,
tx.job_no,
tx.bag_no
order by
tx.bag_no,
tx.job_no,
tx.grp,
tx.stock_code,
tx.lot_code]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="grp" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<field name="lot_code" class="java.lang.String"/>
