	<summary>
		<band height="312">
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="269" width="554" height="43" isPrintWhenDetailOverflows="true" uuid="6ac99069-f956-447f-a415-9133121b45ea"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Authorised Signatory"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="23" y="0" width="531" height="26" uuid="2215ddc1-c99a-4206-b1d0-d22c818a41fa"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["4. Items not sold abroad should be re-imported within a period of 180 days from the date of their export, and a bill of entry to be submitted to us promptly."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="42" width="554" height="19" uuid="389a1731-e95b-4592-902a-a1228f894dee"/>
				<textElement verticalAlignment="Middle">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="61" width="554" height="84" uuid="f2855df3-8015-47ac-b85e-b8c390e94c83"/>
				<box topPadding="1" leftPadding="2" bottomPadding="1" rightPadding="2"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["This communication is issued from the foreign exchange angle under provisions of FEMA as applicable to ''Consignment Exports'' and should not be construed to convey approval by any other statutory authority or government under any other laws/regulations. It further approval or permission is required of the concerned agency before effecting any transaction. Further, it should not be construed as regularizing or validating any irregularities, contravention or other lapses, if any under the provisions of any other laws/regulation."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="145" width="554" height="16" uuid="5d20c497-f495-479a-a564-c92360e8376b"/>
				<textElement verticalAlignment="Middle" markup="html">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["This letter is being issued at the specific request of <b>"+$F{company_name}+"</b> and is not "]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="177" width="554" height="10" isPrintWhenDetailOverflows="true" uuid="a8beea8e-5062-493e-b98a-c80d844e3f10"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA[""]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="187" width="554" height="30" isPrintWhenDetailOverflows="true" uuid="020589cc-2f93-4f25-8dbd-5dd84020ff37"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Thanking you,"]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="217" width="554" height="52" isPrintWhenDetailOverflows="true" uuid="72faadbd-537b-49c5-b40f-4cdd2842a965"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement verticalAlignment="Top">
					<font fontName="Arial" size="10" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Yours Faithfully,"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="23" y="26" width="531" height="16" uuid="5e477a41-b57d-478b-b776-a8d9220b4a34"/>
				<textElement>
					<font isBold="false" isUnderline="false"/>
				</textElement>
				<textFieldExpression><![CDATA["5. Please Submit a list of bills sent on consignment basis every half year to us."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="0" y="161" width="554" height="16" uuid="9ad3ff4f-dbf3-4270-bbca-71638c9ad63b"/>
				<textElement markup="none"/>
				<textFieldExpression><![CDATA["intended to be guarantee or undertaking of any sort."]]></textFieldExpression>
