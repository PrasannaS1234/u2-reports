<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BankPermissionLetter" pageWidth="594" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="554" leftMargin="20" rightMargin="20" topMargin="50" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="471"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="bank_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    TO_CHAR(CURRENT_DATE, 'dd/mm/yyyy') AS curr_dt,
    max(tcomp.company_name) company_name,
          COALESCE(max(tcomp.city),'') comp_city,
	max(im.inv_id) inv_id,
	max(im.inv_type) inv_type,
          fn_get_customer_invoice_no(max(im.inv_type),max(im.inv_id)) cus_doc_type,
	max(im.inv_type||'-'||im.inv_no) inv_type_no,
	to_char(max(im.inv_dt), 'dd/mm/yyyy') inv_dt,
          to_char(max(im.inv_dt), 'dd-mon-yyyy') inv_dt_text,
          to_char(max(im.inv_dt)+30, 'dd/mm/yyyy') thirty_days,
	to_char(max(im.inv_due_dt), 'dd/mm/yyyy')     inv_due_dt,
          max(tcus.customer_name) customer_name,
          max(tcus.email) cus_email,
	COALESCE(max(im.bill_address1),'') bill_addr1,
	COALESCE(max(im.bill_address2),'') bill_addr2,
	COALESCE(max(im.bill_country),'') bill_country,
	COALESCE(max(im.bill_state),'') bill_state,
	COALESCE(max(im.bill_city),'') bill_city,
	COALESCE(max(im.bill_street),'') bill_street,
	COALESCE(max(im.bill_pincode),'') bill_pincode,
	COALESCE(max(im.bill_website),'') bill_website,
	COALESCE(max(im.bill_phone_no),'') bill_phone_no,
	COALESCE(max(im.bill_fax_no),'') bill_fax_no,
	COALESCE(max(im.bill_mobile_no),'') bill_mobile_no,
	COALESCE(max(im.ship_address1),'') ship_addr1,
	COALESCE(max(im.ship_address2),'') ship_addr2,
	COALESCE(max(im.ship_country),'') ship_country,
	COALESCE(max(im.ship_state),'') ship_state,
	COALESCE(max(im.ship_city),'') ship_city,
	COALESCE(max(im.ship_street),'') ship_street,
	COALESCE(max(im.ship_pincode),'') ship_pincode,
	COALESCE(max(im.ship_website),'') ship_website,
	COALESCE(max(im.ship_phone_no),'') ship_phone_no,
	COALESCE(max(im.ship_fax_no),'') ship_fax_no,
	COALESCE(max(im.ship_mobile_no),'') ship_mobile_no,
	max(COALESCE(bank.bank_name,'')) bank_name,
          max(COALESCE(bank.bank_account_number,'')) acc_no,
		  max(COALESCE(bank.beneficiary_name,'')) beneficiary,
		  max(COALESCE(bank.bank_address,'')) bank_add,
          'IFSC Code : ' ||max(COALESCE(bank.ifsc_code,'')) ifsc_code,
          round(max(im.total_invoice_qty1),3) qty1,
           round(max(im.total_invoice_net_amount),2) total_amt,
           max(im.inv_type||'-'||im.inv_no) inv_type_no,
           COALESCE(max(tcomp.ie_code_no),'') comp_ie_code_no,
           COALESCE(max(c.line1),'') customs_info_line1,
		   COALESCE(max(c.line2),'') customs_info_line2,
		   COALESCE(max(c.line3),'') customs_info_line3,
		   COALESCE(max(c.line4),'') customs_info_line4,
           to_char(max(tcomp.iec_date), 'dd/mm/yyyy') comp_iec_date,
	max(case when cmd.commodity_name like '%Lab Grown%' then 'Lab Grown Cut & Polished Diamonds'
	         when cmd.commodity_name like '%Natrual Diamond%' then 'Cut & Polished Diamonds' end) diamond_type,
           COALESCE(max(bank.ad_code),'') bank_ad_code,
max(im.ship_consignee)  ship_consignee,
           ROUND(MAX(im.total_invoice_amount) / NULLIF(MAX(im.exchange_rate),0), 2) AS total_amt_usd
from
	tbl_memo_sales_invoice_main im
          inner join tbl_customer tcus on im.customer_id = tcus.customer_id
	inner join tbl_company tcomp on im.company_id = tcomp.company_id
	inner join tbl_memo_sales_invoice_det id on im.inv_id = id.inv_id
		and id.is_deleted = 0
	  left join tbl_company_bank bank on ($P!{bank_id}) = bank.map_id
	  left join tbl_customs_info c on im.customs_info_id = c.customs_info_id
	  left join tbl_terms_condition tc on im.terms_condition_id = tc.terms_condition_id
            left join tbl_lot lt on id.lot_id = lt.lot_id
	  left join tbl_commodity cmd on lt.commodity_id = cmd.commodity_id
where
	im.is_deleted = 0
	and im.inv_id in ($P!{i_inv_id})
group by
	im.inv_id,
	im.inv_type]]>
	</queryString>
