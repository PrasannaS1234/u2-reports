<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGPurchaseInvoicewithImageSuraj" pageWidth="540" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="520" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" isSummaryNewPage="true" uuid="9ad6d883-1638-4ddd-b4d4-9debcc20f6c2">
	<property name="ireport.zoom" value="1.3310000000000024"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="147"/>
	<subDataset name="dataset1" uuid="aab1cfac-44ab-4519-8a85-1da358ac9197">
		<parameter name="invId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select

			max(chgs.charge_name) charge_name,
			sum(chgs.plus_minus_flag * case when 0 < 0 then -1 else 1 end * chgs.input_amt) othamt
		from
			tbl_jew_memo_sales_invoice_chgs chgs
		where
			1 = 1
			and chgs.inv_id =  $P!{invId}
			and chgs.is_deleted = 0
		group by
			chgs.inv_id,
			chgs.charge_id
		 having sum(chgs.plus_minus_flag * chgs.input_amt) <> 0]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="othamt" class="java.math.BigDecimal"/>
	</subDataset>
	<scriptlet name="scriptlet1" class="net.sf.jasperreports.engine.JRDefaultScriptlet"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY q.inv_id, q.product_type) AS s_no,
	ROUND((max(q.invoice_total_amt_usd) OVER (PARTITION BY q.inv_id)),0)  AS inv_total_usd_roundoff,
    ROUND((max(q.invoice_total_amt_usd) OVER (PARTITION BY q.inv_id)),2) - TRUNC((max(q.invoice_total_amt_usd) OVER (PARTITION BY q.inv_id)), 0)  AS amount_decimal,
   COALESCE(
    fn_amount_to_words(
        FLOOR(
            round(max(q.invoice_total_amt_usd) OVER (PARTITION BY q.inv_id),0)
        ),
        ''::varchar,
        '',
        ''
    ) || ' only',
    ''
) AS inv_total_words,
    q.*
FROM (SELECT
    im.inv_id,
    im.remarks,
    pt.product_type_name product_type,
    --(case when max(id.prod_description) is not null then max(id.prod_description) else max(pt.product_type_name) end) AS --product_type,
    COUNT(DISTINCT id.jew_id)             AS item_count,
    MAX(tcomp.company_name)               AS company_name,

    MAX(COALESCE(
        NULLIF(fn_get_customer_invoice_no(im.inv_type, im.inv_id), ''),
        concat(im.inv_type, '-', im.inv_no))) AS inv_type_no,
    TO_CHAR(MAX(im.inv_dt), COALESCE(MAX(tcomp.date_format), 'dd/MM/yyyy')) AS inv_dt,
    im.created_dt,
    MAX(im.currency)                      AS currency,
max(c.currency_code)                      as currency_code,
    MAX(tcus.customer_name)               AS customer_name,
     MAX(tcus.display_name)               AS customer_dis_name,
    MAX(im.reference_no)                  AS reference_no,
    to_char(MAX(im.inv_due_dt),'dd/MM/yyyy')  AS inv_due_dt,
    MAX(addr.country)                     AS country,
max(addr.state) as state,
        max(addr.primary_contact_no) as ph_no,
    MAX(im.exchange_rate)                 AS exchange_rate,
    MAX(CONCAT(emp.first_name,' ',emp.last_name)) AS sales_man,
    max(concat (prp.first_name, ' ', prp.last_name)) as prepare_by,
    STRING_AGG(DISTINCT id.prod_description, ', ' ORDER BY id.prod_description) AS prod_description,
    SUM(id.inv_qty)                       AS gross_wt,
    SUM(j.net_wt)                         AS total_net_wt,
    SUM(id.input_amt ) AS total_amt_usd,
    MAX( im.total_invoice_net_amount) AS invoice_total_amt_usd,
max(payment.paid_amount)paid_amt,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo
FROM tbl_jew_memo_sales_invoice_main im
INNER JOIN tbl_jew_memo_sales_invoice_det id
    ON im.inv_id = id.inv_id
   AND id.is_deleted = 0
INNER JOIN tbl_company tcomp
    ON im.company_id = tcomp.company_id
left join tbl_currency c on im.currency = c.currency_code
and c.is_deleted =0
INNER JOIN tbl_jewellery j
    ON id.jew_id = j.jew_id
   AND j.is_deleted = 0
inner join tbl_product_type pt on pt.product_type_id = j.product_type_id
  LEFT JOIN (
        SELECT
            p.inv_id,
            SUM(
                COALESCE(p.received_amount, 0)) AS paid_amount
        FROM tbl_payment_received_det p
        INNER JOIN tbl_payment_received_main pm ON pm.payment_id = p.payment_id
        WHERE p.is_deleted = 0
        GROUP BY p.inv_id
    ) payment ON payment.inv_id = im.inv_id
LEFT JOIN (
        SELECT DISTINCT ON (jc.jew_id)
               jc.jew_id,
               jc.pp_rate,
               l.impure_to_pure_conv_factor AS purity
        FROM tbl_jewellery_component jc
        LEFT JOIN tbl_lot l ON jc.lot_id = l.lot_id AND l.is_deleted = 0 and l.lot_type = 'METAL'
        ORDER BY jc.jew_id
) tj ON j.jew_id = tj.jew_id
LEFT JOIN tbl_employee emp
    ON emp.employee_id = im.salesman_id
   AND emp.is_deleted = 0
left join tbl_user prp on im.created_by = prp.user_id and prp.is_deleted=0
INNER JOIN tbl_sku s
    ON j.sku_id = s.sku_id
   AND s.is_deleted = 0
LEFT JOIN tbl_customer tcus
    ON im.customer_id = tcus.customer_id
LEFT JOIN (
    SELECT DISTINCT ON (a.customer_id)
        a.customer_id,
        a.country,
        a.state,
        a.primary_contact_no
    FROM tbl_customer_address a
    WHERE a.is_deleted = 0
      AND a.default_address = 1
    ORDER BY a.customer_id, a.address_id DESC
) addr
    ON addr.customer_id = tcus.customer_id
WHERE im.is_deleted = 0
AND im.inv_id IN ($P!{i_inv_id})
GROUP BY
    im.inv_id,
    pt.product_type_name,
    tcomp.company_id
ORDER BY
    im.inv_id,
    pt.product_type_name
)q]]>
	</queryString>
