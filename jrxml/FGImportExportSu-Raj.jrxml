	<title>
		<band height="258" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="585" height="46" isPrintWhenDetailOverflows="true" forecolor="#660066" uuid="175aca1c-d7c2-4805-b448-b7b9d0b32fff"/>
				<box leftPadding="2" rightPadding="2"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="28" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{company_name}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="0" y="46" width="585" height="33" isPrintWhenDetailOverflows="true" forecolor="#660066" uuid="ab818383-a1eb-4fe3-88ff-e96b51114cae"/>
