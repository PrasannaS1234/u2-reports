<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGImportExportSu-Raj" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="585" leftMargin="5" rightMargin="5" topMargin="10" bottomMargin="10" uuid="34c3672d-ea2d-4d85-ac60-f253552ef34b">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="144"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by $P!{sortColumn}) sno,
    tmp.*
from
(
select
       ROW_NUMBER() OVER (
    PARTITION BY d.reference_no
    ORDER BY d.reference_no
) AS serial_no,
	m.inv_id,
          d.inv_det_id,
	j.jew_id,
          mlot.lot_code lot_no,
          sku.sku_no,
          j.jew_no,
	d.prod_description as jew_description,
          concat(d.reference_no,d.prod_description) as grouping,
	c.company_name,
	c.street company_address,
	c.area company_location,
	cus.customer_name,
	COALESCE(cus_add.line1, '') as line1,
          COALESCE(cus_add.line2, '') as line2,
          COALESCE(cus_add.line3, '') as line3,
          COALESCE(cus_add.line4, '') as line4,
          COALESCE(cus_add.line5, '') as line5,
          COALESCE(cus_add.line6, '') as line6,
           m.currency,
	TO_CHAR(m.inv_dt, 'FMMonth DD, YYYY') invoice_dt,
	concat(m.inv_type,'-',m.inv_no) system_inv_no,
	m.reference_no export_inv_no,
	carr.carrier_name through,
	d.reference_no import_entry_no,
	k.karatage_name karatage,
	pr.product_type_name,
          round(case when j.uom = 'PCS' then d.inv_qty end,1) no_of_pcs,
	round(case when j.uom = 'PRS' then d.inv_qty end,1) no_of_pairs,
	j.gross_wt,
	j.net_wt,
	d.input_rate price_per_pcs,
	round(d.inv_qty * d.input_rate,3) amt,
	m.tin_box_no,
          cur.symbol,
          round(SUM(
       CASE
          WHEN j.uom = 'PCS'
          THEN j.gross_wt ELSE 0
       END
    ) OVER (),3) AS tot_net_wt_pcs,
	round(SUM(
       CASE
          WHEN j.uom = 'PRS'
          THEN j.gross_wt ELSE 0
       END
    ) OVER (),3) AS tot_net_wt_prs,
	round(SUM(
       CASE
          WHEN j.uom = 'PCS'
          THEN d.inv_qty * d.input_rate
          ELSE 0
       END
    ) OVER (),2) AS tot_pcs_amt,
	round(SUM(
       CASE
          WHEN j.uom = 'PRS'
          THEN d.inv_qty * d.input_rate
          ELSE 0
       END
    ) OVER (),2) AS tot_prs_amt,
round(sum(d.inv_qty * d.input_rate) over (), 2) as tot_amt,
fn_amount_to_words(
  round(sum(d.inv_qty * d.input_rate) over (), 2),
    'USD'::varchar,
    'dollars',
    'cents'
) || ' only.' AS inv_total_words,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',m.company_id,'/stamp_sign.png')  as img_url
from
	tbl_jew_sales_invoice_main m
	inner join tbl_jew_sales_invoice_det d on m.inv_id = d.inv_id
		and d.is_deleted = 0
          inner join (select
	      currency_code,
                max(symbol)symbol
	     from tbl_currency
		group by currency_code)
		cur on m.currency = cur.currency_code
	inner join tbl_company c on m.company_id = c.company_id
	inner join tbl_customer cus on m.customer_id = cus.customer_id
	inner join tbl_jewellery j on d.jew_id = j.jew_id
	inner join tbl_sku sku on j.sku_id = sku.sku_id
	inner join tbl_product_type pr on sku.product_type_id = pr.product_type_id
	left join tbl_lot mlot on j.metal_id = mlot.lot_id
	left join tbl_karatage k on mlot.karatage_id = k.karatage_id
	left join tbl_carrier carr on m.carrier_id = carr.carrier_id
	left join (
		select
			a.customer_id,
			a.address1 line1,
			a.address2 line2,
			concat(a.state,', ',a.country) line3,
			concat('TEL: ',a.primary_contact_no) line4,
			concat('FAX: ', a.email ) line5,
			concat('Contact Person: -',a.primary_contact_name) line6
		from
			tbl_customer_address a
		where
			a.is_deleted = 0
			and a.address_type = 'Billing'
	)cus_add on cus.customer_id = cus_add.customer_id
where 1 =1
and m.inv_id in ($P!{i_inv_id})
)tmp
order by $P!{sortColumn}]]>
	</queryString>
