				<textField isBlankWhenNull="true">
					<reportElement stretchType="RelativeToTallestObject" x="75" y="160" width="371" height="57" isPrintWhenDetailOverflows="true" uuid="45be1033-fb8a-44ac-b93e-b6cfee06643e"/>
					<box topPadding="4" leftPadding="4" rightPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement verticalAlignment="Top">
						<font fontName="Arial Unicode MS" isBold="false" pdfFontName="STSong-Light" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{prod_description}]]></textFieldExpression>
