	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.transfer_id,
	row_number() over (partition by t.transfer_id order by t.transfer_id, det.transfer_det_id) sno,
	concat(t.transfer_type,'-',t.transfer_no) inv_type_no,
	to_char(t.transfer_dt,'dd/MM/yyyy') inv_dt,
	sb.company_name from_company_name,
	concat(sb.street,',',sb.area) from_area,
	concat(sb.city,',',sb.state,',',sbc.country_name,',',sb.pin_code) from_city,
	concat('Phone: ',sb.phone_number,'  Fax: ', sb.fax_no) from_phone_no,
	db.company_name to_company_name,
	concat(db.street,',',db.area) to_area,
	concat(db.city,',',db.state,',',dbc.country_name,',',db.pin_code) to_city,
	concat('Phone: ',db.phone_number,'  Fax: ', db.fax_no) to_no,
	b.bin_name as source_bin,
          destb.bin_name as dest_bin,
	concat(jew.jew_type,jew.jew_no) jewel_no,
	sku.sku_no,
	det.description,
	det.qty,
	det.input_rate,
	det.input_amt,
	t.remarks,
          lot.lot_code,
          pdt.product_type_name,
          t.reference_no,
          t.currency,
          jew.gross_wt,
          jew.net_wt,
          jc.stone_wt
from
	tbl_jew_branch_transfer t
	inner join tbl_jew_branch_transfer_det det on t.transfer_id = det.transfer_id
		and det.is_deleted = 0
	inner join tbl_bin b on t.source_bin_id = b.bin_id
          	inner join tbl_bin destb on t.dest_bin_id = destb.bin_id
	inner join tbl_company db on t.dest_branch_id = db.company_id
	inner join tbl_jewellery jew on det.jew_id = jew.jew_id
          left join
(
  select
      j.jew_id,
      sum(j.consumed_qty1) as stone_wt
  from  tbl_jewellery_component j
  inner join tbl_commodity c on j.commodity_id = c.commodity_id
where
    c.metal_type not in ('GOLD','SILVER','PLATINUM')
group by j.jew_id
)jc on jc.jew_id = jew.jew_id
	inner join tbl_sku sku on jew.sku_id = sku.sku_id
          left join tbl_lot lot on jew.metal_id = lot.lot_id
          left join tbl_product_type pdt on jew.product_type_id = pdt.product_type_id
	inner join tbl_company sb on t.company_id = sb.company_id
	left join tbl_country sbc on sb.country_id = sbc.country_id
	left join tbl_country dbc on db.country_id = dbc.country_id
where
	t.is_deleted = 0
	and t.transfer_id = $P!{i_inv_id}
order by
	t.transfer_id, det.transfer_det_id]]>
	</queryString>
