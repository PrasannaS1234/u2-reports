				<staticText>
					<reportElement key="staticText-104" stretchType="RelativeToTallestObject" mode="Opaque" x="503" y="193" width="52" height="14" isPrintWhenDetailOverflows="true" forecolor="#000000" backcolor="#CCCCCC" uuid="d4c0eef5-4ba2-4b05-bc43-36d1cdc74b33"/>
					<box topPadding="2" leftPadding="2" bottomPadding="2" rightPadding="2">
						<topPen lineWidth="0.5" lineColor="#000000"/>
