	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
ROW_NUMBER() OVER (ORDER BY d.inv_det_id) AS sno,
m.inv_id,
concat(m.inv_type,'-',m.inv_no) inv_no,
m.reference_no,
m.inv_dt,
f.factory_name,
dep.department_name,
e.first_name,
concat(tre.inv_type,'-',tre.inv_no) wax_tree_no,
lot.lot_code main_lot,
m.issue_wt,
m.mounting_wt,
m.sprue_wt,
m.dust_wt,
m.gross_loss_wt,
m.finding_wt rm_wt,
l.lot_code,
b.bag_no,
sku.sku_no,
b.customer_bag_order_no,
d.bag_qty,
d.bag_gross_wt,
d.bag_metal_wt,
d.bag_stone_pcs,
p.part_name,
d.issue_qty1,
d.issue_qty2,
concat(cas.inv_type,'-',cas.inv_no) issue_no,
cas.inv_dt issue_dt,
tre.inv_dt tree_dt,
round((m.mounting_wt/m.issue_wt)*100
+(m.sprue_wt/m.issue_wt)*100
+(m.gross_loss_wt/m.issue_wt)*100,2)issue_pct,
round((m.mounting_wt/m.issue_wt)*100,2)mount_pct,
round((m.sprue_wt/m.issue_wt)*100,2) sprue_pct,
round((m.dust_wt/m.issue_wt)*100,2) dust_pct,
round((m.finding_wt/m.issue_wt)*100,2) rm_pct,
round((m.gross_loss_wt/m.issue_wt)*100,2) gross_loss_pct,
case
		when coalesce(length(trim(j.image_url)),0) > 0 then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',j.company_id,'/jewellery/',j.jew_id,j.image_url)
		else concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)
	end image_url,
m.remarks
from tbl_mfg_casting_receive m
inner join tbl_mfg_casting_receive_det d on m.inv_id = d.inv_id
and d.is_deleted =0
left join tbl_factory f on m.factory_id = f.factory_id
and f.is_deleted =0
left join tbl_department dep on m.department_id = dep.department_id
and d.is_deleted = 0
left join tbl_employee e on m.employee_id = e.employee_id
and e.is_deleted = 0
left join tbl_mfg_wax_tree tre on m.wax_tree_id = tre.inv_id
and tre.is_deleted =0
left join (
select inv_id,
	max(inv_type) inv_type,
	max(inv_no) inv_no,
	max(inv_dt) inv_dt,
	max(wax_tree_id) wax_tree_id
from
tbl_mfg_casting_issue
	group by inv_id
)cas on m.wax_tree_id =cas.wax_tree_id
left join tbl_lot lot on m.main_lot_id = lot.lot_id
left join tbl_lot l on d.lot_id = l.lot_id
left join tbl_mfg_bag b on d.bag_id = b.bag_id
and b.is_deleted =0
left join tbl_jewellery j on b.job_id = j.jew_id
and j.is_deleted =0
left join tbl_sku sku on j.sku_id = sku.sku_id
and sku.is_deleted = 0
left join tbl_parts p on d.part_id = p.part_id
and p.is_deleted =0
where m.inv_id = $P!{i_inv_id}]]>
	</queryString>
