	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tcomp.company_name,
	e.shape_name,
	trim(concat(ur.first_name,' ',ur.last_name)) created,
	to_char(e.created_dt,'dd/mm/yyyy hh12:mi:ss') created_dt,
	case
		when e.is_deleted = 1 then 'Deleted'
		when e.is_locked = 0 then 'Active' else 'Inactive' end status
from tbl_shape e
inner join tbl_company tcomp on e.company_id = tcomp.company_id
left join tbl_user ur on e.created_by = ur.user_id
where
	 (cast(e.company_id as text) in ($P!{companyId}) or '-1' in ($P!{companyId}))
order by
	tcomp.company_id,
	e.shape_id]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="created" class="java.lang.String"/>
	<field name="created_dt" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
