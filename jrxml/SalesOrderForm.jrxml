<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesOrderForm" pageWidth="1200" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1190" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over (partition by so.sales_order_id order by 1) sno,
    so.sales_order_id,
	company.company_name,
	concat(so.sales_order_type, '-', so.sales_order_no) sales_order_no,
	sd.sales_order_det_id,
	so.reference_no,
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	s.sku_no,
	p.product_type_name,
	sm.mould_no,
	c.display_name customer_display_name,
	sd.customer_order_no,
	to_char(so.delivery_date, 'dd-Mon-yyyy') delivery_date,
	to_char(so.sales_order_date, 'dd-Mon-yyyy') sales_order_date,
	round(t.qty,0) qty,
    	t.uom,
	ps.product_size,
	t.metal_weight,
	sc.dia_wt,
	sc.dia_pcs,
	sc.cs_wt,
	sc.cs_pcs,
	case when sc.dia_pcs > 0 then sc.dia_wt / sc.dia_pcs else 0 end dia_per_wt,
	case when sc.cs_pcs > 0 then sc.cs_wt / sc.cs_pcs else 0 end cs_per_wt,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url
from
	tbl_jewellery t
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
	inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
	inner join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	left join tbl_company company on t.company_id = company.company_id
	left join(
		select
		    comp.sales_order_det_id,
			round(sum(case when lower(comm.commodity_name) like '%dia%' then comp.tot_qty else 0 end),2) dia_wt,
			round(sum(case when lower(comm.commodity_name) like '%dia%' then comp.qty2 else 0 end),0) dia_pcs,
			round(sum(case when lower(comm.commodity_name) not like '%dia%' then comp.tot_qty else 0 end),2) cs_wt,
			round(sum(case when lower(comm.commodity_name) not like '%dia%' then comp.qty2 else 0 end),0) cs_pcs
			from tbl_sales_order_component comp
			left join tbl_commodity comm on comp.commodity_id = comm.commodity_id
			and comm.is_deleted = 0
		group by comp.sales_order_det_id
	)sc on t.sales_order_det_id = sc.sales_order_det_id
	left join(
		select
		  row_number() over(partition by mo.sku_id order by 1) sno,
		  mo.*
		from tbl_sku_mould mo where mo.is_deleted = 0 order by 1
     )sm on t.sku_id = sm.sku_id
		and sm.sno = 1
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
	(so.sales_order_id) in ($P!{i_inv_id})]]>
	</queryString>
