	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\Tekfilo\\jasper-reports\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
 row_number() over(order by $P!{sortColumn}) srno,
tmp.*
from
(
select
    (tcomp.company_name) company_name,
    (im.inv_id) inv_id,
    (id.inv_det_id)inv_det_id,
    (im.inv_type) inv_type,
    (im.inv_type||'-'||im.inv_no) inv_type_no,
    to_char((im.inv_dt), (coalesce(tcomp.date_format,'dd/MM/yyyy'))) inv_dt,
    (im.currency) currency,
    (pyt.payment_type_name) payment_term,
    (tsup.customer_name) customer_name,
    (coalesce(im.bill_address1,'')) bill_addr1,
    (coalesce(im.bill_address2,'')) bill_addr2,
    (coalesce(im.bill_country,'')) bill_country,
    (coalesce(im.bill_state,'')) bill_state,
    (coalesce(im.bill_city,'')) bill_city,
    (coalesce(im.bill_street,'')) bill_street,
    (coalesce(im.bill_pincode,'')) bill_pincode,
    ((coalesce(tcomp.street,''))) address1,
    ((coalesce(tcomp.area,''))) address2,
    ((coalesce(tcomp.city,'')) || ', ' || (coalesce(tcomp.state,'')) || ' ' || (coalesce(tcomp.pin_code,'')) ||
	 ', ' || (coalesce(tcou.country_name,''))
    ) address3,
    (tcomp.email) comp_email,
    (phone_number) comp_phone_no,
    (tcomp.website) comp_website,
    (coalesce(tcomp.payment_address,'')) payment_address,
    (coalesce(im.terms_conditions,'')) terms_conditions,
    (im.total_invoice_amount) grossAmount,
    (cmbnk.beneficiary_name) benificiary_name,
    (cmbnk.bank_name) bank_name,
    (cmbnk.bank_account_number) bank_account_number,
    (cmbnk.ifsc_code) ifsc_code,
    (cmbnk.routing) routing,
    (cmbnk.bank_address) bank_address,
    upper(spellnumericvalue((im.total_invoice_net_amount),(im.currency))) amount_in_words,
     concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo,
    (case when (tcomp.log_url) is not null then true else false end) logo_print,
   case when (im.total_charge_plus_amount) + (im.total_charge_minus_amount) > 0 then 1 else 0 end show_chgs,
   (im.total_invoice_net_amount) tot_amt,
   (im.total_invoice_qty1) tot_qty1,
   (im.total_invoice_qty2) tot_qty2,
   (cmbnk.wire_transfer) wire_transfer,
    id.inv_id,
    lot.lot_code lot_no,
    com.commodity_id,
    id.inv_qty1,
    id.input_rate,
    id.input_amt

from
    tbl_sales_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
left join tbl_country tcou on tcomp.country_id= tcou.country_id
    inner join tbl_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_customer tsup on im.customer_id = tsup.customer_id
	inner join tbl_payment_type pyt on im.payment_type_id = pyt.payment_type_id
	left join tbl_company_bank cmbnk on tcomp.company_id = cmbnk.company_id
	    and cmbnk.is_default = 1
    inner join tbl_lot lot on id.lot_id = lot.lot_id
left join tbl_commodity com on lot.commodity_id = com.commodity_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
)tmp
order by $P!{sortColumn}]]>
	</queryString>
