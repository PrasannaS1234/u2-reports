	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY pd.product_type_name) AS s_no,

    MAX(CONCAT(t.transfer_type,t.transfer_no)) AS transfer_no,
    MAX(t.reference_no) AS reference_no,
    MAX(t.transfer_dt) AS transfer_dt,
    MAX(t.status) AS status,
    MAX(t.description) AS description,
    MAX(t.remarks) AS remarks,
    MAX(t.system_remarks) AS system_remarks,
    MAX(concat(prp.first_name,' ',prp.last_name)) as prepare_by,
    MAX(CONCAT(j.jew_type,j.jew_no)) AS jew_no,
        MAX(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url)) comp_logo,
    SUM(d.qty) AS qty,
    MAX(d.uom) AS uom,

    COUNT(d.transfer_det_id) AS detail_count,
    COUNT(*) AS pc,

    MAX(s.sku_no) AS sku_no,

    MAX(
        CASE
            WHEN d.remarks IS NOT NULL THEN d.remarks
            ELSE j.description
        END
    ) AS det_remarks,

    MAX(d.system_remarks) AS det_system_remarks,

    MAX(source_bin.bin_name) AS source_bin_name,
    MAX(dest_bin.bin_name) AS dest_bin_name,

    pd.product_type_name

FROM tbl_jew_bin_transfer t
JOIN tbl_jew_bin_transfer_det d
    ON t.transfer_id = d.transfer_id
   AND d.is_deleted = 0

LEFT JOIN tbl_bin source_bin
    ON d.source_bin_id = source_bin.bin_id

LEFT JOIN tbl_bin dest_bin
    ON d.dest_bin_id = dest_bin.bin_id

INNER JOIN tbl_jewellery j
    ON d.jew_id = j.jew_id

INNER JOIN tbl_sku s
    ON j.sku_id = s.sku_id

left join tbl_user prp on
    t.created_by = prp.user_id and prp.is_deleted=0

INNER JOIN tbl_company tcomp ON t.company_id = tcomp.company_id

INNER JOIN tbl_product_type pd
    ON j.product_type_id = pd.product_type_id

WHERE t.transfer_id = $P!{i_inv_id}
  AND t.is_deleted = 0

GROUP BY pd.product_type_name;]]>
	</queryString>
	<field name="s_no" class="java.lang.Long"/>
	<field name="transfer_no" class="java.lang.String"/>
