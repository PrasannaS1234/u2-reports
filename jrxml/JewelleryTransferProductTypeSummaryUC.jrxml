			<textField isStretchWithOverflow="true" pattern="###0.00" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="206" y="0" width="93" height="15" isPrintWhenDetailOverflows="true" uuid="b5d8ad24-30aa-436c-a076-54de6d437186"/>
