<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CADOrderForm" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="570" leftMargin="15" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.650000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	d.design_id,
	tcomp.company_name,
	concat(tcomp.street,', ',tcomp.area,', ',tcomp.state,', ',st.state_name,', ',tcountry.country_name) comp_address,
	COALESCE(tcomp.phone_number,'') phone_number,
	COALESCE(tcomp.fax_no,'') fax_no,
	COALESCE(tcomp.email,'') email,
	d.design_no,
	pt.product_type_name,
	d.category,
	d.description,
	lot.lot_code,
	d.metal_weight,
	com.commodity_name,
	sh.shape_name,
	color.color_name,
	cut.cut_name,
	dc.total_wt,
	dc.qty2,
	stt.setting_type_name,
	case when dc.is_center_stone = 1 then 'Yes' else 'No' end center_stone,
	dc.sieve_size,
	dc.mm_size,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',d.company_id,'/design/',d.design_id,d.image_url)	image_url
from
	tbl_design d
	left join tbl_lot lot on d.metal_id = lot.lot_id
	left join tbl_product_type pt on d.product_type_id = pt.product_type_id
	inner join tbl_company tcomp on d.company_id = tcomp.company_id
	left join tbl_state st on tcomp.state = st.state_code
	left join tbl_country tcountry on tcomp.country_id = tcountry.country_id
	inner join tbl_design_component dc on d.design_id = dc.design_id
		and dc.is_deleted = 0
	left join tbl_commodity com on dc.commodity_id = com.commodity_id
	left join tbl_shape sh on dc.shape_id = sh.shape_id
	left join tbl_color color on dc.color_id = color.color_id
	left join tbl_cut cut on dc.cut_id = cut.cut_id
	left join tbl_setting_type stt on dc.setting_type_id = stt.setting_type_id
where
	d.is_deleted = 0
	and d.design_id = $P!{i_inv_id}]]>
	</queryString>
