			<staticText>
				<reportElement key="staticText-104" stretchType="RelativeToTallestObject" mode="Transparent" x="191" y="222" width="46" height="16" isPrintWhenDetailOverflows="true" forecolor="#008083" backcolor="#473427" uuid="21273410-9224-4a55-84af-6448f7bc5e30"/>
