	<parameter name="invoiceNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	im.items grp,
	sum(1.0) qty,
	sum(total_gross_wt) net_wt,
	sum(total_amount) amt
from
	tbl_invoice_summary im
where
	im.is_deleted = 0
	and im.inv_id = $P!{invId}
group by
	im.items]]>
	</queryString>
	<field name="grp" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="net_wt" class="java.math.BigDecimal"/>
	<field name="amt" class="java.math.BigDecimal"/>
	<variable name="net_wt_1" class="java.math.BigDecimal" calculation="Sum">
