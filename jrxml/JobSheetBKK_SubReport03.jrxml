				</textElement>
				<textFieldExpression><![CDATA[$F{total_qty1}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="226" y="0" width="45" height="17" isPrintWhenDetailOverflows="true" uuid="ebfcd4ef-273e-4bad-9fd9-672fc73b804a"/>
				<box leftPadding="2" rightPadding="2">
					<topPen lineWidth="0.5" lineStyle="Dotted"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Arial" size="9" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{total_qty2}.doubleValue() == 0.00 ? null : $F{total_qty1}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="80" y="0" width="101" height="17" isPrintWhenDetailOverflows="true" uuid="6e41e4d5-e1d4-418b-a2b6-c04e1cd0a6d2"/>
				<box leftPadding="2" rightPadding="2">
