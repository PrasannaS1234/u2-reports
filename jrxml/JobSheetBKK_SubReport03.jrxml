<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKK_SubReport02" pageWidth="271" pageHeight="200" columnWidth="271" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="164787d2-0b5e-42a4-8bf7-81dda9657bd8">
	<property name="ireport.zoom" value="1.5026296018031553"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="jew_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
	select
		l.lot_code,
		p.part_name,
       som.weight total_qty1,
       som.qty total_qty2
  from tbl_sales_order_finding som
 inner join tbl_jewellery j on som.sales_order_det_id = j.sales_order_det_id
 inner join tbl_lot l on som.lot_id = l.lot_id
 left join tbl_parts p on som.part_id = p.part_id
 where
      som.is_deleted = 0
      and j.jew_id = $P!{jew_id}
)
select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
    NULL as part_name,
    NULL AS lot_code,
    NULL AS qty1,
    NULL AS qty2
FROM generate_series(1, 9-(select count(*) from w_result_set))]]>
	</queryString>
	<field name="lot_code" class="java.lang.String"/>
	<field name="part_name" class="java.lang.String"/>
	<field name="total_qty1" class="java.math.BigDecimal"/>
	<field name="total_qty2" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
		<band height="17" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="80" height="17" isPrintWhenDetailOverflows="true" uuid="b84cedfc-8d4a-4332-b515-382d3dd7eaa4"/>
				<box leftPadding="2" rightPadding="2">
					<topPen lineWidth="0.5" lineStyle="Dotted"/>
