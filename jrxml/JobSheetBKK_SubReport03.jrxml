				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="9" pdfEncoding="Cp1252" isPdfEmbedded="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{lot_code}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement stretchType="RelativeToTallestObject" x="181" y="0" width="45" height="17" isPrintWhenDetailOverflows="true" uuid="6dd3439f-4745-4082-9438-5a72bec3627a"/>
				<box leftPadding="2" rightPadding="2">
					<topPen lineWidth="0.5" lineStyle="Dotted"/>
					<leftPen lineWidth="0.5"/>
