	<subDataset name="chgs" uuid="50ca7150-1da2-49cf-bc76-65aedb3110b6">
		<parameter name="invId" class="java.lang.Integer"/>
		<parameter name="currency" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
    2 as groupno,
    max(chgs.charge_name) as charge_name,

    sum(
        chgs.plus_minus_flag *
        case
            when $P{currency} = 'USD' then chgs.input_amt
            else chgs.input_amt / im.exchange_rate
        end
    ) as amt_usd,

    sum(
        chgs.plus_minus_flag *
        case
            when $P{currency} = 'THB' then chgs.input_amt
            else chgs.input_amt * im.exchange_rate
        end
    ) as amt_local

from
    tbl_jew_purchase_invoice_chgs chgs
    inner join tbl_jew_purchase_invoice_main im
        on im.inv_id = chgs.inv_id
where
    chgs.inv_id = $P!{invId}
    and chgs.is_deleted = 0

group by
    chgs.inv_id,
    chgs.charge_id

having
    sum(chgs.plus_minus_flag * chgs.input_amt) <> 0;]]>
		</queryString>
		<field name="groupno" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt_usd" class="java.math.BigDecimal"/>
		<field name="amt_local" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="dataset1" uuid="877ebb5f-622b-4d9e-88b7-a45148dfc57e"/>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    row_number() over (partition by im.inv_id order by id.inv_det_id asc) AS sno,
    tcomp.company_name AS company_name,
    im.inv_id         AS inv_id,
    im.inv_type       AS inv_type,
    (COALESCE(NULLIF(fn_get_customer_invoice_no(im.inv_type, im.inv_id), ''), concat(im.inv_type, '-', im.inv_no))) AS inv_type_no,
    to_char(im.inv_dt, COALESCE(tcomp.date_format, 'dd/MM/yyyy')) AS inv_dt,
    im.currency       AS currency,
    pyt.payment_type_name AS payment_term,
    tsup.supplier_name,
    im.supplier_dt,
    im.reference_no,
    l.lot_code,
    j.net_wt,
    kt.karatage_name,
    CASE WHEN id.uom = 'PCS'   THEN id.inv_qty END AS pcs,
    CASE WHEN id.uom = 'PRS' THEN id.inv_qty END AS pairs,
    id.prod_description,
    id.inv_qty,
    id.input_rate,
    id.input_amt,
    add.country,
    COALESCE(stoneWt.dia_wt,   0) AS dia_wt,
    COALESCE(stoneWt.cs_wt,    0) AS cs_wt,
    COALESCE(stoneWt.cz_wt,    0) AS cz_wt,
    COALESCE(stoneWt.pearl_wt, 0) AS pearl_wt,
   im.exchange_rate,
   case when im.currency = 'USD' then id.input_amt else id.input_amt / im.exchange_rate end as amt_usd,

   case when im.currency = 'THB' then id.input_amt else id.input_amt * im.exchange_rate end as amt_local,

   case when im.currency = 'USD' then im.total_invoice_net_amount else im.total_invoice_net_amount / im.exchange_rate end as total_amt_usd,

   case when im.currency = 'THB' then  im.total_invoice_net_amount else im.total_invoice_net_amount *
im.exchange_rate end as total_amt_local

FROM tbl_jew_purchase_invoice_main im
INNER JOIN tbl_jew_purchase_invoice_det id
    ON im.inv_id = id.inv_id AND id.is_deleted = 0
INNER JOIN tbl_company tcomp
    ON im.company_id = tcomp.company_id
INNER JOIN tbl_jewellery j
    ON id.jew_id = j.jew_id AND j.is_deleted = 0
LEFT JOIN tbl_lot l
    ON j.metal_id = l.lot_id AND l.is_deleted = 0
LEFT JOIN tbl_karatage kt on l.karatage_id = kt.karatage_id
LEFT JOIN tbl_country tcou
    ON tcomp.country_id = tcou.country_id
LEFT JOIN tbl_supplier tsup
    ON im.supplier_id = tsup.supplier_id
LEFT JOIN (
    SELECT DISTINCT ON (a.supplier_id)
        a.supplier_id,
        a.country
    FROM tbl_supplier_address a
    WHERE a.is_deleted = 0
    ORDER BY a.supplier_id, a.address_id DESC
) add
    ON add.supplier_id = tsup.supplier_id
LEFT JOIN tbl_payment_type pyt
    ON im.payment_type_id = pyt.payment_type_id
LEFT JOIN (
    SELECT
        c.jew_id,
        SUM(CASE WHEN com.commodity_code = 'DIA' THEN c.total_qty1 ELSE 0 END) AS dia_wt,
        SUM(CASE WHEN com.commodity_code = 'CS'  THEN c.total_qty1 ELSE 0 END) AS cs_wt,
        SUM(CASE WHEN com.commodity_code = 'CZ'  THEN c.total_qty1 ELSE 0 END) AS cz_wt,
        SUM(CASE WHEN com.commodity_code = 'PRL' THEN c.total_qty1 ELSE 0 END) AS pearl_wt
    FROM tbl_jewellery_component c
    INNER JOIN tbl_commodity com
        ON com.commodity_id = c.commodity_id
    GROUP BY c.jew_id
) stoneWt
    ON stoneWt.jew_id = j.jew_id

WHERE im.is_deleted = 0
  AND im.inv_id IN ($P!{i_inv_id})
ORDER BY id.inv_det_id asc;]]>
	</queryString>
