<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKK_SubReport02" pageWidth="862" pageHeight="200" columnWidth="862" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="164787d2-0b5e-42a4-8bf7-81dda9657bd8">
	<property name="ireport.zoom" value="1.607691607500001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="sales_order_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="jew_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tx.*
from (
    with w_result_set as (
        select
           'Mould' etype,
           cm.commodity_name,
           NULL as shape_name,
           NULL as sieve_size,
           som.weight as total_qty1,
           som.qty as total_qty2,
           concat(round(som.weight,3), '/', round(som.qty,0)) as wt_pcs,
           som.description as remarks,
           NULL as setting_type_name,
           p.part_name as lot_code
        from tbl_sales_order_finding som
        inner join tbl_jewellery j on som.sales_order_det_id = j.sales_order_det_id
        inner join tbl_lot l on som.lot_id = l.lot_id
        inner join tbl_commodity cm on l.commodity_id = cm.commodity_id
        left join tbl_parts p on som.part_id = p.part_id
        where som.is_deleted = 0
		 and j.job_category = 'Normal'
          and j.jew_id = $P!{jew_id}
		union all
			 select
           'Repair' etype,
           cm.commodity_name,
           NULL as shape_name,
           NULL as sieve_size,
           ic.qty1 as total_qty1,
           ic.qty2 as total_qty2,
           concat(round(ic.qty1,3), '/', round(ic.qty2,0)) as wt_pcs,
           NULL as remarks,
           NULL as setting_type_name,
           l.lot_code as lot_code
        from
		tbl_jewellery j
		inner join tbl_mfg_bag bag on j.jew_id = bag.job_id and bag.is_deleted = 0
        inner join tbl_lot l on j.metal_id = l.lot_id
		INNER JOIN tbl_mfg_bag_rm_issue_receive_det id
            ON bag.bag_id = id.bag_id
            AND id.is_deleted = 0
        INNER JOIN tbl_mfg_bag_rm_issue_receive_component ic
            ON id.inv_det_id = ic.inv_det_id
			and l.lot_id = ic.lot_id
            AND ic.is_deleted = 0
		 INNER JOIN tbl_mfg_bag_rm_issue_receive i on i.inv_id = id.inv_id and i.is_deleted = 0
        inner join tbl_commodity cm on l.commodity_id = cm.commodity_id
        where j.is_deleted = 0
		and i.inv_type = 'RBRMI'
		 and j.job_category = 'Repair'
          and j.jew_id = $P!{jew_id}
    )
    select * from w_result_set
    union all
    select
        'Mould', null, null, null, null, null, null, null, null, null
    from generate_series(
        1,
        greatest(0, 5 - (select count(*) from w_result_set))
    )
) tx

union all

select ty.*
from (
    with w_result_set as (

        -- NORMAL COMPONENTS
        (
            select
               'Stone' as etype,
               cm.commodity_name,
               shp.shape_name,
               case when som.mm_size is not null then som.mm_size else coalesce(som.sieve,'') end as sieve_size,
               som.qty1,
               som.qty2,
               concat(round(som.tot_qty,3), '/', round(som.qty2,0)) as wt_pcs,
               som.remarks,
               stp.setting_type_name,
               lot.lot_code
            from tbl_sales_order_component som
            inner join tbl_jewellery j on som.sales_order_det_id = j.sales_order_det_id
            left join tbl_commodity cm on som.commodity_id = cm.commodity_id
            left join tbl_shape shp on som.shape_id = shp.shape_id
            left join tbl_lot lot on som.lot_id = lot.lot_id
            left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
            where som.is_deleted = 0
              and j.job_category = 'Normal'
              and j.jew_id = $P!{jew_id}
        )
        union all
        -- REPAIR COMPONENTS
        (
            select
               'Stone' as etype,
               cm.commodity_name,
               shp.shape_name,
               case when som.mm_size is not null then som.mm_size else coalesce(som.sieve,'') end as sieve_size,
               som.qty1,
               som.qty2,
               concat(round(som.tot_qty,3), '/', round(som.qty2,0)) as wt_pcs,
               som.remarks,
               stp.setting_type_name,
               lot.lot_code
            from tbl_repair_order_component som
            inner join tbl_jewellery j on som.repair_order_det_id = j.sales_order_det_id
            left join tbl_commodity cm on som.commodity_id = cm.commodity_id
            left join tbl_shape shp on som.shape_id = shp.shape_id
            left join tbl_lot lot on som.lot_id = lot.lot_id
            left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
            where
			  som.is_deleted = 0
              and j.job_category = 'Repair'
              and j.jew_id = $P!{jew_id}
        )

    )
    select * from w_result_set

 union all

   select
    'Stone', null, null, null, null, null, null, null, null, null
from generate_series(
    1,
    case
        when (select count(*) from w_result_set) < 9
        then 9 - (select count(*) from w_result_set)
 	else 0
   end
)
) ty]]>
	</queryString>
