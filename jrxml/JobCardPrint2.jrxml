<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobCardPrint2" pageWidth="450" pageHeight="340" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="448" leftMargin="1" rightMargin="1" topMargin="1" bottomMargin="1" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="component_dia" uuid="e8061e66-2d2b-40af-9c95-d4ac0b602427">
		<parameter name="bagId" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.component_id,
		 tsc.sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.jew_id,
		 (bag.bag_qty * tsc.tot_qty) tot_qty,
		 (bag.bag_qty * tsc.qty1) qty1,
		 (bag.bag_qty * tsc.qty2) qty2,
		 round((case when tsc.qty2 > 0 then tsc.tot_qty / tsc.qty2 else 0 end),3) per_pc_wt
	FROM
		 tbl_sales_order_component tsc
		 inner join tbl_sales_order_det tsd on tsc.sales_order_det_id = tsd.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_jewellery j on tsd.sales_order_det_id = j.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_mfg_bag bag on j.jew_id = bag.job_id
		inner join tbl_commodity com on tsc.commodity_id = com.commodity_id
		inner join tbl_commodity_group cgr on com.commodity_group_id = cgr.commodity_group_id
	WHERE
		 tsc.is_deleted = 0
		 and (cgr.commodity_group_type like '%DIAMOND%')
		 and bag.bag_id = $P!{bagId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pc_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,6) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
		<group name="component_id">
			<groupExpression><![CDATA[$F{component_id}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="comp_cs" uuid="ac55cc8d-a11d-48d8-ad8c-e76ab1d33efa">
		<parameter name="bagId" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.component_id,
		 tsc.sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 j.jew_id,
		 (bag.bag_qty * tsc.tot_qty) tot_qty,
		 (bag.bag_qty * tsc.qty1) qty1,
		 (bag.bag_qty * tsc.qty2) qty2,
		 round((case when tsc.qty2 > 0 then tsc.tot_qty / tsc.qty2 else 0 end),3) per_pc_wt
	FROM
		 tbl_sales_order_component tsc
		 inner join tbl_sales_order_det tsd on tsc.sales_order_det_id = tsd.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_jewellery j on tsd.sales_order_det_id = j.sales_order_det_id
			and tsd.is_deleted = 0
		inner join tbl_mfg_bag bag on j.jew_id = bag.job_id
		inner join tbl_commodity com on tsc.commodity_id = com.commodity_id
		inner join tbl_commodity_group cgr on com.commodity_group_id = cgr.commodity_group_id
	WHERE
		 tsc.is_deleted = 0
		 and (cgr.commodity_group_type not like '%DIAMOND%')
		 and bag.bag_id = $P!{bagId}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pc_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,6) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="i_source_bag_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_bag_No" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_gross_wt" class="java.lang.String"/>
	<parameter name="i_bag_qty" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_cus_bag_no" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_cus_order_no" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	bag.bag_id,
	$P!{i_bag_qty} bag_qty,
	bag.bag_gross_wt,
	$P!{i_bag_No} bag_type_no,
	s.sku_no,
	p.product_type_name,
	sm.mould_no,
	so.reference_no,
	s.customer_ref_no,
          concat(so.sales_order_type,'-',so.sales_order_no) so_no,
	c.display_name customer_name,
          case when $P!{i_cus_order_no} = 'null' then ' ' else $P!{i_cus_order_no} end customer_order_no,
          case when $P!{i_cus_bag_no} = 'null' then ' ' else $P!{i_cus_bag_no} end customer_bag_no,
	sd.customer_sku_no,
	to_char(so.delivery_date, 'dd-Mon-yyyy') delivery_date,
	to_char(so.sales_order_date, 'dd-Mon-yyyy') sales_order_date,
	ps.product_size,
	t.metal_weight,
	sf.finding_name||' ( '|| sf.weight ||' ) ' finding_name,
	pc.*,
	(bag.bag_qty * sc.tot_qty) tot_qty,
	(bag.bag_qty * sc.qty2) qty2,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url
from
	tbl_jewellery t
	inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
		and bag.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
	left join(
	select tbag.bag_id, sum(c.tot_qty) tot_qty, sum(c.qty1) qty1, sum(c.qty2) qty2
	 from    tbl_jewellery sjob
	inner join tbl_sales_order_component c on sjob.sales_order_det_id = c.sales_order_det_id
	 and c.is_deleted  = 0
	inner join tbl_mfg_bag tbag on sjob.jew_id = tbag.job_id
	 where (tbag.bag_id ) in ($P!{i_source_bag_id})
	 group by tbag.bag_id
	)sc on bag.bag_id = sc.bag_id
	left join(
			select
			jm.job_id,
			round(max(case when upper(dp.process_name) = 'CASTING' then jm.output_weight else 0 end),3) casting_wt,
			round(max(case when upper(dp.process_name) = 'SOCKET' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) socket_wt,
			round(max(case when upper(dp.process_name) = 'SEMI POLISH' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) semi_polish_wt,
			round(max(case when upper(dp.process_name) = 'ASSEMBLY' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) anging_wt,
			round(max(case when upper(dp.process_name) = 'CAM' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) cam_wt,
			round(max(case when upper(dp.process_name) = 'CAD' and jm.loss_weight <> 0 then jm.output_weight else 0 end),4) cad_wt,
			round(max(case when upper(dp.process_name) = 'FILING' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) sf_filing_wt,
			round(max(case when upper(dp.process_name) = 'PIPE PAIR' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) pipe_pair_wt,
			round(max(case when upper(dp.process_name) = 'DESIGNING' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) sf_design_wt,
			round(max(case when upper(dp.process_name) = 'S-WALLBUM' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) valbum_wt,
			round(max(case when upper(dp.process_name) = 'SCREW' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) screw_wt,
			round(max(case when upper(dp.process_name) = 'BUR' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) balls_wt,
			round(max(case when upper(dp.process_name) = 'POLISH' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) polish_wt,
			round(max(case when upper(dp.process_name) = 'PRE PCS' and jm.loss_weight <> 0 then jm.output_weight else 0 end),3) per_pcs_wt
		 	from tbl_mfg_job_metal_weight_calculation jm
		    inner join tbl_process dp on jm.process_id = dp.process_id
		    inner join tbl_mfg_bag mb on jm.job_id = mb.job_id
		    where (mb.bag_id ) in ($P!{i_source_bag_id})
		    group by jm.job_id
    )pc on bag.job_id = pc.job_id
	left join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
	left join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	left join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	left join tbl_sku_mould sm on t.sku_id = sm.sku_id
		and sm.is_deleted = 0
	left join (
		select sjob.jew_id, max(c.finding_name) finding_name, max(c.weight) weight
		 from    tbl_jewellery sjob
		inner join tbl_sales_order_finding c on sjob.sales_order_det_id = c.sales_order_det_id
		 and c.is_deleted  = 0
		inner join tbl_mfg_bag tbag on sjob.jew_id = tbag.job_id
		 where (tbag.bag_id ) in ($P!{i_source_bag_id})
		 group by sjob.jew_id
	)sf on bag.job_id = sf.jew_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
 (bag.bag_id ) in ($P!{i_source_bag_id})]]>
	</queryString>
