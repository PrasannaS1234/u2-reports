	<parameter name="invoiceNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\tekfilo-java\\tekfilo-connectx-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over( order by im.items,im.style_no,im.cref) sr_no,
	im.job_no jobno,
	im.style_no styleno,
	concat(im.metal,'T ',im.items,' SET WITH DIAMOND') description,
	(total_gross_wt) gross_wt,
	1.0 qty,
	round(total_amount,2)	unit_price,
	round(total_amount,2) unit_amt,
  	'Total Weight  goldt.(gms.)' total_met_desc,
	--COALESCE(im.total_cust_dia_wt,0.00) tot_cus_dia_wt,
	--COALESCE(im.total_cust_cs_wt,0.00) cust_cs_wt,
	case when im.total_cust_dia_wt = 0 then null else im.total_cust_dia_wt end tot_cus_dia_wt,
	case when im.total_cust_cs_wt = 0 then null else im.total_cust_cs_wt end cust_cs_wt,
	--COALESCE(im.total_our_dia_wt,0.00) u_tot_dia_wt,
	case when im.total_our_dia_wt = 0 then null else im.total_our_dia_wt end u_tot_dia_wt,
	--COALESCE(im.total_our_cs_wt,0.00) u_cs_wt,
	case when im.total_our_cs_wt = 0 then null else im.total_our_cs_wt end u_cs_wt,
          im.inv_id,
inv_main.inv_no,
to_char(inv_main.inv_dt,'DD-Mon-YYYY') inv_dt,
spellnumericvalue(sum(round(im.total_amount,2)) over(), 'USD') words,
inv_main.customer_name
from
	tbl_invoice_summary im
inner join tbl_invoice_main inv_main on im.inv_id = inv_main.inv_id
where
	im.is_deleted = 0
	and im.inv_id = $P!{invId} order by im.items,im.style_no,im.cref]]>
	</queryString>
