<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JewelleryDetailsSub" pageWidth="2135" pageHeight="842" columnWidth="2135" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="303"/>
	<property name="ireport.y" value="0"/>
	<parameter name="jew_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_tot_amt as
(
select
	rr.jew_id,
	sum(rr.dia_total_amount) as dia_total_amount,
	sum(rr.cs_total_amount) as cs_total_amount,
	sum(rr.met_total_amount) as met_total_amount,
	sum(rr.lab_total_amount) as lab_total_amount
from
(
select
   jltc.jew_id,
   sum(sum(jltc.total_qty1 * jltc.pp_rate))	OVER () as dia_total_amount,
   0 cs_total_amount,
   0 met_total_amount,
   0 lab_total_amount
FROM
tbl_jewellery_component jltc
LEFT JOIN tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
LEFT JOIN tbl_lot lot ON jltc.lot_id = lot.lot_id
LEFT JOIN tbl_shape shp ON jltc.shape_id = shp.shape_id
LEFT JOIN tbl_setting_type stp ON jltc.setting_type_id = stp.setting_type_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
WHERE
jltc.jew_id = $P!{jew_id}
	and cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND')
group by
    jltc.jew_id
union
select
   jltc.jew_id,
   0 dia_total_amount,
   sum(sum(jltc.total_qty1 * jltc.pp_rate))	OVER () as cs_total_amount,
   0 met_total_amount,
   0 lab_total_amount
FROM
tbl_jewellery_component jltc
LEFT JOIN tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
LEFT JOIN tbl_lot lot ON jltc.lot_id = lot.lot_id
LEFT JOIN tbl_shape shp ON jltc.shape_id = shp.shape_id
LEFT JOIN tbl_setting_type stp ON jltc.setting_type_id = stp.setting_type_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
WHERE
jltc.jew_id = $P!{jew_id}
	and cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL')
group by
    jltc.jew_id
union
select
   jltc.jew_id,
   0 dia_total_amount,
   0 cs_total_amount,
   sum(sum(jltc.total_qty1 * jltc.pp_rate))	OVER () as met_total_amount,
   0 lab_total_amount
FROM
tbl_jewellery_component jltc
LEFT JOIN tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
LEFT JOIN tbl_lot lot ON jltc.lot_id = lot.lot_id
LEFT JOIN tbl_shape shp ON jltc.shape_id = shp.shape_id
LEFT JOIN tbl_setting_type stp ON jltc.setting_type_id = stp.setting_type_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
WHERE
jltc.jew_id = $P!{jew_id}
	and cmg.commodity_group_type in ('METAL')
group by
    jltc.jew_id
union
select
   jltc.jew_id,
   0 dia_total_amount,
   0 cs_total_amount,
   0 met_total_amount,
   COALESCE((sum(sum(jlb.qty * jlb.rate))	OVER ()),0) as lab_total_amount
FROM
tbl_jewellery_component jltc
LEFT JOIN tbl_jewellery_labour jlb ON jltc.jew_id = jlb.jew_id
WHERE
jltc.jew_id = $P!{jew_id}
group by
    jltc.jew_id
) rr
group by
    rr.jew_id
),w_result_set as
(
Select
res.jew_id,
max(res.karatage) karatage,
max(res.net_wt) net_wt,
max(res.loss_wt) loss_wt,
max(res.met_rate) met_rate,
max(res.met_amount) met_amount,
max(res.dia_column_lot_code) as dia_column_lot_code,
max(res.dia_column_commodity_name) as dia_column_commodity_name,
max(res.dia_column_shape_name) as dia_column_shape_name,
max(res.dia_column_sieve_size) as dia_column_sieve_size,
max(res.dia_column_mm_size) as dia_column_mm_size,
sum(res.dia_column_total_qty1) as dia_column_total_qty1,
sum(res.dia_column_total_qty2) as dia_column_total_qty2,
max(res.dia_column_rate) as dia_column_rate,
sum(res.dia_column_amount) as dia_column_amount,
max(res.dia_column_setting_type) as dia_column_setting_type,
max(res.dia_total_amount) as dia_total_amount,
max(res.cs_column_lot_code) as cs_column_lot_code,
max(res.cs_column_commodity_name) as cs_column_commodity_name,
max(res.cs_column_shape_name) as cs_column_shape_name,
max(res.cs_column_sieve_size) as cs_column_sieve_size,
max(res.cs_column_mm_size) as cs_column_mm_size,
sum(res.cs_column_total_qty1) as cs_column_total_qty1,
sum(res.cs_column_total_qty2) as cs_column_total_qty2,
max(res.cs_column_rate) as cs_column_rate,
sum(res.cs_column_amount) as cs_column_amount,
max(res.cs_column_setting_type) as cs_column_setting_type,
max(res.cs_total_amount) as cs_total_amount,
max(res.process_name) as labour_process_name,
max(res.qty) as labour_qty,
max(res.rate) as labour_rate,
max(res.amount) as labour_amount,
max(res.lab_total_amount) lab_total_amount
from
(
SELECT
	jltc.jew_id,
	null as karatage,
	0 as net_wt,
	0 as loss_wt,
	0 as met_rate,
	0 as met_amount,
    lot.lot_code AS dia_column_lot_code,
    cm.commodity_name AS dia_column_commodity_name,
    shp.shape_name AS dia_column_shape_name,
    jltc.sieve_size AS dia_column_sieve_size,
    jltc.mm_size AS dia_column_mm_size,
    jltc.total_qty1 AS dia_column_total_qty1,
    jltc.total_qty2 AS dia_column_total_qty2,
    jltc.pp_rate AS dia_column_rate,
    jltc.total_qty1 * jltc.pp_rate AS dia_column_amount,
    stp.setting_type_name AS dia_column_setting_type,
	wt.dia_total_amount,
	null as cs_column_lot_code,
	null AS cs_column_commodity_name,
    null AS cs_column_shape_name,
    null AS cs_column_sieve_size,
    null AS cs_column_mm_size,
    null AS cs_column_total_qty1,
    null AS cs_column_total_qty2,
    null AS cs_column_rate,
    null AS cs_column_amount,
    null AS cs_column_setting_type,
	0 cs_total_amount,
	null AS process_name,
	0 AS qty,
	0 AS rate,
	0 AS amount,
	0 AS lab_total_amount
FROM tbl_jewellery_component jltc
LEFT JOIN tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
LEFT JOIN tbl_lot lot ON jltc.lot_id = lot.lot_id
LEFT JOIN tbl_shape shp ON jltc.shape_id = shp.shape_id
LEFT JOIN tbl_setting_type stp ON jltc.setting_type_id = stp.setting_type_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
inner join w_tot_amt wt on jltc.jew_id = wt.jew_id
WHERE
     jltc.jew_id = $P!{jew_id}
and cmg.commodity_group_type in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND')
union
SELECT
	jltc.jew_id,
	null as karatage,
	0 as net_wt,
	0 as loss_wt,
	0 as met_rate,
	0 as met_amount,
    null AS dia_column_lot_code,
    null AS dia_column_commodity_name,
    null AS dia_column_shape_name,
    null AS dia_column_sieve_size,
    null AS dia_column_mm_size,
    null AS dia_column_total_qty1,
    null AS dia_column_total_qty2,
    null AS dia_column_rate,
    null AS dia_column_amount,
    null AS dia_column_setting_type,
	null dia_total_amount,
	lot.lot_code as cs_column_lot_code,
	cm.commodity_name AS cs_column_commodity_name,
    shp.shape_name AS cs_column_shape_name,
    jltc.sieve_size AS cs_column_sieve_size,
    jltc.mm_size AS cs_column_mm_size,
    jltc.total_qty1 AS cs_column_total_qty1,
    jltc.total_qty2 AS cs_column_total_qty2,
    jltc.pp_rate AS cs_column_rate,
    jltc.total_qty1 * jltc.pp_rate AS cs_column_amount,
    stp.setting_type_name AS cs_column_setting_type,
	wt.cs_total_amount,
	null AS process_name,
	0 AS qty,
	0 AS rate,
	0 AS amount,
	0 AS lab_total_amount
FROM tbl_jewellery_component jltc
LEFT JOIN tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
LEFT JOIN tbl_lot lot ON jltc.lot_id = lot.lot_id
LEFT JOIN tbl_shape shp ON jltc.shape_id = shp.shape_id
LEFT JOIN tbl_setting_type stp ON jltc.setting_type_id = stp.setting_type_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
inner join w_tot_amt wt on jltc.jew_id = wt.jew_id
WHERE
     jltc.jew_id = $P!{jew_id}
and cmg.commodity_group_type not in ('DIAMOND','CVD','CERTDIAMOND','LOOSEDIAMOND','METAL')
union
select
	jltc.jew_id,
	kt.karatage_name as karatage,
	jltc.consumed_qty1 as net_wt,
	jltc.loss_qty1 as loss_wt,
	jltc.pp_rate as met_rate,
	jltc.consumed_qty1 * jltc.pp_rate as met_amount,
    lot.lot_code AS dia_column_lot_code,
    cm.commodity_name AS dia_column_commodity_name,
    shp.shape_name AS dia_column_shape_name,
    jltc.sieve_size AS dia_column_sieve_size,
    jltc.mm_size AS dia_column_mm_size,
    jltc.total_qty1 AS dia_column_total_qty1,
    jltc.total_qty2 AS dia_column_total_qty2,
    jltc.pp_rate AS dia_column_rate,
    jltc.total_qty1 * jltc.pp_rate AS dia_column_amount,
    stp.setting_type_name AS dia_column_setting_type,
	wt.dia_total_amount,
	null as cs_column_lot_code,
	null AS cs_column_commodity_name,
    null AS cs_column_shape_name,
    null AS cs_column_sieve_size,
    null AS cs_column_mm_size,
    null AS cs_column_total_qty1,
    null AS cs_column_total_qty2,
    null AS cs_column_rate,
    null AS cs_column_amount,
    null AS cs_column_setting_type,
	0 cs_total_amount,
	null AS process_name,
	0 AS qty,
	0 AS rate,
	0 AS amount,
	0 AS lab_total_amount
FROM tbl_jewellery_component jltc
LEFT JOIN tbl_commodity cm ON jltc.commodity_id = cm.commodity_id
LEFT JOIN tbl_lot lot ON jltc.lot_id = lot.lot_id
LEFT JOIN tbl_shape shp ON jltc.shape_id = shp.shape_id
LEFT JOIN tbl_setting_type stp ON jltc.setting_type_id = stp.setting_type_id
LEFT JOIN tbl_commodity_group cmg ON cm.commodity_group_id = cmg.commodity_group_id
left join tbl_karatage kt on lot.karatage_id = kt.karatage_id
inner join w_tot_amt wt on jltc.jew_id = wt.jew_id
WHERE
     jltc.jew_id = $P!{jew_id}
and cmg.commodity_group_type in ('METAL')
union
select
	jltc.jew_id,
	null as karatage,
	0 as net_wt,
	0 as loss_wt,
	0 as met_rate,
	0 as met_amount,
    null AS dia_column_lot_code,
    null AS dia_column_commodity_name,
    null AS dia_column_shape_name,
    null AS dia_column_sieve_size,
    null AS dia_column_mm_size,
    null AS dia_column_total_qty1,
    null AS dia_column_total_qty2,
    null AS dia_column_rate,
    null AS dia_column_amount,
    null AS dia_column_setting_type,
	null dia_total_amount,
	null as cs_column_lot_code,
	null AS cs_column_commodity_name,
    null AS cs_column_shape_name,
    null AS cs_column_sieve_size,
    null AS cs_column_mm_size,
    null AS cs_column_total_qty1,
    null AS cs_column_total_qty2,
    null AS cs_column_rate,
    null AS cs_column_amount,
    null AS cs_column_setting_type,
	null AS cs_total_amount,
	jlb.process_name as process_name,
	jlb.qty as qty,
	jlb.rate as rate,
	jlb.amount as amount,
	wt.lab_total_amount
FROM
tbl_jewellery_component jltc
LEFT JOIN tbl_jewellery_labour jlb ON jltc.jew_id = jlb.jew_id
inner join w_tot_amt wt on jltc.jew_id = wt.jew_id
WHERE
jltc.jew_id = $P!{jew_id}
) res
group by
res.jew_id
)
select
rr.*
from
    w_result_set rr
union all
select
	null as jew_id,
	null as karatage,
	null as net_wt,
	null as loss_wt,
	null as met_rate,
	null as met_amount,
    null AS dia_column_lot_code,
    null AS dia_column_commodity_name,
    null AS dia_column_shape_name,
    null AS dia_column_sieve_size,
    null AS dia_column_mm_size,
    null AS dia_column_total_qty1,
    null AS dia_column_total_qty2,
    null AS dia_column_rate,
    null AS dia_column_amount,
    null AS dia_column_setting_type,
	null as dia_total_amount,
	null as cs_column_lot_code,
	null AS cs_column_commodity_name,
    null AS cs_column_shape_name,
    null AS cs_column_sieve_size,
    null AS cs_column_mm_size,
    null AS cs_column_total_qty1,
    null AS cs_column_total_qty2,
    null AS cs_column_rate,
    null AS cs_column_amount,
    null AS cs_column_setting_type,
	null AS cs_total_amount,
	null as process_name,
	null as qty,
	null as rate,
	null as amount,
	null as lab_total_amount
FROM generate_series(1, 5-(select count(*) from w_result_set))]]>
	</queryString>
