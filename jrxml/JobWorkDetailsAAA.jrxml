<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetails" pageWidth="2600" pageHeight="842" columnWidth="2590" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="257"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["d.inv_det_id"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over (order by $P!{sortColumn}) as sno,
    d.*
from (
    select
        t.inv_id,
        d.inv_det_id,
        concat(t.inv_type||'-'||t.inv_no) inv_type_no,
        concat(j.jew_type,j.jew_no) job_no,
        concat(so.sales_order_type||'-'||so.sales_order_no) so_no,
        concat(sod.sales_order_det_type,'-',sod.sales_order_det_no) sod_no,
        sku.sku_no,
        concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url) image_url,
        pr.product_type_name as product_type_name,
        lot1.lot_code as metal_code1,
        ps.product_size,
        d.inv_qty as qty,
        COALESCE(net.gross_wt,0) gross_wt,
        COALESCE(net.net_wt,0) net_wt,
        COALESCE(net.gold_rate,0) gold_rate,
        round(COALESCE(net.net_wt,0) * COALESCE(net.gold_rate,0),3) gold_value,
        COALESCE(net.stone_amount,0) stone_amount,
        COALESCE(lab.amount,0) labour,
        round((COALESCE(net.net_wt,0) * COALESCE(net.gold_rate,0)) + COALESCE(net.stone_amount,0) + COALESCE(lab.amount,0),2) + COALESCE(lab.amount,0) total_amount

    from tbl_factory_invoice_main t
    inner join tbl_factory_invoice_det d
        on t.inv_id = d.inv_id and d.is_deleted = 0
    inner join tbl_jewellery j
        on d.jew_id = j.jew_id

    left join tbl_sales_order_det sod
        on j.sales_order_det_id = sod.sales_order_det_id
        and sod.is_deleted = 0
        and j.job_category = 'Normal'

    left join tbl_sales_order_main so
        on sod.sales_order_id = so.sales_order_id
        and so.is_deleted = 0

    inner join tbl_sku sku
        on j.sku_id = sku.sku_id
    inner join tbl_product_type pr
        on sku.product_type_id = pr.product_type_id

    left join tbl_lot lot1
        on j.metal_id = lot1.lot_id
    left join tbl_product_size ps
        on j.product_size_id = ps.size_id

    left join (
        select comp.inv_det_id,
            sum(case when lot.lot_type = 'METAL' then comp.consumed_qty1 else 0 end) net_wt,
            round(sum(case
                when lot.lot_type = 'METAL' then comp.consumed_qty1
                when lot.lot_type = 'STONE' then comp.consumed_qty1 * 0.2
                else 0 end),3) gross_wt,
            max(case when upper(COALESCE(com.metal_type,'GOLD')) = 'GOLD'
                and lot.lot_type = 'METAL' then comp.pp_rate else 0 end) gold_rate,
            max(case when upper(COALESCE(com.metal_type,'GOLD')) = 'SILVER'
                and lot.lot_type = 'METAL' then comp.pp_rate else 0 end) silver_rate,
            max(case when upper(COALESCE(com.metal_type,'GOLD')) = 'PT'
                and lot.lot_type = 'METAL' then comp.pp_rate else 0 end) pt_rate,
            round(sum(case when lot.lot_type = 'STONE' then comp.consumed_qty1 * comp.pp_rate else 0 end),2) stone_amount
        from tbl_factory_invoice_component comp
        inner join tbl_lot lot on comp.lot_id = lot.lot_id
        inner join tbl_commodity com on lot.commodity_id = com.commodity_id
        where comp.is_deleted = 0
        group by comp.inv_det_id
    ) net on d.inv_det_id = net.inv_det_id

    left join (
        select la.inv_det_id, sum(la.amount) amount
        from tbl_factory_invoice_labour la
        where la.is_deleted = 0
        group by la.inv_det_id
    ) lab on d.inv_det_id = lab.inv_det_id

    where t.is_deleted = 0
      and t.inv_id in ($P!{i_inv_id})
) d

order by
$P!{sortColumn}]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="job_no" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="sod_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="metal_code1" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="gross_wt" class="java.math.BigDecimal"/>
	<field name="net_wt" class="java.math.BigDecimal"/>
	<field name="gold_rate" class="java.math.BigDecimal"/>
	<field name="gold_value" class="java.math.BigDecimal"/>
	<field name="stone_amount" class="java.math.BigDecimal"/>
	<field name="labour" class="java.math.BigDecimal"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<variable name="qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="labor" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="total_amount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
	</variable>
