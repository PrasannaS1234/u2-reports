<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobSheetBKK_SubReport02" pageWidth="561" pageHeight="200" columnWidth="561" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="164787d2-0b5e-42a4-8bf7-81dda9657bd8">
	<property name="ireport.zoom" value="1.5026296018031553"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="jew_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
	select
       cm.commodity_name,
       shp.shape_name,
       coalesce(som.mm_size,som.sieve) sieve_size,
       som.tot_qty total_qty1,
       som.qty2 total_qty2,
       stp.setting_type_name
  from tbl_sales_order_component som
 inner join tbl_jewellery j on som.sales_order_det_id = j.sales_order_det_id
 left join tbl_commodity cm on som.commodity_id = cm.commodity_id
 left join tbl_shape shp on som.shape_id = shp.shape_id
 left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
 where
      som.is_deleted = 0
      and j.jew_id = $P!{jew_id}
)
select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
    NULL as commodity_name,
    NULL AS shape_name,
	NULL AS seive_size,
    NULL AS qty1,
    NULL AS qty2,
	NULL AS setting_type_name
FROM generate_series(1, 9-(select count(*) from w_result_set))]]>
	</queryString>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="sieve_size" class="java.lang.String"/>
	<field name="total_qty1" class="java.math.BigDecimal"/>
	<field name="total_qty2" class="java.math.BigDecimal"/>
	<field name="setting_type_name" class="java.lang.String"/>
