	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="614"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<style name="style1" vAlign="Top"/>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["'TEKFILO'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["'Style Catalogue'"]]></defaultValueExpression>
	</parameter>
	<parameter name="catalogName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="catalogDescription" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="product_type" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="prod_size" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="diamond_weight" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="color_stone_weight" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="metal" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="karatage" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="metal_weight" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	cm.catalog_name,
	cm.description,
	v.product_name,
	case when $P{product_type} = 1 then v.product_type_name end as product_type_name,
	coalesce(v.product_desc,'') product_desc,
	case when $P{diamond_weight} =1 then coalesce(v.dia_qty1,0.000) end as dia_qty1,
	coalesce(v.dia_qty2,0.000) dia_qty2,
	case when $P{color_stone_weight} =1 then coalesce(v.cs_qty1,0.000) end as cs_qty1,
	coalesce(v.cs_qty2,0.000) cs_qty2,
          case when $P{product_type} = 1 then 'Product Type' else null end as product_type_lable,
          case when $P{prod_size} = 1 then 'Product Size' end as product_size_lable,
          case when $P{diamond_weight} = 1 then 'Diamond Weight' end as diamon_wt_lable,
          case when  $P{color_stone_weight} = 1 then 'Colour Stone Weight' end as cs_wt_lable,
          case when $P{metal} = 1 then 'Metal' end as metal_lable,
          case when $P{karatage} = 1 then 'Karatage' end as karatage_lable,
          case when $P{metal_weight} = 1 then 'Metal Weight' end metal_wt_lable,
          case when $P{metal_weight} = 1 then coalesce(v.metal_wt,null) end metal_wt,
	v.is_center_stone,
	case when $P{karatage} = 1 then coalesce(v.karatage,'-') end karatage,
	case when $P{metal}  = 1 then coalesce(v.metal_code,'-') end metal_code,
	case when $P{prod_size} = 1 then coalesce(v.product_size, '-') end product_size,
case when v.picture_url is not null
then concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',v.company_id,'/',lower(cd.category),'/',cd.product_id,v.picture_url)
when cd.category = 'JEWELLERY' and sku.image_url is not null
then concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku','/',sku.sku_id,sku.image_url)
end as image_url,
          concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',v.company_id,'/','company','/',c.company_id,c.log_url) logo_url
from
	tbl_catalog  cm
	left join tbl_catalog_det cd on cm.catalog_id = cd.catalog_id
		and cd.is_deleted = 0
	left join v_catalog_summary v on cd.category = v.category
		and cd.product_id = v.product_id
          left join tbl_company c on c.company_id = cm.company_id
          left join tbl_jewellery j on cd.product_id = j.jew_id and cd.category = 'JEWELLERY'
	left join tbl_sku sku on j.sku_id = sku.sku_id
where
	cm.is_deleted = 0
	and cm.catalog_id = $P!{id}
order by cd.catalog_det_id asc]]>
	</queryString>
