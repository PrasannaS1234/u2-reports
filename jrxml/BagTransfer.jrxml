			<textField isStretchWithOverflow="true" pattern="#,##0;(#,##0)" isBlankWhenNull="true">
				<reportElement key="textField" stretchType="RelativeToTallestObject" x="320" y="0" width="50" height="20" isPrintWhenDetailOverflows="true" uuid="a8443164-316f-4b52-a3c6-6b75222c7ca1"/>
				<box leftPadding="2" rightPadding="2">
