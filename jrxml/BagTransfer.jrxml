<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GoodsIssueNote" pageWidth="725" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="675" leftMargin="40" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.inv_id,
	concat(t.inv_type,'-',t.inv_no) inv_type_no,
		to_char(t.created_dt AT TIME ZONE 'UTC' AT TIME ZONE coalesce(comp.time_zone, 'Asia/Kolkata'),concat(comp.date_format,' HH:mi:ss AM')) AS inv_dt,
	row_number() over (partition by t.inv_id order by t.inv_id, d.inv_det_id) sno,
	cus.display_name customername,
	concat(bag.bag_type,bag.bag_no) bag_type_no,
	concat(j.jew_type,j.jew_no) jew_type_no,
	coalesce(bag.customer_bag_no, customer_jew_no) customer_bag_no,
	sd.reference_no,
	concat(fd.department_name,' Department') from_sign,
	concat(td.department_name,' Department') to_sign,
	bag.bag_qty,
	c.dia_qty1,
	c.dia_qty2,
	c.cs_qty1,
	c.cs_qty2,
	bag.bag_gross_wt,
	bag.bag_metal_wt
from
	tbl_mfg_bag_transfer t
	inner join tbl_company comp on t.company_id = comp.company_id
	inner join tbl_mfg_bag_transfer_det d on t.inv_id = d.inv_id
		and d.is_deleted = 0
	inner join tbl_mfg_bag bag on d.bag_id = bag.bag_id
	inner join tbl_jewellery j on bag.job_id = j.jew_id
	inner join tbl_department fd on t.from_department_id = fd.department_id
	inner join tbl_department td on t.to_department_id = td.department_id
	inner join tbl_customer cus on j.customer_id = cus.customer_id
	left join(
		select
			cmp.inv_det_id,
			sum(case when coalesce(com.metal_type,'DIAMOND') = 'DIAMOND' then cmp.qty1 else 0 end) dia_qty1,
			sum(case when coalesce(com.metal_type,'DIAMOND') = 'DIAMOND' then cmp.qty2 else 0 end) dia_qty2,
			sum(case when coalesce(com.metal_type,'DIAMOND') = 'GEMSTONE' then cmp.qty1 else 0 end) cs_qty1,
			sum(case when coalesce(com.metal_type,'DIAMOND') = 'GEMSTONE' then cmp.qty2 else 0 end) cs_qty2
		from
			tbl_mfg_bag_transfer_component cmp
			inner join tbl_lot l on cmp.lot_id = l.lot_id
				and l.lot_type = 'STONE'
			inner join tbl_commodity com on l.commodity_id = com.commodity_id
		where cmp.is_deleted = 0
		group by cmp.inv_det_id
	)c  on d.inv_det_id = c.inv_det_id
	left join(
		select
			'Normal' job_category,
			nsd.sales_order_det_id,
			nsm.reference_no,
			nsd.customer_jew_no,
			nsd.customer_order_no
		from
			tbl_sales_order_det nsd
			inner join tbl_sales_order_main nsm on nsd.sales_order_id = nsm.sales_order_id
		where
			nsd.is_deleted = 0
		union all
		select
			'Repair' job_category,
			rsd.repair_order_id sales_order_det_id,
			rsm.reference_no,
			rsd.customer_jew_no,
			rsd.customer_order_no
		from
			tbl_repair_order_det rsd
			inner join tbl_repair_order_main rsm on rsd.repair_order_id = rsm.repair_order_id
		where
			rsd.is_deleted = 0
	)sd on j.job_category = sd.job_category
		and j.sales_order_det_id = sd.sales_order_det_id
where
	t.is_deleted = 0
	and t.inv_id = $P!{i_inv_id}
order by t.inv_id]]>
	</queryString>
