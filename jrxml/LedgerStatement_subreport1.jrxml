		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
ac.account_name,
case when d.dr_cr = 'D' then d.amount end as debit_amt,
case when d.dr_cr = 'C' then d.amount end as credit_amt
from tbl_account_posting_main m
inner join tbl_account_posting_det d on d.posting_id = m.posting_id and d.is_deleted = 0
inner join tbl_account ac on ac.account_id = d.account_id
where
m.company_id = 10
and m.is_deleted = 0
and m.posting_id = 670
and ac.account_id != 50]]>
	</queryString>
	<field name="account_name" class="java.lang.String"/>
	<field name="debit_amt" class="java.math.BigDecimal"/>
	<field name="credit_amt" class="java.math.BigDecimal"/>
