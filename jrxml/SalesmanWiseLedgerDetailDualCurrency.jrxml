			<conditionExpression><![CDATA[new Boolean(($F{vou_status}.toUpperCase()).contains( "DONE" ))]]></conditionExpression>
			<style forecolor="#3333FF" fill="Solid" markup="none" fontName="Arial" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" isPdfEmbedded="true"/>
		</conditionalStyle>
	</style>
	<parameter name="accountCode" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'28/08/2020'"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'28/08/2050'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'DD/MM/YYYY'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="subgroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="groupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="salesmanId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="accountId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="invoiceSalesManId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH accfil AS
(
    SELECT
        acc.*
    FROM tbl_account acc
    INNER JOIN tbl_sub_group sg
        ON acc.subgroup_id = sg.subgroup_id
    INNER JOIN tbl_group grp
        ON sg.group_id = grp.group_id
    INNER JOIN tbl_schedule st
        ON grp.schedule_id = st.schedule_id
    WHERE acc.is_deleted = 0
        AND (sg.subgroup_id IN ($P!{subgroupId}) OR -1 IN ($P!{subgroupId}))
        AND (grp.group_id IN ($P!{groupId}) OR -1 IN ($P!{groupId}))
        AND (acc.account_id IN ($P!{i_inv_id}) OR -1 IN ($P!{i_inv_id}))
        AND (acc.account_id IN ($P!{accountId}) OR -1 IN ($P!{accountId}))
),

voudet AS
(
    SELECT
        t2.posting_det_id,
        COALESCE(t2.amount,0) AS disp_amount,
        COALESCE(t2.amount_usd,0) AS amount_usd
    FROM tbl_account_posting_main t1
    INNER JOIN tbl_account_posting_det t2
        ON t1.posting_id = t2.posting_id
        AND t2.is_deleted = 0
    INNER JOIN accfil
        ON t2.account_id = accfil.account_id
    WHERE t1.inv_dt <= TO_DATE($P!{toDate}, $P!{dateFormat})
)

SELECT
    temp.acc_id,
    temp.customer_id,
    temp.account_name,
    temp.salesman_name,
    temp.acc_desc,
    TO_CHAR(temp.inv_dt, $P!{dateFormat}) inv_dt_FRM,
    temp.inv_dt,
    temp.csc_code company_name,
    temp.voucher_id,
    temp.vou_no,
    temp.vou_status,
    temp.reference_no,
    COALESCE(temp.particulars,'') AS particulars,
    COALESCE(temp.narration,'') AS narration,
    temp.debit_amt_local,
    temp.debit_amt_intl,
    temp.credit_amt_local,
    temp.credit_amt_intl,

    NULLIF(
        ROUND(
            SUM(temp.op_bal_amt_local + temp.debit_amt_local - temp.credit_amt_local)
            OVER (
                PARTITION BY temp.acc_desc
                ORDER BY temp.acc_desc,
                inv_dt NULLS FIRST,
                temp.voucher_id,
                temp.cost_category_id,
                temp.sort_seq,
                temp.cost_center_name,
                temp.debit_credit DESC
            ),2
        ),0
    ) ROW_BAL_AMT_LOCAL,

    NULLIF(
        ROUND(
            SUM(temp.op_bal_amt_intl + temp.debit_amt_intl - temp.credit_amt_intl)
            OVER (
                PARTITION BY temp.acc_desc
                ORDER BY temp.acc_desc,
                inv_dt NULLS FIRST,
                temp.voucher_id,
                temp.cost_category_id,
                temp.sort_seq,
                temp.cost_center_name,
                temp.debit_credit DESC
            ),2
        ),0
    ) ROW_BAL_AMT_INTL,

    temp.cost_category_name,
    temp.cost_center_name,
    temp.debit_credit,
    temp.amount,
    temp.sort_seq,
    CASE WHEN temp.currency = 'USD' THEN 'USD' ELSE 'LOCAL' END currency

FROM
(

    -------------------------------------------------------------------
    -- OPENING BALANCE
    -------------------------------------------------------------------

    SELECT
        MAX(accfil.account_id) acc_id,
        MAX(cus.customer_id) customer_id,
        MAX(accfil.account_name) account_name,
        MAX(sman.first_name) salesman_name,
       -- MAX(cus.customer_name) customer_name,
        accfil.account_name || ' (' || accfil.account_code || ')' acc_desc,
        NULL inv_dt,
        NULL csc_code,
        -1 voucher_id,
        NULL vou_no,
        NULL reference_no,
        'Opening Balance' particulars,
        '' narration,

        ROUND(SUM(v.disp_amount * t2.in_out_flag),2) op_bal_amt_local,
        ROUND(SUM(v.amount_usd * t2.in_out_flag),2) op_bal_amt_intl,

        0 debit_amt_local,
        0 debit_amt_intl,
        0 credit_amt_local,
        0 credit_amt_intl,

        NULL cost_category_name,
        NULL cost_center_name,
        NULL debit_credit,
        CAST(NULL AS bigint) amount,

        -2 cost_category_id,
        'POSTED' vou_status,
        1 sort_seq,

        MAX(t1.currency) currency

    FROM tbl_account_posting_main t1

    INNER JOIN tbl_account_posting_det t2
        ON t1.posting_id = t2.posting_id
        AND t2.is_deleted = 0

    INNER JOIN voudet v
        ON t2.posting_det_id = v.posting_det_id

    INNER JOIN tbl_company t3
        ON t1.company_id = t3.company_id

    INNER JOIN accfil
        ON t2.account_id = accfil.account_id

  INNER JOIN (select s.customer_id , c.salesman_id from tbl_sales_invoice_main s
inner join tbl_customer c on s.customer_id = c.customer_id
where s.is_deleted = 0
group by s.customer_id, c.salesman_id
union all
select s.customer_id , c.salesman_id from tbl_jew_sales_invoice_main s
inner join tbl_customer c on s.customer_id = c.customer_id
where s.is_deleted = 0
group by s.customer_id, c.salesman_id
union all
select s.customer_id , c.salesman_id from tbl_jew_memo_sales_invoice_main s
inner join tbl_customer c on s.customer_id = c.customer_id
where s.is_deleted = 0
group by s.customer_id, c.salesman_id
union all
select s.customer_id , c.salesman_id from tbl_jew_memo_sales_invoice_main s
inner join tbl_customer c on s.customer_id = c.customer_id
where s.is_deleted = 0
group by s.customer_id, c.salesman_id)cus
        ON (
            cus.salesman_id IN ($P!{invoiceSalesManId})
            OR -1 IN ($P!{invoiceSalesManId})
        )
INNER JOIN tbl_customer cust
        ON (
            cust.salesman_id IN ($P!{salesmanId})
            OR -1 IN ($P!{salesmanId})
        )

    INNER JOIN
    (
        SELECT DISTINCT customer_id, account_id
        FROM tbl_customer_account_map
    ) cacc
        ON cacc.customer_id = CASE WHEN $P!{invoiceSalesManId} = '-1' THEN $P!{salesmanId} ELSE $P!{invoiceSalesManId} END

    INNER JOIN tbl_employee sman
        ON sman.employee_id = CASE WHEN $P!{invoiceSalesManId} = '-1' THEN cust.salesman_id ELSE cus.salesman_id END

    WHERE t1.inv_dt < TO_DATE($P!{fromDate}, $P!{dateFormat})
        AND cacc.account_id = accfil.account_id

    GROUP BY
        accfil.account_name || ' (' || accfil.account_code || ')'

    HAVING ROUND(ABS(SUM(t2.amount * t2.in_out_flag)),1) > 0

    UNION ALL

    -------------------------------------------------------------------
    -- SUMMARY
    -------------------------------------------------------------------

    SELECT
        accfil.account_id,
        MAX(cus.customer_id) customer_id,
        MAX(accfil.account_name) account_name,
        MAX(sman.first_name) salesman_name,
        --MAX(cus.customer_name) customer_name,

        MAX(accfil.account_name || ' (' || accfil.account_code || ')') acc_desc,

        MAX(t1.inv_dt) inv_dt,
        MAX(t3.company_name) csc_code,

        t1.posting_id voucher_id,

        MAX(t1.inv_type || '-' || t1.inv_no) vou_no,
        MAX(t1.reference_no) reference_no,

        COALESCE(
            MAX(
                CASE
                    WHEN t1.note1 IS NULL THEN ''
                    ELSE t1.note2 || '; '
                END || t1.note3
            ),
        '') particulars,

        COALESCE(MAX(t2.narration), MAX(t1.narration), '') narration,

        0 op_bal_amt_local,
        0 op_bal_amt_intl,

        ROUND(SUM(CASE WHEN t2.in_out_flag = 1 THEN v.disp_amount ELSE 0 END),2) debit_amt_local,
        ROUND(SUM(CASE WHEN t2.in_out_flag = 1 THEN v.amount_usd ELSE 0 END),2) debit_amt_intl,

        ROUND(SUM(CASE WHEN t2.in_out_flag = -1 THEN v.disp_amount ELSE 0 END),2) credit_amt_local,
        ROUND(SUM(CASE WHEN t2.in_out_flag = -1 THEN v.amount_usd ELSE 0 END),2) credit_amt_intl,

        NULL cost_category_name,
        NULL cost_center_name,
        NULL debit_credit,

        CAST(NULL AS bigint) amount,

        -1 cost_category_id,
        'POSTED' vou_status,
        2 sort_seq,

        t1.currency

    FROM tbl_account_posting_main t1

    INNER JOIN tbl_account_posting_det t2
        ON t1.posting_id = t2.posting_id
        AND t2.is_deleted = 0

    INNER JOIN voudet v
        ON t2.posting_det_id = v.posting_det_id

    INNER JOIN tbl_company t3
        ON t1.company_id = t3.company_id

    INNER JOIN accfil
        ON t2.account_id = accfil.account_id

INNER JOIN (select s.customer_id , s.salesman_id from tbl_sales_invoice_main s
where s.is_deleted = 0
group by s.customer_id, s.salesman_id
union all
select s.customer_id , s.salesman_id from tbl_jew_sales_invoice_main s
where s.is_deleted = 0
group by s.customer_id, s.salesman_id
union all
select s.customer_id , s.salesman_id from tbl_jew_memo_sales_invoice_main s
where s.is_deleted = 0
group by s.customer_id, s.salesman_id
union all
select s.customer_id , s.salesman_id from tbl_jew_memo_sales_invoice_main s
where s.is_deleted = 0
group by s.customer_id, s.salesman_id)cus
        ON (
            cus.salesman_id IN ($P!{invoiceSalesManId})
            OR -1 IN ($P!{invoiceSalesManId})
        )
INNER JOIN tbl_customer cust
        ON (
            cust.salesman_id IN ($P!{salesmanId})
            OR -1 IN ($P!{salesmanId})
        )

    INNER JOIN
    (
        SELECT DISTINCT customer_id, account_id
        FROM tbl_customer_account_map
    ) cacc
        ON cacc.customer_id = CASE WHEN $P!{invoiceSalesManId} = '-1' THEN cust.customer_id ELSE cus.customer_id END

    INNER JOIN tbl_employee sman
        ON sman.employee_id = CASE WHEN $P!{invoiceSalesManId} = '-1' THEN cust.salesman_id ELSE cus.salesman_id END

    WHERE t1.inv_dt >= TO_DATE($P!{fromDate}, $P!{dateFormat})
        AND t1.inv_dt <= TO_DATE($P!{toDate}, $P!{dateFormat})
        AND cacc.account_id = accfil.account_id

    GROUP BY
        accfil.account_id,
        t1.posting_id

    HAVING ROUND(ABS(SUM(t2.amount * t2.in_out_flag)),1) > 0

) temp

ORDER BY
    temp.acc_id,
    inv_dt NULLS FIRST,
    temp.voucher_id,
    temp.cost_category_id,
    temp.sort_seq,
    temp.cost_center_name,
    temp.debit_credit DESC]]>
	</queryString>
	<field name="acc_id" class="java.lang.Integer"/>
	<field name="customer_id" class="java.lang.Integer"/>
	<field name="account_name" class="java.lang.String"/>
	<field name="salesman_name" class="java.lang.String"/>
	<field name="acc_desc" class="java.lang.String"/>
	<field name="inv_dt_frm" class="java.lang.String"/>
	<field name="inv_dt" class="java.sql.Date"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="voucher_id" class="java.lang.Integer"/>
	<field name="vou_no" class="java.lang.String"/>
	<field name="vou_status" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="particulars" class="java.lang.String"/>
	<field name="narration" class="java.lang.String"/>
	<field name="debit_amt_local" class="java.math.BigDecimal"/>
	<field name="debit_amt_intl" class="java.math.BigDecimal"/>
	<field name="credit_amt_local" class="java.math.BigDecimal"/>
	<field name="credit_amt_intl" class="java.math.BigDecimal"/>
	<field name="row_bal_amt_local" class="java.math.BigDecimal"/>
	<field name="row_bal_amt_intl" class="java.math.BigDecimal"/>
	<field name="cost_category_name" class="java.lang.String"/>
	<field name="cost_center_name" class="java.lang.String"/>
	<field name="debit_credit" class="java.lang.String"/>
	<field name="amount" class="java.lang.Long"/>
	<field name="sort_seq" class="java.lang.Integer"/>
	<field name="currency" class="java.lang.String"/>
	<variable name="DEBIT_AMT_LOCAL" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_group" calculation="Sum">
		<variableExpression><![CDATA[$F{debit_amt_local}]]></variableExpression>
	</variable>
	<variable name="CREDIT_AMT_LOCAL" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_group" calculation="Sum">
		<variableExpression><![CDATA[$F{credit_amt_local}]]></variableExpression>
	</variable>
	<variable name="DEBIT_AMT_INTL_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_group" calculation="Sum">
		<variableExpression><![CDATA[$F{debit_amt_intl}]]></variableExpression>
	</variable>
	<variable name="CREDIT_AMT_INTL_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_group" calculation="Sum">
		<variableExpression><![CDATA[$F{credit_amt_intl}]]></variableExpression>
	</variable>
	<variable name="CLOSING_BAL_LOCAL" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_group">
		<variableExpression><![CDATA[$F{row_bal_amt_local}]]></variableExpression>
	</variable>
	<variable name="CLOSING_BAL_INTL" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_group">
		<variableExpression><![CDATA[$F{row_bal_amt_intl}]]></variableExpression>
	</variable>
