<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AssortmentFormatIN1_sub" pageWidth="770" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="770" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="61fcc04f-329c-4f00-b3f6-941874fefd1c">
	<property name="ireport.zoom" value="4.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_jew_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_grp_1" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    l.lot_code,
    a.accessory_name,
    a.weight,
    a.pcs
FROM
    tbl_jewellery j
INNER JOIN tbl_sales_order_det d
    ON j.sales_order_det_id = d.sales_order_det_id
    AND d.is_deleted = 0
INNER JOIN tbl_sales_order_accessories a
    ON j.sales_order_det_id = a.sales_order_det_id
    AND a.is_deleted = 0
INNER JOIN tbl_lot l
    ON a.lot_id = l.lot_id
WHERE
    j.jew_id = $P!{i_jew_id}
    AND j.job_category = 'Normal';]]>
	</queryString>
	<field name="lot_code" class="java.lang.String"/>
	<field name="accessory_name" class="java.lang.String"/>
	<field name="weight" class="java.math.BigDecimal"/>
	<field name="pcs" class="java.math.BigDecimal"/>
