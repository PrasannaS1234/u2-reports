<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MaterialDemandGS-ColS" pageWidth="439" pageHeight="802" columnWidth="439" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a249c612-2db5-4606-876e-cc74a31ad2dd">
	<property name="ireport.zoom" value="1.366026910730141"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH data AS (
	SELECT
		m.inv_id inv_id,
		max(concat(m.inv_type,'-',m.inv_no)) demand_no,
		max(COALESCE(sup.supplier_name,dc.company_name)) demand_supplier,
		max(concat(sm.sales_order_type,'-',sm.sales_order_no)) so_no,
		max(sm.reference_no) reference_no,
	    max(COALESCE(sku.set_no,sku.sku_no)) as sku_no,
		max(sd.qty) sales_qty,
		max(l.lot_code) lot_code,
		max(com.commodity_name) commodity_name,
		max(sh.shape_name) shape_name,
		max(d.mm_size) as mm_size,
		max(d.sieve) as sieve,
		sum(sc.tot_qty) pc_qty1,
		sum(sc.qty2) pc_qty2,
		sum(d.qty1) qty1,
		sum(d.qty2) qty2
	FROM
		tbl_material_demand_main m
		inner join tbl_material_demand_det d
			on m.inv_id = d.inv_id
			and d.is_deleted = 0

		inner join tbl_commodity com
			on d.commodity_id = com.commodity_id

		left join tbl_sales_order_main sm
			on d.so_id = sm.sales_order_id

		left join tbl_sales_order_component sc
			on d.sales_order_component_id = sc.component_id
			and sc.is_deleted = 0
			and sm.sales_order_id = sc.sales_order_id

		left join tbl_sales_order_det sd
			on sc.sales_order_det_id = sd.sales_order_det_id
			and sd.is_deleted = 0
			and sm.sales_order_id = sd.sales_order_id

		left join tbl_sku sku
			on sd.sku_id = sku.sku_id

		left join tbl_lot l
			on sc.lot_id = l.lot_id

		left join tbl_shape sh
			on sc.shape_id = sh.shape_id

		left join tbl_supplier sup
			on m.supplier_id = sup.supplier_id

		left join tbl_company dc
			on m.dest_branch_id = dc.company_id

		left join tbl_clarity cla
			on d.clarity_id = cla.clarity_id

	WHERE
		m.is_deleted = 0
		and m.inv_id in ($P!{i_inv_id})
                     and upper(com.metal_type) != 'DIAMOND'
                     and upper(l.lot_type) = 'STONE'

	GROUP BY
		com.commodity_id,
		COALESCE(sku.set_no,sku.sku_no),
		sh.shape_id,
		d.mm_size,
		d.sieve,
		m.inv_id
)

SELECT
	inv_id,
	demand_no,
	demand_supplier,
	so_no,
	reference_no,
	sku_no,
	case
	when
     COUNT(*) OVER (
			PARTITION BY commodity_name, sku_no
		) = 1 then '-'
	 when
	 COUNT(*) OVER (
			PARTITION BY commodity_name, sku_no
		) != 1
	 and
	 ROW_NUMBER() OVER (
			PARTITION BY commodity_name, sku_no
			ORDER BY commodity_name, sku_no, shape_name
		) = 1
	 then sku_no else null end as n_sku_no,

	  ROW_NUMBER() OVER (
			PARTITION BY commodity_name, sku_no
			ORDER BY commodity_name, sku_no, shape_name
		)
	  as row_no,
		 COUNT(*) OVER (
			PARTITION BY commodity_name, sku_no
		) as row_count,

	sales_qty,
	lot_code,
	commodity_name,
	shape_name,
	mm_size,
	sieve,
	pc_qty1,
	pc_qty2,
	qty1,
	qty2

FROM data

ORDER BY
    commodity_name,
    sku_no,
    shape_name,
    lot_code,
    inv_id;]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="demand_no" class="java.lang.String"/>
	<field name="demand_supplier" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="n_sku_no" class="java.lang.String"/>
	<field name="row_no" class="java.lang.Long"/>
	<field name="row_count" class="java.lang.Long"/>
	<field name="sales_qty" class="java.math.BigDecimal"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="sieve" class="java.lang.String"/>
	<field name="pc_qty1" class="java.math.BigDecimal"/>
	<field name="pc_qty2" class="java.math.BigDecimal"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
