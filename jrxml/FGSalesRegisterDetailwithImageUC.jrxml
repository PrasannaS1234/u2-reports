<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetails" pageWidth="700" pageHeight="842" columnWidth="690" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="group1" class="java.lang.String">
		<defaultValueExpression><![CDATA["'product_type'"]]></defaultValueExpression>
	</parameter>
	<parameter name="group2" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="group3" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="group5" class="java.lang.String">
		<defaultValueExpression><![CDATA["null"]]></defaultValueExpression>
	</parameter>
	<parameter name="group4" class="java.lang.String">
		<defaultValueExpression><![CDATA[null]]></defaultValueExpression>
	</parameter>
	<parameter name="company" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'01/01/2020'"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'30/12/2100'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'dd/mm/yyyy'"]]></defaultValueExpression>
	</parameter>
	<parameter name="salesType" class="java.lang.String">
		<defaultValueExpression><![CDATA["'grossSales'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
*
from
(
select
comp.company_id,
comp.display_name as company_display_name,
concat(emp.first_name,' ',emp.last_name) as sales_man,
c.customer_id,
c.customer_name,
c.display_name as customer_display_name,
COALESCE(
        NULLIF(fn_get_customer_invoice_no(m.inv_type, m.inv_id), ''),
        concat(m.inv_type, '-', m.inv_no)) AS inv_no,
m.reference_no,
m.inv_dt,
cu.symbol as currency_symbol,
$P{currency} currency,
m.exchange_rate,
TO_DATE($P!{toDate}, $P!{dateFormat}) as to_date,
TO_DATE($P!{fromDate}, $P!{dateFormat}) as from_date,
j.jew_type||''||j.jew_no as job_no,
sk.sku_no,
pr.product_type_id,
pr.product_type_name,
1 as pcs,
case when $P!{salesType} = 'grossSales' then d.inv_qty
	       when $P!{salesType} = 'netSales' then d.inv_qty - d.ret_qty
	       when $P!{salesType} = 'salesReturn' then d.ret_qty
	    else d.inv_qty end as sales_qty,
j.gross_wt as gross_wt,
(j.net_wt * metal.impure_to_pure_conv_factor) as pure_wt,
(j.diamond_wt + j.gemstone_wt) as stone_wt,
0 as stone_value,
CASE
                WHEN $P!{salesType} = 'grossSales' THEN 'Gross Sales'
                WHEN $P!{salesType} = 'netSales' THEN 'Net Sales'
                WHEN $P!{salesType} = 'salesReturn' THEN 'Sales Return'

            END as sales_type,
    CASE
    WHEN m.currency = $P!{currency}
    THEN
        d.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN d.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN d.inv_qty - d.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN d.ret_qty
                ELSE d.inv_qty
            END
        )

    WHEN m.currency = 'USD'
         AND $P!{currency} <> 'USD'
    THEN
        d.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN d.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN d.inv_qty - d.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN d.ret_qty
                ELSE d.inv_qty
            END
        ) * NULLIF(m.exchange_rate, 0)

    WHEN m.currency <> 'USD'
         AND $P!{currency} = 'USD'
    THEN
        d.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN d.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN d.inv_qty - d.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN d.ret_qty
                ELSE d.inv_qty
            END
        ) / NULLIF(m.exchange_rate, 0)

    ELSE
        d.input_rate *
        (
            CASE
                WHEN $P!{salesType} = 'grossSales' THEN d.inv_qty
                WHEN $P!{salesType} = 'netSales' THEN d.inv_qty - d.ret_qty
                WHEN $P!{salesType} = 'salesReturn' THEN d.ret_qty
                ELSE d.inv_qty
            END
        )
END AS sales_value,

d.ret_qty as sales_return,
d.inv_qty - d.ret_qty as net_sales,
d.uom,
d.input_rate,
d.input_amt,
CASE $P!{group1}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group1,

        CASE $P!{group2}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group2,

        CASE $P!{group3}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group3,

        CASE $P!{group4}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group4,

        CASE $P!{group5}
            WHEN 'company'       THEN comp.display_name
            WHEN 'customer_name' THEN c.customer_name
            WHEN 'sales_man'     THEN CONCAT(emp.first_name, ' ', emp.last_name)
            WHEN 'supplier_name' THEN supplier.supplier_name
            WHEN 'product_type'  THEN pr.product_type_name
            ELSE NULL
        END AS group5,
case
    when coalesce(length(trim(j.image_url)),0) > 0 then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',j.company_id,'/jewellery/',j.jew_id,j.image_url)
    when coalesce(length(trim(sk.image_url)),0) > 0 then
                concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sk.company_id,'/sku/',sk.sku_id,sk.image_url)
    else concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sm.company_id,'/salesorder/',sd.sales_order_det_id,sd.image_url)
end image_url

from tbl_jew_sales_invoice_main m
join tbl_jew_sales_invoice_det d
on m.inv_id = d.inv_id and d.is_deleted = 0
join tbl_jewellery j
on d.jew_id = j.jew_id
left join tbl_sales_order_main sm
on sm.sales_order_id = j.sales_order_id
left join tbl_sales_order_det sd
on sd.sales_order_id = j.sales_order_det_id
left join tbl_lot metal
on metal.lot_id = j.metal_id
join tbl_sku sk
on j.sku_id = sk.sku_id
left join tbl_currency cu on cu.currency_code = $P!{currency}
join tbl_product_type pr
on j.product_type_id = pr.product_type_id
join tbl_customer c
on m.customer_id = c.customer_id
join tbl_company comp
on m.company_id = comp.company_id
left join tbl_employee emp
on emp.employee_id = m.salesman_id
left join (
select distinct on (det.jew_id)
det.jew_id,
sup.supplier_name,
sup.supplier_id
from tbl_jew_purchase_invoice_det det
join tbl_jew_purchase_invoice_main t
on t.inv_id = det.inv_id
and t.is_deleted = 0
inner join tbl_supplier sup
on sup.supplier_id = t.supplier_id
and sup.is_deleted = 0
where det.is_deleted = 0
order by det.jew_id, t.inv_id desc
) supplier
on supplier.jew_id = d.jew_id
	 WHERE m.is_deleted = 0

      AND (
            m.inv_dt >= TO_DATE($P!{fromDate}, $P!{dateFormat})
            OR ' ' = $P!{fromDate}
          )
      AND (
            m.inv_dt <= TO_DATE($P!{toDate}, $P!{dateFormat})
            OR ' ' = $P!{toDate}
          )
      AND m.company_id IN ($P!{company})
)x
where  sales_qty > 0
order by
group1,
group2,
group3,
group4,
group5]]>
	</queryString>
