<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="VoucherDualCur" pageWidth="680" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="655" leftMargin="20" rightMargin="5" topMargin="20" bottomMargin="20" uuid="a2ddf2c9-fb24-4dd5-8562-d3c2b0789871">
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="reportCode" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["EE-01"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_type" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="vouStatus" class="java.lang.String">
		<defaultValueExpression><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["LOC"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="company_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH base AS (
    SELECT
        vc.posting_id,
        vc.inv_type,
        vc.inv_no,
        vc.inv_id,
        vc.currency,
        vc.exchange_rate,
        vc.reference_no,
        vc.note1,
        vc.company_id,
        vc.created_by,
		vc.inv_dt,
  		vc.inv_due_dt,
  		vc.created_dt,

        vcdet.account_id,
        vcdet.dr_cr,
        vcdet.amount,
        vcdet.amount_usd,
        vcdet.in_out_flag,
        vcdet.cost_center_id,
        vcdet.cost_category_id,

        /* Window calculation moved here */
        SUM(
            (CASE WHEN vcdet.in_out_flag = -1 THEN 0 ELSE 1 END) * vcdet.amount
        ) OVER (PARTITION BY vc.posting_id) AS posting_total_amt

    FROM tbl_account_posting_main vc
    JOIN tbl_account_posting_det vcdet
        ON vc.posting_id = vcdet.posting_id
       AND vcdet.is_deleted = 0
    WHERE vc.is_deleted = 0
	  and ((vc.inv_type in ($P!{i_inv_type})))
  and (vc.inv_id in ($P!{i_inv_id}) OR -1 in ($P!{i_inv_id}))
)

SELECT
    MAX(b.posting_id) AS voucher_id,
    MAX(b.posting_id) AS posting_id,
    MAX(comp.company_name) AS company_name,
    NULL AS country_compcode,
    MAX(b.inv_type || '-' || b.inv_no) AS vou_no,
    MAX(b.currency) AS cur_code,

    MAX(CASE WHEN b.currency = 'USD' THEN b.currency END) AS int_cur_code,
    MAX(CASE WHEN b.currency = 'USD' THEN 'Local' ELSE b.currency END) AS loc_cur_code,

    MAX(b.exchange_rate) AS exchange_rate,
    'USD' AS intl_cur_code,
    NULL AS third_cur_code,
    NULL AS third_cur_exchange_rate,

    MAX(b.reference_no) AS off_ref_no,
    MAX(concat(emp.first_name, ' ', emp.last_name, ' (', emp.user_id, ')')) AS vou_entered_by,
	to_char(max(b.inv_dt),$P{dateFormat}) VOU_DT,
    to_char(max(b.inv_due_dt),$P{dateFormat}) VOU_DUE_DT,
    to_char(max(b.created_dt),$P{dateFormat}) VOU_ENTRY_DT,
    'POSTED' AS voucher_status,
    NULL AS loc_code,

    b.account_id,
    MAX(acc.account_name) AS acc_name,
    NULL AS csc_code,
    MAX(b.note1) AS narration,

    MAX(cc2.cost_category_name) AS cost_category,
    MAX(cc1.cost_center_name) AS cost_center,

    SUM(CASE WHEN b.dr_cr = 'D' THEN b.amount_usd END) AS debit_amt_intl_cur,
    SUM(CASE WHEN b.dr_cr = 'D' THEN b.amount END)     AS debit_amt_loc_cur,
    SUM(CASE WHEN b.dr_cr = 'D' THEN b.amount END)     AS debit_amt_tc,

    SUM(CASE WHEN b.dr_cr = 'C' THEN b.amount_usd END) AS credit_amt_intl_cur,
    SUM(CASE WHEN b.dr_cr = 'C' THEN b.amount END)     AS credit_amt_loc_cur,
    SUM(CASE WHEN b.dr_cr = 'C' THEN b.amount END)     AS credit_amt_tc,

    /* Amount in words – now safe */
    MAX(
        CASE
            WHEN b.currency = 'INR' THEN
                initcap(fn_amount_to_words(
                    abs(b.posting_total_amt),
                    b.currency,
                    'Rupees',
                    'Paise'
                ))
            ELSE
                initcap(fn_amount_to_words(
                    abs(b.posting_total_amt),
                    b.currency,
                    'Dollars',
                    'Cents'
                ))
        END
    ) AS amountinwords

FROM base b
JOIN tbl_account acc ON b.account_id = acc.account_id
JOIN tbl_company comp ON b.company_id = comp.company_id
LEFT JOIN tbl_user emp ON b.created_by = emp.user_id
LEFT JOIN tbl_cost_center cc1 ON b.cost_center_id = cc1.cost_center_id
LEFT JOIN tbl_cost_category cc2 ON b.cost_category_id = cc2.cost_category_id

where b.company_id =$P!{company_id}
GROUP BY
    b.inv_type || b.inv_id,
    b.in_out_flag,
    b.account_id

ORDER BY
    posting_id,
    in_out_flag DESC,
    debit_amt_loc_cur DESC]]>
	</queryString>
