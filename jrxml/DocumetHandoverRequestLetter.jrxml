<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DocumetHandoverRequestLetter" pageWidth="594" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="554" leftMargin="20" rightMargin="20" topMargin="50" bottomMargin="20" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="bank_id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    CURRENT_DATE AS curr_dt,
    max(tcomp.company_name) company_name,
          COALESCE(max(tcomp.city),'') comp_city,
	max(im.inv_id) inv_id,
	max(im.inv_type) inv_type,
	max(im.inv_type||'-'||im.inv_no) inv_type_no,
	to_char(max(im.inv_dt), 'dd/mm/yyyy') inv_dt,
	to_char(max(im.inv_due_dt), 'dd/mm/yyyy')     inv_due_dt,
          max(im.inv_dt) inv_dt_text,
		 fn_get_customer_invoice_no(max(im.inv_type),max(im.inv_id)) cus_doc_type,
	max(COALESCE(bank.bank_name,'')) bank_name,
          max(COALESCE(bank.bank_account_number,'')) acc_no,
		  max(COALESCE(bank.beneficiary_name,'')) beneficiary,
		  max(COALESCE(bank.bank_address,'')) bank_add,
          'IFSC Code : ' ||max(COALESCE(bank.ifsc_code,'')) ifsc_code,
          max(im.total_invoice_qty1) qty1,
           max(im.total_invoice_amount) total_amt,
           max(im.inv_type||'-'||im.inv_no) inv_type_no,
           COALESCE(max(tcomp.ie_code_no),'') comp_ie_code_no,
           COALESCE(max(c.pan_no),'') pan_no,
		   COALESCE(max(c.aadhar_no),'') aadhar_no,
		   COALESCE(max(c.nick_name),'')  handover_person,
           to_char(max(tcomp.iec_date), 'dd/mm/yyyy') comp_iec_date,
           ROUND(MAX(im.total_invoice_amount) / NULLIF(MAX(im.exchange_rate),0), 2) AS total_amt_usd
from
	tbl_memo_sales_invoice_main im
	inner join tbl_company tcomp on im.company_id = tcomp.company_id
	inner join tbl_memo_sales_invoice_det id on im.inv_id = id.inv_id
		and id.is_deleted = 0
	  left join tbl_company_bank bank on ($P!{bank_id}) = bank.map_id
	  left join tbl_employee c on im.document_handover_person_id = c.employee_id
where
	im.is_deleted = 0
	and im.inv_id in ($P!{i_inv_id})
group by
	im.inv_id,
	im.inv_type]]>
	</queryString>
	<field name="curr_dt" class="java.sql.Date"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="comp_city" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="inv_due_dt" class="java.lang.String"/>
	<field name="inv_dt_text" class="java.sql.Date"/>
	<field name="cus_doc_type" class="java.lang.String"/>
	<field name="bank_name" class="java.lang.String"/>
	<field name="acc_no" class="java.lang.String"/>
	<field name="beneficiary" class="java.lang.String"/>
	<field name="bank_add" class="java.lang.String"/>
	<field name="ifsc_code" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="total_amt" class="java.math.BigDecimal"/>
	<field name="comp_ie_code_no" class="java.lang.String"/>
	<field name="pan_no" class="java.lang.String"/>
	<field name="aadhar_no" class="java.lang.String"/>
	<field name="handover_person" class="java.lang.String"/>
	<field name="comp_iec_date" class="java.lang.String"/>
	<field name="total_amt_usd" class="java.math.BigDecimal"/>
	<group name="BAG" keepTogether="true">
		<groupExpression><![CDATA[$F{inv_id}]]></groupExpression>
	</group>
	<title>
