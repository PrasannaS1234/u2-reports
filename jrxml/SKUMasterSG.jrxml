<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SkUMaster" pageWidth="640" pageHeight="842" columnWidth="630" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_sku_id" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	s.sku_no,
	d.design_no,
	pt.product_type_name,
	f.factory_name,
	l.lot_code,
	s.metal_weight,
	col.collection_name,
	pr.parameter_name category,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url
from
	tbl_sku s
	inner join tbl_product_type pt on s.product_type_id = pt.product_type_id
	left join tbl_lot l on s.metal_id = l.lot_id
	left join tbl_design d on s.design_id = d.design_id
	left join tbl_factory f on s.factory_id = f.factory_id
	left join tbl_global_parameter pr on pr.parameter_group = 'CATEGORY'
		and pr.is_deleted = 0
		and s.category = pr.parameter_code
	left join tbl_collection col on s.collection_id = col.collection_id
where
	s.sku_id = $P!{i_sku_id}]]>
	</queryString>
	<field name="sku_no" class="java.lang.String"/>
	<field name="design_no" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="metal_weight" class="java.math.BigDecimal"/>
	<field name="collection_name" class="java.lang.String"/>
	<field name="category" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
