	<subDataset name="matrial" uuid="67533e1a-e09d-4e2b-9a76-7621b6dc1a55">
		<parameter name="jew_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[select tx.* from (
with w_result_set as (
	select
	   'Mould' etype,
	   cm.commodity_name,
       NULL shape_name,
       NULL sieve_size,
       som.weight total_qty1,
       som.qty total_qty2,
       som.remarks,
       NULL setting_type_name,
       l.lot_code

 from tbl_sales_order_finding som
 inner join tbl_jewellery j on som.sales_order_det_id = j.sales_order_det_id
 inner join tbl_lot l on som.lot_id = l.lot_id
 inner join tbl_commodity cm on L.commodity_id = cm.commodity_id
 left join tbl_parts p on som.part_id = p.part_id
 where
      som.is_deleted = 0
      and j.jew_id = $P!{jew_id}
)
select
	rr.*
from
  w_result_set rr
UNION ALL
SELECT
	'Mould' etype,
    NULL as commodity_name,
    NULL AS shape_name,
	NULL AS seive_size,
    NULL AS qty1,
    NULL AS qty2,
    NULL AS lot,
    NULL AS remarks,
	NULL AS setting_type_name
FROM generate_series(1, 5-(select count(*) from w_result_set))
)tx
union all
select ty.*
from (
with w_result_set as (
	select
	   'Stone' etype,
       cm.commodity_name,
       shp.shape_name,
       coalesce(som.sieve,som.mm_size) sieve_size,
       som.tot_qty total_qty1,
       som.qty2 total_qty2,
       som.remarks,
       stp.setting_type_name,
       lot.lot_code
  from tbl_sales_order_component som
 inner join tbl_jewellery j on som.sales_order_det_id = j.sales_order_det_id
 left join tbl_commodity cm on som.commodity_id = cm.commodity_id
 left join tbl_shape shp on som.shape_id = shp.shape_id
 left join tbl_lot lot on som.lot_id = lot.lot_id
 left join tbl_setting_type stp on som.setting_type_id = stp.setting_type_id
 where
      som.is_deleted = 0
      and j.jew_id = $P!{jew_id}
)
select
	rr.*
from
  w_result_set rr
UNION ALL
SELECT
	'Stone' etype,
    NULL as commodity_name,
    NULL AS shape_name,
	NULL AS seive_size,
    NULL AS qty1,
    NULL AS qty2,
    NULL AS lot,
    NULL AS remarks,
	NULL AS setting_type_name
FROM generate_series(1, 20-(select count(*) from w_result_set))
)ty]]>
		</queryString>
		<field name="etype" class="java.lang.String"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="sieve_size" class="java.lang.String"/>
		<field name="total_qty1" class="java.math.BigDecimal"/>
		<field name="total_qty2" class="java.math.BigDecimal"/>
		<field name="remarks" class="java.lang.String"/>
		<field name="setting_type_name" class="java.lang.String"/>
		<field name="lot_code" class="java.lang.String"/>
	</subDataset>
	<parameter name="i_bag_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["E:\\Development\\source-code\\jew-trade-service\\src\\main\\resources\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tx.* from (
	select
    sd.sales_order_det_id,
	comp.company_name,
	t.jew_id,
          t.customer_ref_no,
	concat(t.jew_type, t.jew_no) job_type_no,
	bag.bag_id,
	round(bag.bag_qty,1) bag_qty,
          bag.bag_gross_wt,
	concat(bag.bag_type, bag.bag_no) bag_type_no,
	to_char(so.delivery_date, $P{dateFormat}) delivery_date,
	to_char(so.sales_order_date, $P{dateFormat}) sales_order_date,
	ps.product_size,
	t.stamping_details,
	t.prod_description,
	case
		when t.job_category = 'Normal' and sd.image_url is not null then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/salesorder/',sd.sales_order_det_id,sd.image_url)
		else
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url)
	end	image_url,
	s.uom,
	sd.color_code,
	s.sku_no sku_no,
	c.customer_name,
	sd.customer_order_no,
	sd.customer_jew_no,
	so.reference_no,
	sd.diamond_remarks,
	sd.gemstone_remarks,
	sd.metal_wt,
	so.sales_order_type ||'-'||so.sales_order_no so_no,
	t.metal_weight,
	concat(ps.product_size,'     ',metal.lot_code) as metal,
	p.product_type_code,
          sd.customer_jew_no,
          sd.stamping_remarks,
          null  as iss_pross,
          null as iss_stone,
          null as iss_net,
          null as iss_gross,
          null as iss_wrk,
          null as iss_pcs,
          null as iss_dt
from
    tbl_jewellery t
    inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
    inner join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
	and t.sales_order_det_id = sd.sales_order_det_id
	and sd.is_deleted = 0
    inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
	and bag.is_deleted = 0
    inner join tbl_sku s on t.sku_id = s.sku_id
	and s.is_deleted = 0
    left join tbl_lot metal on metal.lot_id = t.metal_id
    inner join tbl_product_type p on s.product_type_id = p.product_type_id
	and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
    inner join tbl_customer c on so.customer_id = c.customer_id
	and c.is_deleted = 0
    left join tbl_product_size ps on t.product_size_id = ps.size_id
where
	t.job_category = 'Normal'
    and(bag.bag_id) in ($P!{i_bag_id} )
union all
	select
    sd.repair_order_det_id,
	comp.company_name,
	t.jew_id,
          t.customer_ref_no,
	concat(t.jew_type, t.jew_no) job_type_no,
	bag.bag_id,
	round(bag.bag_qty,1) bag_qty,
          bag.bag_gross_wt,
	concat(bag.bag_type, bag.bag_no) bag_type_no,
	to_char(so.delivery_date, $P{dateFormat}) delivery_date,
	to_char(so.repair_order_date, $P{dateFormat}) sales_order_date,
	ps.product_size,
	t.stamping_details,
	t.prod_description,
	case
		when t.job_category = 'Repair' and sd.image_url is not null then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/repairorder/',sd.repair_order_det_id,sd.image_url)
		else
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url)
	end	image_url,
	s.uom,
	null color_code,
	s.sku_no sku_no,
	c.customer_name,
	sd.customer_order_no,
	sd.customer_jew_no,
	so.reference_no,
	null diamond_remarks,
	null gemstone_remarks,
	sd.metal_wt,
	so.repair_order_type ||'-'||so.repair_order_no so_no,
	t.metal_weight,
          	concat(ps.product_size,'     ',metal.lot_code) as metal,
	p.product_type_code,
          sd.customer_jew_no,
          sd.stamping_remarks,
          iss.process as iss_pross,
          iss.bag_stone_wt as iss_stone,
          iss.bag_net_wt as iss_net,
          iss.bag_gross_wt as iss_gross,
          iss.worker as iss_wrk,
          iss.pcs as iss_pcs,
          iss.dt as iss_dt
from
    tbl_jewellery t
    inner join tbl_repair_order_main so on t.sales_order_id = so.repair_order_id
    inner join tbl_repair_order_det sd on so.repair_order_id = sd.repair_order_id
	and t.sales_order_det_id = sd.repair_order_det_id
	and sd.is_deleted = 0
    left join tbl_lot metal on metal.lot_id = t.metal_id
    inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
	and bag.is_deleted = 0
    inner join tbl_sku s on t.sku_id = s.sku_id
	and s.is_deleted = 0
    inner join tbl_product_type p on s.product_type_id = p.product_type_id
	and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
    inner join tbl_customer c on so.customer_id = c.customer_id
	and c.is_deleted = 0
    left join tbl_product_size ps on t.product_size_id = ps.size_id
	left join (
		select
		det.bag_id,
		'Casting' as process,
		'Customer' as worker,
		max(m.created_dt) as dt,
                     sum(det.bag_qty) as pcs,
		sum(case when l.lot_type = 'METAL' then ic.qty1 else  ic.qty1 * 0.2 end) as bag_gross_wt,
		sum(case when l.lot_type = 'METAL' then ic.qty1 else 0 end) as bag_net_wt,
		sum(case when l.lot_type = 'STONE' then ic.qty1 else 0 end) as bag_stone_wt
		from tbl_mfg_bag_rm_issue_receive_det det
		inner join tbl_mfg_bag_rm_issue_receive m on m.inv_id = det.inv_id and m.is_deleted = 0
		INNER JOIN tbl_mfg_bag_rm_issue_receive_component ic
            ON det.inv_det_id = ic.inv_det_id
            AND ic.is_deleted = 0
		inner join tbl_lot l on ic.lot_id = l.lot_id
                     inner join tbl_commodity cm on l.commodity_id = cm.commodity_id
        where det.is_deleted = 0
		and m.inv_type = 'RBRMI'
		group by bag_id
	)iss on iss.bag_id = bag.bag_id
where
	t.job_category = 'Repair'
    and (bag.bag_id) in ($P!{i_bag_id})
)tx
order by
     tx.bag_id]]>
	</queryString>
