				<staticText>
					<reportElement stretchType="RelativeToTallestObject" x="254" y="235" width="30" height="14" isPrintWhenDetailOverflows="true" uuid="98821f57-529f-4ac7-9473-9476adb643d7"/>
					<box leftPadding="2" rightPadding="2">
