<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DeliveryNote" pageWidth="594" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="564" leftMargin="15" rightMargin="15" topMargin="15" bottomMargin="15" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="334"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by qd.inv_det_Id) sno,
	max(qm.inv_id) inv_id,
	max(qm.inv_type||qm.inv_no) quotation_no,
	max(qm.reference_no) reference_no,
	to_char(max(qm.inv_dt),$P{dateFormat}) quotation_dt,
	max(qm.created_by) quotation_by,
    max(emp.first_name||' '||emp.last_name) quotation_by_name,
	upper(max(cmp.company_name)) company_name,
	concat(max(cmp.street),',',max(cmp.area),',',max(cmp.city),',',max(cmp.state),'-',max(cmp.pin_code),',',max(cnt.country_name)) company_address,
	max(cus.customer_name) customer_name,
	max(cus.primary_contact_name) primary_contact_name,
	max(cus.primary_contact_no) primary_contact_no,
	max(cbaddr.address1) address1,
	max(cbaddr.address2) address2,
	max(cbaddr.street) street,
	max(cbaddr.area) area,
	max(cbaddr.city) city,
	concat(max(cbaddr.state),'-',max(cbaddr.pin_code)) state,
	max(cbaddr.country) country,
	max(sku.sku_no) sku_no,
	max(qd.qty) qty,
	max(qd.sales_price) rate,
	max(qd.qty) * max(qd.sales_price) amount,
	concat(max(qd.metal_kt),' ',max(qd.metal_wt),' ',max(qmc.mmsize),' ',max(qmc.uom1),' ',sum(qmc.qty1),' ',max(qmc.uom2),' ',sum(qmc.qty2)) description,      concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',max(sku.company_id),'/sku/',max(sku.sku_id),max(sku.image_url)) image_url
from tbl_quotation_main qm
inner join tbl_quotation_det qd on qm.inv_id = qd.inv_id
	and qd.is_deleted = 0
left join tbl_quotation_component qmc on qd.inv_det_id = qmc.inv_det_Id
    and qmc.inv_id = qd.inv_Id
	and qmc.is_deleted = 0
left join tbl_sku sku on qd.type_id = sku.product_type_id
inner join tbl_company cmp on qm.company_id = cmp.company_id
inner join tbl_country cnt on cmp.country_id = cnt.country_id
inner join tbl_customer cus on qm.customer_id = cus.customer_id
inner join tbl_employee emp on qm.created_by = emp.employee_id
left join tbl_customer_address cbaddr on cus.customer_id =cbaddr.customer_id
    and cbaddr.address_type = 'Billing'
	and cbaddr.default_address = 1
	and cbaddr.is_deleted= 0
where
	qm.is_deleted = 0
	and qm.inv_id in ($P!{i_inv_id})
group by
    qm.inv_Id,
    qd.inv_det_id]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="quotation_no" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="quotation_dt" class="java.lang.String"/>
	<field name="quotation_by" class="java.lang.Integer"/>
	<field name="quotation_by_name" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="company_address" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="primary_contact_name" class="java.lang.String"/>
	<field name="primary_contact_no" class="java.lang.String"/>
	<field name="address1" class="java.lang.String"/>
	<field name="address2" class="java.lang.String"/>
	<field name="street" class="java.lang.String"/>
	<field name="area" class="java.lang.String"/>
	<field name="city" class="java.lang.String"/>
	<field name="state" class="java.lang.String"/>
	<field name="country" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="rate" class="java.math.BigDecimal"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="description" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
	<variable name="qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
