	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<parameter name="currency" class="java.lang.String"/>
		<queryString>
			<![CDATA[with dt as (
select row_number() over (order by  id.inv_det_id) srno,
    id.inv_id,
    lot.lot_code lot_description,
    comm.commodity_name,
    sh.shape_name,
    case when id.stone_size = 'NA' then id.mm_size else id.stone_size end as size,
    id.inv_qty1,
    id.inv_qty2,
    id.sieve_size,
    id.input_rate,
    id.uom1,
    case when id.uom1 = 'GM' then id.inv_qty1 else 0 end as qty_gm,
    case when id.uom1 = 'CT' then id.inv_qty1 else 0 end as qty_ct,
    id.input_amt,
    id.custom_rate,
    id.custom_amount
from
    tbl_purchase_invoice_det id
    inner join tbl_lot lot on id.lot_id = lot.lot_id
    inner join tbl_commodity comm on lot.commodity_id = comm.commodity_id
    left join tbl_shape sh on lot.shape_id = sh.shape_id
where
    id.is_deleted = 0
    and id.inv_id = $P!{i_inv_id}),
dm as
(
select  generate_series(1,1000) srno
)
select
dt.*
from
dm left join dt on dm.srno = dt.srno
where
(dt.srno is not null or dm.srno <= 2
)]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="lot_description" class="java.lang.String"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="size" class="java.lang.String"/>
		<field name="inv_qty1" class="java.math.BigDecimal"/>
		<field name="inv_qty2" class="java.math.BigDecimal"/>
		<field name="sieve_size" class="java.lang.String"/>
		<field name="input_rate" class="java.math.BigDecimal"/>
		<field name="uom1" class="java.lang.String"/>
		<field name="qty_gm" class="java.math.BigDecimal"/>
		<field name="qty_ct" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<field name="custom_rate" class="java.math.BigDecimal"/>
		<field name="custom_amount" class="java.math.BigDecimal"/>
		<variable name="QTY" class="java.math.BigDecimal" resetType="Group" resetGroup="group1" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" resetType="Group" resetGroup="group1" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<variable name="PCS" class="java.math.BigDecimal" resetType="Group" resetGroup="group1" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
		</variable>
		<variable name="total_gm" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{qty_gm}]]></variableExpression>
		</variable>
		<variable name="total_ct" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{qty_ct}]]></variableExpression>
		</variable>
		<variable name="custom_rate" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{custom_rate}]]></variableExpression>
		</variable>
		<variable name="custom_amount" class="java.lang.Double" calculation="Sum">
			<variableExpression><![CDATA[$F{custom_amount}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="ae07db0d-4235-4eb6-9024-6e785feda5e3">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
       0 sort_seq,
        sal_chg.charge_name,
        sal_chg.plus_minus_flag * sal_chg.input_amt amount
    from
        tbl_purchase_invoice_chgs sal_chg
    where
        sal_chg.is_deleted = 0
        and sal_chg.inv_id = $P!{i_inv_id}
     order by
        sort_seq]]>
		</queryString>
		<field name="sort_seq" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    max(tcomp.company_name) company_name,
    max(im.inv_id) inv_id,
    max(im.inv_type) inv_type,
    max(im.inv_type||'-'||im.inv_no) inv_type_no,
    to_char(max(im.inv_dt), max(coalesce(tcomp.date_format,'dd/MM/yyyy'))) inv_dt,
    max(im.currency) currency,
	max(pyt.payment_type_name) payment_term,
    max(tsup.supplier_name) customer_name,
    max(tcomp.tax_number) tax_no,
    max(coalesce(im.bill_address1,'')) bill_addr1,
    max(coalesce(im.bill_address2,'')) bill_addr2,
    max(coalesce(im.bill_country,'')) bill_country,
    max(coalesce(im.bill_state,'')) bill_state,
    max(coalesce(im.bill_city,'')) bill_city,
    max(coalesce(im.bill_street,'')) bill_street,
    max(coalesce(im.bill_pincode,'')) bill_pincode,
    (max(coalesce(tcomp.street,''))) address1,
    (max(coalesce(tcomp.area,''))) address2,
    (max(coalesce(tcomp.city,'')) || ', ' || max(coalesce(tcomp.state,'')) || ' ' || max(coalesce(tcomp.pin_code,'')) ||
	 ', ' || max(coalesce(tcou.country_name,''))
    ) address3,
    max(tcomp.email) comp_email,
    max(phone_number) comp_phone_no,
    max(tcomp.website) comp_website,
    max(coalesce(tcomp.payment_address,'')) payment_address,
    max(coalesce(im.terms_conditions,'')) terms_conditions,
    max(im.total_invoice_amount) grossAmount,
    max(cmbnk.beneficiary_name) benificiary_name,
    max(cmbnk.bank_name) bank_name,
    max(cmbnk.bank_account_number) bank_account_number,
    max(cmbnk.ifsc_code) ifsc_code,
    max(cmbnk.routing) routing,
    max(cmbnk.bank_address) bank_address,
    upper(spellnumericvalue(max(im.total_invoice_net_amount),max(im.currency))) amount_in_words,
     concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo,
    (case when max(tcomp.log_url) is not null then true else false end) logo_print,
   case when max(im.total_charge_plus_amount) + max(im.total_charge_minus_amount) > 0 then 1 else 0 end show_chgs,
   max(im.total_invoice_amount + coalesce(chgs.invoice_chgs,0)) tot_amt,
   max(im.total_invoice_qty1) tot_qty1,
   max(im.total_invoice_qty2) tot_qty2,
   max(cmbnk.wire_transfer) wire_transfer
from
    tbl_purchase_invoice_main im
    inner join tbl_purchase_invoice_det pd on pd.inv_id = im.inv_id
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
left join tbl_country tcou on tcomp.country_id= tcou.country_id
    inner join tbl_purchase_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_supplier tsup on im.supplier_id = tsup.supplier_id
	inner join tbl_payment_type pyt on im.payment_type_id = pyt.payment_type_id
	left join tbl_company_bank cmbnk on tcomp.company_id = cmbnk.company_id
	    and cmbnk.is_default = 1
	left join(
		select inv_id, sum(plus_minus_flag * input_amt) invoice_chgs
		from
			tbl_purchase_invoice_chgs
		where is_deleted = 0
		group by inv_id
	)chgs on im.inv_id = chgs.inv_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
group by
    tcomp.company_id,
    im.inv_id,
    im.inv_type]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="payment_term" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="tax_no" class="java.lang.String"/>
	<field name="bill_addr1" class="java.lang.String"/>
	<field name="bill_addr2" class="java.lang.String"/>
	<field name="bill_country" class="java.lang.String"/>
	<field name="bill_state" class="java.lang.String"/>
	<field name="bill_city" class="java.lang.String"/>
	<field name="bill_street" class="java.lang.String"/>
	<field name="bill_pincode" class="java.lang.String"/>
	<field name="address1" class="java.lang.String"/>
	<field name="address2" class="java.lang.String"/>
	<field name="address3" class="java.lang.String"/>
	<field name="comp_email" class="java.lang.String"/>
	<field name="comp_phone_no" class="java.lang.String"/>
	<field name="comp_website" class="java.lang.String"/>
	<field name="payment_address" class="java.lang.String"/>
	<field name="terms_conditions" class="java.lang.String"/>
	<field name="grossamount" class="java.math.BigDecimal"/>
	<field name="benificiary_name" class="java.lang.String"/>
	<field name="bank_name" class="java.lang.String"/>
	<field name="bank_account_number" class="java.lang.String"/>
	<field name="ifsc_code" class="java.lang.String"/>
	<field name="routing" class="java.lang.String"/>
	<field name="bank_address" class="java.lang.String"/>
	<field name="amount_in_words" class="java.lang.String"/>
	<field name="comp_logo" class="java.lang.String"/>
	<field name="logo_print" class="java.lang.Boolean"/>
	<field name="show_chgs" class="java.lang.Integer"/>
	<field name="tot_amt" class="java.math.BigDecimal"/>
	<field name="tot_qty1" class="java.math.BigDecimal"/>
	<field name="tot_qty2" class="java.math.BigDecimal"/>
	<field name="wire_transfer" class="java.lang.String"/>
