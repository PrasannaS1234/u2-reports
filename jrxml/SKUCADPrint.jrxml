<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SKUCADPrint" pageWidth="900" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="890" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="component" uuid="93dc6e20-dc0c-4fd2-bfc7-81dc648e8986">
		<parameter name="skuid" class="java.lang.String"/>
		<queryString>
			<![CDATA[WITh v_comp AS (
	SELECT
		 tsc.sku_component_id component_id,
		 tsc.sku_id sales_order_det_id,
		 row_number() over (order by 1) recusrive_level,
		 tsc.sku_id jew_id,
		 tsc.total_wt tot_qty,
		 tsc.qty1,
		 tsc.qty2,
		 round(case when tsc.qty2 > 0 then tsc.total_wt / tsc.qty2 else 0 end,3) per_pc_wt
	FROM
		 tbl_sku_component tsc
		 inner join tbl_sku tsd on tsc.sku_id = tsd.sku_id
			and tsd.is_deleted = 0
	WHERE
		 tsc.is_deleted = 0
		 and tsd.sku_id = $P!{skuid}
	 ),
	 v_max as (
		 select max(recusrive_level) recusrive_level,
		 max(sales_order_det_id) sales_order_det_id,
		 max(jew_id) jew_id
		 from v_comp
	 ),
v_temp as (
	select
		9999999+row_number() over (order by 1) component_id,
		m.sales_order_det_id,
	    generate_series recusrive_level,
		m.jew_id,
		0 tot_qty,
	 	0 qty1,
	 	0 qty2,
		0 per_pc_wt
	from
	v_max m
	inner join generate_series(COALESCE (m.recusrive_level,0)+1,9) on 1 = 1
)select * from v_comp v union all select * from v_temp]]>
		</queryString>
		<field name="component_id" class="java.lang.Long"/>
		<field name="sales_order_det_id" class="java.lang.Integer"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="jew_id" class="java.lang.Integer"/>
		<field name="tot_qty" class="java.math.BigDecimal"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="per_pc_wt" class="java.math.BigDecimal"/>
		<group name="component_id">
			<groupExpression><![CDATA[$F{component_id}]]></groupExpression>
		</group>
		<group name="sales_order_det_id">
			<groupExpression><![CDATA[$F{sales_order_det_id}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_sku_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	sku.sku_id,
	trim(to_char(CURRENT_DATE, 'dd/Month/yyyy')) print_time,
	max(comp.company_name) company_name,
    	max(ps.product_size) product_size,
	max(sku.sku_id) sku_id,
	max(sku.sku_no) sku_no,
	max(c.display_name) customer_name,
	max(sku.reference_no) customer_ref_no,
	max(sm.mould_no) mould_no,
	sum(case when lower(comm.commodity_name) like '%dia%' then sc.total_wt else 0 end) dia_wt,
	sum(case when lower(comm.commodity_name) like '%dia%' then sc.qty2 else 0 end) dia_pcs,
	sum(case when lower(comm.commodity_name) not like '%dia%' then sc.total_wt else 0 end) cs_wt,
	sum(case when lower(comm.commodity_name) not like '%dia%' then sc.qty2 else 0 end) cs_pcs,
	round(sum(case when lower(comm.commodity_name) like '%dia%' then sc.total_wt else 0 end)
	/	sum(case when sc.qty2 > 0 then sc.qty2 else 1 end),3)  dia_pcs_wt,
	round(sum(case when lower(comm.commodity_name) not like '%dia%' then sc.total_wt else 0 end)
	/ sum(case when sc.qty2 > 0 then sc.qty2 else 1 end),3)  cs_pcs_wt,
	max(sku.metal_weight) delivery_weight,
	max(jm.casting_wt) casting_wt,
	max(jm.cam_wt) cam_wt,
	max(jm.cad_volume) cad_volume,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',max(sku.sku_id),max(sku.image_url)) image_url
from
	tbl_sku sku
	inner join tbl_company comp on sku.company_id = comp.company_id
	left join tbl_customer c on sku.customer_id = c.customer_id
		and c.is_deleted = 0
	left join tbl_sku_component sc on sku.sku_id = sc.sku_id
		and sc.is_deleted = 0
	left join tbl_commodity comm on sc.commodity_id = comm.commodity_id
		and comm.is_deleted = 0
	left join(
		select
			mc.sku_id,
			max(case when upper(dp.process_name) = 'CASTING' then mc.output_weight else 0 end) casting_wt,
			max(case when upper(dp.process_name) = 'CAM' then mc.output_weight else 0 end) cam_wt,
			max(case when upper(dp.process_name) = 'CAD' then mc.output_weight else 0 end) cad_volume
		from
			tbl_sku_metal_weight_calculation mc
			left join tbl_process dp on mc.process_id = dp.process_id
		where
			mc.is_deleted = 0
			and (mc.sku_id) in ($P!{i_sku_id})
		group by
			mc.sku_id
	)jm on sku.sku_id = jm.sku_id
	left join tbl_sku_mould sm on sku.sku_id = sm.sku_id
		and sm.is_deleted = 0
	left join tbl_product_size ps on sku.product_size_id = ps.size_id
where
	(sku.sku_id) in ($P!{i_sku_id})
group by sku.sku_id]]>
	</queryString>
	<field name="sku_id" class="java.lang.Integer"/>
	<field name="print_time" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="customer_ref_no" class="java.lang.String"/>
	<field name="mould_no" class="java.lang.String"/>
	<field name="dia_wt" class="java.math.BigDecimal"/>
	<field name="dia_pcs" class="java.math.BigDecimal"/>
	<field name="cs_wt" class="java.math.BigDecimal"/>
	<field name="cs_pcs" class="java.math.BigDecimal"/>
	<field name="dia_pcs_wt" class="java.math.BigDecimal"/>
	<field name="cs_pcs_wt" class="java.math.BigDecimal"/>
	<field name="delivery_weight" class="java.math.BigDecimal"/>
	<field name="casting_wt" class="java.math.BigDecimal"/>
	<field name="cam_wt" class="java.math.BigDecimal"/>
	<field name="cad_volume" class="java.math.BigDecimal"/>
	<field name="image_url" class="java.lang.String"/>
