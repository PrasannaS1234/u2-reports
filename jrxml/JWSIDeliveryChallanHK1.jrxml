	<subDataset name="REPORT" uuid="f037cdac-f3a7-4a32-a289-cb25472535b3">
		<parameter name="i_inv_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT
     charge_name,
     (plus_minus_flag * input_amt) amt
FROM
     "tbl_mfg_bag_sales_invoice_chgs"
where
    inv_id = $P!{i_inv_id}]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (order by main.inv_id, det.inv_det_id) sno,
	main.inv_id,
	det.inv_det_id,
	comp.company_name,
	comp.tax_number,
	comp.street company_address1,
	comp.area 	company_address2,
	COALESCE(comp.phone_number,comp.mobile_no) contact_tel,
	comp.city,
	comp.reg_number,
	sta.state_name state,
	cou.country_name,
	comp.tax_number,
	concat(main.inv_type,'-',main.inv_no) dc_no,
	to_char(main.inv_dt,'DD-MM-YYYY') dc_date,
	to_char(CURRENT_TIMESTAMP at time zone 'IST','DD-MM-YYYY HH:MI:SS') print_date_time,
	cus.customer_name,
	cua.address1,
	cua.address2,
	cus.primary_contact_no customer_tel,
	cua.city cus_city,
	cua.state cus_state,
	cus.gst_number,
	sku.sku_no,
	pr.product_type_name,
	sku.sku_no sku_no,
	bag.bag_type_no bag_no,
	main.tracking_no,
	COALESCE(nullif(bag.customer_bag_no,''), concat(bag.bag_type,bag.bag_no)) 		customer_bag_no,
	ps.product_size,
	lot.lot_code,
	det.bag_qty qty,
	round(det.gross_wt,2) gross_wt,
	round(det.net_wt,3) net_wt,
	round(det.al_wt,3) wastage_wt,
	round(det.net_wt + det.al_wt,3) total_wt,
	round(det.labor_amount,2) labour,
	det.dia_wt,
	det.dia_pcs,
	det.cs_wt col_wt,
	det.cs_pcs col_pcs,
	round(((round(det.net_wt,3) * main.gold_rate) + (det.dia_wt * main.diamond_rate)
	 + (det.cs_wt * main.color_stone_rate)),2) amount
from
	tbl_mfg_bag_sales_invoice_main main
	inner join tbl_mfg_bag_sales_invoice_det det on main.inv_id = det.inv_id
		and det.is_deleted = 0
	inner join tbl_mfg_bag bag on det.bag_id = bag.bag_id
	inner join tbl_jewellery jew on bag.job_id = jew.jew_id
	inner join tbl_sales_order_det sod on jew.sales_order_det_id = sod.sales_order_det_id
	inner join tbl_sales_order_main som on jew.sales_order_id = som.sales_order_id
	inner join tbl_company comp on main.company_id = comp.company_id
	inner join tbl_customer cus on som.customer_id = cus.customer_id
		and cus.is_deleted = 0
	inner join tbl_sku sku on jew.sku_id = sku.sku_id
	inner join tbl_product_type pr on sku.product_type_id = pr.product_type_id
	left join tbl_customer_address cua on cus.customer_id = cua.customer_id
		and cua.is_deleted = 0
		and upper(cua.address_type) = 'SHIPPING'
	left join tbl_lot lot on jew.metal_id = lot.lot_id
	left join tbl_country cou on comp.country_id = cou.country_id
	left join tbl_state sta on comp.state = sta.state_code
	left join tbl_product_size ps on jew.product_size_id = ps.size_id
where
	main.is_deleted = 0
	and main.inv_id in ($P!{i_inv_id})
order by main.inv_id, det.inv_det_id]]>
	</queryString>
