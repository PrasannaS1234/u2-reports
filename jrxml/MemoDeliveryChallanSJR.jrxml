				<reportElement x="406" y="0" width="131" height="20" uuid="ae6f9462-f0d4-4c7f-9c73-8dbc737fa61d"/>
				<box topPadding="0" leftPadding="2" bottomPadding="0" rightPadding="2">
					<pen lineWidth="0.0"/>
