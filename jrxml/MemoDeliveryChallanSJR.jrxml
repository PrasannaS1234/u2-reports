	<field name="net_wt" class="java.math.BigDecimal"/>
	<field name="dia_wt" class="java.math.BigDecimal"/>
	<field name="dia_pcs" class="java.math.BigDecimal"/>
	<field name="col_wt" class="java.math.BigDecimal"/>
	<field name="col_pcs" class="java.math.BigDecimal"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<variable name="v_qty" class="java.lang.String" calculation="Sum">
