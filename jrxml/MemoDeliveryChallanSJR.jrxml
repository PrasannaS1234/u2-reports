	</variable>
	<variable name="v_net_wt" class="java.lang.String" calculation="Sum">
		<variableExpression><![CDATA[$F{net_wt}]]></variableExpression>
	</variable>
	<variable name="v_gross_wt" class="java.lang.String" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="v_amount" class="java.lang.String" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
