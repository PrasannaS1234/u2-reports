<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MemoDeliveryChallanSJR " language="groovy" pageWidth="840" pageHeight="590" columnWidth="800" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="61fcc04f-329c-4f00-b3f6-941874fefd1c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="9"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	main.inv_id,
	det.inv_det_id,
	comp.company_name,
	comp.street company_address1,
	comp.area 	company_address2,
	COALESCE(comp.phone_number,comp.mobile_no) contact_tel,
	comp.city,
	comp.state,
	cou.country_name,
	comp.tax_number,
	concat(main.inv_type,'-',main.inv_no) dc_no,
	to_char(main.inv_dt,'DD-MM-YYYY') dc_date,
	to_char(CURRENT_TIMESTAMP at time zone 'IST','DD-MM-YYYY HH:MI:SS') print_date_time,
	cus.customer_name,
	cua.address1,
	cua.address2,
	cus.primary_contact_no customer_tel,
	cua.city,
	cua.state,
	cus.gst_number,
	sku.sku_no,
	sku.customer_ref_no customer_sku_no,
	concat(jew.jew_type,jew.jew_no) job_no,
	jew.customer_ref_no customer_job_no,
	concat(som.sales_order_type,'-',som.sales_order_no) so_no,
	som.reference_no customer_so_no,
	det.inv_qty qty,
	wt.gross_wt,
	wt.net_wt,
	wt.dia_wt,
	wt.dia_pcs,
	wt.col_wt,
	wt.col_pcs,
	det.input_amt amount
from
	tbl_jew_memo_sales_invoice_main main
	inner join tbl_jew_memo_sales_invoice_det det on main.inv_id = det.inv_id
		and det.is_deleted = 0
	inner join tbl_company comp on main.company_id = comp.company_id
	inner join tbl_customer cus on main.customer_id = cus.customer_id
		and cus.is_deleted = 0
	inner join tbl_jewellery jew on det.jew_id = jew.jew_id
	inner join tbl_sales_order_det sod on jew.sales_order_det_id = sod.sales_order_det_id
	inner join tbl_sales_order_main som on jew.sales_order_id = som.sales_order_id
	inner join tbl_sku sku on jew.sku_id = sku.sku_id
	left join tbl_customer_address cua on cus.customer_id = cua.customer_id
		and cua.is_deleted = 0
		and upper(cua.address_type) = 'SHIPPING'
	left join tbl_country cou on comp.country_id = cou.country_id
	left join(
		select
			sd.jew_id,
			sum(case
					when lot.lot_type = 'METAL' then jc.consumed_qty1
			   		when lot.lot_type = 'STONE' then jc.consumed_qty1 * 0.2
			   		else 0
				end) gross_wt,
			sum(case
					when lot.lot_type = 'METAL' then jc.consumed_qty1
			   		else 0
				end) net_wt,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) like '%diamond%' then jc.consumed_qty1
			   		else 0
				end) dia_wt,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) like '%diamond%' then jc.consumed_qty2
			   		else 0
				end) dia_pcs,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) not like '%diamond%' then jc.consumed_qty1
			   		else 0
				end) col_wt,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) not like '%diamond%' then jc.consumed_qty2
			   		else 0
				end) col_pcs
		from
			tbl_jew_memo_sales_invoice_det sd
			inner join tbl_jewellery_component jc on sd.jew_id = jc.jew_id
				and jc.is_deleted = 0
			inner join tbl_lot lot on jc.lot_id = lot.lot_id
			inner join tbl_commodity_group cg on lot.commodity_group_id = cg.commodity_group_id
		where
			sd.is_deleted = 0
			and sd.inv_id = $P!{i_inv_id}
		group by
			sd.jew_id
	)wt on jew.jew_id = wt.jew_id
where
	main.is_deleted = 0
	and main.inv_id = $P!{i_inv_id}]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
