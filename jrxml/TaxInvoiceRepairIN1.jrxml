	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    row_number() over (order by  im.inv_id) srno,
	round(sum(id.bag_qty),0) pcs,
	max(coalesce(im.note,'')) note,
	max(im.reference_no) ref_no,
	round(sum(coalesce(id.al_wt,0)),3) al_wt,
	round(sum(coalesce(id.dia_pcs,0)),0) dia_pcs,
	round(sum(coalesce(id.dia_wt,0)),3)	dia_ct,
	round(sum(coalesce(id.cs_pcs,0)),0) cspcs,
	round(sum(coalesce(id.cs_wt,0)),3)	cs_ct,
	round(sum(coalesce(id.gross_wt,0)),3) gross_wt,
	round(sum(coalesce(id.net_wt,0)),3) net_wt,
	round(sum(coalesce(id.net_wt,0) + coalesce(id.al_wt,0)),3) total_wt,
	round(sum(id.total_amount),2) input_amt,
          round(sum(coalesce(r.gross_wt, 0)), 3) r_gross_wt,
	case when upper(max(prod.job_category)) = 'REPAIR' then '9987' else '9988' end hsn,
          case when(round(sum(coalesce(r.gross_wt, 0)), 3)-round(sum(coalesce(id.gross_wt,0)),3))  > 0 then (round(sum(coalesce(r.gross_wt, 0)), 3)- (round(sum(coalesce(id.gross_wt,0)),3)))
          else '0' end as loss,
          case when (round(sum(coalesce(r.gross_wt, 0)), 3)-(round(sum(coalesce(id.gross_wt,0)),3))) < 0 then ((round(sum(coalesce(id.gross_wt,0)),3)) - round(sum(coalesce(r.gross_wt, 0)), 3))
          else '0' end as extra
from
    tbl_mfg_bag_sales_invoice_main im
    inner join tbl_mfg_bag_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
	inner join tbl_mfg_bag bag on id.bag_id = bag.bag_id
    inner join tbl_jewellery prod on bag.job_id = prod.jew_id
    inner join tbl_repair_order_det r on prod.sales_order_det_id = r.repair_order_det_id
where
    im.is_deleted = 0
    and im.inv_id = ($P!{invId})
group by
	im.inv_id]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="pcs" class="java.math.BigDecimal"/>
		<field name="note" class="java.lang.String"/>
		<field name="ref_no" class="java.lang.String"/>
		<field name="al_wt" class="java.math.BigDecimal"/>
		<field name="dia_pcs" class="java.math.BigDecimal"/>
		<field name="dia_ct" class="java.math.BigDecimal"/>
		<field name="cspcs" class="java.math.BigDecimal"/>
		<field name="cs_ct" class="java.math.BigDecimal"/>
		<field name="gross_wt" class="java.math.BigDecimal"/>
		<field name="net_wt" class="java.math.BigDecimal"/>
		<field name="total_wt" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<field name="r_gross_wt" class="java.math.BigDecimal"/>
		<field name="hsn" class="java.lang.String"/>
		<field name="extra" class="java.math.BigDecimal"/>
		<field name="loss" class="java.math.BigDecimal"/>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<variable name="v_gross_wt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
		</variable>
		<variable name="v_net_wt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{net_wt}]]></variableExpression>
		</variable>
		<variable name="v_amount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="f2523445-e3c7-4637-a9da-0e96129f78c0">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	case when upper(max(ids.job_category)) = 'REPAIR' then '9987' else '9988' end hsn,
	sum(case when upper(sal_chg.charge_name) like 'CGST' then round(sal_chg.input_pct_amt_value,2) else 0 end) ||
		max(case when upper(sal_chg.charge_name) like 'CGST' and sal_chg.input_pct_amt_type <> 'AMOUNT' then '%' else '' end) central_rate,
	sum(case when upper(sal_chg.charge_name) like 'SGST' then round(sal_chg.input_pct_amt_value,2) else 0 end)||
		max(case when upper(sal_chg.charge_name) like 'SGST' and sal_chg.input_pct_amt_type <> 'AMOUNT' then '%' else '' end) state_rate,
	sum(case when upper(sal_chg.charge_name) like 'IGST' then round(sal_chg.input_pct_amt_value,2) else 0 end)||
		max(case when upper(sal_chg.charge_name) like 'IGST' and sal_chg.input_pct_amt_type <> 'AMOUNT' then '%' else '' end) igst_rate,
	sum(case when upper(sal_chg.charge_name) like 'CGST' then sal_chg.plus_minus_flag * sal_chg.input_amt else 0 end) central_tax,
	sum(case when upper(sal_chg.charge_name) like 'SGST' then sal_chg.plus_minus_flag * sal_chg.input_amt else 0 end) state_tax,
	sum(case when upper(sal_chg.charge_name) like 'IGST' then sal_chg.plus_minus_flag * sal_chg.input_amt else 0 end) igst_tax,
	max(ids.taxable_amount) taxable_amount,
	sum(case when upper(sal_chg.charge_name) not like '%ROUND%' then sal_chg.plus_minus_flag * sal_chg.input_amt else 0 end) total_tax_amount
from
	tbl_mfg_bag_sales_invoice_chgs sal_chg
	inner join(
		select id.inv_id, sum(id.total_amount) taxable_amount, max(j.job_category) job_category
		from	tbl_mfg_bag_sales_invoice_det id
		inner join tbl_mfg_bag bag on id.bag_id = bag.bag_id
		inner join tbl_jewellery j on bag.job_id = j.jew_id
		where 		id.is_deleted = 0
		group by id.inv_id
	)ids on sal_chg.inv_id = ids.inv_id
	inner join tbl_mfg_bag_sales_invoice_main im on sal_chg.inv_id = im.inv_id
where
	sal_chg.is_deleted = 0
	and sal_chg.inv_id in ($P!{invId})
group by
	sal_chg.inv_id]]>
		</queryString>
		<field name="hsn" class="java.lang.String"/>
		<field name="central_rate" class="java.lang.String"/>
		<field name="state_rate" class="java.lang.String"/>
		<field name="igst_rate" class="java.lang.String"/>
		<field name="central_tax" class="java.math.BigDecimal"/>
		<field name="state_tax" class="java.math.BigDecimal"/>
		<field name="igst_tax" class="java.math.BigDecimal"/>
		<field name="taxable_amount" class="java.math.BigDecimal"/>
		<field name="total_tax_amount" class="java.math.BigDecimal"/>
		<variable name="v_tot_taxable_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{taxable_amount}]]></variableExpression>
		</variable>
		<variable name="v_total_net_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{total_tax_amount}]]></variableExpression>
		</variable>
		<variable name="v_central_tax_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{central_tax}]]></variableExpression>
		</variable>
		<variable name="v_state_tax_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{state_tax}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="table_charges" uuid="fefc3636-7416-43ec-a53c-50f24d04e7c8">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select tx.* from (
select
	0 charge_id,
	'Discount'	charge_name,
	 chgs.discount amt
from
	tbl_mfg_bag_sales_invoice_main chgs
where
	chgs.is_deleted = 0
	and chgs.inv_id in ($P!{invId})
union all
select
	chgs.charge_id,
	case
		when upper(chgs.charge_name) like '%GST%' then concat(chgs.charge_name,' ',round(chgs.input_pct_amt_value,1),'%')
		else chgs.charge_name
	end	charge_name,
	chgs.plus_minus_flag * chgs.input_amt amt
from
	tbl_mfg_bag_sales_invoice_chgs chgs
where
	chgs.is_deleted = 0
	and chgs.inv_id in ($P!{invId})
)tx
order by
	tx.charge_id]]>
		</queryString>
		<field name="charge_id" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="table_total" uuid="4b44db94-30eb-4bb3-b6d4-70c5bd87224f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	des,
	sum(gross_wt)	grw,
	sum(net_wt)		nwt,
	sum(input_amt)  amt
from
(
select
    'Total' des,
	sum(id.gross_wt) gross_wt,
	sum(id.net_wt) net_wt,
	sum(id.total_amount) - max(im.discount) input_amt
from
    tbl_mfg_bag_sales_invoice_main im
    inner join tbl_mfg_bag_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
where
    im.is_deleted = 0
    and im.inv_id in ($P!{invId})
group by
	im.inv_id
union all
select
  	'Total' des,
	0	gross_wt,
	0	net_wt,
	sum(chgs.plus_minus_flag * chgs.input_amt) input_amt
from
	tbl_mfg_bag_sales_invoice_chgs chgs
where
	chgs.is_deleted = 0
	 and chgs.inv_id in ($P!{invId})
) tmp
group by
	des]]>
		</queryString>
		<field name="des" class="java.lang.String"/>
		<field name="grw" class="java.math.BigDecimal"/>
		<field name="nwt" class="java.math.BigDecimal"/>
		<field name="amt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="invType" class="java.lang.String">
		<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
	max(tcomp.company_name) company_name,
	max(im.inv_id) inv_id,
          COALESCE(max(im.customer_inv_no),'') cus_inv_no,
	max(im.inv_type) inv_type,
	max(im.note) note,
          max(im.remarks) remarks,
	max(im.inv_type||'-'||im.inv_no) inv_type_no,
	to_char(max(im.inv_dt), 'dd/mm/yyyy') inv_dt,
	to_char(max(im.inv_due_dt), 'dd/mm/yyyy')     inv_due_dt,
	max(im.currency) currency,
	max(im.exchange_rate) exchange_rate,
	max(COALESCE(im.reference_no,'')) reference_no,
	max(tcus.customer_name) customer_name,
	COALESCE(max(im.bill_address1),'') bill_addr1,
	COALESCE(max(im.bill_address2),'') bill_addr2,
	COALESCE(max(im.bill_country),'') bill_country,
	COALESCE(max(im.bill_state),'') bill_state,
	COALESCE(max(im.bill_city),'') bill_city,
	COALESCE(max(im.bill_street),'') bill_street,
	COALESCE(max(im.bill_pincode),'') bill_pincode,
	COALESCE(max(im.bill_website),'') bill_website,
	COALESCE(max(im.bill_phone_no),'') bill_phone_no,
	COALESCE(max(im.bill_fax_no),'') bill_fax_no,
	COALESCE(max(im.bill_mobile_no),'') bill_mobile_no,
	COALESCE(max(im.ship_address1),'') ship_addr1,
	COALESCE(max(im.ship_address2),'') ship_addr2,
	COALESCE(max(im.ship_country),'') ship_country,
	COALESCE(max(im.ship_state),'') ship_state,
	COALESCE(max(im.ship_city),'') ship_city,
	COALESCE(max(im.ship_street),'') ship_street,
	COALESCE(max(im.ship_pincode),'') ship_pincode,
	COALESCE(max(im.ship_website),'') ship_website,
	COALESCE(max(im.ship_phone_no),'') ship_phone_no,
	COALESCE(max(im.ship_fax_no),'') ship_fax_no,
	COALESCE(max(im.ship_mobile_no),'') ship_mobile_no,
	COALESCE(max(tcomp.state),'') comp_state,
	COALESCE(max(tcomp.city),'') comp_city,
	COALESCE(max(tcomp.street),'') comp_street,
	COALESCE(max(tcomp.area),'') comp_area,
	COALESCE(max(tcomp.pin_code),'') comp_pin,
	COALESCE(max(tcomp.email),'') comp_email,
	COALESCE(max(tcomp.phone_number),'') comp_phone_number,
	COALESCE(max(tcomp.mobile_no),'') comp_mobile_no,
	COALESCE(max(tcomp.website),'') comp_website,
	COALESCE(max(tcomp.reg_number),'') comp_pan,
	COALESCE(max(tcomp.tax_number),'') comp_gstn,
	COALESCE(max(tcomp.fax_no),'') comp_fax,
	COALESCE(max(tcomp.company_name),'') ||','||COALESCE(max(tcomp.street),'') || ',' || COALESCE(max(tcomp.area),'') || ',' ||
	COALESCE(max(tcomp.city),'') || ' - ' || COALESCE(max(tcomp.pin_code),'') ||',' ||
	COALESCE(max(tcomp.state),'') || ', ' || '' address,
	COALESCE(max(tcomp.company_name),'') addressLine1,
	COALESCE(max(tcomp.street),'') addressLine2,
	COALESCE(max(tcomp.area),'') addressLine3,
	COALESCE(max(tcomp.city),'') addressLine4,
	COALESCE(max(tcomp.pin_code),'') addressLine5,
	COALESCE(max(tcomp.state),'') addressLine6,
	COALESCE(max(tcus.pan_number),'') cus_pan,
	COALESCE(max(tcus.gst_number),'') cus_gstn,
	'Tel: ' ||  COALESCE(max(tcomp.phone_number),'')  addressLine7,
	max(im.total_invoice_amount) grossAmount,
	amount_in_indian_words(max(im.total_invoice_amount)) amount_in_words,
          amount_in_indian_words(max(tax.total_tax_amount))   tax_amount_in_words

from
	tbl_mfg_bag_sales_invoice_main im
	inner join tbl_company tcomp on im.company_id = tcomp.company_id
	inner join tbl_mfg_bag_sales_invoice_det id on im.inv_id = id.inv_id
		and id.is_deleted = 0
	inner join tbl_customer tcus on im.customer_id = tcus.customer_id
	left join(
		select
			sal_chg.inv_id,
			sum(sal_chg.plus_minus_flag * sal_chg.input_amt) total_tax_amount
		from
			tbl_mfg_bag_sales_invoice_chgs sal_chg
		where
			sal_chg.is_deleted = 0
			and sal_chg.inv_id in ($P!{i_inv_id})
		group by
			sal_chg.inv_id
	)tax on im.inv_id = tax.inv_id
where
	im.is_deleted = 0
	and im.inv_id in ($P!{i_inv_id})
group by
	im.inv_id,
	im.inv_type]]>
	</queryString>
