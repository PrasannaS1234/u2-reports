	<variable name="v_qty" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="v_dia_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{dia_wt}]]></variableExpression>
	</variable>
	<variable name="v_dia_pcs" class="java.math.BigDecimal" calculation="Sum">
