<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JBDeliveryChallanSJR" pageWidth="670" pageHeight="840" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="10" bottomMargin="10" uuid="61fcc04f-329c-4f00-b3f6-941874fefd1c">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="26"/>
	<property name="ireport.y" value="50"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (order by main.inv_id, det.inv_det_id) sno,
	main.inv_id,
	det.inv_det_id,
	comp.company_name,
	comp.tax_number,
	comp.street company_address1,
	comp.area 	company_address2,
	COALESCE(comp.phone_number,comp.mobile_no) contact_tel,
	comp.city,
	comp.state,
	cou.country_name,
	comp.tax_number,
	concat(main.inv_type,'-',main.inv_no) dc_no,
	to_char(main.inv_dt,'DD-MM-YYYY') dc_date,
	to_char(CURRENT_TIMESTAMP at time zone 'IST','DD-MM-YYYY HH:MI:SS') print_date_time,
	cus.customer_name,
	cua.address1,
	cua.address2,
	cus.primary_contact_no customer_tel,
	cua.city cus_city,
	cua.state cus_state,
	cus.gst_number,
	sku.sku_no,
	sku.customer_ref_no customer_sku_no,
	concat(bag.bag_type,bag.bag_no) bag_no,
	concat(jew.jew_type,jew.jew_no) job_no,
		COALESCE(nullif(bag.customer_bag_no,''), concat(bag.bag_type,bag.bag_no)) 		customer_bag_no,
	COALESCE(nullif(bag.customer_bag_order_no,''), concat(jew.jew_type,jew.jew_no)) 	customer_order_no,
	det.bag_qty qty,
	round(wt.gross_wt,2) gross_wt,
	round(wt.net_wt,2) net_wt,
round(det.allow_loss_wt,2) wastage_wt,
round(det.labour_amount,2) labour,
	wt.dia_wt,
	wt.dia_pcs,
	wt.col_wt,
	wt.col_pcs,
	(round(wt.net_wt,2) * 6000) + ((wt.dia_wt + wt.col_wt) * 70000) amount
from
	tbl_mfg_factory_invoice_main main
	inner join tbl_mfg_factory_invoice_det det on main.inv_id = det.inv_id
		and det.is_deleted = 0
	inner join tbl_mfg_bag bag on det.bag_id = bag.bag_id
	inner join tbl_jewellery jew on bag.job_id = jew.jew_id
	inner join tbl_sales_order_det sod on jew.sales_order_det_id = sod.sales_order_det_id
	inner join tbl_sales_order_main som on jew.sales_order_id = som.sales_order_id
	inner join tbl_company comp on main.company_id = comp.company_id
	inner join tbl_customer cus on som.customer_id = cus.customer_id
		and cus.is_deleted = 0
	inner join tbl_sku sku on jew.sku_id = sku.sku_id
	left join tbl_customer_address cua on cus.customer_id = cua.customer_id
		and cua.is_deleted = 0
		and upper(cua.address_type) = 'SHIPPING'
	left join tbl_country cou on comp.country_id = cou.country_id
	left join(
		select
			sd.bag_id,
			sum(case
					when lot.lot_type = 'METAL' then jc.consumed_qty1
			   		when lot.lot_type = 'STONE' then jc.consumed_qty1 * 0.2
			   		else 0
				end) gross_wt,
			sum(case
					when lot.lot_type = 'METAL' then jc.consumed_qty1
			   		else 0
				end) net_wt,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) like '%diamond%' then jc.consumed_qty1
			   		else 0
				end) dia_wt,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) like '%diamond%' then jc.consumed_qty2
			   		else 0
				end) dia_pcs,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) not like '%diamond%' then jc.consumed_qty1
			   		else 0
				end) col_wt,
			sum(case
			   		when lot.lot_type = 'STONE' and lower(cg.commodity_group_type) not like '%diamond%' then jc.consumed_qty2
			   		else 0
				end) col_pcs
		from
			tbl_mfg_factory_invoice_det sd
			inner join tbl_mfg_factory_invoice_component jc on sd.inv_det_id = jc.inv_det_id
				and jc.is_deleted = 0
			inner join tbl_lot lot on jc.lot_id = lot.lot_id
			inner join tbl_commodity_group cg on lot.commodity_group_id = cg.commodity_group_id
		where
			sd.is_deleted = 0
			and sd.inv_id in ($P!{i_inv_id})
		group by
			sd.bag_id
	)wt on det.bag_id = wt.bag_id
where
	main.is_deleted = 0
	and main.inv_id in ($P!{i_inv_id})
order by main.inv_id, det.inv_det_id]]>
	</queryString>
