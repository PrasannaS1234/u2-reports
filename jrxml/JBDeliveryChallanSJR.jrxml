	</variable>
	<variable name="v_col_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{col_wt}]]></variableExpression>
	</variable>
	<variable name="v_col_pcs" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{col_pcs}]]></variableExpression>
	</variable>
	<variable name="v_net_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{net_wt}]]></variableExpression>
	</variable>
	<variable name="v_gross_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="v_amount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{amount}]]></variableExpression>
	</variable>
	<variable name="v_labor" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{labour}]]></variableExpression>
	</variable>
	<variable name="v_wastage" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{wastage_wt}]]></variableExpression>
	</variable>
