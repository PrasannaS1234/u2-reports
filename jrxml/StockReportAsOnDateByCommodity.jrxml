<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StockReportByCommodity" pageWidth="2000" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="rate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'CP'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select res.*, res.inv_qty1 * res.cost_price pp_amount from (
select
	tx.*,
 	case when $P!{rate} = 'CP' then tx.cost_price else
		fn_rm_pp_wac(product_id,company_id,$P{toDate}, $P{dateFormat},$P{currency})
	end pp_rate
from (
	select
		tcomp.company_id,
		max(tcomp.company_name) company_name,
		prod.lot_id	product_id,
		nullif(stk.stone_size,'NA') stone_size,
		max(tcomg.commodity_group_name) commodity_group_name,
		max(tcom.commodity_name) commodity_name,
		max(prod.lot_code) product_no,
		tbin.bin_id,
		max(tbin.bin_name) bin_name,
		max(prod.description) description,
		max(prod.measurement_lxb_h) measurement,
		max(sh.shape_name) shape_name,
		max(cut.cut_name) cut_name,
		max(col.color_name) color_name,
		max(cla.clarity_name) clarity_name,
		max(prod.sieve_size) sieve_size,
		max(prod.mm_size) mm_size,
		max(prod.cost_price_code) cost_price_code,
		sum(stk.in_out_flag * stk.qty1) inv_qty1,
		sum(stk.in_out_flag * stk.qty2) inv_qty2,
		max(prod.uom1) uom1,
		max(prod.uom2) uom2,
		coalesce(nullif($P{currency},'-1'),tcomp.default_currency) currency,
		max(prod.cost_price) cost_price
	from
		public.tbl_lot_stock_trans stk
		inner join public.tbl_company tcomp on stk.company_id = tcomp.company_id
		inner join public.tbl_lot prod on stk.lot_id = prod.lot_id
		inner join public.tbl_bin tbin on stk.bin_id = tbin.bin_id
		inner join public.tbl_commodity tcom on prod.commodity_id = tcom.commodity_id
		inner join public.tbl_commodity_group tcomg on tcom.commodity_group_id = tcomg.commodity_group_id
		left join public.tbl_shape sh on prod.shape_id = sh.shape_id
		left join public.tbl_cut cut on prod.cut_id = cut.cut_id
		left join public.tbl_color col on prod.color_id = col.color_id
		left join public.tbl_clarity cla on prod.clarity_id = cla.clarity_id
	where
		stk.is_deleted = 0
		and stk.inv_dt <= to_date($P{toDate}, $P{dateFormat})
		and (stk.bin_id in ($P!{binId}) or '-1' in ($P!{binId}))
		and (prod.commodity_id in ($P!{commodityId}) or '-1' in ($P!{commodityId}))
		and (prod.commodity_group_id in ($P!{commodityGroupId}) or '-1' in ($P!{commodityGroupId}))
		and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
		and stk.company_id = $P!{loginCompanyId}
	group by
		tcomp.company_id,
		tbin.bin_id,
		prod.lot_id,
		stk.stone_size
	having
	 (sum(stk.in_out_flag * stk.qty1) <> 0 or
		sum(stk.in_out_flag * stk.qty2) <> 0)
	order by
		tcomp.company_id,
		max(tcom.commodity_group_id),
		max(prod.commodity_id),
		--tbin.bin_id,
		prod.lot_code,
		stk.stone_size
)tx) res]]>
	</queryString>
