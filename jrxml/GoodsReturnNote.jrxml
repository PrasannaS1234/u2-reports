<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GoodsReturnNote" pageWidth="670" pageHeight="840" whenNoDataType="AllSectionsNoDetail" columnWidth="660" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	 im.inv_id,
	 im.inv_type||'-'||im.inv_no ReturnNo,
	 to_char(im.inv_dt,'dd/mm/yyyy') ReturnDate,
	 im.description,
	 im.issue_return_type returnType,
	 lot.lot_code,
      tcomp.company_name company_name,
	 coalesce(tcomp.street,'') address1,
     coalesce(tcomp.area,'') address2,
     coalesce(tcomp.city,'') || ', ' || coalesce(tcomp.state,'') || ' ' || coalesce(tcomp.pin_code,'') ||
	 ', ' || coalesce(tcou.country_name,'') address3,
     tcomp.email comp_email,
     tcomp.phone_number comp_phone_no,
	 tcomp.fax_no comp_fax_no,
     tcomp.website comp_website,
	 concat(jw.jew_type,jw.jew_no) jew_no,
	 sku.sku_no,
	 case
	 	when so.sales_order_id is not null then concat(so.sales_order_type,so.sales_order_no)
		when soj.sales_order_id is not null then concat(soj.sales_order_type,soj.sales_order_no)
		else null
	 end sales_order_no,
	 cmd.commodity_name,
	 shp.shape_name,
	 lot.mm_size,
	 lot.sieve_size,
	 id.qty1,
	 id.uom1,
	 id.qty2,
	 id.uom2,
	 lot.description
from tbl_goods_return_main im
inner join tbl_goods_return_det id on im.inv_id = id.inv_id
	and id.is_deleted = 0
inner join tbl_company tcomp on im.company_id = tcomp.company_id
left join tbl_country tcou on tcomp.country_id= tcou.country_id
inner join tbl_lot lot on id.lot_id = lot.lot_id
inner join tbl_bin bin on id.bin_id = bin.bin_id
left join tbl_jewellery jw on id.jew_id = jw.jew_id
left join tbl_sku sku on jw.sku_id = sku.sku_id
left join tbl_sales_order_main so on id.so_id = so.sales_order_id
left join tbl_sales_order_main soj on jw.sales_order_id = soj.sales_order_id
left join tbl_commodity cmd on lot.commodity_id = cmd.commodity_id
left join tbl_shape shp on lot.shape_id = shp.shape_id
where
    im.is_deleted = 0
	and im.inv_id = $P!{i_inv_id}]]>
	</queryString>
