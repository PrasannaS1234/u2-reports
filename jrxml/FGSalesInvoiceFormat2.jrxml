<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesInvoiceFormat3" pageWidth="500" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="475" leftMargin="15" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.8150000000000028"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="32"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<subDataset name="othChgs" uuid="6e89ef51-de48-4ecf-9355-dff3e9ac6f71">
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'APPROVAL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="invId" class="java.math.BigDecimal" isForPrompting="false">
			<defaultValueExpression><![CDATA[new BigDecimal(-1)]]></defaultValueExpression>
		</parameter>
		<parameter name="totAmt" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[new BigDecimal(0)]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select

			2 groupno,
			max(chgs.charge_name) charge_name,
			sum(chgs.plus_minus_flag * case when 0 < 0 then -1 else 1 end * chgs.input_amt) othamt
		from
			tbl_jew_sales_invoice_chgs chgs
		where
			1 = 1
			and chgs.inv_id =  $P!{invId}
			and chgs.is_deleted = 0
		group by
			chgs.inv_id,
			chgs.charge_id
		 having sum(chgs.plus_minus_flag * chgs.input_amt) <> 0]]>
		</queryString>
		<field name="groupno" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="othamt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\GITHUB\\jew-trade-service\\src\\main\\resources\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="parameter1" class="java.lang.String"/>
	<parameter name="customDateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.sku_no"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select * from
 (select
    ma.inv_type||'_'||ma.inv_no main_qr_code,
    ma.inv_id,
    ma.inv_no,
    ma.inv_type,
    ma.salesman_id salesman_emp_id,
    ma.reference_no off_ref_no,
    to_char(ma.inv_dt,coalesce($P{customDateFormat},$P{dateFormat})) inv_dt,
    ma.currency	cur_code,
    ma.exchange_rate conv_rate,
    pt.payment_type_name payment_type,
   	null po_so_id,
    0	close_day,
    ma.close_dt,
    0 pn_recv_day,
    null pn_recv_dt,
    ma.inv_due_days,
    ma.inv_due_months,
    ma.inv_due_dt,
    null carrier_name,
    null mawb_no,
    null hawb_no,
    null shipment_type,
    null csc_id,
    cont.jew_id cont_id,
    cont.jew_type cont_type,
    cont.jew_no ,
    jt.product_type_name ,
	sty.sku_no  ,
    det.uom uom,
    det.inv_qty inv_qty,
    det.input_rate rate,
    det.input_amt amt,
    coalesce(ma.bill_street,'') bstreet,
    coalesce(ma.bill_address1,'') barea1,
    coalesce(ma.bill_address2,'') barea,
    coalesce(ma.bill_city,'') bcity,
    coalesce(ma.bill_pincode,'') bcity_pin,
    coalesce(ma.bill_state,'') bstate,
    coalesce(ma.bill_country,'') bcountry,
    coalesce(ma.bill_phone_no,'') bcontact_code,
    coalesce(ma.bill_phone_no,'') bcontact_phone,
    '' bcontact_name,
    coalesce(ma.bill_phone_no,'') bcontact_mobile,
    coalesce(ma.bill_fax_no,'') bcontact_fax,
    '' bcontact_email,

     ma.bill_address1,
     ma.bill_address2,
     concat(ma.bill_country,' ',ma.bill_state,' ',ma.bill_pincode) bill_address3,
     ma.ship_address1,
     ma.ship_address2,
     concat(ma.ship_country,' ',ma.ship_state,' ',ma.ship_pincode) ship_address3,
    coalesce(ma.ship_street,'') sstreet,
    coalesce(ma.ship_address1,'') sarea1,
    coalesce(ma.ship_address2,'') sarea,
    coalesce(ma.ship_city,' ') scity,
    coalesce(ma.ship_pincode,' ') scity_pin,
    coalesce(ma.ship_state,' ') sstate,
    coalesce(ma.ship_country,' ') scountry,
    coalesce(ma.ship_phone_no,' ') scontact_code,
    coalesce(ma.ship_phone_no,' ') scontact_phone,
    ' ' scontact_name,
    coalesce(ma.ship_phone_no,' ') scontact_mobile,
    coalesce(ma.bill_fax_no,' ') scontact_fax,
    ' ' scontact_email,
    coalesce(nullif(det.prod_description,''),sty.description) description,
    concat(pod.sales_order_type,'-',pod.sales_order_no) po_no,
    null	cus_po_no,
    emp.first_name||' '||emp.last_name orderby,
    null pogivenby,
    pd.customer_name cus_name,
    pd.display_name cus_code,
    ma.remarks,
    pt.payment_type_name payment_type,
    null msrp,
    null msrp_lbl,
    upper(comp.company_name) comp_off_name,

    CONCAT(comp.area,',',comp.street) comp_area,
    concat(comp.city,',',upper(st.state_name),',',upper(tc.country_name)) comp_state_name,
    concat('Tel:',comp.phone_number,' Fax:',comp.fax_no) comp_contact,
    comp.street,
    null phone_fax,
    comp.website,
    pd.customer_id party_id,
    'CUSTOMER' party_type,
    null color,
    null clarity,
	'SALES'	trans_type,
    0.00 consumed_qty1,
    0.00 consumed_qty2,
	'' data_signed_qr_code,
	null	jid,
	null	style_reference_no,
	(upper(spellnumericvalue((ma.total_invoice_net_amount),(ma.currency)))) amount_in_words,
		case
		when coalesce(length(trim(cont.image_url)),0) > 0 then
		concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',cont.company_id,'/jewellery/',cont.jew_id,cont.image_url)
		else concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sty.company_id,'/sku/',sty.sku_id,sty.image_url)
	end image_url,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',comp.company_id,'/company/',comp.company_id,comp.log_url)	comp_logo,
ma.total_invoice_net_amount inv_net_amt,
ma.total_invoice_qty inv_net_qty,
concat(round(det.inv_qty,0),' ', det.uom) qty_with_uom,
sum(round(coalesce(tcomp.total_weight,0),3))  over(partition by ma.inv_id) total_weight,
concat(cont.jew_type,cont.jew_no) job_no
from
    tbl_jew_sales_invoice_main ma
    inner join tbl_jew_sales_invoice_det det on ma.inv_id = det.inv_id
		and det.is_deleted = 0
    inner join tbl_customer pd on ma.customer_id = pd.customer_id
    inner join tbl_jewellery cont on det.jew_id = cont.jew_id
	left join tbl_sales_order_det sdsd on cont.sales_order_det_id = sdsd.sales_order_det_id
    left join tbl_sku sty on cont.sku_id = sty.sku_id
    left join tbl_payment_type pt on ma.payment_type_id = pt.payment_type_id
    left join tbl_sales_order_main pod on cont.sales_order_id = pod.sales_order_id
    left join tbl_employee emp on pd.salesman_id = emp.employee_id
    inner join tbl_company comp on ma.company_id = comp.company_id
    LEFT JOIN tbl_country tc ON comp.country_id = tc.country_id
    left join tbl_state st on comp.state = st.state_code
    left join tbl_product_type jt on cont.product_type_id = jt.product_type_id
    left join tbl_lot t9 on cont.metal_id = t9.lot_id
    left join
	(
	select
	jc.jew_id,
	round(sum(case when tcg.commodity_group_type = 'METAL' then jc.consumed_qty1
	 else jc.consumed_qty1 * 0.2
	 end),3) total_weight

from
tbl_jewellery_component jc
left join tbl_lot tlot on jc.lot_id = tlot.lot_id
left join tbl_commodity tcom on jc.commodity_id = tcom.commodity_id
left join tbl_commodity_group tcg on tcom.commodity_group_id = tcg.commodity_group_id
where
	jc.is_deleted = 0
	and jc.commodity_id <> 27
group by
	jc.jew_id
	) tcomp on det.jew_id = tcomp.jew_id
where
    ma.inv_id = $P!{i_inv_id}
    and ma.is_deleted = 0)tmp
order by $P!{sortColumn}]]>
	</queryString>
