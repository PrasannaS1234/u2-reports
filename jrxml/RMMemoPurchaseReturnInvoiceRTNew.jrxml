	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<parameter name="invoice_cts" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="invoice_pcs" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="return_cts" class="java.math.BigDecimal" isForPrompting="false"/>
		<parameter name="return_pcs" class="java.math.BigDecimal" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY irm.inv_id) AS srno,
    COALESCE(irm.inv_id, 0) AS inv_id,
    COALESCE(irm.inv_type, '') AS inv_type,
    COALESCE(lot.lot_code, '') AS lot_code,
    COALESCE(ird.inv_qty1, 0) AS return_cts,
    COALESCE(ird.inv_qty2, 0) AS return_pcs,
    COALESCE(id.inv_qty1, 0) AS invoice_cts,
    COALESCE(id.inv_qty2, 0) AS invoice_pcs
FROM
tbl_memo_purchase_return_invoice_main irm
INNER JOIN tbl_memo_purchase_return_invoice_det ird ON irm.inv_id = ird.inv_id
        and ird.is_deleted = 0
left join tbl_memo_purchase_invoice_main im  on ird.ref_inv_id = im.inv_id
and ird.ref_inv_type = im.inv_type
and im.is_deleted=0
LEFT JOIN tbl_memo_purchase_invoice_det id ON ird.ref_inv_det_id = id.inv_det_id
        AND ird.ref_inv_id = id.inv_id
        AND ird.ref_inv_type = im.inv_type
        and id.is_deleted = 0
INNER JOIN tbl_lot lot ON ird.lot_id = lot.lot_id
INNER JOIN tbl_company tcomp ON irm.company_id = tcomp.company_id
where irm.inv_id in ($P!{i_inv_id})
ORDER BY
    irm.inv_id;]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="inv_type" class="java.lang.String"/>
		<field name="lot_code" class="java.lang.String"/>
		<field name="return_cts" class="java.math.BigDecimal"/>
		<field name="return_pcs" class="java.math.BigDecimal"/>
		<field name="invoice_cts" class="java.math.BigDecimal"/>
		<field name="invoice_pcs" class="java.math.BigDecimal"/>
		<variable name="QTY" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[]]></variableExpression>
		</variable>
		<variable name="variable1" class="java.lang.String" calculation="Sum">
			<variableExpression><![CDATA[$F{return_cts}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
