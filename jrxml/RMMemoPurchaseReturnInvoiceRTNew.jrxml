	</parameter>
	<parameter name="invType" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
	</parameter>
	<parameter name="invoice_cts" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="invoice_pcs" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="return_cts" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="return_pcs" class="java.math.BigDecimal" isForPrompting="false"/>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    max(tcomp.company_name) company_name,
    max(im.inv_id) inv_id,
    max(im.inv_type) inv_type,
    max(im.inv_type||'-'||im.inv_no) inv_type_no,
    to_char(max(im.inv_dt), max(coalesce(tcomp.date_format,'dd/MM/yyyy'))) inv_dt,
MAX(im.reference_no) reference_no,
    max(im.currency) currency,
    max(pyt.payment_type_name) payment_term,
    max(tbuy.first_name) buyer_name,
    max(tsup.supplier_name) customer_name,
    max(coalesce(im.bill_address1,'')) bill_addr1,
    max(coalesce(im.bill_address2,'')) bill_addr2,
    max(coalesce(im.bill_country,'')) bill_country,
    max(coalesce(im.bill_state,'')) bill_state,
    max(coalesce(im.bill_city,'')) bill_city,
    max(coalesce(im.bill_street,'')) bill_street,
    max(coalesce(im.bill_pincode,'')) bill_pincode,
    max(coalesce(tbuy.first_name,'')) buyer_name,
    max(coalesce(im.ship_address1,'')) ship_addr1,
    max(coalesce(im.ship_address2,'')) ship_addr2,
    max(coalesce(im.ship_country,'')) ship_country,
    max(coalesce(im.ship_state,'')) ship_state,
    max(coalesce(im.ship_city,'')) ship_city,
    max(coalesce(im.ship_street,'')) ship_street,
    max(coalesce(im.ship_pincode,'')) ship_pincode,
    (max(coalesce(tcomp.street,''))) address1,
    (max(coalesce(tcomp.area,''))) address2,
    (max(coalesce(tcomp.city,'')) || ', ' || max(coalesce(tcomp.state,'')) || ' ' || max(coalesce(tcomp.pin_code,'')) ||
	 ', ' || max(coalesce(tcou.country_name,''))
    ) address3,
    max(tcomp.email) comp_email,
    max(phone_number) comp_phone_no,
    max(tcomp.website) comp_website,
    max(coalesce(tcomp.payment_address,'')) payment_address,
    max(coalesce(im.terms_conditions,'')) terms_conditions,
    max(im.total_invoice_amount) grossAmount,
    max(cmbnk.beneficiary_name) benificiary_name,
    max(cmbnk.bank_name) bank_name,
    max(cmbnk.bank_account_number) bank_account_number,
    max(cmbnk.ifsc_code) ifsc_code,
    max(cmbnk.routing) routing,
    max(cmbnk.bank_address) bank_address,
    upper(spellnumericvalue(max(im.total_invoice_net_amount),max(im.currency))) amount_in_words,
    CONCAT(
    '/home/ubuntu/tekfilo/jewtrade/uploads/',
    '',
    'comp',
    MAX(tcomp.company_id),
    '/company/',
    MAX(tcomp.company_id),
    MAX(tcomp.log_url)
) AS comp_logo,
    (case when max(tcomp.log_url) is not null then true else false end) logo_print,
   case when max(im.total_charge_plus_amount) + max(im.total_charge_minus_amount) > 0 then 1 else 0 end show_chgs,
   max(im.total_invoice_net_amount) tot_amt,
   max(im.total_invoice_qty1) tot_qty1,
   max(im.total_invoice_qty2) tot_qty2,
  COALESCE(SUM(pd.inv_qty1), 0) AS invoice_cts,
   COALESCE(SUM(pd.inv_qty2), 0) AS invoice_pcs,
   COALESCE(SUM(id.inv_qty1), 0) AS return_cts,
   COALESCE(SUM(id.inv_qty2), 0) AS return_pcs,
   max(cmbnk.wire_transfer) wire_transfer
from
    tbl_memo_purchase_return_invoice_main im
    inner join tbl_memo_purchase_return_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
left join tbl_country tcou on tcomp.country_id= tcou.country_id
left join tbl_memo_purchase_invoice_main pm on id.ref_inv_id = pm.inv_id
and id.ref_inv_type = pm.inv_type
	   and pm.is_deleted = 0
left JOIN tbl_memo_purchase_invoice_det pd ON id.ref_inv_det_id = pd.inv_det_id
	    and id.ref_inv_id = pd.inv_id
		and id.ref_inv_type = pm.inv_type
		and pd.is_deleted = 0
    left join tbl_supplier tsup on im.supplier_id = tsup.supplier_id
    left join tbl_buyer tbuy on im.buyer_id = tbuy.buyer_id
	inner join tbl_payment_type pyt on im.payment_type_id = pyt.payment_type_id
	left join tbl_company_bank cmbnk on tcomp.company_id = cmbnk.company_id
	    and cmbnk.is_default = 1
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
    and im.company_id = pm.company_id
group by
    tcomp.company_id,
    im.inv_id,
    im.inv_type]]>
	</queryString>
