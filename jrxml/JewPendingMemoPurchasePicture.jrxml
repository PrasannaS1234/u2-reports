<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JewPendingMemoPurchasePic" pageWidth="1180" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1140" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.1269722013523664"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeIds" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    im.inv_id,
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    tsup.display_name supplier_code,
    tsup.supplier_name,
    concat(prod.jew_type,prod.jew_no)prod_no,
    id.prod_description,
    tcomp.company_name,
    (id.inv_qty - id.conf_qty - id.ret_qty) inv_qty,
    id.uom,
    id.input_rate,
    ((id.inv_qty - id.conf_qty - id.ret_qty) * id.input_rate) input_amt,
    id.discount_type,
    id.discount_value,
    id.cost_price,
    pt.product_type_name,
    concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',im.company_id,'/sku/',prod.sku_id,sku.image_url) image_url
from
    tbl_jew_memo_purchase_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_jew_memo_purchase_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_supplier tsup on im.supplier_id = tsup.supplier_id
	and (tsup.supplier_name like concat(trim($P!{supplierLike}),'%%'))
    inner join tbl_jewellery prod on id.jew_id = prod.jew_id
    left join tbl_sku sku on prod.sku_id = sku.sku_id
    left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
where
    im.is_deleted = 0
    and ((id.inv_qty - id.conf_qty - id.ret_qty) <> 0 )
    and (concat(prod.jew_type,prod.jew_no) in ($P!{jewNos}) or ' ' in ($P!{jewNos}))
    and (prod.product_type_id in ($P!{productTypeIds}) or -1 in ($P!{productTypeIds}))

order by
    im.inv_dt,
    im.inv_id]]>
	</queryString>
