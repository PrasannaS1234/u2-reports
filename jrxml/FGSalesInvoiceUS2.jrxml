<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGSalesInvoiceMF23" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="587" leftMargin="15" rightMargin="10" topMargin="10" bottomMargin="10" uuid="994b5161-1c97-4377-8335-10ca4d4a4a3a">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<subDataset name="othChgs" uuid="6e89ef51-de48-4ecf-9355-dff3e9ac6f71">
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'APPROVAL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="invId" class="java.math.BigDecimal" isForPrompting="false">
			<defaultValueExpression><![CDATA[new BigDecimal(-1)]]></defaultValueExpression>
		</parameter>
		<parameter name="totAmt" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[new BigDecimal(0)]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select * from (
select
    inv_type,
    inv_id,
    charge_name,
    case
        when groupno = 3 then
            sum(othamt) over (partition by 1)
        else
            othamt
    end amt,
    groupno
from
    (
    select
        $P{invType} inv_type,
        $P{invId} inv_id,
        1 groupno,
        'Sub-Total' charge_name,
        $P{totAmt} othamt
    from
        dual
    union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_sal_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
    having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
    union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_apr_sal_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
     having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
   union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_sal_ret_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
     having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
   union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_apr_sal_ret_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
    having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
    union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_pur_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
    having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
    union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_apr_pur_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
     having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
   union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_pur_ret_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
     having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
    union all
    select
        chgs.inv_type,
        chgs.inv_id,
        2 groupno,
        max(rul.charge_name) charge_name,
        sum(chgs.plus_minus_flag * case when $P{totAmt} < 0 then -1 else 1 end * chgs.oth_chgs_amt_intl) othamt
    from
        t_fg_apr_pur_ret_inv_chgs chgs
        inner join t_inv_oth_chgs_rule rul
        on chgs.rule_id = rul.rule_id
    where
        1 = 1
    and chgs.inv_type =  $P{invType}
    and chgs.inv_id =  $P{invId}
        and chgs.is_deleted = 0
    group by
        chgs.inv_type,
        chgs.inv_id,
        rul.rule_id
    having sum(chgs.plus_minus_flag * chgs.oth_chgs_amt_intl) <> 0
    union all
    select
        $P{invType} inv_type,
        $P{invId} inv_id,
        3 groupno,
        'Grand Total' charge_name,
        0 othamt
    from
        dual
    )
)
order by groupno]]>
		</queryString>
		<field name="INV_TYPE" class="java.lang.String"/>
		<field name="INV_ID" class="java.math.BigDecimal"/>
		<field name="CHARGE_NAME" class="java.lang.String"/>
		<field name="AMT" class="java.math.BigDecimal"/>
		<field name="GROUPNO" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="componentDet" uuid="553acdf1-6b65-429d-b5d1-55b0d31f1b75">
		<parameter name="contId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    mc.cont_id,
    mc.lot_id,
    mc.lot_code,
    mc.consumed_qty2,
    mc.consumed_qty1,
    case when lot.rm_id in (1,2,3,4,5)and mc.consumed_qty1 > 0 then trim(to_char(round(mc.consumed_qty1, 3),'9999999990.000'))||' '||mc.uom1 else trim(to_char(mc.consumed_qty1, '9999999990')) end tag_wt,
    case when lot.rm_id in (1,2,3,4,5) and mc.consumed_qty2 > 0 then trim(to_char(mc.consumed_qty2, '9999999990')) else trim(to_char(mc.consumed_qty2, '9999999990')) end no_of_stn,
    lot.ss_inscription_no inscription_no,
    lot.shape_name||' '||trim(case when lot.ss_certificate_no is not null then 'CERT: '|| nvl(lot.ss_lab_name,'GIA') || ' '|| lot.ss_certificate_no end ||
case when lot.ss_inscription_no is not null then ' INS: '||
    lot.ss_inscription_no end) description,
    nvl(lot.color_name,' ') color_name,
    nvl(lot.ss_clarity,' ') international_quality,
nvl(lot.ss_color||case when lot.ss_clarity is not null then '-'||lot.ss_clarity end,' ') color_clarity,
    mc.csc_id,
lot.shape_name
from t_main_components mc
    inner join t_rm_lot lot on mc.lot_id = lot.lot_id
        and lot.is_deleted = 0
and lot.is_single_stone = 1
where mc.cont_id in ($P!{contId})
and mc.consumed_qty1 > 0
    and mc.is_deleted = 0
union
select
    c1.cont_id,
    mc.lot_id,
    mc.lot_code,
    mc.consumed_qty2,
    mc.consumed_qty1,
    case when lot.rm_id in (1,2,3,4,5)and mc.consumed_qty1 > 0 then trim(to_char(round(mc.consumed_qty1, 3),'9999999990.000'))||' '||mc.uom1 else trim(to_char(mc.consumed_qty1, '9999999990')) end tag_wt,
    case when lot.rm_id in (1,2,3,4,5)and mc.consumed_qty2 > 0 then trim(to_char(mc.consumed_qty2, '9999999990')) else     trim(to_char(mc.consumed_qty2, '9999999990')) end no_of_stn,
    lot.ss_inscription_no inscription_no,
    lot.shape_name||' '||trim(case when lot.ss_certificate_no is not null then 'CERT: '|| nvl(lot.ss_lab_name,'GIA') || ' '|| lot.ss_certificate_no end ||
case when lot.ss_inscription_no is not null then ' INS: '||
    lot.ss_inscription_no end) description,
    nvl(lot.color_name,' ') color_name,
    nvl(lot.ss_clarity,' ') international_quality,
    nvl(lot.ss_color||case when lot.ss_clarity is not null then '-'||lot.ss_clarity end,' ') color_clarity,
    mc.csc_id,
lot.shape_name
from
t_contract c1
inner join t_main_components mc on c1.original_cont_id = mc.cont_id
and mc.consumed_qty1 > 0
    and mc.is_deleted = 0
    inner join t_rm_lot lot on mc.lot_id = lot.lot_id
        and lot.is_deleted = 0
and ((lot.is_single_stone = 1)
or lot.com_id in (192))
where
    c1.cont_id in ($P!{contId})
     and c1.previous_cont_id <> c1.original_cont_id
    and c1.is_deleted = 0
union
select
    c2.cont_id,
    mc.lot_id,
    mc.lot_code,
    mc.consumed_qty2,
    mc.consumed_qty1,
    case when lot.rm_id in (1,2,3,4,5)and mc.consumed_qty1 > 0 then trim(to_char(round(mc.consumed_qty1, 3),'9999999990.000'))||' '||mc.uom1 else trim(to_char(mc.consumed_qty1, '9999999990')) end tag_wt,
    case when lot.rm_id in (1,2,3,4,5)and mc.consumed_qty2 > 0 then trim(to_char(mc.consumed_qty2, '9999999990')) else     trim(to_char(mc.consumed_qty2, '9999999990')) end no_of_stn,
    lot.ss_inscription_no inscription_no,
    lot.shape_name||' '||trim(case when lot.ss_certificate_no is not null then 'CERT: '|| nvl(lot.ss_lab_name,'GIA') || ' '|| lot.ss_certificate_no end ||
case when lot.ss_inscription_no is not null then ' INS: '||
    lot.ss_inscription_no end) description,
    nvl(lot.color_name,' ') color_name,
    nvl(lot.ss_clarity,' ') international_quality,
    nvl(replace(lot.ss_color,'/','-')||case when lot.ss_clarity is not null then '-'||lot.ss_clarity end,' ') color_clarity,
    mc.csc_id,
lot.shape_name
from
t_contract c2
inner join t_main_components mc on c2.previous_cont_id = mc.cont_id

and mc.consumed_qty1 > 0
    and mc.is_deleted = 0
    inner join t_rm_lot lot on mc.lot_id = lot.lot_id
        and lot.is_deleted = 0
and ((lot.is_single_stone = 1)
or lot.com_id in (192))
where
    c2.cont_id in ($P!{contId})
and c2.cont_type <> 'MFSP'
    and c2.is_deleted = 0]]>
		</queryString>
		<field name="CONT_ID" class="java.math.BigDecimal"/>
		<field name="LOT_ID" class="java.math.BigDecimal"/>
		<field name="LOT_CODE" class="java.lang.String"/>
		<field name="CONSUMED_QTY2" class="java.math.BigDecimal"/>
		<field name="CONSUMED_QTY1" class="java.math.BigDecimal"/>
		<field name="TAG_WT" class="java.lang.String"/>
		<field name="NO_OF_STN" class="java.lang.String"/>
		<field name="INSCRIPTION_NO" class="java.lang.String"/>
		<field name="DESCRIPTION" class="java.lang.String"/>
		<field name="COLOR_NAME" class="java.lang.String"/>
		<field name="INTERNATIONAL_QUALITY" class="java.lang.String"/>
		<field name="COLOR_CLARITY" class="java.lang.String"/>
		<field name="CSC_ID" class="java.math.BigDecimal"/>
		<field name="SHAPE_NAME" class="java.lang.String"/>
	</subDataset>
	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="invType" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
	</parameter>
	<parameter name="invId" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="LGStatus" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("intl")]]></defaultValueExpression>
	</parameter>
	<parameter name="cscId" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["27"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="picReq" class="java.lang.String">
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<parameter name="showMSRP" class="java.lang.String">
		<defaultValueExpression><![CDATA["'Y'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reporttype" class="java.lang.String">
		<defaultValueExpression><![CDATA["'pdf'"]]></defaultValueExpression>
	</parameter>
	<parameter name="subAreaId" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["27"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    case when ma.csc_id = 27 then 'https://d2gw0etq5qqk93.cloudfront.net/m/smdmf/mfwp2/MF-LOGO_Brwn.png' else $P{PM_SUB_REPORT_PATH}||'Sugarock.png' end img,
    ma.inv_id,
    ma.inv_no,
    ma.inv_type,
    ma.coordinator_employee_id salesman_emp_id,
    ma.reference_no off_ref_no,
    ma.inv_dt,
    ma.cur_code,
    ma.exchange_rate conv_rate,
    pt.payment_type_name payment_type,
    ma.po_so_id,
    ma.close_day,
    ma.close_dt,
    ma.pn_recv_day,
    ma.pn_recv_dt,
    ma.inv_due_days,
    ma.inv_due_months,
    ma.inv_due_dt,
    ma.carrier_name,
    ma.mawb_no,
    ma.hawb_no,
    st.shipment_type_name shipment_type,
    ma.csc_id,
    cont.cont_id,
    cont.cont_type,
    det.product_code cont_no,
    cont.jewellery_type,
case when cont.cont_type like 'HK%' then nvl(cont.style_reference_no, cont.style_no) else  sty.style_no end style_no,
    /* case when cont.cont_type like 'HK%' then nvl(cont.style_reference_no, cont.style_no) else nvl(sdsd.style_no, sty.style_no) end style_no, */
/* commenting this bcs sod have 2 qty with one but in contract each contract hav different style */
    det.uom1 uom,
    det.inv_qty1 inv_qty,
    det.inv_rate_intl rate,
    det.inv_amt_intl amt,
    nvl(badd.street,' ') bstreet,
    nvl(badd.area,' ') barea,
    nvl(badd.city,' ') bcity,
    nvl(badd.city_pin,' ') bcity_pin,
    nvl(badd.state,' ') bstate,
    nvl(badd.country,' ') bcountry,
    nvl(badd.contact_code,' ') bcontact_code,
    nvl(badd.contact_phone,' ') bcontact_phone,
    nvl(badd.contact_name,' ') bcontact_name,
    nvl(badd.contact_mobile,' ') bcontact_mobile,
    nvl(badd.contact_fax,' ') bcontact_fax,
    nvl(badd.contact_email,' ') bcontact_email,
    nvl(sadd.street,' ') sstreet,
    nvl(sadd.area,' ') sarea,
    nvl(sadd.city,' ') scity,
    nvl(sadd.city_pin,' ') scity_pin,
    nvl(sadd.state,' ') sstate,
    nvl(sadd.country,' ') scountry,
    nvl(sadd.contact_code,' ') scontact_code,
    nvl(sadd.contact_phone,' ') scontact_phone,
    nvl(sadd.contact_name,' ') scontact_name,
    nvl(sadd.contact_mobile,' ') scontact_mobile,
    nvl(sadd.contact_fax,' ') scontact_fax,
    nvl(sadd.contact_email,' ') scontact_email,
    nvl(det.prod_desc,case when sty.style_no like '%-0%' then sdsd.style_description
when sty.style_no in ('LABOR','SUPPLIED') then sdsd.style_description
when sty.style_stock_type in ('DELIVERY') then nvl(sdsd.style_description,t8.parameter_desc|| ' ' ||
      t9.lot_desc || ' ' ||jt.jeweller_type_name)
when sty.style_stock_type in ('FM_WHOLESALE') then trim(t8.parameter_desc|| ' ' ||
      t9.lot_desc || ' ' ||jt.jeweller_type_name||' '||sdsd.style_description)
 else
    case when sty.style_stock_type in ('PROTOTYPE', 'SILVER') then
             'INSTORE PROTOTYPE: '
           end
             ||t8.parameter_desc || ' ' ||case when sty.style_stock_type not in ('PROTOTYPE', 'SILVER') then t9.lot_desc||' ' end|| jt.jeweller_type_name end) description,
    so.so_no po_no,

    so.customer_reference_no cus_po_no,
    emp.first_name||' '||emp.last_name orderby,
    null pogivenby,
    pd.party_company_name cus_name,
    ma.remarks,
    pt.payment_type_name payment_type,
    case when $P!{showMSRP} = 'Y' then sty.msrp else null end msrp,
    case when $P!{showMSRP} = 'Y' then 'MSRP' else null end msrp_lbl,
    comp.company_official_name comp_off_name,
    coad.street,
    coad.contact_phone || ' ' ||coad.contact_fax phone_fax,
    coad.website,
    pd.party_id,
    pd.party_type,

    sty.diamond_color color,
    sty.diamond_clarity clarity,
ma.trans_type,
        nvl(case when sty.style_no like 'SS%' then sty.tag_desc else cnm.consumed_qty1 end,case when stone.min_total_wt > 0 and sty.style_stock_type <> 'DELIVERY' and sty.style_no not in ('SUPPLIED','LABOR') then 'D '||trim(to_char(stone.min_total_wt,'99999999990.00'))||' CT' end) consumed_qty1,
        nvl(case when sty.style_no like 'SS%' then
case
            when sty.tag_desc is not null and stone.no_of_stone > 0  and sty.style_stock_type <> 'DELIVERY' and sty.style_no not in ('SUPPLIED','LABOR') then
                stone.no_of_stone || ' PCS'

    end
else cnm.consumed_qty2 end,case when stone.no_of_stone > 0  and sty.style_stock_type <> 'DELIVERY' and sty.style_no not in ('SUPPLIED','LABOR') then stone.no_of_stone end) consumed_qty2,
case when sty.style_stock_type <> 'FM_WHOLESALE' then
case when replace(sty.diamond_color,'/','-') = 'G-H' and replace(sty.diamond_clarity,'/','-') = 'VS2-SI1' then 'Exceptional'
             when replace(sty.diamond_color,'/','-') = 'H-I' and replace(sty.diamond_clarity,'/','-') = 'SI1' then 'Premium'
             when replace(sty.diamond_color,'/','-') = 'H-I' and replace(sty.diamond_clarity,'/','-') = 'SI2' then 'Standard'
             when replace(sty.diamond_color,'/','-') = 'H-I' and replace(sty.diamond_clarity,'/','-') = 'I1' then 'Commercial'
             else replace(nullif(sty.diamond_color,'NA'),'/','-')||case when nullif(sty.diamond_color,'NA') is not null then '/' end||replace(nullif(sty.diamond_clarity,'NA'),'/','-') end else ' ' end diam_quality
from
    v_all_inv_main ma
    inner join v_all_inv_det det on ma.inv_id = det.inv_id
        and ma.inv_type = det.inv_type
    inner join v_party_details pd on ma.party_id = pd.party_id
        and ma.party_type = pd.party_type
        and lower(pd.party_company_name) like replace('%' || lower(trim('')) || '%', '%%', '%')
    inner join t_contract cont on det.product_id = cont.cont_id
        and cont.is_deleted = 0
    left join t_sales_order_det sdsd on cont.sod_id = sdsd.sod_id
        and sdsd.is_deleted = 0
    left join (

select
    rr.inv_id,
    rr.inv_type,
    rr.inv_det_id,
    rr.cont_id,
    trim(to_char(wm_concat(case when rr.consumed_qty1 > 0 then rr.com_desc||' ' end||trim(to_char(rr.consumed_qty1,'99999990.00')))||' '||max(rr.uom1))) consumed_qty1,
    trim(to_char(sum(rr.consumed_qty2),'9999999990')) consumed_qty2
from
(
select
sr.inv_id,
    sr.inv_type,
    sr.inv_det_id,
    sr.cont_id,
    max(sr.com_desc) com_desc,
    case when cont_id = 5000940206 then 8.15 else sum(sr.consumed_qty1) end consumed_qty1,
    case when cont_id = 5000940206 then 40 else sum(sr.consumed_qty2) end consumed_qty2,
    max(sr.uom1) uom1
from
(
select
    ma1.inv_id,
    ma1.inv_type,
    det2.inv_det_id,
lot.com_id,
    max(det2.product_id) cont_id,
    max(co.remarks) com_desc,
    sum(det2.inv_qty1 * mc.consumed_qty1) cs1,
    nullif(round(sum(det2.inv_qty1 * case when mc.rm_from_type in ('FROM_FG') then -1 * (mc.broken_qty1+mc.loss_qty1+mc.return_qty1) else mc.consumed_qty1 end),2),0) consumed_qty1,
    max(mc.uom1) uom1,
    sum(det2.inv_qty1 * case when mc.rm_from_type in ('FROM_FG') then -1 * (mc.broken_qty2+mc.loss_qty2+mc.return_qty2) else mc.consumed_qty2 end) consumed_qty2
from
    v_all_inv_main ma1
inner join v_all_inv_det det2 on ma1.inv_id = det2.inv_id
     and ma1.inv_type = det2.inv_type
inner join t_contract ccon on det2.product_id = ccon.cont_id
    inner join t_main_components mc on ccon.cont_id = mc.cont_id
        and mc.is_deleted = 0
    inner join t_rm_lot lot on mc.lot_id = lot.lot_id
    and lot.is_deleted = 0
    and lot.is_stone = 1
and lot.is_single_stone = 0
    and lot.com_id not in (192,2060,208,53,83)
    inner join t_commodity co on lot.com_id = co.com_id
        and co.is_deleted = 0
where
    ma1.csc_id in ($P!{cscId})
    and (ma1.inv_id = $P!{invId} or -1 = $P!{invId})
    and (ma1.inv_type = $P!{invType} or ' ' = $P!{invType})
group by
    ma1.inv_id,
    ma1.inv_type,
    det2.inv_det_id,
    mc.cont_id,
    lot.com_id
union
select
    ma1.inv_id,
    ma1.inv_type,
    det2.inv_det_id,
    lot.com_id,
    max(det2.product_id) cont_id,
    max(co.remarks) com_desc,
    sum(det2.inv_qty1 * mc.consumed_qty1) cs1,
    nullif(round(sum(det2.inv_qty1 * case when mc.rm_from_type in ('FROM_FG') then -1 * (mc.broken_qty1+mc.loss_qty1+mc.return_qty1) else mc.consumed_qty1 end),2),0) consumed_qty1,
    max(mc.uom1) uom1,
    sum(det2.inv_qty1 * case when mc.rm_from_type in ('FROM_FG') then -1 * (mc.broken_qty2+mc.loss_qty2+mc.return_qty2) else mc.consumed_qty2 end) consumed_qty2
from
    v_all_inv_main ma1
inner join v_all_inv_det det2 on ma1.inv_id = det2.inv_id
     and ma1.inv_type = det2.inv_type
inner join t_contract ccon on det2.product_id = ccon.cont_id
    inner join t_main_components mc on ccon.original_cont_id = mc.cont_id
        and mc.is_deleted = 0
    inner join t_rm_lot lot on mc.lot_id = lot.lot_id
    and lot.is_deleted = 0
    and lot.is_stone = 1
    and lot.is_single_stone = 0
    and lot.com_id not in (192,2060,208,53,83)
  inner join t_commodity co on lot.com_id = co.com_id
        and co.is_deleted = 0
where
    ma1.csc_id in ($P!{cscId})
    and (ma1.inv_id = $P!{invId} or -1 = $P!{invId})
    and (ma1.inv_type = $P!{invType} or ' ' = $P!{invType})
group by
    ma1.inv_id,
    ma1.inv_type,
    det2.inv_det_id,
    mc.cont_id,
    lot.com_id
union
select
    ma1.inv_id,
    ma1.inv_type,
    det2.inv_det_id,
lot.com_id,
    max(det2.product_id) cont_id,
    max(co.remarks) com_desc,
    sum(det2.inv_qty1 * mc.consumed_qty1) cs1,
    nullif(round(sum(det2.inv_qty1 * case when mc.rm_from_type in ('FROM_FG') then -1 * (mc.broken_qty1+mc.loss_qty1+mc.return_qty1) else mc.consumed_qty1 end),2),0) consumed_qty1,
    max(mc.uom1) uom1,
    sum(det2.inv_qty1 * case when mc.rm_from_type in ('FROM_FG') then -1 * (mc.broken_qty2+mc.loss_qty2+mc.return_qty2) else mc.consumed_qty2 end) consumed_qty2
from
    v_all_inv_main ma1
inner join v_all_inv_det det2 on ma1.inv_id = det2.inv_id
     and ma1.inv_type = det2.inv_type
inner join t_contract ccon on det2.product_id = ccon.cont_id

    inner join t_main_components mc on ccon.previous_cont_id = mc.cont_id
        and mc.is_deleted = 0
    inner join t_rm_lot lot on mc.lot_id = lot.lot_id
    and lot.is_deleted = 0
    and lot.is_stone = 1
and lot.is_single_stone = 0
    and lot.com_id not in (192,2060,208,53,83)
    inner join t_commodity co on lot.com_id = co.com_id
        and co.is_deleted = 0
where
     ma1.csc_id in ($P!{cscId})
    and (ma1.inv_id = $P!{invId} or -1 = $P!{invId})
    and (ma1.inv_type = $P!{invType} or ' ' = $P!{invType})
group by
    ma1.inv_id,
    ma1.inv_type,
    det2.inv_det_id,
    mc.cont_id,
    lot.com_id
)sr
group by
sr.inv_id,
    sr.inv_type,
    sr.inv_det_id,
    sr.cont_id,
    sr.com_id
)rr
group by
    rr.inv_id,
    rr.inv_type,
    rr.inv_det_id,
    rr.cont_id
having sum(rr.consumed_qty1) > 0
    ) cnm on det.product_id = cnm.cont_id and ma.inv_id = cnm.inv_id
    and ma.inv_type = cnm.inv_type and det.inv_det_id = cnm.inv_det_id
    inner join t_style sty on det.style_no = sty.style_no
        and sty.is_deleted = 0
    inner join t_payment_type pt on ma.payment_type_id = pt.payment_type_id
    inner join t_shipment_type st on ma.shipment_type_id = st.shipment_type_id
    left join t_prod_order pod on cont.prod_order_id = pod.prod_order_id

    left join t_purchase_order po on pod.po_id = po.po_id
        and po.is_deleted = 0
    left join t_sales_order so on ma.po_so_id = so.so_id
        and so.csc_id = $P!{cscId}
        and so.is_deleted = 0
    left join t_sales_order_det sod on pod.sod_id = sod.sod_id
        and sod.is_deleted = 0
    left join t_style rsty on cont.style_reference_no = rsty.style_reference_no
        and rsty.subarea_id = $P!{subAreaId}
        and rsty.is_deleted = 0
    left join t_inv_ship_address sadd on ma.inv_type = sadd.inv_type
        and ma.inv_id = sadd.inv_id
        and sadd.is_deleted = 0
    left join t_inv_bill_address badd on ma.inv_type = badd.inv_type
        and ma.inv_id = badd.inv_id
        and badd.is_deleted = 0
    left join t_employee emp on pd.coordinator_employee_id = emp.employee_id
    inner join t_employee sman on ma.coordinator_employee_id = sman.employee_id
    inner join t_csc ac on ma.csc_id = ac.csc_id
    inner join t_company comp on ac.company_id = comp.company_id
    inner join t_company_address coad on comp.company_id = coad.company_id
        and coad.company_address_type = 'BILL_ADDR'
    left join (
                select
                    sc.style_id style_id,
                    sum(scd.pc_count) no_of_stone,
                    sum(scd.min_total_wt) min_total_wt
                from
                    t_style_stone_card sc
                    inner join t_style_stone_card_det scd on sc.style_stone_card_id = scd.style_stone_card_id
                        and nvl(scd.min_total_wt, 0)  > 0
                        and scd.com_id not in (53)
                        and scd.is_deleted = 0
                    inner join t_style sty on sc.style_id = sty.style_id
                        and sty.subarea_id = 15
                        and sty.is_deleted = 0
                where
                    sc.is_default = 1
                    and sc.is_deleted = 0
                group by
                    sc.style_id
                union
                select
                    sc1.style_id style_id,
                    sum(scd1.pc_count) no_of_stone,
                    sum(scd1.min_total_wt) min_total_wt
                from
                    t_style_stone_card sc1
                    inner join t_style_stone_card_det scd1 on sc1.style_stone_card_id = scd1.style_stone_card_id
                        and nvl(scd1.min_total_wt, 0)> 0
                        and scd1.is_deleted = 0
                    inner join t_style sty1 on sc1.style_id = sty1.style_id
                        and sty1.subarea_id = 15
                        and sty1.is_deleted = 0
                where
                    sc1.is_default = 1
                    and sc1.is_deleted = 0
                group by
                    sc1.style_id
              ) stone on cont.style_id = stone.style_id
    left join t_design des on sty.design_id = des.design_id
        and sty.subarea_id = des.subarea_id
        and des.is_deleted = 0
    left join t_design_label dl on des.label_id = dl.label_id
        and des.subarea_id = dl.subarea_id
        and dl.is_deleted = 0

    left join t_parameter t8 on dl.brand = t8.parameter_code
        and t8.parameter_head = 'BRAND_CATEGORY'
        and t8.parameter_sub_head = 'BRAND_CATEGORY'
        and t8.subarea_id = $P!{subAreaId}
and t8.is_locked = 0
        and t8.is_deleted = 0
    left join t_jewellery_type jt on nvl(dl.jewellery_type,des.jewellery_type) = jt.jewellery_type
        and jt.is_deleted = 0
    left join t_rm_lot t9 on sty.default_metal = t9.lot_code
                    and t9.is_stone = 0
                    and t9.is_deleted = 0

where
    ma.csc_id in ($P!{cscId})
    and (ma.inv_id = $P!{invId} or -1 = $P!{invId})
    and (ma.inv_type = $P!{invType} or ' ' = $P!{invType})
order by
    ma.inv_no,
    det.inv_det_id]]>
	</queryString>
