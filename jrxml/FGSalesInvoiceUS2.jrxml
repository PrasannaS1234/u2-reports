		<band height="266" splitType="Stretch">
			<printWhenExpression><![CDATA[new Boolean((!$F{TRANS_TYPE}.equals( "MEMO" )) && !($V{PAGE_NUMBER}.intValue() != 1 && $P{reporttype}.equals( "xls" )))]]></printWhenExpression>
