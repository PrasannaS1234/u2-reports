				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
					<reportElement key="textField-2" stretchType="RelativeToTallestObject" x="0" y="192" width="220" height="13" isPrintWhenDetailOverflows="true" uuid="010e112f-7b24-47fc-8b8d-9af55c00aaed"/>
					<textElement verticalAlignment="Middle">
						<font fontName="Arial" size="8"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{BCITY}+" "+$F{BSTATE}+" "+$F{BCITY_PIN}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" isBlankWhenNull="true">
