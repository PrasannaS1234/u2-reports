				<textField isBlankWhenNull="true">
					<reportElement key="textField-37" x="0" y="13" width="587" height="25" uuid="5fe7cab8-c6e1-45ee-b0ad-e9d0e21ffc6d"/>
					<box leftPadding="1" rightPadding="1"/>
					<textElement verticalAlignment="Top">
						<font fontName="Arial" size="8"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{REMARKS}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement key="staticText-25" x="0" y="45" width="119" height="13" uuid="e84a9d33-f32e-40d0-9a4c-b653430035ff"/>
					<textElement textAlignment="Left" verticalAlignment="Middle" markup="none">
						<font fontName="Arial" size="8" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA["Disclaimer:"]]></textFieldExpression>
				</textField>
				<textField isBlankWhenNull="true">
					<reportElement key="textField-37" x="0" y="71" width="587" height="205" uuid="5fe7cab8-c6e1-45ee-b0ad-e9d0e21ffc6d"/>
					<box leftPadding="1" rightPadding="1"/>
					<textElement textAlignment="Justified" verticalAlignment="Top">
						<font fontName="Arial" size="8"/>
					</textElement>
					<textFieldExpression><![CDATA["The merchandise described and valued as above (merchandise) is delivered to you for inspection only. Title to the merchandise, except as expressly provided herein, shall at all times remain with " + $F{COMP_OFF_NAME} + ". You shall have no right, power or authority to sell, pledge, transfer, dispose or hypothecate all or any part of the Merchandise, by agreement or otherwise. You will not represent these goods to any seller as being owned by you and will inform creditors that these goods are not part of your inventory and belong to " + $F{COMP_OFF_NAME} + ".\n" +
"\n" +
"The sale of any or all of the merchandise by " + $F{COMP_OFF_NAME} + " to you shall only occur upon the rendition of an invoice by " + $F{COMP_OFF_NAME} + " to you for the merchandise. This agreement is NOT an invoice. A sale of any portion of such merchandise by " + $F{COMP_OFF_NAME} + " to you shall not affect the terms and provisions hereof with respect to the remaining merchandise in your possession on agreement. In the event that " + $F{COMP_OFF_NAME} + " sells all or any of the merchandise to you, you hereby grant " + $F{COMP_OFF_NAME} + " security interest in such Merchandise and the proceeds thereof.\n" +
"\n" +
"Upon demand, you shall immediately return the Merchandise to " + $F{COMP_OFF_NAME} + " in its original form, without substitution. While the merchandise is in your possession or that of your agents or representatives and until the merchandise is returned to " + $F{COMP_OFF_NAME} + ", you assume all risks of loss or damage to such merchandise regardless of cause. In case the seller retains account for collection of amount due under terms of this agreement the buyer agrees to pay the actual attorney’s fees or actual collection agency’s fees with interest and the costs of the court. Any discrepancies must be brought to our attention within 7 days of the invoice date, enabling us to take necessary action. Further all terms and conditions mentioned above will be deemed to be accepted unless notified in writing within 7 days of the memo date.\n" +
"\n" +
"The diamonds herein invoiced have been purchased from legitimate sources not involved in funding conflict, in compliance with United Nations Resolutions and corresponding national laws. The seller hereby guarantees that these diamonds are conflict free and confirms adherence to the World Diamond Council System of Warranties Guidelines."]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement x="0" y="58" width="587" height="13" uuid="45466bb5-c4b1-46e2-a596-61574dff01f5"/>
