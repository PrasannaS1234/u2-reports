	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="reportTitle" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
ROW_NUMBER() OVER (ORDER BY id.inv_det_id) AS sno,
im.inv_id,
concat(im.inv_type,'-',im.inv_no) as inv_no,
im.reference_no,
im.inv_dt,
cus.customer_name,
fac.factory_name,
d.department_name,
im.status,
im.remarks,
im.issue_return_type,
id.inv_det_id,
case when im.issue_return_type = 'JEWEL' then 'Job No'
when im.issue_return_type = 'SO' then 'SO No'
when im.issue_return_type = 'BAG' then 'Bag No' else ' ' end as head,
case when im.issue_return_type = 'JEWEL' then concat (jew.jew_type, jew.jew_no)
when im.issue_return_type = 'SO' then concat (so.sales_order_type, so.sales_order_no)
when im.issue_return_type = 'BAG' then concat(bag.bag_type,bag.bag_no) else ' ' end as issue_no,
lot.lot_code,
case when id.stone_size='NA' then null else id.stone_size end as stone_size,
bin.bin_name,
id.return_qty1,
id.return_qty2,
id.uom1,
id.uom2,
CASE
            WHEN COALESCE(length(trim(comp.log_url)),0) > 0 THEN
                concat('/home/ubuntu/tekfilo/jewtrade/uploads/', $P{tenant}, 'comp',im.company_id, '/company/',comp.company_id,comp.log_url)
        END AS logo_url
from tbl_mfg_rm_return im
inner join tbl_mfg_rm_return_det id on im.inv_id = id.inv_id
and id.is_deleted =0
inner join tbl_customer cus on im.customer_id = cus.customer_id
and cus.is_deleted =0
left join tbl_factory fac on im.factory_id = fac.factory_id
and fac.is_deleted =0
left join tbl_department d on im.department_id =d.department_id
and d.is_deleted =0
left join tbl_mfg_bag bag on id.bag_id = bag.bag_id
and bag.is_deleted = 0
left join tbl_sales_order_main so on id.so_id = so.sales_order_id
and so.is_deleted =0
left join tbl_jewellery jew on id.job_id = jew.jew_id
and jew.is_deleted =0
left join tbl_lot lot on id.lot_id = lot.lot_id
and lot.is_deleted =0
left join tbl_bin bin on id.bin_id = bin.bin_id
and bin.is_deleted = 0
LEFT JOIN tbl_company comp ON im.company_id = comp.company_id
 where im.inv_id = $P!{i_inv_id};]]>
	</queryString>
