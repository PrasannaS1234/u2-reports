<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PaymentReceivedRegister" pageWidth="1000" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["'%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="accountId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (partition by t.payment_id order by d.payment_det_id) sno,
	dense_rank() over (order by t.payment_id) inv_sno,
	d.payment_det_id,
	t.payment_id,
	c.display_name cus_name,
	concat(t.payment_type, '-', t.payment_no) payment_type_no,
	to_char(t.payment_dt, $P{dateFormat}) inv_dt,
	t.currency,
	t.exchange_rate,
	t.payment_mode,
	t.deposit_to,
	a.account_name,
	d.inv_id,
	d.inv_type_no,
	t.received_amount apply_amount,
	d.invoice_amount,
	d.received_amount
from
	tbl_payment_received_main t
	inner join tbl_payment_received_det d on t.payment_id = d.payment_id
		and d.is_deleted = 0
	inner join tbl_customer c on t.customer_id = c.customer_id
		and (lower(c.customer_name) like concat(lower(trim($P!{customerLike})),'%%'))
	left join tbl_account a on t.bank_cash_account_id = a.account_id
where
	t.is_deleted = 0
	and t.payment_dt >= to_date($P{fromDate}, $P{dateFormat})
    	and t.payment_dt <= to_date($P{toDate}, $P{dateFormat})
	and (a.account_id in ($P!{accountId}) or -1 in ($P!{accountId}))
order by
	t.payment_id,
	d.payment_det_id]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="inv_sno" class="java.lang.Long"/>
	<field name="payment_det_id" class="java.lang.Integer"/>
	<field name="payment_id" class="java.lang.Integer"/>
	<field name="cus_name" class="java.lang.String"/>
	<field name="payment_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="payment_mode" class="java.lang.String"/>
	<field name="deposit_to" class="java.lang.String"/>
	<field name="account_name" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="apply_amount" class="java.math.BigDecimal"/>
	<field name="invoice_amount" class="java.math.BigDecimal"/>
	<field name="received_amount" class="java.math.BigDecimal"/>
	<variable name="input_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{invoice_amount}]]></variableExpression>
	</variable>
	<variable name="received_amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{received_amount}]]></variableExpression>
	</variable>
