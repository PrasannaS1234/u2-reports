	<queryString>
		<![CDATA[SELECT
    t.inv_id,
    ROW_NUMBER() OVER (PARTITION BY t.inv_id ORDER BY det.inv_det_id ASC) AS sno,
    t.party_type,
    t.inv_dt,
t.inv_no,
    t.inv_type,
    t.REFERENCE_no,
    t.bill_address1,
    t.bill_address2,
    t.bill_city,
    t.bill_phone_no,
    t.ship_address1,
    t.ship_address2,
    t.ship_city,
    ship_phone_no,
    acc.account_name,
    det.description,
   det.amount,
    CASE
        WHEN t.party_type = 'SUPPLIER' THEN sup.supplier_name
        ELSE factory.factory_name
    END AS party_name
FROM
    tbl_credit_note_main t
    INNER JOIN tbl_credit_note_det det ON t.inv_id = det.inv_id AND det.is_deleted = 0
    LEFT JOIN tbl_supplier sup ON sup.supplier_id = t.party_id
    LEFT JOIN tbl_factory factory ON factory.factory_id = t.party_id
    LEFT JOIN tbl_account acc ON acc.account_id = det.account_id
WHERE
    t.is_deleted = 0
    AND t.inv_id = $P!{i_inv_id}
ORDER BY
    det.inv_det_id]]>
	</queryString>
