<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DemandRegister" pageWidth="1025" pageHeight="842" orientation="Landscape" columnWidth="985" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="584ec8c6-ce5d-471c-b198-86606c8bbffe">
	<property name="ireport.zoom" value="1.4641000000000006"/>
	<property name="ireport.x" value="42"/>
	<property name="ireport.y" value="0"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["'%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	tx1.sales_order_id,
	case when tx1.sr_no = 1 then tx1.so_no end so_no,
	case when tx1.sr_no = 1 then tx1.so_dt end so_dt,
	case when tx1.sr_no = 1 then tx1.customer_name end customer_name,
	case when tx1.sr_no = 1 then tx1.customer_code end customer_code,
	case when tx1.sr_no = 1 then tx1.customer_order_no end customer_order_no ,
	case when tx1.sr_no = 1 then to_char(tx1.delivery_date,$P{dateFormat}) end delivery_date,
	case when tx1.sr_no = 1 then tx1.qty end qty,
	tx1.lot_code,
	tx1.description,
	tx1.commodity_name,
	tx1.shape_name,
	tx1.cut_name,
	tx1.color_name,
	tx1.clarity_name,
	tx1.cts,
	tx1.pcs
from
(
select
	so.sales_order_id,
	row_number() over(partition by so.sales_order_id order by soc.component_id asc ) sr_no,
	concat(so.sales_order_type,'-',so.sales_order_no)	so_no,
	to_char(so.sales_order_date,'dd/MM/yyyy') so_dt,
	tcus.customer_name,
	tcus.display_name customer_code,
	sod.customer_order_no,
	so.delivery_date,
	sod.qty,
	lot.lot_code,
	lot.description,
	com.commodity_name,
	sh.shape_name,
	cut.cut_name,
	color.color_name,
	clarity.clarity_name,
	sod.qty * soc.qty1 cts,
	sod.qty * soc.qty2	pcs
from
	tbl_sales_order_main so
	inner join tbl_customer tcus on so.customer_id = tcus.customer_id
		and (lower(tcus.customer_name) like concat(lower(trim($P!{customerLike})),'%%'))
	inner join tbl_sales_order_det sod on so.sales_order_id = sod.sales_order_id
		and sod.is_deleted = 0
	inner join tbl_sales_order_component soc on sod.sales_order_det_id = soc.sales_order_det_id
		and sod.sales_order_id = soc.sales_order_id
		and soc.is_deleted = 0
	left join tbl_lot lot on soc.lot_id = lot.lot_id
	left join tbl_commodity com on soc.commodity_id = com.commodity_id
	left join tbl_commodity_group cg on com.commodity_group_id = cg.commodity_group_id
	left join tbl_shape sh on soc.shape_id = sh.shape_id
	left join tbl_cut cut on soc.cut_id = cut.cut_id
	left join tbl_color color on soc.color_id = color.color_id
	left join tbl_clarity clarity on soc.clarity_id = clarity.clarity_id
where
	so.is_deleted = 0
 	and so.sales_order_date >= to_date($P{fromDate}, $P{dateFormat})
    	and so.sales_order_date <= to_date($P{toDate}, $P{dateFormat})
   	and (soc.commodity_id  in ($P!{commodityId}) or -1 in ($P!{commodityId}))
    	and (cg.commodity_group_id  in ($P!{commodityGroupId}) or -1 in ($P!{commodityGroupId}))
	and (lot.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
) tx1
order by
	tx1.sales_order_id asc]]>
	</queryString>
