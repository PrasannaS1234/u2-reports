	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[with dt as (
		select row_number() over (order by  id.inv_det_id) srno,
    im.inv_id,
    prod.lot_code product_no,
    im.currency,
    id.uom1,
    id.uom2,
    id.lot_description prod_description,
    id.inv_qty1,
    id.inv_qty2,
    id.input_rate,
    id.input_amt,
    id.discount_type,
    id.discount_value
from
    tbl_sales_invoice_main im
    inner join tbl_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_lot prod on id.lot_id = prod.lot_id

where
    im.is_deleted = 0
    and im.inv_id = $P!{invId}),
dm as
(
select  generate_series(1,1000) srno
)
select
dt.*
from
dm left join dt on dm.srno = dt.srno
where
(dt.srno is not null or dm.srno <= 6
)]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="product_no" class="java.lang.String"/>
		<field name="currency" class="java.lang.String"/>
		<field name="uom1" class="java.lang.String"/>
		<field name="uom2" class="java.lang.String"/>
		<field name="prod_description" class="java.lang.String"/>
		<field name="inv_qty1" class="java.math.BigDecimal"/>
		<field name="inv_qty2" class="java.math.BigDecimal"/>
		<field name="input_rate" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<field name="discount_type" class="java.lang.String"/>
		<field name="discount_value" class="java.math.BigDecimal"/>
		<variable name="QTY" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<variable name="qty2" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="f2523445-e3c7-4637-a9da-0e96129f78c0">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
        0 sort_seq,
        sal_chg.charge_name,
        sal_chg.plus_minus_flag * input_amt amount
    from
        tbl_sales_invoice_chgs sal_chg
    where
        sal_chg.is_deleted = 0
        and sal_chg.inv_id = $P!{invId}
    union all
    select
        1 sort_seq,
        'Total',
        im.total_invoice_amount
    from
        tbl_sales_invoice_main im
    where
        im.is_deleted = 0
        and im.inv_id = $P!{invId}
     order by
        sort_seq]]>
		</queryString>
		<field name="sort_seq" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
    max(tcomp.company_name) company_name,
    max(im.inv_id) inv_id,
    max(im.inv_type) inv_type,
    max(im.inv_type||'-'||im.inv_no) inv_type_no,
    to_char(max(im.inv_dt), 'dd/mm/yyyy') inv_dt,
    to_char(max(im.inv_due_dt), 'dd/mm/yyyy')     inv_due_dt,
    max(im.currency) currency,
    max(im.exchange_rate) exchange_rate,
    max(im.reference_no) reference_no,
    max(tcus.customer_name) customer_name,
    max(coalesce(im.bill_address1,'')) bill_addr1,
    max(coalesce(im.bill_address2,'')) bill_addr2,
    max(coalesce(im.bill_country,'')) bill_country,
    max(coalesce(im.bill_state,'')) bill_state,
    max(coalesce(im.bill_city,'')) bill_city,
    max(coalesce(im.bill_street,'')) bill_street,
    max(coalesce(im.bill_pincode,'')) bill_pincode,

max(coalesce(im.ship_address1,'')) ship_addr1,
    max(coalesce(im.ship_address2,'')) ship_addr2,
    max(coalesce(im.ship_country,'')) ship_country,
    max(coalesce(im.ship_state,'')) ship_state,
    max(coalesce(im.ship_city,'')) ship_city,
    max(coalesce(im.ship_street,'')) ship_street,
    max(coalesce(im.ship_pincode,'')) ship_pincode,

    max(coalesce(tcomp.street,'')) || ',' || max(coalesce(tcomp.area,'')) || ', ' ||
    max(coalesce(tcomp.city,'')) || ', ' ||
    max(coalesce(tcomp.state,'')) || '- ' || max(coalesce(tcomp.pin_code,'')) address,

max(coalesce(tcomp.street,'')) addressline1,
max(coalesce(tcomp.area,'')) addressline2,
    max(coalesce(tcomp.city,'')) addressline3,
    max(coalesce(tcomp.state,'')) addressline4,
max(coalesce(tcomp.pin_code,'')) addressline5,

max(coalesce(tcomp.email,'')) com_email,
max(coalesce(tcomp.phone_number,'')) com_phone_no,
max(coalesce(tcomp.website,'')) com_webiste,

    max(coalesce(tcomp.payment_address,'')) payment_address,
    max(coalesce(im.terms_conditions,'')) terms_conditions,
    max(im.total_invoice_amount) grossAmount,
    spellNumericValue(im.total_invoice_amount,im.currency) amount_to_words
from
    tbl_sales_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_customer tcus on im.customer_id = tcus.customer_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
group by
    im.inv_id,
    im.inv_type]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="inv_due_dt" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
