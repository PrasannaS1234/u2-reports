					</textElement>
					<textFieldExpression><![CDATA[$F{stock_code} + " Total "]]></textFieldExpression>
				</textField>
				<textField pattern="###0.000" isBlankWhenNull="true">
					<reportElement mode="Opaque" x="500" y="0" width="100" height="20" backcolor="#ECECEC" uuid="f8a1cadb-c944-4fd3-a7cf-5eafe1e02a1e"/>
					<box leftPadding="2" rightPadding="2"/>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Arial" size="9" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$V{inv_qty2_1}]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
