<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FinvByStockCode" pageWidth="650" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="610" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0245201830476058"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="departmentId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (partition by grp order by grp, stock_code) sno,
	tx.grp,
	tx.company_name,
	tx.factory_name,
	tx.department_name,
	tx.lot_code,
	tx.stock_code,
	tx.job_no,
	tx.bag_no,
	sum(tx.qty1) qty1,
	sum(tx.qty2) qty2
from (
select
coalesce(nullif(concat(j.jew_type,j.jew_no,bag.bag_type,bag.bag_no),''), coalesce(l.custom_no, l.lot_code))  grp,
c.company_name,
f.factory_name,
d.department_name,
l.lot_code,
coalesce(l.custom_no, l.lot_code) stock_code,
concat(j.jew_type,j.jew_no) job_no,
concat(bag.bag_type,bag.bag_no) bag_no,
t.qty1,
t.qty2
from
(
	select
		ic.component_id,
		i.company_id,
		i.factory_id,
		i.department_id,
		id.bag_id,
		id.job_id,
		ic.lot_id,
		ic.stone_size,
		ic.consumed_qty1 qty1,
		ic.consumed_qty2 qty2
	from
		tbl_mfg_factory_invoice_main i
		inner join tbl_mfg_factory_invoice_det id on i.inv_id = id.inv_id
			and id.is_deleted = 0
		inner join tbl_mfg_factory_invoice_component ic on id.inv_det_id = ic.inv_det_id
			and ic.is_deleted = 0
	where
		i.is_deleted = 0
		and i.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
		and i.inv_dt <= to_date($P{toDate}, $P{dateFormat})
) t
inner join tbl_company c on t.company_id = c.company_id
inner join tbl_factory f on t.factory_id = f.factory_id
inner join tbl_department d on t.department_id = d.department_id
inner join tbl_lot l on t.lot_id = l.lot_id
inner join tbl_commodity comm on l.commodity_id = comm.commodity_id
left join tbl_jewellery j on t.job_id = j.jew_id
left join tbl_mfg_bag bag on t.bag_id = bag.bag_id
where 1 = 1
and t.company_id in ($P!{loginCompanyId})
)tx
group by
tx.grp,
tx.company_name,
tx.factory_name,
tx.department_name,
tx.lot_code,
tx.stock_code,
tx.job_no,
tx.bag_no
order by
tx.bag_no,
tx.job_no,
tx.grp,
tx.stock_code]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="grp" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="department_name" class="java.lang.String"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="stock_code" class="java.lang.String"/>
	<field name="job_no" class="java.lang.String"/>
	<field name="bag_no" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<variable name="inv_qty1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GRP-2" calculation="Sum">
		<variableExpression><![CDATA[$F{qty1}]]></variableExpression>
	</variable>
	<variable name="inv_qty2_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GRP-2" calculation="Sum">
		<variableExpression><![CDATA[$F{qty2}]]></variableExpression>
	</variable>
	<group name="GRP-1">
		<groupExpression><![CDATA[$F{grp}]]></groupExpression>
