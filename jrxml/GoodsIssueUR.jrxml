	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    ma.inv_type||'-'||ma.inv_no main_qr_code,
    ma.inv_id,
    ma.inv_no,
    ma.inv_type,
    coalesce(ma.description,ma.remarks) off_ref_no,
    to_char(ma.inv_dt,$P{dateFormat}) inv_dt,
	ma.issue_return_type issue_against,
	pd.factory_name factory_name,
	fd.address1 fac_address1,
	fd.address2 fac_address2,
    	fd.street fac_street,
	fd.area fac_area,
    	fd.city fac_city,
	fd.pin_code fac_pincode,

	fd.address1	bill_address1,
     	fd.address2	bill_address2,
     	concat(fd.country,' ',fd.state,' ',fd.pin_code) bill_address3,
	concat('PH:-',pd.primary_contact_no) primary_contact_no,
	concat('ATTN:-',pd.primary_contact_name) primary_contact_name,
	upper(comp.company_name) comp_off_name,
    	comp.street,
	comp.area,
    	comp.city,
	comp.pin_code,
	comp.fax_no phone_fax,
	comp.phone_number,
	COALESCE(nullif(concat(pod.sales_order_type,'-',pod.sales_order_no),'-'),
	concat(cont.jew_type,cont.jew_no))  issue_against_no,
	t9.lot_code,
	t9.description,
	col.color_name,
	sh.shape_name,
	NULLIF(det.stone_size,'NA') STONE_SIZE,
	det.mm_size,
	det.qty1,
	det.qty2,
	det.rate,
	det.amount as amt,
    	upper(comp.company_name) comp_off_name,
    	CONCAT(comp.area,',',comp.street) comp_area,
    	concat(comp.city,',',upper(st.state_name),',',upper(tc.country_name)) comp_state_name,
    	concat('Tel:',comp.phone_number,' Fax:',comp.fax_no) comp_contact,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',comp.company_id,'/company/',comp.company_id,comp.log_url)	comp_logo
from
    tbl_goods_issue_main ma
    inner join tbl_goods_issue_det det on ma.inv_id = det.inv_id
		and det.is_deleted = 0
	inner join tbl_company comp on ma.company_id = comp.company_id
    inner join tbl_lot t9 on det.lot_id = t9.lot_id
    left join tbl_lot_price_det lpd on t9.lot_id = lpd.lot_id
	and ma.company_id = lpd.company_id
	and lpd.is_deleted = 0
    inner join tbl_factory pd on ma.factory_id = pd.factory_id
	left join tbl_factory_address fd on ma.factory_id = fd.factory_id
		and fd.is_deleted = 0
		and lower(fd.address_type) = 'billing'
		and fd.default_address = 1
    left join tbl_jewellery cont on det.jew_id = cont.jew_id
    left join tbl_sales_order_main pod on det.so_id = pod.sales_order_id
    left join tbl_color col on t9.color_id = col.color_id
    left join tbl_shape sh on t9.shape_id = sh.shape_id
    LEFT JOIN tbl_country tc ON comp.country_id = tc.country_id
    left join tbl_state st on comp.state = st.state_code
where
	ma.inv_id = $P!{i_inv_id}
	and ma.is_deleted = 0
ORDER BY
	det.inv_det_id]]>
	</queryString>
