	<field name="inv_total_words" class="java.lang.String"/>
	<variable name="gross_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="purity_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{pure_wt}]]></variableExpression>
	</variable>
	<variable name="making_wt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{metal_value_usd}]]></variableExpression>
	</variable>
	<variable name="making_value" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{making_value_usd}]]></variableExpression>
	</variable>
	<variable name="metal_value" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{metal_value_usd}]]></variableExpression>
	</variable>
	<variable name="total_value" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{line_total_usd}]]></variableExpression>
	</variable>
