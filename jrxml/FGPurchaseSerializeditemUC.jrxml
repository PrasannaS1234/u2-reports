<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGPurchaseInvoicewithImageSuraj" pageWidth="630" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="610" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="9ad6d883-1638-4ddd-b4d4-9debcc20f6c2">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH base AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY im.inv_id, id.inv_det_id) AS inv_sno,
        tcomp.company_name AS company_name,
        im.inv_id          AS inv_id,
         COALESCE(
        NULLIF(fn_get_customer_invoice_no(im.inv_type, im.inv_id), ''),
        concat(im.inv_type, '-', im.inv_no)) AS inv_type_no,
        TO_CHAR(im.inv_dt, COALESCE(tcomp.date_format, 'dd/MM/yyyy')) AS inv_dt,
        im.remarks,
        im.created_dt timee,
        TO_CHAR(im.created_dt, 'DD/MM/YY HH:MI:SSPM') AS tme,
        CONCAT(im.currency, ' ', '@', ' ', im.exchange_rate) AS ac_currency,
        c.currency_code,
        tsup.display_name AS supplier_dis_name,
        tsup.supplier_name as supplier_name,
        tadd.address1,
        tadd.address2,
        im.reference_no,
 concat(prp.first_name,' ',prp.last_name) as prepare_by,
        CONCAT(j.jew_type, j.jew_no) AS jew_no,
        pt.product_type_name description,
        sku.sku_no,
        det.gross_wt AS gross_wt,
        tj.purity,
        Round(COALESCE(det.gross_wt, 1) * COALESCE(tj.purity, 1),3) AS pure_wt,
        round(CASE
            WHEN im.currency = 'USD' THEN det.labour_rate
            ELSE det.labour_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
        END,2)  making_rate_usd,
        round((COALESCE(det.gross_wt, 1) *
        CASE
            WHEN im.currency = 'USD' THEN det.labour_rate
            ELSE det.labour_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
        END),2)  making_value_usd,
       round(CASE
            WHEN im.currency = 'USD' THEN det.metal_rate
            ELSE det.metal_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
        END,2) metal_rate,
       round( COALESCE(det.gross_wt, 1)
        * COALESCE(tj.purity, 1)
        * COALESCE(
            CASE
                WHEN im.currency = 'USD' THEN det.metal_rate
                ELSE det.metal_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
            END, 0
          ),2)AS metal_value_usd,
       round( (
            COALESCE(det.gross_wt, 1)
            * COALESCE(tj.purity, 1)
            * COALESCE(
                CASE
                    WHEN im.currency = 'USD' THEN det.metal_rate
                    ELSE det.metal_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
                END, 0
              )
        )
        +
                (COALESCE(det.gross_wt, 1) *
        CASE
            WHEN im.currency = 'USD' THEN det.labour_rate
            ELSE det.labour_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
        END),2) AS line_total_usd,
		payment.paid_amount,
        CASE
            WHEN COALESCE(LENGTH(TRIM(j.image_url)), 0) > 0 THEN
                CONCAT(
                    '/home/ubuntu/tekfilo/jewtrade/uploads/',
                    $P{tenant},
                    'comp', im.company_id,
                    '/jewellery/',
                    j.jew_id,
                    j.image_url
                )
            ELSE
                CONCAT(
                    '/home/ubuntu/tekfilo/jewtrade/uploads/',
                    $P{tenant},
                    'comp', im.company_id,
                    '/sku/',
                    sku.sku_id,
                    sku.image_url
                )
        END AS img_url,
        CASE
            WHEN COALESCE(LENGTH(TRIM(tcomp.log_url)), 0) > 0 THEN
                CONCAT(
                    '/home/ubuntu/tekfilo/jewtrade/uploads/',
                    $P{tenant},
                    'comp', im.company_id,
                    '/company/',
                    tcomp.company_id,
                    tcomp.log_url
                )
        END AS logo_url
    FROM tbl_jew_purchase_invoice_main im
    INNER JOIN tbl_jew_purchase_invoice_det id
        ON im.inv_id = id.inv_id
       AND id.is_deleted = 0
	left join tbl_jew_purchase_invoice_jewel_detail det on im.inv_id = id.inv_id
and id.inv_det_id = det.inv_det_id
    INNER JOIN tbl_company tcomp
        ON im.company_id = tcomp.company_id
    INNER JOIN tbl_jewellery j
        ON id.jew_id = j.jew_id
       AND j.is_deleted = 0
left join tbl_user prp on im.created_by = prp.user_id and prp.is_deleted=0
left join tbl_currency c on im.currency = c.currency_code and c.is_deleted =0
left join tbl_product_type pt on j.product_type_id = pt.product_type_id
	and pt.is_deleted = 0
    LEFT JOIN (
        SELECT DISTINCT ON (jc.jew_id)
               jc.jew_id,
               jc.pp_rate,
               l.impure_to_pure_conv_factor AS purity
        FROM tbl_jewellery_component jc
        LEFT JOIN tbl_lot l
            ON jc.lot_id = l.lot_id
           AND l.is_deleted = 0
and l.lot_type = 'METAL'
        ORDER BY jc.jew_id
    ) tj
        ON j.jew_id = tj.jew_id
    LEFT JOIN (
        SELECT DISTINCT ON (jew_id)
               jew_id,
               rate,
               amount
        FROM tbl_jewellery_labour
        WHERE is_deleted = 0
        ORDER BY jew_id
    ) jl
        ON j.jew_id = jl.jew_id
    LEFT JOIN tbl_sku sku
        ON j.sku_id = sku.sku_id
       AND sku.is_deleted = 0
    INNER JOIN tbl_country tcou
        ON tcomp.country_id = tcou.country_id
    INNER JOIN tbl_supplier tsup
        ON im.supplier_id = tsup.supplier_id
    left JOIN (
        SELECT DISTINCT ON (supplier_id)
               supplier_id,
               address1,
               address2
        FROM tbl_supplier_address
        WHERE is_deleted = 0
          AND address_type = 'Billing'
        ORDER BY supplier_id
    ) tadd
        ON tsup.supplier_id = tadd.supplier_id

	left join (
	select
		p.inv_id,
		case when max(pm.currency) ='USD' then sum(p.paid_amount) else  sum(p.paid_amount) * max(pm.exchange_rate)
		end as paid_amount
		from tbl_payment_paid_det p
		inner join tbl_payment_paid_main pm on p.payment_id = pm.payment_id
		and pm.is_deleted =0
		where p.is_deleted = 0
		group by p.inv_id
	)payment on payment.inv_id = im.inv_id
    INNER JOIN tbl_payment_type pyt
        ON im.payment_type_id = pyt.payment_type_id
    WHERE im.is_deleted = 0
      AND im.inv_id IN ($P!{i_inv_id})
)
SELECT
    base.*,
  SUM(base.line_total_usd) OVER (PARTITION BY base.inv_id) AS inv_total_usd,
	ROUND(TRUNC((SUM(base.line_total_usd) OVER (PARTITION BY base.inv_id)), 0),2)  AS inv_total_usd_roundoff,
    COALESCE(
    fn_amount_to_words(
        FLOOR(
            SUM(base.line_total_usd) OVER (PARTITION BY base.inv_id)
        ),
        ''::varchar,
        '',
        ''
    ) || ' only',
    ''
) AS inv_total_words
FROM base
ORDER BY base.inv_id, base.inv_sno;]]>
	</queryString>
