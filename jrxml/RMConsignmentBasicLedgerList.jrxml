<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RMConsignmentBasicLedgerlList" pageWidth="1700" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1690" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="88ac9fd1-ed7b-42c0-81b9-2065444fdf18">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="outStanding" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String"/>
	<parameter name="lotCodes" class="java.lang.String"/>
	<parameter name="invNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="asOnDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/04/2025"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="currency_1" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[WITH base_data AS (
    SELECT
        im.inv_id,
        im.inv_type,
        fn_get_customer_invoice_no(im.inv_type, im.inv_id) AS cus_doc_type,
        case when COALESCE(msrd.inv_qty1,0) > 0 then fn_get_customer_invoice_no(msrm.inv_type, msrm.inv_id) else fn_get_customer_invoice_no(sm.inv_type, sm.inv_id) end reference_no,
        im.company_id,
        im.customer_id,
        im.inv_no,
        im.inv_dt,
        im.currency,
        im.exchange_rate,
        tcomp.company_name,
        tcomp.street,
        tcomp.area,
        tcomp.city,
        tcomp.pin_code,
        tcomp.state AS state_code,
        tcomp.country_id,
        tcus.customer_name,
        lot.commodity_id,
        com.commodity_name,
        selcus.customer_name AS selected_customer_name,
        -- Fetch once per invoice
        COALESCE(fn_get_exchange_rate(
            tcomp.company_id,
            TO_CHAR(im.inv_dt, $P{dateFormat}),
            $P{dateFormat},
            $P!{currency}
        ), im.exchange_rate) AS report_exch_rate,

        id.inv_qty1 AS issue_qty1,
        id.inv_qty2 AS issue_qty2,
        id.input_amt AS issue_amt,

        sd.inv_qty1 AS confirm_qty1,
        sd.inv_qty2 AS confirm_qty2,
        sd.input_amt AS confirm_amt,

        msrd.inv_qty1 AS return_qty1,
        msrd.inv_qty2 AS return_qty2,
        msrd.input_amt AS return_amt

    FROM tbl_memo_sales_invoice_main im
    JOIN tbl_memo_sales_invoice_det id
        ON im.inv_id = id.inv_id
       AND id.is_deleted = 0
    LEFT JOIN tbl_sales_invoice_det sd
        ON sd.ref_inv_id = id.inv_id
       AND sd.ref_inv_det_id = id.inv_det_id
       AND sd.ref_inv_type = im.inv_type
       AND sd.is_deleted = 0
    LEFT JOIN tbl_sales_invoice_main sm
        ON sm.inv_id = sd.inv_id
       AND sm.is_deleted = 0
    LEFT JOIN tbl_memo_sales_return_invoice_det msrd
        ON msrd.ref_inv_id = id.inv_id
       AND msrd.ref_inv_det_id = id.inv_det_id
       AND msrd.ref_inv_type = im.inv_type
       AND msrd.is_deleted = 0
    left join tbl_memo_sales_return_invoice_main msrm on msrd.inv_id = msrm.inv_id
	    and msrm.is_deleted = 0
    JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
    JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
    JOIN tbl_lot lot ON id.lot_id = lot.lot_id
    JOIN tbl_commodity com ON lot.commodity_id = com.commodity_id
    LEFT JOIN tbl_state state ON tcomp.state = state.state_code
    LEFT JOIN tbl_country c ON tcomp.country_id = c.country_id
    LEFT JOIN tbl_customer selcus ON selcus.customer_id = $P!{customerId}
    WHERE im.is_deleted = 0
      AND (im.inv_dt IS NULL OR im.inv_dt <= TO_DATE($P{asOnDate}, $P{dateFormat}))
)

SELECT
    ROW_NUMBER() OVER (ORDER BY MAX(b.inv_id)) AS sno,
    MAX(b.inv_id) AS inv_id,
    MAX(b.cus_doc_type) AS cus_doc_type,
    MAX(b.reference_no) AS reference_no,
    TO_CHAR(CURRENT_DATE, 'dd/mm/yyyy') AS date,
    MAX(b.company_name) AS company_name,
    MAX(b.street) AS addressLine2,
    MAX(b.area) AS addressLine3,
    MAX(b.city) AS addressLine4,
    MAX(b.pin_code) AS addressLine5,
    MAX(COALESCE(state.state_name, '') || ', ' || COALESCE(c.country_name, '')) AS addressLine6,
    MAX(b.company_id) AS company_id,
    MAX(b.selected_customer_name) AS selected_customer_name,
    MAX(b.inv_type || '-' || b.inv_no) AS inv_type_no,
    TO_CHAR(MAX(b.inv_dt), 'dd/mm/yyyy') AS inv_dt,
    MAX(b.customer_name) AS customer_name,
    MAX(b.commodity_name) AS commodity_name,
    $P!{currency} AS currency,
    MAX(b.report_exch_rate) AS exchange_rate,
    SUM(COALESCE(b.issue_qty1,0)) AS issue_qty1,
    SUM(COALESCE(b.issue_qty2,0)) AS issue_qty2,

    -- Issue total
    CASE
        WHEN $P!{currency} = 'USD' THEN
            SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.issue_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.issue_amt,0)
                END
            )
        ELSE
            ROUND(SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.issue_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.issue_amt,0)
                END
            ),2)
    END AS issue_total_amt,

    SUM(COALESCE(b.confirm_qty1,0)) AS confirm_qty1,
    SUM(COALESCE(b.confirm_qty2,0)) AS confirm_qty2,

    -- Confirm total
    CASE
        WHEN $P!{currency} = 'USD' THEN
            SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.confirm_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.confirm_amt,0)
                END
            )
        ELSE
            ROUND(SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.confirm_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.confirm_amt,0)
                END
            ),2)
    END AS confirm_total_amt,

    SUM(COALESCE(b.return_qty1,0)) AS return_qty1,
    SUM(COALESCE(b.return_qty2,0)) AS return_qty2,

    -- Return total
    CASE
        WHEN $P!{currency} = 'USD' THEN
            SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.return_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.return_amt,0)
                END
            )
        ELSE
            ROUND(SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.return_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.return_amt,0)
                END
            ),2)
    END AS return_total_amt,

    -- Balance quantities
    (SUM(COALESCE(b.issue_qty1,0)) - SUM(COALESCE(b.confirm_qty1,0)) - SUM(COALESCE(b.return_qty1,0))) AS balance_qty1,
    (SUM(COALESCE(b.issue_qty2,0)) - SUM(COALESCE(b.confirm_qty2,0)) - SUM(COALESCE(b.return_qty2,0))) AS balance_qty2,

    -- Balance total
    CASE
        WHEN $P!{currency} = 'USD' THEN
            SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.issue_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.issue_amt,0)
                END
            )
            - SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.confirm_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.confirm_amt,0)
                END
            )
            - SUM(
                CASE
                    WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                        THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                    WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                        THEN COALESCE(b.return_amt,0) * b.report_exch_rate
                    WHEN b.currency <> $P!{currency}
                        THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                    ELSE COALESCE(b.return_amt,0)
                END
            )
        ELSE
            ROUND(
                SUM(
                    CASE
                        WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                            THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                        WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                            THEN COALESCE(b.issue_amt,0) * b.report_exch_rate
                        WHEN b.currency <> $P!{currency}
                            THEN COALESCE(b.issue_amt,0) / b.report_exch_rate
                        ELSE COALESCE(b.issue_amt,0)
                    END
                )
                -
                SUM(
                    CASE
                        WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                            THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                        WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                            THEN COALESCE(b.confirm_amt,0) * b.report_exch_rate
                        WHEN b.currency <> $P!{currency}
                            THEN COALESCE(b.confirm_amt,0) / b.report_exch_rate
                        ELSE COALESCE(b.confirm_amt,0)
                    END
                )
                -
                SUM(
                    CASE
                        WHEN $P!{currency} = 'USD' AND b.currency <> 'USD'
                            THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                        WHEN $P!{currency} <> 'USD' AND b.currency = 'USD'
                            THEN COALESCE(b.return_amt,0) * b.report_exch_rate
                        WHEN b.currency <> $P!{currency}
                            THEN COALESCE(b.return_amt,0) / b.report_exch_rate
                        ELSE COALESCE(b.return_amt,0)
                    END
                ),
            2)
    END AS balance_total_amt

FROM base_data b
LEFT JOIN tbl_state state ON b.state_code = state.state_code
LEFT JOIN tbl_country c ON b.country_id = c.country_id
where 1 = 1
     and (cus_doc_type IN ($P!{invNos}) or ' ' in ($P!{invNos}))
     and CASE
        WHEN $P!{outStanding} = 1 THEN
            ((COALESCE(b.issue_qty1,0)) - (COALESCE(b.confirm_qty1,0)) - (COALESCE(b.return_qty1,0))) > 0
        ELSE TRUE
    END
GROUP BY b.inv_id, b.inv_type
ORDER BY cus_doc_type;]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="cus_doc_type" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="date" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="addressline2" class="java.lang.String"/>
	<field name="addressline3" class="java.lang.String"/>
	<field name="addressline4" class="java.lang.String"/>
	<field name="addressline5" class="java.lang.String"/>
	<field name="addressline6" class="java.lang.String"/>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="selected_customer_name" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="issue_qty1" class="java.math.BigDecimal"/>
	<field name="issue_qty2" class="java.math.BigDecimal"/>
	<field name="issue_total_amt" class="java.math.BigDecimal"/>
	<field name="confirm_qty1" class="java.math.BigDecimal"/>
	<field name="confirm_qty2" class="java.math.BigDecimal"/>
	<field name="confirm_total_amt" class="java.math.BigDecimal"/>
	<field name="return_qty1" class="java.math.BigDecimal"/>
	<field name="return_qty2" class="java.math.BigDecimal"/>
	<field name="return_total_amt" class="java.math.BigDecimal"/>
	<field name="balance_qty1" class="java.math.BigDecimal"/>
	<field name="balance_qty2" class="java.math.BigDecimal"/>
	<field name="balance_total_amt" class="java.math.BigDecimal"/>
	<variable name="issue_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_qty1}]]></variableExpression>
	</variable>
	<variable name="issue_total_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_total_amt}]]></variableExpression>
	</variable>
	<variable name="confirm_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{confirm_qty1}]]></variableExpression>
	</variable>
	<variable name="confirm_total_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{confirm_total_amt}]]></variableExpression>
	</variable>
	<variable name="retrun_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{return_qty1}]]></variableExpression>
	</variable>
	<variable name="return_total_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{return_total_amt}]]></variableExpression>
	</variable>
	<variable name="balance_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_qty1}]]></variableExpression>
	</variable>
	<variable name="balance_total_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_total_amt}]]></variableExpression>
	</variable>
