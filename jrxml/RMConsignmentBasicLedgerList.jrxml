	<columnHeader>
		<band height="44" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="1247" y="22" width="102" height="22" backcolor="#CCCCCC" uuid="205f6442-ba89-4031-be5f-8405712aba77"/>
				<box leftPadding="2">
					<pen lineWidth="0.5"/>
					<topPen lineWidth="0.5"/>
					<leftPen lineWidth="0.5"/>
					<bottomPen lineWidth="0.5"/>
					<rightPen lineWidth="0.5"/>
