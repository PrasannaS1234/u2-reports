<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Ledger_Detail" pageWidth="880" pageHeight="880" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="852" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" isIgnorePagination="true" uuid="88c5cf92-5562-4017-aabf-9cf0a225cbcc">
	<property name="ireport.scriptlethandling" value="0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.xls.white.page.background" value="0"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<style name="StyleBold">
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean($F{particulars}.equals( "Opening Balance" ))]]></conditionExpression>
			<style forecolor="#000000" backcolor="#FFFFFF" markup="styled" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" isPdfEmbedded="false">
				<box leftPadding="1" rightPadding="1"/>
			</style>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean(($F{vou_status}.toUpperCase()).contains( "NOTDONE" ))]]></conditionExpression>
			<style forecolor="#FF0000" fill="Solid" markup="none" fontName="Arial" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" isPdfEmbedded="true"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[new Boolean(($F{vou_status}.toUpperCase()).contains( "DONE" ))]]></conditionExpression>
			<style forecolor="#3333FF" fill="Solid" markup="none" fontName="Arial" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" isPdfEmbedded="true"/>
		</conditionalStyle>
	</style>
	<parameter name="accountCode" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'28/08/2020'"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'28/08/2050'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["'DD/MM/YYYY'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String"/>
	<parameter name="subgroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="groupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="accountId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with accfil as
(
   select
       acc.*
   from
       tbl_account acc
        inner join tbl_sub_group sg on acc.subgroup_id = sg.subgroup_id
		inner join tbl_group grp on sg.group_id = grp.group_id
		inner join tbl_schedule st on grp.schedule_id = st.schedule_id
     where
          acc.is_deleted = 0
	and (sg.subgroup_id in ($P!{subgroupId}) or -1 in ($P!{subgroupId}))
	and (grp.group_id in ($P!{groupId}) or -1 in ($P!{groupId}))
	and (acc.account_id in ($P!{i_inv_id}) or -1 in ($P!{i_inv_id}))
	and (acc.account_id in ($P!{accountId}) or -1 in ($P!{accountId}))
),
voudet as(
	select
		t2.posting_det_id,
		case
    -- Same currency, no conversion
    when t1.currency = $P!{currency} then t2.amount

    -- USD to non-USD
    when t1.currency = 'USD' and $P!{currency} <> 'USD' then
        round(t2.amount * COALESCE(fn_get_exchange_rate(t1.company_id, to_char(t1.inv_dt,'dd/MM/yyyy'), 'dd/MM/yyyy', $P!{currency}), t1.exchange_rate), 2)

    -- Non-USD to USD
    when t1.currency <> 'USD' and $P!{currency} = 'USD' then
        round(t2.amount / nullif(COALESCE(fn_get_exchange_rate(t1.company_id, to_char(t1.inv_dt,'dd/MM/yyyy'), 'dd/MM/yyyy', t1.currency), t1.exchange_rate), 0), 2)

    -- Non-USD to Non-USD
    when t1.currency <> $P!{currency} then
        round(
            t2.amount / nullif(COALESCE(fn_get_exchange_rate(t1.company_id, to_char(t1.inv_dt,'dd/MM/yyyy'), 'dd/MM/yyyy', t1.currency), t1.exchange_rate), 0)
            * COALESCE(fn_get_exchange_rate(t1.company_id, to_char(t1.inv_dt,'dd/MM/yyyy'), 'dd/MM/yyyy', $P!{currency}), 1),
            2
        )
end as disp_amount

	from
		tbl_account_posting_main t1
		inner join tbl_account_posting_det t2 on t1.posting_id = t2.posting_id
			and t2.is_deleted = 0
		inner join accfil on t2.account_id = accfil.account_id
	where
		1 = 1
		and t1.inv_dt <= to_date($P!{toDate}, $P!{dateFormat})

)
select
    temp.acc_id,
    temp.acc_desc,
	to_char(temp.inv_dt, $P!{dateFormat})   inv_dt_FRM,
	temp.inv_dt ,
    temp.csc_code company_name,
    temp.voucher_id ,
    temp.vou_no ,
    temp.vou_status ,
    temp.reference_no,
    temp.particulars,
    temp.debit_amt,
    temp.credit_amt,
    nullif(round(sum(temp.op_bal_amt + temp.debit_amt - temp.credit_amt)
				 over (partition by temp.acc_desc order by temp.acc_desc, inv_dt nulls first, temp.voucher_id, temp.cost_category_id,temp.sort_seq, temp.cost_center_name, temp.debit_credit desc),2),0) ROW_BAL_AMT,
    temp.cost_category_name,
    temp.cost_center_name ,
    temp.debit_credit,
    temp.amount,
    temp.sort_seq
from
    (
        select
            max(accfil.account_id) acc_id,
            accfil.account_name || ' (' || accfil.account_code || ')' acc_desc,
            null inv_dt,
            null csc_code,
            -1 		voucher_id,
            null 	vou_no,
            null 	reference_no,
            'Opening Balance' particulars,
	round(sum(v.disp_amount * t2.in_out_flag),2) op_bal_amt,
            0 debit_amt,
            0 credit_amt,
            null cost_category_name,
            null cost_center_name,
            null debit_credit,
            CAST(NULL AS bigint) amount,
        	-2 cost_category_id,
            'POSTED'	vou_status,
            1 sort_seq
   from
            tbl_account_posting_main t1
            inner join tbl_account_posting_det t2 on t1.posting_id = t2.posting_id
                and t2.is_deleted = 0
	  inner join voudet v on t2.posting_det_id = v.posting_det_id
            inner join tbl_company t3 on t1.company_id = t3.company_id
            inner join accfil on t2.account_id = accfil.account_id
        where
            1 = 1
            and t1.inv_dt < to_date($P!{fromDate}, $P!{dateFormat})
        group by
            accfil.account_name || ' (' || accfil.account_code || ')'
        having
             (round(abs(sum((case when t1.currency = $P!{currency} then t2.amount
			  when t1.currency = 'USD' and $P!{currency} <> 'USD'
			 	then round(t2.amount * COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),2)
			  when t1.currency <> 'USD' and $P!{currency} = 'USD'
			 	then round(t2.amount / nullif(COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),0),2)
			 else 0 end ) * t2.in_out_flag)),1) > 0)
        union all
        select
            accfil.account_id,
            max(accfil.account_name || ' (' || accfil.account_code || ')') acc_desc,
            max(t1.inv_dt) inv_dt,
            max(t3.company_name) csc_code,
            t1.posting_id	voucher_id,
            max(t1.inv_type || '-' || t1.inv_no) vou_no,
            max(t1.reference_no) reference_no,
 			max(case when t1.note1 is null then '' else t1.note2|| '; ' end || t1.note3) particulars,
            0 op_bal_amt,
            round(sum(case when t2.in_out_flag = 1 then v.disp_amount else 0 end),2) debit_amt,
            round(sum(case when t2.in_out_flag = -1 then v.disp_amount else 0 end),2) credit_amt,
            null cost_category_name,
            null cost_center_name,
            null debit_credit,
            CAST(NULL AS bigint) amount,
        	-1 cost_category_id,
            'POSTED'	vou_status,
            2 sort_seq
        from
            tbl_account_posting_main t1
            inner join tbl_account_posting_det t2 on t1.posting_id = t2.posting_id
                and t2.is_deleted = 0
	  inner join voudet v on t2.posting_det_id = v.posting_det_id
            inner join tbl_company t3 on t1.company_id = t3.company_id
            inner join accfil on t2.account_id = accfil.account_id
        where
            1 = 1
            and t1.inv_dt >= to_date($P!{fromDate}, $P!{dateFormat})
            and t1.inv_dt <= to_date($P!{toDate}, $P!{dateFormat})
        group by
            accfil.account_id,
            t1.posting_id
        having
            (round(abs(sum((case when t1.currency = $P!{currency} then t2.amount
			  when t1.currency = 'USD' and $P!{currency} <> 'USD'
			 	then round(t2.amount * COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),2)
			  when t1.currency <> 'USD' and $P!{currency} = 'USD'
			 	then round(t2.amount / nullif(COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),0),2)
			 else 0 end ) * t2.in_out_flag)),1) > 0)

	   union all
        select
            accfil.account_id,
            max(accfil.account_name || ' (' || accfil.account_code || ')') acc_desc,
            max(t1.inv_dt) inv_dt,
            max(t3.company_name) csc_code,
            t1.posting_id	voucher_id,
            max(t1.inv_type || '-' || t1.inv_no) vou_no,
            max(t1.reference_no) reference_no,
            max(case when t1.note1 is null then '' else t1.note1|| '; ' end || t1.note2) particulars,
            0 op_bal_amt,
            0 debit_amt,
            0 credit_amt,
            max(c.cost_category_name) cost_category_name,
            max(cc.cost_center_name) 	cost_center_name,
            case when max(t2.in_out_flag) = 1 then 'Dr' else 'Cr' end debit_credit,
            sum(v.disp_amount * t2.in_out_flag)	amount,
             c.cost_category_id,
            'POSTED' vou_status,
            3 sort_seq
        from
            tbl_account_posting_main t1
            inner join tbl_account_posting_det t2 on t1.posting_id = t2.posting_id
                and t2.is_deleted = 0
	  inner join voudet v on t2.posting_det_id = v.posting_det_id
            inner join public.tbl_company t3 on t1.company_id = t3.company_id
            inner join accfil on t2.account_id = accfil.account_id
            inner join tbl_cost_category c on t2.cost_category_id = c.cost_category_id
            inner join tbl_cost_center cc on t2.cost_center_id = cc.cost_center_id
        where
            1 = 1
            and t1.inv_dt >= to_date($P!{fromDate}, $P!{dateFormat})
            and t1.inv_dt <= to_date($P!{toDate}, $P!{dateFormat})
        group by
            accfil.account_id,
            t1.posting_id,
            c.cost_category_id,
            cc.cost_center_id
        having
            (round(abs(sum((case when t1.currency = $P!{currency} then t2.amount
			  when t1.currency = 'USD' and $P!{currency} <> 'USD'
			 	then round(t2.amount * COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),2)
			  when t1.currency <> 'USD' and $P!{currency} = 'USD'
			 	then round(t2.amount / nullif(COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),0),2)
			 else 0 end ) * t2.in_out_flag)),1) > 0)
        union all
        select
            accfil.account_id,
            max(accfil.account_name || ' (' || accfil.account_code || ')') acc_desc,
            max(t1.inv_dt) inv_dt,
            max(t3.company_name) csc_code,
            t1.posting_id	voucher_id,
            max(t1.inv_type || '-' || t1.inv_no) vou_no,
            max(t1.reference_no) reference_no,
            max(case when t1.note1 is null then '' else t1.note2|| '; ' end || t1.note3) particulars,
            0 op_bal_amt,
            0 debit_amt,
            0 credit_amt,
            max(c.cost_category_name) cost_category_name,
            null cost_center_name,
            case when max(t2.in_out_flag) = 1 then 'Dr' else 'Cr' end debit_credit,
            sum(t2.in_out_flag * v.disp_amount) amount,
        	c.cost_category_id,
            'POSTED' vou_status,
            4 sort_seq
        from
            tbl_account_posting_main t1
            inner join tbl_account_posting_det t2 on t1.posting_id = t2.posting_id
                and t2.is_deleted = 0
			inner join voudet v on t2.posting_det_id = v.posting_det_id
            inner join tbl_company t3 on t1.company_id = t3.company_id
            inner join accfil on t2.account_id = accfil.account_id
            inner join tbl_cost_category c on t2.cost_category_id = c.cost_category_id
            inner join tbl_cost_center cc on t2.cost_center_id = cc.cost_center_id
        where
            1 = 1
            and t1.inv_dt >= to_date($P!{fromDate}, $P!{dateFormat})
            and t1.inv_dt <= to_date($P!{toDate}, $P!{dateFormat})
        group by
            accfil.account_id,
            t1.posting_id,
            c.cost_category_id
        having
            (round(abs(sum((case when t1.currency = $P!{currency} then t2.amount
			  when t1.currency = 'USD' and $P!{currency} <> 'USD'
			 	then round(t2.amount * COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency), t1.exchange_rate),2)
			  when t1.currency <> 'USD' and $P!{currency} = 'USD'
			 	then round(t2.amount / nullif(COALESCE(fn_get_exchange_rate(t1.company_id,to_char(t1.inv_dt :: date,'dd/MM/yyyy'),'dd/MM/yyyy',t1.currency),t1.exchange_rate),0),2)
			 else 0 end ) * t2.in_out_flag)),1) > 0)

    ) temp
where
    1 = 1
order by
    temp.acc_desc,
    inv_dt nulls first,
    COALESCE (temp.voucher_id, -1),
    temp.cost_category_id,
    temp.sort_seq,
    temp.cost_category_name,
    temp.cost_center_name,
    temp.debit_credit desc]]>
	</queryString>
	<field name="acc_id" class="java.lang.Integer"/>
	<field name="acc_desc" class="java.lang.String"/>
	<field name="inv_dt_frm" class="java.lang.String"/>
	<field name="inv_dt" class="java.sql.Date"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="voucher_id" class="java.lang.Integer"/>
	<field name="vou_no" class="java.lang.String"/>
	<field name="vou_status" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="particulars" class="java.lang.String"/>
	<field name="debit_amt" class="java.math.BigDecimal"/>
	<field name="credit_amt" class="java.math.BigDecimal"/>
	<field name="row_bal_amt" class="java.math.BigDecimal"/>
	<field name="cost_category_name" class="java.lang.String"/>
	<field name="cost_center_name" class="java.lang.String"/>
	<field name="debit_credit" class="java.lang.String"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="sort_seq" class="java.lang.Integer"/>
	<variable name="DEBIT_AMT_INTL" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{debit_amt}]]></variableExpression>
	</variable>
	<variable name="CREDIT_AMT_INTL" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{credit_amt}]]></variableExpression>
	</variable>
	<variable name="DEBIT_AMT_INTL_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{debit_amt}]]></variableExpression>
	</variable>
	<variable name="CREDIT_AMT_INTL_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Acc_Group" calculation="Sum">
		<variableExpression><![CDATA[$F{credit_amt}]]></variableExpression>
	</variable>
	<group name="Acc_Group">
		<groupExpression><![CDATA[$F{acc_id}]]></groupExpression>
		<groupHeader>
			<band height="16" splitType="Stretch">
				<textField isBlankWhenNull="true" hyperlinkType="RemotePage" bookmarkLevel="1">
					<reportElement key="textField" x="0" y="0" width="278" height="16" forecolor="#FF00CC" uuid="97428c0a-c167-4941-882f-7545b0091ec7"/>
