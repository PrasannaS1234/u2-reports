				<staticText>
					<reportElement key="staticText-41" stretchType="RelativeToTallestObject" mode="Transparent" x="0" y="0" width="30" height="16" isPrintWhenDetailOverflows="true" backcolor="#99CCFF" uuid="7acab57e-c30f-48eb-988b-65a7aed022ba"/>
					<box>
						<pen lineWidth="0.0" lineColor="#000000"/>
