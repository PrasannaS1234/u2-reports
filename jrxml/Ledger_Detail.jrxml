				</staticText>
				<staticText>
					<reportElement key="staticText-42" stretchType="RelativeToTallestObject" mode="Transparent" x="30" y="0" width="70" height="16" isPrintWhenDetailOverflows="true" backcolor="#99CCFF" uuid="917a82af-f463-4642-999c-e903b78ed746"/>
					<box>
						<pen lineWidth="0.0" lineColor="#000000"/>
						<topPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.5" lineStyle="Solid" lineColor="#000000"/>
