<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JewSales" pageWidth="2750" pageHeight="842" columnWidth="2740" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="e46e22ca-9416-4007-b33f-e330bb6818a5">
	<property name="ireport.zoom" value="0.9982500000000005"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["D:\\Tekfilo\\jasper-reports\\jasper\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.commodity_type asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over () as sno,
    tmp.*
from (
    --Sales invoice
    select
        t.inv_id,
        d.inv_det_id inv_det_id,
        max(concat(t.inv_type||'-'||t.inv_no)) inv_type_no,
        max(concat(j.jew_type,j.jew_no)) jobno,
        max(concat(so.sales_order_type||'-'||so.sales_order_no)) so_no,
        max(concat(sod.sales_order_det_type,'-',sod.sales_order_det_no)) sod_no,
        max(sku.sku_no) sku_no,
        MAX(com.metal_type) as commodity_type, max(concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',sku.company_id,'/sku/',sku.sku_id,sku.image_url)) image_url,
        max(pr.product_type_name) product_type_name,
        max(lot1.lot_code) metal_code1,
        max(ps.product_size) product_size,
        sum(d.inv_qty) qty,

        case
            when MAX(UPPER(com.metal_type)) LIKE '%GOLD%'
            then sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0))
            else 0
        end AS gold_net_wt,

        case
            when MAX(UPPER(com.metal_type)) LIKE '%SILVER%'
            then sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0))
            else 0
        end AS silver_net_wt,

        sum(COALESCE(net.gross_wt,0)*COALESCE(d.inv_qty,0)) gross_wt,
        sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0)) net_wt,

        round(sum(round(COALESCE(net.metal_amount,0),2)),2) gold_rate,

        round(
            sum(COALESCE(net.metal_amount,0)) *
            sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0))
        ,2) gold_value,

        sum(COALESCE(net.avg_lab_amount,0)*COALESCE(d.inv_qty,0)) labour,

        round(
            sum(COALESCE(net.stone_amount,0)) *
            sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0))
        ,2) stone_amount,

        sum(net.stone_amount) s_amount,

        round(
            sum(COALESCE(net.metal_amount,0)) *
            sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0))
        ,2)
        +
        round(
            sum(COALESCE(net.stone_amount,0)) *
            sum(COALESCE(net.net_wt,0)*COALESCE(d.inv_qty,0))
        ,2)
        +
        sum(COALESCE(net.avg_lab_amount,0)*COALESCE(d.inv_qty,0))
        as total_amount

    from
        tbl_jew_sales_invoice_main t
        inner join tbl_jew_sales_invoice_det d
            on t.inv_id = d.inv_id
            and d.is_deleted = 0

        inner join tbl_jewellery j
            on d.jew_id = j.jew_id

        left join tbl_sales_order_det sod
            on j.sales_order_det_id = sod.sales_order_det_id
            and sod.is_deleted = 0
            and j.job_category = 'Normal'

        left join tbl_sales_order_main so
            on sod.sales_order_id = so.sales_order_id
            and so.is_deleted = 0

        inner join tbl_sku sku
            on j.sku_id = sku.sku_id

        inner join tbl_product_type pr
            on sku.product_type_id = pr.product_type_id

        left join tbl_lot lot1
            on j.metal_id = lot1.lot_id

        left join tbl_commodity com
            on lot1.commodity_id = com.commodity_id

        left join tbl_product_size ps
            on j.product_size_id = ps.size_id

        left join v_jewellery_component_and_labor_summary net
            on j.jew_id = net.jew_id

    where
        t.is_deleted = 0
        and t.inv_id in ($P!{i_inv_id})

    group by
        t.inv_id, d.inv_det_id
) tmp

order by $P!{sortColumn};]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="jobno" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="sod_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="commodity_type" class="java.lang.String"/>
	<field name="image_url" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="metal_code1" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="gold_net_wt" class="java.math.BigDecimal"/>
	<field name="silver_net_wt" class="java.math.BigDecimal"/>
	<field name="gross_wt" class="java.math.BigDecimal"/>
	<field name="net_wt" class="java.math.BigDecimal"/>
	<field name="gold_rate" class="java.math.BigDecimal"/>
	<field name="gold_value" class="java.math.BigDecimal"/>
	<field name="labour" class="java.math.BigDecimal"/>
	<field name="stone_amount" class="java.math.BigDecimal"/>
	<field name="s_amount" class="java.math.BigDecimal"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<variable name="qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="total_amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
	</variable>
	<variable name="gold_net_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gold_net_wt}]]></variableExpression>
	</variable>
	<variable name="silver_net_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{silver_net_wt}]]></variableExpression>
	</variable>
