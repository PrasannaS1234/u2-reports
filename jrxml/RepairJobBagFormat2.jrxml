<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JobBagFormat2" pageWidth="430" pageHeight="300" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="429" leftMargin="0" rightMargin="1" topMargin="2" bottomMargin="2" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="style1">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{priority}.equals("Urgent") ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#000000" backcolor="#FF0000" fill="Solid" isBlankWhenNull="false" pdfEncoding="Cp1252"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{priority}.equals( "Normal" ) ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#000000" backcolor="#00CC00" fill="Solid" isBlankWhenNull="false" pdfEncoding="Cp1252"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{priority}.equals( "Customer Urgent" ) ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#000000" backcolor="#0066FF" fill="Solid" isBlankWhenNull="false" pdfEncoding="Cp1252"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{priority}.equals( "Repair" ) ? true : false]]></conditionExpression>
			<style mode="Opaque" forecolor="#000000" backcolor="#FFFF00" fill="Solid" isBlankWhenNull="false" pdfEncoding="Cp1252"/>
		</conditionalStyle>
	</style>
	<parameter name="i_bag_id" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	bag.bag_id,
	concat(bag.bag_type, bag.bag_no) bag_type_no,
	round(bag.bag_qty,0)||' '||bag.bag_uom bag_qty,
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	s.sku_no,
	/*case
	   when sd.color_code = '#f44336' then 'Urgent'
	   when sd.color_code = '#4CAF50' then 'Normal'
             when sd.color_code = '#2196F3' then 'Customer Urgent'
	   when sd.color_code = '#FFFF00' then 'Repair'
	   else null
	end priority,*/
	concat(round(sd.gross_wt,3), ' GMS') gross_wt,
	concat(round(sd.metal_wt,3), ' GMS') metal_wt,
	concat(so.repair_order_type,'-',so.repair_order_no) so_no,
	to_char(so.repair_order_date, 'dd-MM-yyyy') sales_order_date,
	to_char(so.delivery_date, 'dd-MM-yyyy') shipment_date,
	sd.customer_order_no,
	p.product_type_name,
	ps.product_size,
	lot.lot_code,
	c.display_name customer_name,
	t.metal_weight,
	sd.prod_remarks,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url,
	round((bag.bag_qty * sc.dia_tot_qty),3) dia_tot_qty,
	round((bag.bag_qty * sc.dia_qty2),0) dia_tot_pcs,
	round((bag.bag_qty * sc.cs_tot_qty),3) cs_tot_qty,
	round((bag.bag_qty * sc.cs_qty2),0) cs_tot_pcs
from
	tbl_jewellery t
	inner join tbl_mfg_bag bag on t.jew_id= bag.job_id
		and bag.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
	inner join tbl_repair_order_main so on t.sales_order_id = so.repair_order_id
	inner join tbl_repair_order_det sd on so.repair_order_id = sd.repair_order_id
		and t.sales_order_det_id = sd.repair_order_det_id
		and sd.is_deleted = 0
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
	inner join tbl_lot lot on sd.metal_id = lot.lot_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
	left join(
		select tbag.bag_id,
		sum(case when comg.commodity_group_type = 'LOOSEDIAMOND' then c.tot_qty else 0 end) dia_tot_qty,
		sum(case when comg.commodity_group_type = 'LOOSEDIAMOND' then c.qty1 else 0 end) dia_qty1,
		sum(case when comg.commodity_group_type = 'LOOSEDIAMOND' then c.qty2 else 0 end) dia_qty2,
		sum(case when comg.commodity_group_type = 'COLORSTONE' then c.tot_qty else 0 end) cs_tot_qty,
		sum(case when comg.commodity_group_type = 'COLORSTONE' then c.qty1 else 0 end) cs_qty1,
		sum(case when comg.commodity_group_type = 'COLORSTONE' then c.qty2 else 0 end) cs_qty2
		 from    tbl_jewellery sjob
		inner join tbl_mfg_bag tbag on sjob.jew_id = tbag.job_id
			and (tbag.bag_id ) in ($P!{i_bag_id})
		inner join tbl_repair_order_component c on sjob.sales_order_det_id = c.repair_order_det_id
		 and c.is_deleted  = 0
		inner join tbl_commodity comm on c.commodity_id = comm.commodity_id
		inner join tbl_commodity_group comg on comm.commodity_group_id = comg.commodity_group_id
		where sjob.is_deleted = 0
		 group by tbag.bag_id
	)sc on bag.bag_id = sc.bag_id
where
 (bag.bag_id ) in ($P!{i_bag_id})]]>
	</queryString>
	<field name="bag_id" class="java.lang.Integer"/>
	<field name="bag_type_no" class="java.lang.String"/>
	<field name="bag_qty" class="java.lang.String"/>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="job_type_no" class="java.lang.String"/>
