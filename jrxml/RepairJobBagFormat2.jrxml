				<staticText>
					<reportElement x="0" y="201" width="82" height="12" uuid="c8fdd9c2-f234-479d-b287-08fb7644914d"/>
					<box leftPadding="2">
						<pen lineWidth="0.5"/>
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
