<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SalesOrderConfirmation" language="groovy" pageWidth="750" pageHeight="842" columnWidth="710" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="55d31a7c-c2ec-4cd4-8b5c-a766287f311a">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_so_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	s.sales_order_id,
	concat(s.sales_order_type,'-',s.sales_order_no) sales_order_no,
	s.sales_order_date,
	s.delivery_date,
	f.factory_name,
          comp.company_name,
	cus.customer_name,
	concat(cua.address1,',',cua.address2) customer_address1,
	concat(cua.city,',',cua.state,',',cua.country) customer_address2,
	concat(comp.street,',',comp.city,',',comp.state) coompany_address,
	row_number() over (partition by sd.sales_order_det_id) sno,
	sd.remarks,
	concat(j.jew_type,j.jew_no) job_no,
	sku.sku_no,
	lot.lot_code alloy,
	sd.qty,
	ps.product_size,
	com.commodity_name,
	sh.shape_name,
	col.color_name,
	cut.cut_name,
	sc.mm_size,
	sc.tot_qty,
	sc.qty2,
	sl.lot_code comp_lot_no,
	cla.clarity_name,
	sl.certificate_no
from
	tbl_sales_order_main s
	inner join tbl_sales_order_det sd on s.sales_order_id = sd.sales_order_id
		and sd.is_deleted = 0
	inner join tbl_sales_order_component sc on sd.sales_order_det_id = sc.sales_order_det_id
		and sc.is_deleted = 0
	inner join tbl_jewellery j on sd.sales_order_det_id = j.jew_id
	inner join tbl_sku sku on j.sku_id = sku.sku_id
	inner join tbl_company comp on s.company_id = comp.company_id
	inner join tbl_factory f on s.factory_id = f.factory_id
	inner join tbl_lot lot on sd.metal_id = lot.lot_id
	inner join tbl_commodity com on sc.commodity_id = com.commodity_id
	inner join tbl_shape sh on sc.shape_id = sh.shape_id
	left join tbl_cut cut on sc.cut_id = cut.cut_id
	left join tbl_color col on sc.color_id = col.color_id
	left join tbl_clarity cla on sc.clarity_id = cla.clarity_id
	left join tbl_customer cus on s.customer_id = cus.customer_id
	left join tbl_customer_address cua on cus.customer_id = cua.customer_id
		and cua.is_deleted = 0
		and cua.address_type = 'Billing'
		and cua.default_address = 1
	left join tbl_lot sl on sc.lot_id = sl.lot_id
	  and sl.is_deleted = 0
	left join tbl_product_size ps on j.product_size_id = ps.size_id
where
	s.is_deleted = 0
	and s.sales_order_id = $P!{i_so_id}]]>
	</queryString>
