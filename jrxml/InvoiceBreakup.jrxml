	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over(order by skuname,jobno asc) sr_no,
	accountdtls,
	jobno,
	refno,
	vrdate,
	cref,
	atoz,
	skuname,
	itemname,
	metalname,
	locationname,
	grosswt,
	jewelleryid,
	diamondcode,
	stonegroupname,
	stoneskuname,
	sizename,
	stonegroupcode,
	pcs,
	stone_wt,
	rateinsystem,
	insystemstonecost,
	stonehandling,
	netwt,
	goldlosswt,
	settingtypecode,
	settingrate,
	settingcost,
	itempcs,
	fineness,
	shapeid,
	to_char(orderdate,'DD-Mon-YYYY') orderdate,
	shapecode,
	shapename,
	versionno,
	setting_labour_rate,
	handling_amt
from
	tbl_invoice_breakup bkk
where is_deleted = 0
and inv_id = $P!{invId} order by skuname,jobno asc]]>
	</queryString>
