<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AssortmentFormatIN1_sub" pageWidth="770" pageHeight="840" columnWidth="770" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="61fcc04f-329c-4f00-b3f6-941874fefd1c">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_grp_1" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over (partition by tx.inv_id order by tx.inv_det_id) as sno,
    tx.*,
    sku.sku_no,
    sod.stamping_remarks,
    sod.prod_remarks
from
(
    select
        t.sales_order_id,
        t.inv_id,
        d.inv_det_id,
        col.color_name,
        cla.clarity_name,
        d.customer_bag_no,
        d.stone_size,
        d.assort_qty1,
        d.assort_qty2,
        d.bag_id,
        concat(
            round(sum(d.assort_qty2) over (partition by t.inv_id, d.assort_qty1, d.assort_qty2),0),
            'D/',
            round(sum(d.assort_qty1) over (partition by t.inv_id, d.assort_qty1, d.assort_qty2),3)
        ) grp_1,
        concat(
            round(sum(d.assort_qty2) over (partition by t.inv_id),0),
            'D/',
            round(sum(d.assort_qty1) over (partition by t.inv_id),3)
        ) grp_2
    from
        tbl_mfg_stone_assortment_bagging t
        inner join tbl_mfg_stone_assortment_bagging_det d
            on t.inv_id = d.inv_id and d.is_deleted = 0
        inner join tbl_lot l on d.lot_id = l.lot_id
        left join tbl_color col on l.color_id = col.color_id
        left join tbl_clarity cla on l.clarity_id = cla.clarity_id
    where
        t.is_deleted = 0
        and t.inv_id = $P!{i_inv_id}
) tx
left join tbl_mfg_bag bag on tx.bag_id = bag.bag_id
left join tbl_jewellery j on bag.job_id = j.jew_id
left join tbl_sales_order_det sod
    on j.sales_order_det_id = sod.sales_order_det_id
    and tx.sales_order_id = sod.sales_order_id
    and sod.is_deleted = 0
left join tbl_sku sku on bag.sku_id = sku.sku_id
where
    tx.grp_1 in ($P{i_grp_1})
order by
    sno;]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="sales_order_id" class="java.lang.Integer"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="color_name" class="java.lang.String"/>
	<field name="clarity_name" class="java.lang.String"/>
	<field name="customer_bag_no" class="java.lang.String"/>
	<field name="stone_size" class="java.lang.String"/>
	<field name="assort_qty1" class="java.math.BigDecimal"/>
	<field name="assort_qty2" class="java.math.BigDecimal"/>
	<field name="bag_id" class="java.lang.Integer"/>
	<field name="grp_1" class="java.lang.String"/>
	<field name="grp_2" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="stamping_remarks" class="java.lang.String"/>
	<field name="prod_remarks" class="java.lang.String"/>
