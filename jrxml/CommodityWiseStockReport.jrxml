<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StockReportByCommodity" pageWidth="1437" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1397" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="rate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'CP'"]]></defaultValueExpression>
	</parameter>
	<parameter name="shape_ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select res.*, round(res.tot_inv_qty1 * res.pp_rate,2) pp_amount from (
select
	tx.*,
 	round(fn_rm_pp_wac(product_id,company_id,$P{toDate}, $P{dateFormat},$P!{currency}),2) pp_rate
from (
	select
		tcomp.company_id,
		max(tcomp.company_name) company_name,
		prod.lot_id	product_id,
		max(tcomg.commodity_group_name) commodity_group_name,
		max(tcom.commodity_name) commodity_name,
		max(prod.lot_code) product_no,
		max(sh.shape_name) shape_name,
		max(prod.mm_size) mm_size,
	    max(prod.gradle) gradle,
		sum(case when tbin.bin_type = 'STOCK_BIN' then stk.in_out_flag * stk.qty1 else 0 end) stock_inv_qty1,
		sum(case when tbin.bin_type = 'STOCK_BIN' then stk.in_out_flag * stk.qty2 else 0 end) stock_inv_qty2,
	    sum(case when tbin.bin_type = 'MEMO_SALES_BIN' then stk.in_out_flag * stk.qty1 else 0 end) msales_inv_qty1,
		sum(case when tbin.bin_type = 'MEMO_SALES_BIN' then stk.in_out_flag * stk.qty2 else 0 end) msales_inv_qty2,
	    sum(case when tbin.bin_type = 'MEMO_PURCHASE_BIN' then stk.in_out_flag * stk.qty1 else 0 end) mpur_inv_qty1,
		sum(case when tbin.bin_type = 'MEMO_PURCHASE_BIN' then stk.in_out_flag * stk.qty2 else 0 end) mpur_inv_qty2,
	    sum(stk.in_out_flag * stk.qty1) tot_inv_qty1,
	    sum(stk.in_out_flag * stk.qty2) tot_inv_qty2,
		coalesce(nullif($P{currency},'-1'),tcomp.default_currency) currency
	from
		tbl_lot_stock_trans stk
		inner join tbl_company tcomp on stk.company_id = tcomp.company_id
		inner join tbl_lot prod on stk.lot_id = prod.lot_id
		inner join tbl_bin tbin on stk.bin_id = tbin.bin_id
		inner join tbl_commodity tcom on prod.commodity_id = tcom.commodity_id
		inner join tbl_commodity_group tcomg on tcom.commodity_group_id = tcomg.commodity_group_id
		left join tbl_shape sh on prod.shape_id = sh.shape_id
	where
		stk.is_deleted = 0
		and stk.inv_dt <= to_date($P{toDate}, $P{dateFormat})
		and (prod.commodity_id in ($P!{commodityId}) or '-1' in ($P!{commodityId}))
		and (prod.commodity_group_id in ($P!{commodityGroupId}) or '-1' in ($P!{commodityGroupId}))
	          and (prod.shape_id in ($P!{shape_ids}) or - 1 in ($P!{shape_ids}))
		and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
	    and tbin.bin_type in ('STOCK_BIN','MEMO_PURCHASE_BIN','MEMO_SALES_BIN')
	group by
		tcomp.company_id,
		prod.lot_id
	having
	 (sum(stk.in_out_flag * stk.qty1) <> 0 or
		sum(stk.in_out_flag * stk.qty2) <> 0)
	order by
		tcomp.company_id,
		max(tcom.commodity_group_id),
		max(prod.commodity_id),
		prod.lot_code
)tx) res]]>
	</queryString>
