	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	lot.lot_code,
	lot.description,
	tcom.commodity_name,
	shape.shape_name,
          case
          when comp.sieve_size is null or comp.sieve_size = '' then    comp.mm_size
  else comp.sieve_size
end as size,
	comp.consumed_qty1 qty1,
	comp.consumed_qty2 qty2,
	round(comp.cost_price,2) rate,
	round(comp.consumed_qty1 * comp.cost_price,2) amount,
	round(comp.pp_rate,2) PP_rate,
	round(comp.consumed_qty1 * comp.pp_rate,2) PP_amount
from
tbl_jewellery_component comp
left join tbl_lot lot on comp.lot_id = lot.lot_id
left join tbl_commodity tcom on comp.commodity_id = tcom.commodity_id
left join tbl_shape shape on comp.shape_id = shape.shape_id
where
comp.is_deleted = 0
and comp.jew_id = $P!{invId}
order by
	tcom.sort_seq,comp.component_id,comp.sieve_size]]>
		</queryString>
		<field name="lot_code" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="size" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="pp_rate" class="java.math.BigDecimal"/>
		<field name="pp_amount" class="java.math.BigDecimal"/>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<variable name="AMOUNT_PP" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{pp_amount}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="BrokenDetails" uuid="20d5fe4c-a4d5-4062-9e51-36327d40545a">
		<parameter name="invId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	max(c.commodity_name) lot_code,
	sum(bc.consumed_qty1) qty1,
	round(sum(bc.consumed_qty1 * bc.cost_price) / case when sum(bc.consumed_qty1) = 0 then 1 else sum(bc.consumed_qty1) end,2)  rate,
	round(sum(bc.consumed_qty1 * bc.cost_price),2) amount,
	round(sum(bc.consumed_qty1 * bc.pp_rate) / case when sum(bc.consumed_qty1) = 0 then 1 else sum(bc.consumed_qty1) end,2)  PP_rate,
	round(sum(bc.consumed_qty1 * bc.pp_rate),2) PP_amount
from
	tbl_jewellery_component bc
	inner join tbl_commodity c on bc.commodity_id = c.commodity_id
where
	bc.is_deleted = 0
	and bc.jew_id = $P!{invId}
group by
	c.commodity_id

order by
	 c.sort_seq,
    c.commodity_id]]>
		</queryString>
		<field name="lot_code" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="pp_rate" class="java.math.BigDecimal"/>
		<field name="pp_amount" class="java.math.BigDecimal"/>
		<variable name="v_broken_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<variable name="v_pp_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{pp_amount}]]></variableExpression>
		</variable>
		<group name="lot_code">
			<groupExpression><![CDATA[$F{lot_code}]]></groupExpression>
		</group>
		<group name="qty1">
			<groupExpression><![CDATA[$F{qty1}]]></groupExpression>
		</group>
		<group name="rate">
			<groupExpression><![CDATA[$F{rate}]]></groupExpression>
		</group>
		<group name="amount">
			<groupExpression><![CDATA[$F{amount}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Labour" uuid="74a5be01-c2b1-45bf-a368-e0d908ac8148">
		<parameter name="invId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	p.process_name,
	l.qty,
	l.rate,
	l.amount
from
	tbl_jewellery_labour l
	inner join tbl_process p on l.process_id = p.process_id
where
l.is_deleted = 0
and l.jew_id = $P!{invId}]]>
		</queryString>
		<field name="process_name" class="java.lang.String"/>
		<field name="qty" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<variable name="v_total_labour" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
comp.company_name,
	jt.jew_id,
  sd.sales_order_type ||'-'||sd.sales_order_no so_no,
  s.sku_no,
  ps.product_size,
  pd.product_type_name,
  sd.order_type,
  fac.factory_name,
  ct.customer_name,
  sr.rate total_amount,
  sr.pp_rate pp_amount,
  jt.factory_ref_no,
  to_char(jt.created_dt, $P{dateFormat}) created_date,
 concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',jt.company_id,'/sku/',s.sku_id,s.image_url) img_url,
  concat(jt.jew_type,jt.jew_no) jew_no
from
tbl_jewellery jt
inner join tbl_company comp on jt.company_id = comp.company_id
inner join tbl_sku s on jt.sku_id = s.sku_id
left join tbl_jew_stock_rate sr on jt.jew_id = sr.jew_id
	and jt.company_id = sr.company_id
	and sr.is_deleted = 0
left join tbl_product_type pd on jt.product_type_id = pd.product_type_id
left join tbl_sales_order_main sd on jt.sales_order_id = sd.sales_order_id
	and jt.job_category = 'Normal'
left join tbl_customer ct on sd.customer_id = ct.customer_id
left join tbl_factory fac on jt.factory_id = fac.factory_id
left join tbl_product_size ps on jt.product_size_id = ps.size_id
where
    jt.is_deleted = 0
   and jt.jew_id = $P!{i_inv_id}
order by
	jt.jew_id asc]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="jew_id" class="java.lang.Integer"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="order_type" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<field name="pp_amount" class="java.math.BigDecimal"/>
	<field name="factory_ref_no" class="java.lang.String"/>
	<field name="created_date" class="java.lang.String"/>
	<field name="img_url" class="java.lang.String"/>
	<field name="jew_no" class="java.lang.String"/>
	<variable name="total_amount_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
	</variable>
	<variable name="total_amount_2" class="java.math.BigDecimal" resetType="Group" resetGroup="Invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{pp_amount}]]></variableExpression>
	</variable>
