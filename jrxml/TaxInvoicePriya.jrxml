	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    row_number() over (order by  im.inv_id) srno,
	round(sum(id.inv_qty),0) pcs,
	sum(coalesce(tcomp.dia_pcs,0)) dia_pcs,
	sum(coalesce(tcomp.dia_cts,0))	dia_ct,
	sum(coalesce(tcomp.cs_pcs,0)) cspcs,
	sum(coalesce(tcomp.cs_cts,0))	cs_ct,
	sum(coalesce(met_wt,0)) + sum(coalesce(tcomp.dia_cts,0) * 0.2) + sum(coalesce(tcomp.cs_cts,0) * 0.2) gross_wt,
	sum(coalesce(met_wt,0)) + sum(coalesce(tcomp.dia_cts,0) * 0.2) + sum(coalesce(tcomp.cs_cts,0) * 0.2) net_wt,
	sum(id.input_amt) input_amt,
	'' hsn
from
    tbl_jew_sales_invoice_main im
    inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_jewellery prod on id.jew_id = prod.jew_id
	left join
		(
			select
				comp.jew_id,
				round(sum(case when cg.commodity_group_type in ('CERTDIAMOND','LOOSEDIAMOND','CVD') then comp.total_qty1 else 0 end),3) dia_cts,
				round(sum(case when cg.commodity_group_type in ('CERTDIAMOND','LOOSEDIAMOND','CVD') then comp.total_qty2 else 0 end),0) dia_pcs,
				round(sum(case when cg.commodity_group_type in ('COLORSTONE') then comp.total_qty1 else 0 end),3) cs_cts,
				round(sum(case when cg.commodity_group_type in ('COLORSTONE') then comp.total_qty2 else 0 end),3) cs_pcs,
				round(sum(case when cg.commodity_group_type in ('METAL') then comp.total_qty1 else 0 end),3) met_wt
			from
				tbl_jewellery_component comp
				inner join tbl_lot tlot on comp.lot_id = comp.lot_id
				inner join tbl_commodity tcom on tlot.commodity_id = tcom.commodity_id
				inner join tbl_commodity_group cg on tcom.commodity_group_id = cg.commodity_group_id
			where
				comp.is_deleted = 0
                                         and tlot.lot_type = 'STONE'
			group by
				comp.jew_id
		) tcomp on id.jew_id = tcomp.jew_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{invId})
group by
	im.inv_id]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="pcs" class="java.math.BigDecimal"/>
		<field name="dia_pcs" class="java.math.BigDecimal"/>
		<field name="dia_ct" class="java.math.BigDecimal"/>
		<field name="cspcs" class="java.math.BigDecimal"/>
		<field name="cs_ct" class="java.math.BigDecimal"/>
		<field name="gross_wt" class="java.math.BigDecimal"/>
		<field name="net_wt" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<field name="hsn" class="java.lang.String"/>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<variable name="v_gross_wt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
		</variable>
		<variable name="v_net_wt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{net_wt}]]></variableExpression>
		</variable>
		<variable name="v_amount" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="f2523445-e3c7-4637-a9da-0e96129f78c0">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	'' hsn,
	sal_chg.charge_name,
	case when sal_chg.input_pct_amt_type <> 'AMOUNT' then sal_chg.input_pct_amt_value end  pct,
	sal_chg.plus_minus_flag * input_amt amount,
	im.total_invoice_amount inv_amt
from
	tbl_jew_sales_invoice_chgs sal_chg
	inner join tbl_jew_sales_invoice_main im on sal_chg.inv_id = im.inv_id
where
	sal_chg.is_deleted = 0
	 and sal_chg.inv_id in ($P!{invId})]]>
		</queryString>
		<field name="hsn" class="java.lang.String"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="pct" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="inv_amt" class="java.math.BigDecimal"/>
		<variable name="v_tot_tax_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_amt}]]></variableExpression>
		</variable>
		<variable name="v_tot_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<variable name="v_total_net_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="table_charges" uuid="fefc3636-7416-43ec-a53c-50f24d04e7c8">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	chgs.charge_name,
	chgs.plus_minus_flag * chgs.input_amt amt
from
	tbl_jew_sales_invoice_chgs chgs
where
	chgs.is_deleted = 0
	and chgs.inv_id in ($P!{invId})]]>
		</queryString>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amt" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="table_total" uuid="4b44db94-30eb-4bb3-b6d4-70c5bd87224f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	des,
	sum(gross_wt)	grw,
	sum(net_wt)		nwt,
	sum(input_amt)  amt
from
(
select
    'Total' des,
	sum(coalesce(met_wt,0)) + sum(coalesce(tcomp.dia_cts,0) * 0.2) + sum(coalesce(cs_cts,0) * 0.2) gross_wt,
	sum(coalesce(met_wt,0)) + sum(coalesce(tcomp.dia_cts,0) * 0.2) + sum(coalesce(cs_cts,0) * 0.2) net_wt,
	sum(id.input_amt) input_amt
from
    tbl_jew_sales_invoice_main im
    inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_jewellery prod on id.jew_id = prod.jew_id
	left join
		(
			select
				comp.jew_id,
				round(sum(case when cg.commodity_group_type in ('CERTDIAMOND','LOOSEDIAMOND','CVD') then comp.total_qty1 else 0 end),3) dia_cts,
				round(sum(case when cg.commodity_group_type in ('CERTDIAMOND','LOOSEDIAMOND','CVD') then comp.total_qty2 else 0 end),0) dia_pcs,
				round(sum(case when cg.commodity_group_type in ('COLORSTONE') then comp.total_qty1 else 0 end),3) cs_cts,
				round(sum(case when cg.commodity_group_type in ('COLORSTONE') then comp.total_qty2 else 0 end),3) cs_pcs,
				round(sum(case when cg.commodity_group_type in ('METAL') then comp.total_qty1 else 0 end),3) met_wt
			from
				tbl_jewellery_component comp
				inner join tbl_lot tlot on comp.lot_id = comp.lot_id
				inner join tbl_commodity tcom on tlot.commodity_id = tcom.commodity_id
				inner join tbl_commodity_group cg on tcom.commodity_group_id = cg.commodity_group_id
			where
				comp.is_deleted = 0
			group by
				comp.jew_id
		) tcomp on id.jew_id = tcomp.jew_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{invId})
group by
	im.inv_id
union all
select
  	'Total' des,
	0	gross_wt,
	0	net_wt,
	sum(chgs.plus_minus_flag * chgs.input_amt) input_amt
from
	tbl_jew_sales_invoice_chgs chgs
where
	chgs.is_deleted = 0
	 and chgs.inv_id in ($P!{invId})
) tmp
group by
	des]]>
		</queryString>
		<field name="des" class="java.lang.String"/>
		<field name="grw" class="java.math.BigDecimal"/>
		<field name="nwt" class="java.math.BigDecimal"/>
		<field name="amt" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="invType" class="java.lang.String">
		<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
    max(tcomp.company_name) company_name,
    max(im.inv_id) inv_id,
    max(im.inv_type) inv_type,
    max(im.inv_type||'-'||im.inv_no) inv_type_no,
    to_char(max(im.inv_dt), 'dd/mm/yyyy') inv_dt,
    to_char(max(im.inv_due_dt), 'dd/mm/yyyy')     inv_due_dt,
    max(im.currency) currency,
    max(im.exchange_rate) exchange_rate,
    max(im.reference_no) reference_no,
    max(tcus.customer_name) customer_name,
    max(im.bill_address1) bill_addr1,
    max(im.bill_address2) bill_addr2,
    max(im.bill_country) bill_country,
    max(im.bill_state) bill_state,
    max(im.bill_city) bill_city,
    max(im.bill_street) bill_street,
    max(im.bill_pincode) bill_pincode,
    max(im.bill_website) bill_website,
    max(im.bill_phone_no) bill_phone_no,
    max(im.bill_fax_no) bill_fax_no,
    max(im.bill_mobile_no) bill_mobile_no,
    max(im.ship_address1) ship_addr1,
    max(im.ship_address2) ship_addr2,
    max(im.ship_country) ship_country,
    max(im.ship_state) ship_state,
    max(im.ship_city) ship_city,
    max(im.ship_street) ship_street,
    max(im.ship_pincode) ship_pincode,
    max(im.ship_website) ship_website,
    max(im.ship_phone_no) ship_phone_no,
    max(im.ship_fax_no) ship_fax_no,
    max(im.ship_mobile_no) ship_mobile_no,
    max(tcomp.state) comp_state,
    max(tcomp.city) comp_city,
    max(tcomp.street) comp_street,
    max(tcomp.area) comp_area,
    max(tcomp.pin_code) comp_pin,
    max(tcomp.email) comp_email,
    max(tcomp.phone_number) comp_phone_number,
    max(tcomp.mobile_no) comp_mobile_no,
    max(tcomp.website) comp_website,
    max(tcomp.reg_number) comp_gstn,
    max(tcomp.fax_no) comp_fax,
    max(tcomp.company_name) ||','||max(tcomp.street) || ',' || max(tcomp.area) || ',' ||
    max(tcomp.city) || ' - ' || max(tcomp.pin_code) ||',' ||
    max(tcomp.state) || ', ' || '' address,
    max(tcomp.company_name) addressLine1,
    max(tcomp.street) addressLine2,
    max(tcomp.area) addressLine3,
    max(tcomp.city) addressLine4,
    max(tcomp.pin_code) addressLine5,
    max(tcomp.state) addressLine6,
    'Tel: ' ||  max(tcomp.phone_number) || ' Fax: ' || max(tcomp.fax_no) addressLine7,
    max(im.total_invoice_amount) grossAmount,
    spellnumericvalue(im.total_invoice_net_amount,im.currency) amount_in_words
from
    tbl_jew_sales_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_jew_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_customer tcus on im.customer_id = tcus.customer_id
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
group by
    im.inv_id,
    im.inv_type]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
