		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	t.inv_no,
	t.inv_type||'-'||t.inv_no inv_no,
    to_char(t.inv_dt, $P{dateFormat}) inv_dt,
    to_char(t.inv_due_dt, $P{dateFormat})     inv_due_dt,
	f.factory_name,
    t.status,
	t.accounting_status,
	t.currency,
	t.exchange_rate,
	d.jew_id,
	concat(j.jew_type,j.jew_no) jew_no,
    pt.product_type_name,
    mk.market_name,
    col.collection_name,
    j.design_no,
	s.sku_no,
	d.inv_qty,
	l.lot_code,
	c.bin_id,
	c.consumed_qty1,
	c.consumed_qty2,
	c.broken_qty1,
	c.broken_qty2,
	c.loss_qty1,
	c.loss_qty2,
	c.total_qty1,
	c.total_qty2,
	c.return_qty1,
	c.return_qty2,
	j.uom
from
	tbl_factory_invoice_main t
      inner join tbl_company tcomp on t.company_id = tcomp.company_id
	inner join tbl_factory_invoice_det d on t.inv_id = d.inv_id
		and d.is_deleted = 0
	inner join tbl_factory_invoice_component c ON d.inv_det_id = c.inv_det_id
		and c.is_deleted = 0
	inner join tbl_factory f ON t.factory_id = f.factory_id
		and (f.factory_id in ($P!{factoryId}) or -1 in ($P!{factoryId}))
	inner join tbl_jewellery j on j.jew_id = c.jew_id
	 	and (j.design_no  in ($P!{designNo}) or ' ' in ($P!{designNo}))
    		and (j.sku_no  in ($P!{skuNo}) or ' ' in ($P!{skuNo}))
    		and (concat(j.jew_type,j.jew_no) in ($P!{jewTypeNo}) or ' ' in ($P!{jewTypeNo}))
	and (j.collection_id  in ($P!{collectionId}) or -1 in ($P!{collectionId}))
	and (j.product_type_id  in ($P!{productTypeId}) or -1 in ($P!{productTypeId}))
	and (j.market_id  in ($P!{marketId}) or -1 in ($P!{marketId}))

	left join public.tbl_sku s on j.sku_id = s.sku_id
	left join tbl_product_type pt on j.product_type_id = pt.product_type_id
	left join tbl_market mk on j.market_id = mk.market_id
	left join tbl_collection col on j.collection_id = col.collection_id
	left join public.tbl_lot l on c.lot_id = l.lot_id
where
    T.is_deleted = 0
    and t.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and t.inv_dt <= to_date($P{toDate}, $P{dateFormat})
Order by
	t.inv_dt,
	t.inv_id]]>
	</queryString>
