<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="FGPurchaseInvoicewithImageSuraj" pageWidth="540" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="520" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="9ad6d883-1638-4ddd-b4d4-9debcc20f6c2">
	<property name="ireport.zoom" value="1.2100000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    ROW_NUMBER() OVER (ORDER BY q.inv_id, q.product_type) AS s_no,
	ROUND(TRUNC((SUM(q.total_amt_usd) OVER (PARTITION BY q.inv_id)), 0),2)  AS inv_total_usd_roundoff,
    ROUND((SUM(q.total_amt_usd) OVER (PARTITION BY q.inv_id)) - TRUNC((SUM(q.total_amt_usd) OVER (PARTITION BY q.inv_id)), 0), 2)   AS amount_decimal,
  COALESCE(
    fn_amount_to_words(
        FLOOR(
            SUM(q.total_amt_usd) OVER (PARTITION BY q.inv_id)
        ),
        ''::varchar,
        '',
        ''
    ) || ' only',
    ''
) AS inv_total_words,
    q.*
from
(
    SELECT
        im.inv_id                                                     AS inv_id,
        COUNT(DISTINCT id.jew_id)                                     AS item_count,
        pt.product_type_name                                          AS product_type,
        MAX(tcomp.company_name)                                       AS company_name,
 COALESCE(
        NULLIF(fn_get_customer_invoice_no(im.inv_type, im.inv_id), ''),
        concat(im.inv_type, '-', im.inv_no)) AS inv_type_no,

        TO_CHAR(MAX(im.inv_dt), COALESCE(MAX(tcomp.date_format), 'dd/MM/yyyy')) AS inv_dt,
         max(im.remarks) remarks,
         max(c.currency_code) currency_code,
         concat(max(prp.first_name),' ',max(prp.last_name)) as prepare_by,
        MAX(im.created_dt) AS created_dt,
        MAX(im.currency)                                              AS currency,
        MAX(tcus.supplier_name)                                       AS supplier_name,
        MAX(tcus.display_name)                                        AS sup_display_name,
        MAX(addr.address1)                                            AS address1,
        MAX(addr.address2)                                            AS address2,
        MAX(im.reference_no)                                          AS reference_no,
        MAX(im.inv_due_dt)                                            AS inv_due_dt,
        MAX(addr.country)                                             AS country,
        MAX(im.exchange_rate)                                         AS exchange_rate,
        SUM(det.gross_wt)                                               AS gross_wt,
        max(CASE
            WHEN im.currency = 'USD' THEN det.metal_rate
            ELSE det.metal_rate * COALESCE(NULLIF(im.exchange_rate, 1), 1)
        END)  metal_rate,
        SUM(
            CASE
                WHEN im.currency = 'USD' THEN COALESCE(det.metal_rate, 1) * COALESCE(det.gross_wt, 1)
                ELSE (COALESCE(det.metal_rate, 1) * COALESCE(det.gross_wt, 1)) * COALESCE(NULLIF(im.exchange_rate, 1), 1)
            END
        )                                                             AS total_amt_usd,
        COALESCE(MAX(payment.paid_amount) , 0)                         AS paid_amt,
        CONCAT('/home/ubuntu/tekfilo/jewtrade/uploads/', $P{tenant}, 'comp', tcomp.company_id, '/company/', tcomp.company_id, tcomp.log_url) AS comp_logo

    FROM tbl_jew_purchase_invoice_main im
    INNER JOIN tbl_jew_purchase_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
	left join tbl_jew_purchase_invoice_jewel_detail det on im.inv_id = det.inv_id
	and id.inv_det_id = det.inv_det_id
	and det.is_deleted =0
    left join tbl_user prp on im.created_by = prp.user_id and prp.is_deleted=0
    left join tbl_currency c on im.currency = c.currency_code and c.is_deleted = 0
    INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
    INNER JOIN tbl_jewellery j ON id.jew_id = j.jew_id AND j.is_deleted = 0
    left JOIN tbl_product_type pt ON pt.product_type_id = j.product_type_id
    LEFT JOIN (
        SELECT DISTINCT ON (jc.jew_id)
            jc.jew_id,
            jc.pp_rate,
            l.impure_to_pure_conv_factor AS purity
        FROM tbl_jewellery_component jc
        LEFT JOIN tbl_lot l ON jc.lot_id = l.lot_id AND l.is_deleted = 0 AND l.lot_type = 'METAL'
        ORDER BY jc.jew_id
    ) tj ON tj.jew_id = j.jew_id
    INNER JOIN tbl_sku s ON j.sku_id = s.sku_id AND s.is_deleted = 0
    LEFT JOIN tbl_supplier tcus ON im.supplier_id = tcus.supplier_id
    LEFT JOIN (
        SELECT
            p.inv_id,
            SUM(
                CASE
                    WHEN pm.currency = 'USD' THEN COALESCE(p.paid_amount, 0)
                    ELSE COALESCE(p.paid_amount, 0) * COALESCE(NULLIF(pm.exchange_rate, 1), 1)
                END
            ) AS paid_amount
        FROM tbl_payment_paid_det p
        INNER JOIN tbl_payment_paid_main pm ON pm.payment_id = p.payment_id
        WHERE p.is_deleted = 0
        GROUP BY p.inv_id
    ) payment ON payment.inv_id = im.inv_id
    LEFT JOIN (
        SELECT DISTINCT ON (a.supplier_id)
            a.supplier_id,
            a.country,
            a.state,
            a.address1,
            a.address2
        FROM tbl_supplier_address a
        WHERE a.is_deleted = 0 AND a.default_address = 1
        ORDER BY a.supplier_id, a.address_id DESC
    ) addr ON addr.supplier_id = tcus.supplier_id

    WHERE im.is_deleted = 0
      AND im.inv_id IN ($P!{i_inv_id})

    GROUP BY im.inv_id, pt.product_type_name, tcomp.company_id
) q
ORDER BY q.inv_id, q.product_type;]]>
	</queryString>
