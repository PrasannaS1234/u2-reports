	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="invId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
		</parameter>
		<parameter name="invDetailId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	lot.lot_code,
	lot.description,
	tcom.commodity_name,
	shape.shape_name,
	coalesce(lot.sieve_size,lot.mm_size) size,
	comp.consumed_qty1 qty1,
	comp.consumed_qty2 qty2,
	round(comp.cost_price,2) rate,
	round(comp.consumed_qty1 * comp.cost_price,2) amount
from
tbl_factory_invoice_component comp
inner join tbl_lot lot on comp.lot_id = lot.lot_id
inner join tbl_commodity tcom on lot.commodity_id = tcom.commodity_id
left join tbl_shape shape on lot.shape_id = shape.shape_id
where
comp.is_deleted = 0
and comp.inv_id = $P!{invId}
and comp.inv_det_id = $P!{invDetailId}]]>
		</queryString>
		<field name="lot_code" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="size" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="BrokenDetails" uuid="20d5fe4c-a4d5-4062-9e51-36327d40545a">
		<parameter name="invId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invDetailId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	lot.lot_code,
	bc.broken_qty1  + bc.loss_qty1 qty1,
	round(bc.cost_price,2) rate,
	round((bc.broken_qty1  + bc.loss_qty1) * bc.cost_price,2) amount
from
	tbl_factory_invoice_component bc
	inner join tbl_lot lot on bc.lot_id = lot.lot_id
where
	bc.is_deleted = 0
	and bc.inv_id = $P!{invId}
	and bc.inv_det_id = $P!{invDetailId}
	and bc.broken_qty1 + bc.broken_qty2 + bc.loss_qty1 + bc.loss_qty2 > 0]]>
		</queryString>
		<field name="lot_code" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<variable name="v_broken_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<group name="lot_code">
			<groupExpression><![CDATA[$F{lot_code}]]></groupExpression>
		</group>
		<group name="qty1">
			<groupExpression><![CDATA[$F{qty1}]]></groupExpression>
		</group>
		<group name="rate">
			<groupExpression><![CDATA[$F{rate}]]></groupExpression>
		</group>
		<group name="amount">
			<groupExpression><![CDATA[$F{amount}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="Labour" uuid="74a5be01-c2b1-45bf-a368-e0d908ac8148">
		<parameter name="invId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invDetailId" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
	p.process_name,
	l.qty,
	l.rate,
	l.amount
from
	tbl_factory_invoice_labour l
	inner join tbl_process p on l.process_id = p.process_id
where
l.is_deleted = 0
and l.inv_id = $P!{invId}
and l.inv_det_id = $P!{invDetailId}]]>
		</queryString>
		<field name="process_name" class="java.lang.String"/>
		<field name="qty" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<variable name="v_total_labour" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
comp.company_name,
  fm.inv_id,
  fm.inv_type,
  fm.inv_type||'-'||fm.inv_no invtype_no,
  to_char(fm.inv_dt,$P{dateFormat}) inv_dt,
  sd.sales_order_type ||'-'||sd.sales_order_no so_no,
  s.sku_no,
  ps.product_size,
  pd.product_type_name,
  sd.order_type,
  fac.factory_name,
  ct.customer_name,
  fd.total_cogs_amount total_amount,
  fd.inv_det_id,
  concat(jt.jew_type,jt.jew_no) jew_no,
concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',fm.company_id,'/sku/',s.sku_id,s.image_url) img_url
from
    tbl_factory_invoice_main fm
inner join tbl_factory_invoice_det fd on fm.inv_id = fd.inv_id
   and fd.is_deleted = 0
inner join tbl_jewellery jt on fd.jew_id = jt.jew_id
left join tbl_sku s on jt.sku_id = s.sku_id
left join tbl_product_type pd on jt.product_type_id = pd.product_type_id
left join tbl_sales_order_main sd on jt.sales_order_id = sd.sales_order_id
inner join tbl_customer ct on sd.customer_id = ct.customer_id
inner join tbl_factory fac on fm.factory_id = fac.factory_id
inner join tbl_company comp on fm.company_id = comp.company_id
left join tbl_product_size ps on jt.product_size_id = ps.size_id
where
    fm.is_deleted = 0
    and fm.inv_id = $P!{i_inv_id}
order by
	fd.inv_det_id asc]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="invtype_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="so_no" class="java.lang.String"/>
	<field name="sku_no" class="java.lang.String"/>
	<field name="product_size" class="java.lang.String"/>
	<field name="product_type_name" class="java.lang.String"/>
	<field name="order_type" class="java.lang.String"/>
	<field name="factory_name" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="total_amount" class="java.math.BigDecimal"/>
	<field name="inv_det_id" class="java.lang.Integer"/>
	<field name="jew_no" class="java.lang.String"/>
	<field name="img_url" class="java.lang.String"/>
	<variable name="total_amount_1" class="java.math.BigDecimal" resetType="Group" resetGroup="Invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{total_amount}]]></variableExpression>
	</variable>
