<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RmConsignmentBasicLedgerlListLotwise" pageWidth="1650" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1640" leftMargin="5" rightMargin="5" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="d0c12a1c-6cbb-4a39-81fb-68eb656a5e33">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="106"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="outStanding" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="invNos" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="asOnDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["22/12/2025"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="currency_1" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    *
FROM
(
    SELECT
        ROW_NUMBER() OVER (ORDER BY (im.inv_id)) AS Sno,
        TO_CHAR(current_date, 'dd/mm/yyyy') AS date,
        tcomp.company_name,
        tcomp.street AS addressLine2,
        tcomp.area AS addressLine3,
        tcomp.city AS addressLine4,
        tcomp.pin_code AS addressLine5,
        (COALESCE(state.state_name, '') || ', ' || COALESCE(c.country_name, '')) AS addressLine6,
        im.company_id,
        selcus.customer_name AS selected_customer_name,
        fn_get_customer_invoice_no(im.inv_type, im.inv_id) AS cus_doc_type,
        im.inv_id,
        im.inv_type,
        (im.inv_type || '-' || im.inv_no) AS inv_type_no,
        TO_CHAR(im.inv_dt, 'dd/mm/yyyy') AS inv_dt,
        case when COALESCE(msrd.inv_qty1,0) > 0 then fn_get_customer_invoice_no(msrm.inv_type, msrm.inv_id) else fn_get_customer_invoice_no(sm.inv_type, sm.inv_id) end reference_no,
        tcus.customer_name,
        im.currency,
        im.exchange_rate,
        lot.lot_code AS lot_no,
        com.commodity_name,

        COALESCE(id.inv_qty1,0) AS issue_qty1,
        COALESCE(id.inv_qty2,0) AS issue_qty2,

        -- ✅ Issue Amount with conversion + conditional rounding
        CASE
            WHEN $P!{currency} = 'USD' THEN
                CASE
                    WHEN im.currency <> 'USD'
                        THEN COALESCE(id.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                    WHEN im.currency = 'USD'
                        THEN COALESCE(id.input_amt,0)
                    ELSE COALESCE(id.input_amt,0)
                END
            ELSE
                ROUND(
                    CASE
                        WHEN $P!{currency} = 'USD' AND im.currency <> 'USD'
                            THEN COALESCE(id.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN $P!{currency} <> 'USD' AND im.currency = 'USD'
                            THEN COALESCE(id.input_amt,0) * COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN im.currency <> $P!{currency}
                            THEN COALESCE(id.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        ELSE COALESCE(id.input_amt,0)
                    END
                ,2)
        END AS issue_total_amt,

        COALESCE(sd.inv_qty1,0) AS confirm_qty1,
        COALESCE(sd.inv_qty2,0) AS confirm_qty2,

        -- ✅ Confirm Amount with conversion + conditional rounding
        CASE
            WHEN $P!{currency} = 'USD' THEN
                CASE
                    WHEN im.currency <> 'USD'
                        THEN COALESCE(sd.conf_input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                    WHEN im.currency = 'USD'
                        THEN COALESCE(sd.conf_input_amt,0)
                    ELSE COALESCE(sd.conf_input_amt,0)
                END
            ELSE
                ROUND(
                    CASE
                        WHEN $P!{currency} = 'USD' AND im.currency <> 'USD'
                            THEN COALESCE(sd.conf_input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN $P!{currency} <> 'USD' AND im.currency = 'USD'
                            THEN COALESCE(sd.conf_input_amt,0) * COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN im.currency <> $P!{currency}
                            THEN COALESCE(sd.conf_input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        ELSE COALESCE(sd.conf_input_amt,0)
                    END
                ,2)
        END AS confirm_total_amt,

        COALESCE(msrd.inv_qty1,0) AS retrun_qty1,
        COALESCE(msrd.inv_qty2,0) AS retrun_qty2,

        -- ✅ Return Amount with conversion + conditional rounding
        CASE
            WHEN $P!{currency} = 'USD' THEN
                CASE
                    WHEN im.currency <> 'USD'
                        THEN COALESCE(msrd.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                    WHEN im.currency = 'USD'
                        THEN COALESCE(msrd.input_amt,0)
                    ELSE COALESCE(msrd.input_amt,0)
                END
            ELSE
                ROUND(
                    CASE
                        WHEN $P!{currency} = 'USD' AND im.currency <> 'USD'
                            THEN COALESCE(msrd.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN $P!{currency} <> 'USD' AND im.currency = 'USD'
                            THEN COALESCE(msrd.input_amt,0) * COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN im.currency <> $P!{currency}
                            THEN COALESCE(msrd.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        ELSE COALESCE(msrd.input_amt,0)
                    END
                ,2)
        END AS return_total_amt,

        COALESCE(id.inv_qty1,0) - COALESCE(sd.inv_qty1,0) - COALESCE(id.ret_qty1,0) AS balance_qty1,
        COALESCE(id.inv_qty2,0) - COALESCE(sd.inv_qty2,0) - COALESCE(id.ret_qty2,0) AS balance_qty2,

        -- ✅ Balance Amount with conversion + conditional rounding
        CASE
            WHEN $P!{currency} = 'USD' THEN
                (
                    (CASE
                        WHEN im.currency <> 'USD'
                            THEN COALESCE(id.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        WHEN im.currency = 'USD'
                            THEN COALESCE(id.input_amt,0)
                        ELSE COALESCE(id.input_amt,0)
                    END)
                    -
                    (CASE
                        WHEN im.currency <> 'USD'
                            THEN COALESCE(sd.conf_input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        ELSE COALESCE(sd.conf_input_amt,0)
                    END)
                    -
                    (CASE
                        WHEN im.currency <> 'USD'
                            THEN COALESCE(msrd.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                        ELSE COALESCE(msrd.input_amt,0)
                    END)
                )
            ELSE
                ROUND(
                    (
                        (CASE
                            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD'
                                THEN COALESCE(id.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD'
                                THEN COALESCE(id.input_amt,0) * COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            WHEN im.currency <> $P!{currency}
                                THEN COALESCE(id.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            ELSE COALESCE(id.input_amt,0)
                        END)
                        -
                        (CASE
                            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD'
                                THEN COALESCE(sd.conf_input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD'
                                THEN COALESCE(sd.conf_input_amt,0) * COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            WHEN im.currency <> $P!{currency}
                                THEN COALESCE(sd.conf_input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            ELSE COALESCE(sd.conf_input_amt,0)
                        END)
                        -
                        (CASE
                            WHEN $P!{currency} = 'USD' AND im.currency <> 'USD'
                                THEN COALESCE(msrd.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            WHEN $P!{currency} <> 'USD' AND im.currency = 'USD'
                                THEN COALESCE(msrd.input_amt,0) * COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            WHEN im.currency <> $P!{currency}
                                THEN COALESCE(msrd.input_amt,0) / COALESCE(fn_get_exchange_rate(im.company_id, TO_CHAR(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P!{currency}), im.exchange_rate,1)
                            ELSE COALESCE(msrd.input_amt,0)
                        END)
                    )
                ,2)
        END AS balance_total_amt

    FROM tbl_memo_sales_invoice_main im
    INNER JOIN tbl_memo_sales_invoice_det id ON im.inv_id = id.inv_id AND id.is_deleted = 0
    INNER JOIN tbl_lot lot ON lot.lot_id = id.lot_id
    INNER JOIN tbl_commodity com ON lot.commodity_id = com.commodity_id AND com.is_deleted = 0
LEFT JOIN (
    SELECT
        inv_id,
        ref_inv_id,
        ref_inv_det_id,
        ref_inv_type,

        SUM(inv_qty1) AS inv_qty1,
        SUM(inv_qty2) AS inv_qty2,
        SUM(
            COALESCE(inv_qty1,0) * COALESCE(input_rate,0)
        ) AS conf_input_amt

    FROM tbl_sales_invoice_det
    WHERE is_deleted = 0
    GROUP BY
        inv_id,
        ref_inv_id,
        ref_inv_det_id,
        ref_inv_type
) sd
ON sd.ref_inv_id      = id.inv_id
AND sd.ref_inv_det_id = id.inv_det_id
AND sd.ref_inv_type   = im.inv_type
    LEFT JOIN tbl_sales_invoice_main sm ON sm.inv_id = sd.inv_id AND sm.is_deleted = 0
    LEFT JOIN tbl_memo_sales_return_invoice_det msrd ON msrd.ref_inv_id = id.inv_id
        AND msrd.ref_inv_det_id = id.inv_det_id AND msrd.ref_inv_type = im.inv_type AND msrd.is_deleted = 0
    left join tbl_memo_sales_return_invoice_main msrm on msrd.inv_id = msrm.inv_id
	    and msrm.is_deleted = 0
    INNER JOIN tbl_customer tcus ON im.customer_id = tcus.customer_id
    INNER JOIN tbl_company tcomp ON im.company_id = tcomp.company_id
    LEFT JOIN tbl_state state ON tcomp.state = state.state_code
    LEFT JOIN tbl_country c ON tcomp.country_id = c.country_id
    LEFT JOIN tbl_customer selcus ON selcus.customer_id = $P!{customerId}
    WHERE im.is_deleted = 0
      AND (im.inv_dt IS NULL OR im.inv_dt <= TO_DATE($P{asOnDate}, $P{dateFormat}))
) res
where 1 = 1
     and (cus_doc_type IN ($P!{invNos}) or ' ' in ($P!{invNos}))
     and CASE
        WHEN $P!{outStanding} = 1 THEN
            ((COALESCE(res.issue_qty1,0)) - (COALESCE(res.confirm_qty1,0)) - (COALESCE(res.retrun_qty1,0))) > 0
        ELSE TRUE
    END
    AND (cus_doc_type IN ($P!{invNos}) OR ' ' IN ($P!{invNos}))
ORDER BY cus_doc_type, res.inv_id, res.inv_type;]]>
	</queryString>
	<field name="sno" class="java.lang.Long"/>
	<field name="date" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="addressline2" class="java.lang.String"/>
	<field name="addressline3" class="java.lang.String"/>
	<field name="addressline4" class="java.lang.String"/>
	<field name="addressline5" class="java.lang.String"/>
	<field name="addressline6" class="java.lang.String"/>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="selected_customer_name" class="java.lang.String"/>
	<field name="cus_doc_type" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type" class="java.lang.String"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="lot_no" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="issue_qty1" class="java.math.BigDecimal"/>
	<field name="issue_qty2" class="java.math.BigDecimal"/>
	<field name="issue_total_amt" class="java.math.BigDecimal"/>
	<field name="confirm_qty1" class="java.math.BigDecimal"/>
	<field name="confirm_qty2" class="java.math.BigDecimal"/>
	<field name="confirm_total_amt" class="java.math.BigDecimal"/>
	<field name="retrun_qty1" class="java.math.BigDecimal"/>
	<field name="retrun_qty2" class="java.math.BigDecimal"/>
	<field name="return_total_amt" class="java.math.BigDecimal"/>
	<field name="balance_qty1" class="java.math.BigDecimal"/>
	<field name="balance_qty2" class="java.math.BigDecimal"/>
	<field name="balance_total_amt" class="java.math.BigDecimal"/>
	<variable name="issue_qty1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_qty1}]]></variableExpression>
	</variable>
	<variable name="issue_total_amt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_total_amt}]]></variableExpression>
	</variable>
	<variable name="confirm_qty1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{confirm_qty1}]]></variableExpression>
	</variable>
	<variable name="confirm_total_amt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{confirm_total_amt}]]></variableExpression>
	</variable>
	<variable name="retrun_qty1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{retrun_qty1}]]></variableExpression>
	</variable>
	<variable name="return_total_amt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{return_total_amt}]]></variableExpression>
	</variable>
	<variable name="balance_qty1_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_qty1}]]></variableExpression>
	</variable>
	<variable name="balance_total_amt_1" class="java.math.BigDecimal" resetType="Group" resetGroup="invoice" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_total_amt}]]></variableExpression>
	</variable>
	<variable name="issue_qty1_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_qty1}]]></variableExpression>
	</variable>
	<variable name="issue_total_amt_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{issue_total_amt}]]></variableExpression>
	</variable>
	<variable name="confirm_qty1_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{confirm_qty1}]]></variableExpression>
	</variable>
	<variable name="confirm_total_amt_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{confirm_total_amt}]]></variableExpression>
	</variable>
	<variable name="retrun_qty1_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{retrun_qty1}]]></variableExpression>
	</variable>
	<variable name="return_total_amt_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{return_total_amt}]]></variableExpression>
	</variable>
	<variable name="balance_qty1_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_qty1}]]></variableExpression>
	</variable>
	<variable name="balance_total_amt_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{balance_total_amt}]]></variableExpression>
	</variable>
	<group name="invoice">
		<groupExpression><![CDATA[$F{cus_doc_type}]]></groupExpression>
		<groupFooter>
			<band height="17">
				<textField pattern="" isBlankWhenNull="false">
					<reportElement stretchType="RelativeToTallestObject" mode="Opaque" x="0" y="0" width="960" height="17" forecolor="#000000" backcolor="#99CCFF" uuid="698a877b-2fee-4f5f-a0ff-bb85f5e23ee8"/>
					<box leftPadding="2" rightPadding="2">
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle" rotation="None" markup="none">
						<font fontName="Arial" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
						<paragraph lineSpacing="Single"/>
					</textElement>
					<textFieldExpression><![CDATA[$F{cus_doc_type}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" pattern="#,##0.000" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToTallestObject" mode="Opaque" x="960" y="0" width="68" height="17" backcolor="#99CCFF" uuid="19bf8b6b-4c5d-41d4-9326-8a07d4f4dfc5"/>
					<box leftPadding="2" rightPadding="2">
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Arial" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$V{issue_qty1_1}]]></textFieldExpression>
				</textField>
				<textField isStretchWithOverflow="true" pattern="#,##0.00" isBlankWhenNull="true">
					<reportElement stretchType="RelativeToTallestObject" mode="Opaque" x="1028" y="0" width="102" height="17" backcolor="#99CCFF" uuid="a11006af-27d3-45f3-af06-f6e941bb909a"/>
					<box leftPadding="2" rightPadding="2">
						<topPen lineWidth="0.5"/>
						<leftPen lineWidth="0.5"/>
						<bottomPen lineWidth="0.5"/>
						<rightPen lineWidth="0.5"/>
