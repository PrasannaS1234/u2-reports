<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RMInvoiceGP" pageWidth="1671" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1631" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="120"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'USD'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="rate" class="java.lang.String">
		<defaultValueExpression><![CDATA["'CP'"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_invoice_list as
(
select
	im.inv_id,
	im.inv_type,
	concat(im.inv_type,'-',im.inv_no) inv_type_no,
   im.reference_no,
    im.inv_dt,
   to_char(im.inv_dt,$P{dateFormat}) invoice_dt,
   im.currency,
   im.company_id,
   cmp.company_name,
   im.customer_id,
   cs.customer_name,
   lt.lot_id,
   lt.lot_code,
   cm.commodity_name,
   shp.shape_name,
   lt.mm_size,
   cla.clarity_name,
   dt.inv_qty1,
   dt.inv_qty2,
   dt.uom1,
   dt.uom2,
	case when im.currency = 'USD' then dt.input_rate else dt.input_rate / nullif(im.exchange_rate,0) end sp_rate,
    case when im.currency = 'USD' then lp.cost_price else lp.cost_price / nullif(im.exchange_rate,0) end cp_rate
from tbl_sales_invoice_main im
inner join tbl_sales_invoice_det dt on im.inv_id = dt.inv_id
	 and dt.is_deleted = 0
inner join tbl_company cmp on im.company_id = cmp.company_id
inner join tbl_customer cs on im.customer_id = cs.customer_id
	and (cs.customer_name like concat(trim($P!{customerLike}),'%%'))
inner join tbl_lot lt on dt.lot_id = lt.lot_id
inner join tbl_commodity cm on lt.commodity_id = cm.commodity_id
left join tbl_shape shp on lt.shape_id = shp.shape_id
left join tbl_clarity cla on lt.clarity_id = cla.clarity_id
left join tbl_lot_price_det lp on lt.lot_id = lp.lot_id
               and im.company_id = lp.company_id
where
     im.is_deleted = 0
	 and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
	 and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
	 and (lt.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
)
select
  txt.*,
  txt.inv_qty1 * txt.pp_rate pp_amount,
txt.sp_amount - (txt.inv_qty1 * txt.pp_rate) gross_profit,
  ((txt.sp_amount - (txt.inv_qty1 * txt.pp_rate))/(nullif((txt.inv_qty1 * txt.pp_rate),0) ) )   gp_per
from
(
select
   res.*,
   res.inv_qty1 * res.sp_rate sp_amount,
	case when $P!{rate} = 'CP' then res.cp_rate else fn_rm_pp_wac(lot_id,company_id,res.invoice_dt, $P{dateFormat},$P{currency}) end pp_rate
from
(
select
   ml.inv_type_no,
   ml.reference_no,
   ml.invoice_dt,
   ml.inv_dt,
   ml.currency,
   ml.company_id,
   ml.company_name,
   ml.customer_id,
   ml.customer_name,
   ml.lot_id,
   ml.lot_code,
   ml.commodity_name,
   ml.shape_name,
   ml.mm_size,
   ml.clarity_name,
   ml.inv_qty1,
   ml.inv_qty2,
   ml.uom1,
   ml.uom2,
   case when $P{currency} = 'USD' then ml.sp_rate else ml.sp_rate * (case when fn_get_exchange_rate($P{currency},ml.company_id,$P{dateFormat},ml.invoice_dt) is null then 1 else fn_get_exchange_rate($P{currency},ml.company_id,$P{dateFormat},ml.invoice_dt) end ) end sp_rate,
   case when $P{currency} = 'USD' then ml.cp_rate else ml.cp_rate * (case when fn_get_exchange_rate($P{currency},ml.company_id,$P{dateFormat},ml.invoice_dt) is null then 1 else fn_get_exchange_rate($P{currency},ml.company_id,$P{dateFormat},ml.invoice_dt) end ) end cp_rate
from w_invoice_list ml
) res ) txt
order by inv_type_no desc]]>
	</queryString>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="reference_no" class="java.lang.String"/>
	<field name="invoice_dt" class="java.lang.String"/>
	<field name="inv_dt" class="java.sql.Date"/>
	<field name="currency" class="java.lang.String"/>
	<field name="company_id" class="java.lang.Integer"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="customer_id" class="java.lang.Integer"/>
	<field name="customer_name" class="java.lang.String"/>
	<field name="lot_id" class="java.lang.Integer"/>
	<field name="lot_code" class="java.lang.String"/>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="clarity_name" class="java.lang.String"/>
	<field name="inv_qty1" class="java.math.BigDecimal"/>
	<field name="inv_qty2" class="java.math.BigDecimal"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="uom2" class="java.lang.String"/>
	<field name="sp_rate" class="java.math.BigDecimal"/>
	<field name="cp_rate" class="java.math.BigDecimal"/>
	<field name="sp_amount" class="java.math.BigDecimal"/>
	<field name="pp_rate" class="java.math.BigDecimal"/>
	<field name="pp_amount" class="java.math.BigDecimal"/>
	<field name="gross_profit" class="java.math.BigDecimal"/>
	<field name="gp_per" class="java.math.BigDecimal"/>
	<variable name="inv_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
	</variable>
	<variable name="inv_qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
	</variable>
	<variable name="v_pp_amount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{pp_amount}]]></variableExpression>
	</variable>
	<variable name="sp_amount_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{sp_amount}]]></variableExpression>
	</variable>
	<variable name="gross_profit_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_profit}]]></variableExpression>
	</variable>
