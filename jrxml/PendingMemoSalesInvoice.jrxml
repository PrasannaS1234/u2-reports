	<field name="input_rate" class="java.math.BigDecimal"/>
	<field name="input_amt" class="java.math.BigDecimal"/>
	<field name="discount_type" class="java.lang.String"/>
	<field name="discount_value" class="java.math.BigDecimal"/>
	<field name="cost_price" class="java.math.BigDecimal"/>
	<field name="cost_price_code" class="java.lang.String"/>
	<variable name="inv_qty1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
	</variable>
	<variable name="inv_qty2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
	</variable>
	<variable name="input_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
	</variable>
	<variable name="cost_price_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{cost_price}]]></variableExpression>
	</variable>
	<variable name="tot_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
	</variable>
