	<field name="customer_name" class="java.lang.String"/>
	<field name="product_no" class="java.lang.String"/>
	<field name="company_name" class="java.lang.String"/>
	<field name="uom1" class="java.lang.String"/>
	<field name="uom2" class="java.lang.String"/>
	<field name="prod_description" class="java.lang.String"/>
	<field name="inv_qty1" class="java.math.BigDecimal"/>
