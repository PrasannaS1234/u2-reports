<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PendingMemoSalesInvoice" pageWidth="1690" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1650" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5000000000000002"/>
	<property name="ireport.x" value="824"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["'%%'"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="customerId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    im.inv_id,
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    tcus.display_name   customer_code,
    tcus.customer_name,
    prod.lot_code product_no,
    tcomp.company_name,
    id.uom1,
    id.uom2,
    id.lot_description prod_description,
    (id.inv_qty1 - id.conf_qty1 - id.ret_qty1) inv_qty1,
    (id.inv_qty2 - id.conf_qty2 - id.ret_qty2) inv_qty2,
    id.input_rate,
    ((id.inv_qty1 - id.conf_qty1 - id.ret_qty1) * id.input_rate) input_amt,
    id.discount_type,
    id.discount_value,
    id.cost_price,
    prod.cost_price_code
from
    tbl_memo_sales_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join tbl_memo_sales_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join tbl_customer tcus on im.customer_id = tcus.customer_id
	and (lower(tcus.customer_name) like concat(lower(trim($P!{customerLike})),'%%'))
    inner join tbl_lot prod on id.lot_id = prod.lot_id
where
    im.is_deleted = 0
    and ((id.inv_qty1 - id.conf_qty1 - id.ret_qty1) <> 0 or (id.inv_qty2 - id.conf_qty2 - id.ret_qty2) <> 0)
    and (prod.commodity_id  in ($P!{commodityId}) or '-1' in ($P!{commodityId}))
    and (prod.commodity_group_id  in ($P!{commodityGroupId}) or '-1' in ($P!{commodityGroupId}))
    and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
order by
	im.inv_dt,
	im.inv_id]]>
	</queryString>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="inv_type_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="inv_due_dt" class="java.lang.String"/>
	<field name="currency" class="java.lang.String"/>
	<field name="exchange_rate" class="java.math.BigDecimal"/>
	<field name="reference_no" class="java.lang.String"/>
