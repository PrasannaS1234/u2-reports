					<reportElement key="textField" stretchType="RelativeToTallestObject" x="105" y="83" width="109" height="18" isRemoveLineWhenBlank="true" isPrintWhenDetailOverflows="true" uuid="6b8295cc-5ac0-4cf9-a0d7-15bcb10cf384"/>
					<box leftPadding="2" rightPadding="2">
