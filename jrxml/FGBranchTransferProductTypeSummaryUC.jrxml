		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    MAX(t.transfer_id) transfer_id,
    ROW_NUMBER() OVER (ORDER BY pdt.product_type_name) sno,
    MAX(CONCAT(t.transfer_type,'-',t.transfer_no)) inv_type_no,
    MAX(TO_CHAR(t.transfer_dt,'dd/MM/yyyy')) inv_dt,
    MAX(sb.company_name) from_company_name,
    MAX(CONCAT(sb.street,',',sb.area)) from_area,
    MAX(CONCAT(sb.city,',',sb.state,',',sbc.country_name,',',sb.pin_code)) from_city,
    MAX(CONCAT('Phone: ',sb.phone_number,'  Fax: ', sb.fax_no)) from_phone_no,
    MAX(db.company_name) to_company_name,
    MAX(CONCAT(db.street,',',db.area)) to_area,
    MAX(CONCAT(db.city,',',db.state,',',dbc.country_name,',',db.pin_code)) to_city,
    MAX(CONCAT('Phone: ',db.phone_number,'  Fax: ', db.fax_no)) to_no,
    MAX(b.bin_name) source_bin,
    MAX(destb.bin_name) dest_bin,
    MAX(CONCAT(jew.jew_type,jew.jew_no)) jewel_no,
    MAX(sku.sku_no) sku_no,
    MAX(det.description) description,

    SUM(det.qty) qty,
    SUM(det.input_rate * det.qty) input_amt,

    MAX(t.remarks) remarks,
    MAX(lot.lot_code) lot_code,
    pdt.product_type_name,
    MAX(t.reference_no) reference_no,
    MAX(t.currency) currency,

    SUM(COALESCE(jew.gross_wt,0)) gross_wt,
    SUM(COALESCE(jew.net_wt,0)) net_wt,
    SUM(COALESCE(jc.stone_wt,0)) stone_wt,
   COUNT(det.transfer_det_id) AS detail_count

FROM tbl_jew_branch_transfer t
INNER JOIN tbl_jew_branch_transfer_det det
    ON t.transfer_id = det.transfer_id
    AND det.is_deleted = 0
INNER JOIN tbl_bin b
    ON t.source_bin_id = b.bin_id
INNER JOIN tbl_bin destb
    ON t.dest_bin_id = destb.bin_id
INNER JOIN tbl_company db
    ON t.dest_branch_id = db.company_id
INNER JOIN tbl_jewellery jew
    ON det.jew_id = jew.jew_id
left join
(
  select
      j.jew_id,
      sum(j.consumed_qty1) as stone_wt
  from  tbl_jewellery_component j
  inner join tbl_commodity c on j.commodity_id = c.commodity_id
where
    c.metal_type not in ('GOLD','SILVER','PLATINUM')
group by j.jew_id
)jc on jc.jew_id = jew.jew_id
INNER JOIN tbl_sku sku
    ON jew.sku_id = sku.sku_id
LEFT JOIN tbl_lot lot
    ON jew.metal_id = lot.lot_id
LEFT JOIN tbl_product_type pdt
    ON jew.product_type_id = pdt.product_type_id
INNER JOIN tbl_company sb
    ON t.company_id = sb.company_id
LEFT JOIN tbl_country sbc
    ON sb.country_id = sbc.country_id
LEFT JOIN tbl_country dbc
    ON db.country_id = dbc.country_id
WHERE
    t.is_deleted = 0
    AND t.transfer_id = $P!{i_inv_id}
GROUP BY
    pdt.product_type_name
ORDER BY
    pdt.product_type_name;]]>
	</queryString>
