<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetailsDTN_subreport1" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="6236be29-4c0f-4c3b-b067-a12bfb1971a6">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_so_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
	select
            lot.lot_code,
            acc.pcs,
            acc.weight

  from tbl_sales_order_main som
 inner join tbl_sales_order_det sod on som.sales_order_id = sod.sales_order_id
   and sod.is_deleted = 0
 inner join tbl_sales_order_accessories acc on sod.sales_order_det_id = acc.sales_order_id
  left join tbl_lot lot on acc.lot_id = lot.lot_id
 where
      som.is_deleted = 0
      and acc.sales_order_det_id =  $P!{i_so_det_id}
)
select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
    NULL AS lot_code,
    NULL AS pcs,
    NULL AS weight
FROM generate_series(1, 5-(select count(*) from w_result_set))]]>
	</queryString>
	<field name="lot_code" class="java.lang.String"/>
	<field name="pcs" class="java.math.BigDecimal"/>
	<field name="weight" class="java.math.BigDecimal"/>
