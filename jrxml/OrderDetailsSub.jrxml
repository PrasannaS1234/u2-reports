<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrderDetailsSub" pageWidth="549" pageHeight="842" columnWidth="549" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="41f0b751-4f50-47aa-a424-779d8d66a782">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="18"/>
	<property name="ireport.y" value="0"/>
	<parameter name="i_so_det_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[with w_result_set as (
	select
       cm.commodity_name,
       shp.shape_name,
       socm.mm_size,
       socm.tot_qty qty1,
       socm.qty2
  from tbl_sales_order_main som
 inner join tbl_sales_order_det sod on som.sales_order_id = sod.sales_order_id
   and sod.is_deleted = 0
 inner join tbl_sales_order_component socm on sod.sales_order_det_id = socm.sales_order_det_id
   and socm.is_deleted = 0
 left join tbl_lot lot on socm.lot_id = lot.lot_id
 left join tbl_commodity cm on socm.commodity_id = cm.commodity_id
 left join tbl_shape shp on socm.shape_id = shp.shape_id
 where
      som.is_deleted = 0
      and sod.sales_order_det_id = $P!{i_so_det_id}
)
select
rr.*
from
  w_result_set rr
UNION ALL
SELECT
    NULL AS commodity_name,
    NULL AS shape_name,
    NULL AS mm_size,
    NULL AS qty1,
    NULL AS qty2
FROM generate_series(1, 5-(select count(*) from w_result_set))]]>
	</queryString>
	<field name="commodity_name" class="java.lang.String"/>
	<field name="shape_name" class="java.lang.String"/>
	<field name="mm_size" class="java.lang.String"/>
	<field name="qty1" class="java.math.BigDecimal"/>
	<field name="qty2" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<detail>
