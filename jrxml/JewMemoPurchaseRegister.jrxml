	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewTypeNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="marketId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="designId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select tp.* from
(
Select
   im.inv_dt dt,
   im.inv_type,
   im.inv_id,
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    emp.first_name||'-'||emp.last_name buyer_name,
    tcus.supplier_name,
    concat(prod.jew_type,prod.jew_no) product_no,
    pt.product_type_name,
    mk.market_name,
    col.collection_name,
    prod.design_no,
    prod.sku_no,
    tcomp.company_name,
    id.prod_description,
    id.inv_qty,
    id.uom,
    id.input_rate,
    id.input_amt,
    id.discount_type,
    id.discount_value,
    id.cost_price
from
    $P!{schema}.tbl_jew_memo_purchase_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join $P!{schema}.tbl_jew_memo_purchase_invoice_det id on im.inv_id = id.inv_id
        and (cast(id.bin_id as text) in ($P!{binId}) or '-1' in ($P!{binId}))
        and id.is_deleted = 0
    inner join $P!{schema}.tbl_supplier tcus on im.supplier_id = tcus.supplier_id
    inner join $P!{schema}.tbl_jewellery prod on id.jew_id = prod.jew_id
    and (cast(prod.jew_id as text) in ($P!{jewId}) or '-1' in ($P!{jewId}))
    and (cast(prod.design_id as text) in ($P!{designId}) or '-1' in ($P!{designId}))
    and (cast(prod.sku_id as text) in ($P!{skuId}) or '-1' in ($P!{skuId}))
    left join $P!{schema}.tbl_employee emp on im.buyer_id = emp.employee_id
left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
    and (cast(pt.product_type_id as text) in ($P!{productTypeId}) or '-1' in ($P!{productTypeId}))
left join tbl_market mk on prod.market_id = mk.market_id
    and (cast(mk.market_id as text) in ($P!{marketId}) or '-1' in ($P!{marketId}))
left join tbl_collection col on prod.collection_id = col.collection_id
    and (cast(col.collection_id as text) in ($P!{collectionId}) or '-1' in ($P!{collectionId}))
where
    im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    and (cast(tcus.supplier_id as text) in ($P!{supplierId}) or '-1' in ($P!{supplierId}))
union all
Select
   im.inv_dt dt,
   im.inv_type,
   im.inv_id,
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat})     inv_due_dt,
    im.currency,
    im.exchange_rate,
    im.reference_no,
    emp.first_name||'-'||emp.last_name buyer_name,
    tcus.supplier_name,
    concat(prod.jew_type,prod.jew_no) product_no,
    pt.product_type_name,
    mk.market_name,
    col.collection_name,
    prod.design_no,
    prod.sku_no,
    tcomp.company_name,
    id.prod_description,
    -id.inv_qty,
    id.uom,
    -id.input_rate,
    -id.input_amt,
    id.discount_type,
    -id.discount_value,
    -id.cost_price
from
    $P!{schema}.tbl_jew_memo_purchase_return_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join $P!{schema}.tbl_jew_memo_purchase_return_invoice_det id on im.inv_id = id.inv_id
        and (cast(id.bin_id as text) in ($P!{binId}) or '-1' in ($P!{binId}))
        and id.is_deleted = 0
    inner join $P!{schema}.tbl_supplier tcus on im.supplier_id = tcus.supplier_id
    inner join $P!{schema}.tbl_jewellery prod on id.jew_id = prod.jew_id
    and (cast(prod.jew_id as text) in ($P!{jewId}) or '-1' in ($P!{jewId}))
    and (cast(prod.design_id as text) in ($P!{designId}) or '-1' in ($P!{designId}))
    and (cast(prod.sku_id as text) in ($P!{skuId}) or '-1' in ($P!{skuId}))
    left join $P!{schema}.tbl_employee emp on im.buyer_id = emp.employee_id
left join tbl_product_type pt on prod.product_type_id = pt.product_type_id
    and (cast(pt.product_type_id as text) in ($P!{productTypeId}) or '-1' in ($P!{productTypeId}))
left join tbl_market mk on prod.market_id = mk.market_id
    and (cast(mk.market_id as text) in ($P!{marketId}) or '-1' in ($P!{marketId}))
left join tbl_collection col on prod.collection_id = col.collection_id
    and (cast(col.collection_id as text) in ($P!{collectionId}) or '-1' in ($P!{collectionId}))
where
    im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    and (cast(tcus.supplier_id as text) in ($P!{supplierId}) or '-1' in ($P!{supplierId}))
) tp
Order by
tp.dt,
tp.inv_type,
tp.inv_id]]>
	</queryString>
