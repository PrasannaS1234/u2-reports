					</textElement>
					<text><![CDATA[laws and regulations in relation to export of these products from HONG KONG and for compliance with all laws and regulations in relation to the import of these ]]></text>
				</staticText>
				<staticText>
					<reportElement key="" stretchType="RelativeToTallestObject" x="0" y="61" width="575" height="12" isPrintWhenDetailOverflows="true" uuid="fd7c347b-14ee-49e3-9ca7-668d54e55a02"/>
