	<subDataset name="details" whenResourceMissingType="Empty" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'FSIL'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[WITH dt AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY id.inv_det_id) srno,
        id.inv_id,
        lot.lot_code AS lot,
        id.inv_qty1,
        id.inv_qty2,
        id.input_rate,
        id.input_amt,
        m.currency,

        (
            COALESCE(lot.lab_shape_description, '-') || '/' ||
            COALESCE(lot.lab_color, '-') || '/' ||
            COALESCE(lot.lab_clarity, '-') || '/' ||
            COALESCE(lot.lab_cut, '-') || '/' ||
            COALESCE(lot.lab_polish, '-') || '/' ||
            COALESCE(lot.lab_symmetry, '-') || '/' ||
            COALESCE(lot.lab_fluorescences_color, '-') || ' (' ||
            COALESCE(lot.lab_name, '-') || '-' ||
            COALESCE(lot.certificate_no, '-') || '-' ||
            COALESCE(CONCAT(mi.inv_type, '-', mi.inv_no), '')
            || ' )'
        ) AS description

    FROM tbl_sales_invoice_det id
    INNER JOIN tbl_sales_invoice_main m
        ON id.inv_id = m.inv_id
    INNER JOIN tbl_lot lot
        ON id.lot_id = lot.lot_id
    LEFT JOIN tbl_memo_sales_invoice_main mi
        ON id.ref_inv_id = mi.inv_id

    WHERE
        id.is_deleted = 0
        AND id.inv_id = $P!{i_inv_id}
),

row_count AS (
    SELECT COUNT(*) AS cnt FROM dt
),

dm AS (
    SELECT GENERATE_SERIES(
        1,
        GREATEST(1, (SELECT cnt FROM row_count))
    ) AS srno
)

SELECT
    dm.srno,
    dt.inv_id,
    dt.lot,
    dt.inv_qty1,
    dt.inv_qty2,
    dt.input_rate,
    dt.input_amt,
    dt.currency,
    dt.description
FROM dm
LEFT JOIN dt
    ON dm.srno = dt.srno
ORDER BY dm.srno;]]>
		</queryString>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="lot" class="java.lang.String"/>
		<field name="inv_qty1" class="java.math.BigDecimal"/>
		<field name="inv_qty2" class="java.math.BigDecimal"/>
		<field name="input_rate" class="java.math.BigDecimal"/>
		<field name="input_amt" class="java.math.BigDecimal"/>
		<field name="currency" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<variable name="QTY" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<variable name="total_pcs" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty2}]]></variableExpression>
		</variable>
		<variable name="total_ct" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{inv_qty1}]]></variableExpression>
		</variable>
		<variable name="total_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{input_amt}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[""]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="otherCharges" uuid="ae07db0d-4235-4eb6-9024-6e785feda5e3">
		<parameter name="i_inv_id" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="invType" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
		</parameter>
		<parameter name="schema" class="java.lang.String">
			<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    0 as sort_seq,
    sal_chg.charge_name,
    sal_chg.plus_minus_flag * sal_chg.input_amt as amount,
    concat(cu.currency_code, cu.symbol) as currency
from
    tbl_memo_sales_invoice_chgs sal_chg
    inner join tbl_memo_sales_invoice_main m
        on m.inv_id = $P!{i_inv_id}
    left join tbl_currency cu
        on m.currency = cu.currency_code
where
    sal_chg.is_deleted = 0
    and sal_chg.inv_id = $P!{i_inv_id}

union all

-- Default row when no charges exist
select
    0 as sort_seq,
    'Other Charges' as charge_name,
    0.00 as amount,
    concat(cu.currency_code, cu.symbol) as currency
from
    tbl_memo_sales_invoice_main m
    left join tbl_currency cu
        on m.currency = cu.currency_code
where
    m.inv_id = $P!{i_inv_id}
    and not exists (
        select 1
        from tbl_memo_sales_invoice_chgs sc
        where sc.inv_id = $P!{i_inv_id}
        and sc.is_deleted = 0
    )

order by
    sort_seq;]]>
		</queryString>
		<field name="sort_seq" class="java.lang.Integer"/>
		<field name="charge_name" class="java.lang.String"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="currency" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1" uuid="8190a75c-e29d-47b9-87e5-7092080175be"/>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd/mm/yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
ROW_NUMBER() OVER ( ORDER BY $P!{sortColumn}) AS sr_no,
tmp.*
from
(
select
    ROW_NUMBER() OVER (PARTITION BY im.inv_id ORDER BY id.inv_det_id) AS s_no,
    tcomp.company_name,
    im.inv_id,
    im.inv_type,
    id.inv_det_id,
    im.inv_due_dt as due_dt,
    concat(cu.currency_code,' ',cu.symbol) as currency,
    concat(cu.currency_code,cu.symbol) as currency1,
    s.first_name as sales_man,
    im.inv_type||'-'||im.inv_no as inv_type_no,
    to_char(im.inv_dt, coalesce(tcomp.date_format,'dd/MM/yyyy')) as inv_dt,
    pyt.payment_type_name as payment_term,
    tsup.customer_name,
    concat(coalesce(im.bill_address1,''),',') bill_addr1,
    coalesce(im.bill_address2,'') bill_addr2,
    coalesce(im.bill_country,'') bill_country,
    coalesce(im.bill_state,'') bill_state,
    coalesce(im.bill_city,'') bill_city,
    coalesce(im.bill_street,'') bill_street,
    coalesce(im.bill_pincode,'') bill_pincode,
    coalesce(im.bill_contact_no,'') bill_ph_no,
    coalesce(tcomp.street,'') address1,
    coalesce(tcou.country_name,'') address2,
    ('Tel.:' ||coalesce(tcomp.phone_number,'') ||
     ' E-mail : ' || coalesce(tcomp.email, '') ||' ' ||
     coalesce(tcomp.website,'')) address3,
    tcomp.email comp_email,
    tcomp.phone_number comp_phone_no,
    tcomp.website comp_website,
    coalesce(tcomp.payment_address,'') payment_address,
    coalesce(im.terms_conditions,'') terms_conditions,
    im.total_invoice_amount as grossAmount,
    coalesce(cmbnk.beneficiary_name,'') benificiary_name,
    coalesce(cmbnk.bank_name,'') bank_name,
    coalesce(cmbnk.bank_account_number,'') bank_account_number,
    coalesce(cmbnk.ifsc_code,'') ifsc_code,
    coalesce(cmbnk.ad_code,'') as bank_code,
    coalesce(cmbnk.wire_transfer,'') as branch_code,
    cmbnk.routing,
    coalesce(cmbnk.bank_address,'') bank_address,
    fn_amount_to_words(im.total_invoice_net_amount,im.currency,'Dollars','Cents') amount_in_words,
    case when im.total_charge_plus_amount + im.total_charge_minus_amount > 0 then 1 else 0 end show_chgs,
    im.total_invoice_net_amount tot_amt,
    im.total_invoice_amount tot_inv_amt,
    im.total_invoice_qty1 tot_qty1,
    im.total_invoice_qty2 tot_qty2,
    id.inv_id,
        lot.lot_code AS lot_no,
com.commodity_id,
        id.inv_qty1,
        id.inv_qty2,
        id.input_rate,
        id.input_amt,
         (
    COALESCE(lot.shape_description, ' - ') || '/' ||
    COALESCE(cl.color_code, ' - ') || '/' ||
    COALESCE(cla.clarity_code, ' - ') || '/' ||
    COALESCE(cut.cut_code, ' - ') || '/' ||
    COALESCE(lot.polish, ' - ') || '/' ||
    COALESCE(lot.symmetry, ' - ') || '/' ||
    COALESCE(lot.fluorescence, '-') || ' (' ||
    COALESCE(lot.lab_name, '-') || '-' ||
    COALESCE(lot.certificate_no, '-') ||
    ' )'
) AS description,
      concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},
          'comp',tcomp.company_id,'/RJC_LOGO.jpeg') as logo_image,
          concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},
         'comp',tcomp.company_id,'/company/',tcomp.company_id,tcomp.log_url) comp_logo,
         pm.parameter_name as origin

from
    tbl_memo_sales_invoice_main im
    inner join tbl_company tcomp on im.company_id = tcomp.company_id
    left join tbl_country tcou on tcomp.country_id= tcou.country_id
    inner join tbl_memo_sales_invoice_det id on im.inv_id = id.inv_id and id.is_deleted = 0
    left join tbl_currency cu on im.currency = cu.currency_code
    left join tbl_employee s on im.salesman_id = s.employee_id
    inner join tbl_customer tsup on im.customer_id = tsup.customer_id
    inner join tbl_payment_type pyt on im.payment_type_id = pyt.payment_type_id
    left join tbl_company_bank cmbnk on im.bank_id = cmbnk.map_id
    INNER JOIN tbl_lot lot
        ON id.lot_id = lot.lot_id
left join tbl_commodity com on lot.commodity_id = com.commodity_id
	left join tbl_color cl on lot.color_id = cl.color_id
	left join tbl_clarity cla on lot.clarity_id = cla.clarity_id
	left join tbl_cut cut on lot.cut_id = cut.cut_id

    left join tbl_global_parameter pm on pm.parameter_code = im.origin_code
where
    im.is_deleted = 0
    and im.inv_id in ($P!{i_inv_id})
order by id.inv_det_id
)tmp
order by $P!{sortColumn}]]>
	</queryString>
