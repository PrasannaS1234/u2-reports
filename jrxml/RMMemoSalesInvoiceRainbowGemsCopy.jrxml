					<textElement verticalAlignment="Middle">
						<font fontName="Calibri" size="7" isBold="false" isUnderline="false" pdfFontName="Helvetica"/>
					</textElement>
					<text><![CDATA[2)The Seller reserves the right to seek identification of the source of the funds received. Please note that you, the Customer, are responsible for compliance with all ]]></text>
