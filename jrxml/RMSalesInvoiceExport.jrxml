	<subDataset name="details" uuid="5ba95d18-556f-48fa-9547-9f4e105fc96f">
		<parameter name="i_inv_id" class="java.lang.String">
			<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
		</parameter>
		<parameter name="parameter1" class="java.lang.String"/>
		<parameter name="sortColumn" class="java.lang.String">
			<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
    row_number() over(order by $P!{sortColumn}) sno,
    tmp.*
from
(
select
     row_number() over(order by d.inv_det_id) srno,
     m.inv_Id,
	 m.inv_type,
           m.currency,
	 d.lot_description,
	 d.inv_qty1 qty1,
	 d.inv_qty2 qty2,
	 d.input_rate rate,
	 d.input_amt amount,
           lot.lot_code lot_no,
           com.commodity_id,
           d.inv_det_id
from tbl_sales_invoice_main m
inner join tbl_sales_invoice_det d on m.inv_id = d.inv_id
   and d.is_deleted = 0
inner join tbl_lot lot on d.lot_id = lot.lot_id
left join tbl_commodity com on lot.commodity_id = com.commodity_id
where
    m.inv_id in ($P!{i_inv_id})
    and m.is_deleted = 0
)tmp
order by $P!{sortColumn}]]>
		</queryString>
		<field name="sno" class="java.lang.Long"/>
		<field name="srno" class="java.lang.Long"/>
		<field name="inv_id" class="java.lang.Integer"/>
		<field name="inv_type" class="java.lang.String"/>
		<field name="currency" class="java.lang.String"/>
		<field name="lot_description" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
		<field name="rate" class="java.math.BigDecimal"/>
		<field name="amount" class="java.math.BigDecimal"/>
		<field name="lot_no" class="java.lang.String"/>
		<field name="commodity_id" class="java.lang.Integer"/>
		<field name="inv_det_id" class="java.lang.Integer"/>
		<variable name="QTY" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{qty2}]]></variableExpression>
		</variable>
		<variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{amount}]]></variableExpression>
		</variable>
		<variable name="GROSS_WT" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{qty1}]]></variableExpression>
		</variable>
		<group name="group1">
			<groupExpression><![CDATA[$F{lot_description}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="sortColumn" class="java.lang.String">
		<defaultValueExpression><![CDATA["tmp.inv_det_id asc"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    row_number() over(order by $P!{sortColumn}) sno,
    tmp.*
from
(
select
	m.inv_id,
	max(m.inv_type) inv_type,
	max(m.inv_type||m.inv_no) invoiceNo,
	to_char(max(m.inv_dt),'dd/mm/yyyy') invoiceDt,
	to_char(max(m.inv_due_dt),'dd/mm/yyyy') invoiceDueDt,
          max(d.inv_det_id) inv_det_id,
	max(m.inv_due_days) invoiceDueDays,
	max(m.tracking_no) tracking_no,
	max(m.shipment_company_name) shipment_company_name,
	max(m.currency) currency,
	max(cm.company_name) ExporterName,
	max(cm.street) ExporterStreet,
	max(cm.area) ExporterArea,
	max(cm.city) ExporterCity,
	max(ct.country_name) Exportercountry,
	max(cm.state||'-'||cm.pin_code) ExporterstateCode,
	max(cm.mobile_no) ExporterMobile,
	max(cm.email) ExporterEmail,
	max(cb.bank_name) ExporterBankName,
	max(cb.bank_account_number) ExporterBankAccNo,
	max(cb.beneficiary_name) ExporterBenificiaryName,
	max(cb.ifsc_code) ExporterIFSCcode,
	max(cb.Bank_Address) ExporterBankAddress,
	max(cs.customer_name) customer_name,
	max(m.bill_address1) bill_address1,
	max(m.bill_address2) bill_address2,
	max(m.bill_street) bill_street,
	max(m.bill_city) bill_city,
	max(m.bill_state||'-'||m.bill_pincode) BillpinCode,
	max(m.bill_country) bill_country,
	max(m.bill_mobile_no) bill_mobile_no,
	max(cs.primary_contact_name) bill_primary_contactName,
	max(cs.primary_contact_no) bill_primary_contactNo,
	max(cs.tax_number) bill_tax_number,
	max(cs.email) bill_email,
	max(cs.export_port) biil_export_port,
	max(cs.category) bill_category,
	max(cs.gst_number) bill_gst_number,
	max(cs.pan_number) bil_pan,
	max(cs.bank_account_number) bank_account_number,
	max(cs.beneficiary_name) bill_beneficiary,
	max(cs.bank_name) bill_name,
	max(cs.ifsc_code) bill_ifsc_code,
	max(shp.shipment_type_name) shipment_type_name,
	max(m.total_invoice_qty1) total_invoice_qty1,
	max(m.total_invoice_qty2) total_invoice_qty2,
	max(m.total_invoice_amount) total_invoice_amount,
	max(fn_amount_to_words(m.total_invoice_amount,m.currency,'','')) amountInWords,
          max(lot.lot_code) lot_no,
          max(com.commodity_id) commodity_id
from tbl_sales_invoice_main m
inner join tbl_sales_invoice_det d on m.inv_id = d.inv_id
   and d.is_deleted = 0
inner join tbl_lot lot on d.lot_id = lot.lot_id
left join tbl_commodity com on lot.commodity_id = com.commodity_id
inner join tbl_customer cs on m.customer_id = cs.customer_id
inner join tbl_company cm on m.company_id = cm.company_id
left join tbl_country ct on cm.country_id = ct.country_id
left join tbl_company_bank cb on cm.company_id = cb.company_id
left join tbl_shipment_type shp on m.shipment_type_id = shp.shipment_type_id
   and shp.is_deleted = 0
where
   m.is_deleted = 0
   and m.inv_id in ($P!{i_inv_id})
group by
   m.inv_id
)tmp
order by $P!{sortColumn}]]>
	</queryString>
