	</parameter>
	<queryString>
		<![CDATA[select
	t1.mixing_type||'-'||t1.mixing_no mixing_type_no,
	t1.mixing_dt,
	t1.currency,
	t1.exchange_rate,
	t5.company_name,
	t6.first_name,
	t7.bin_name source_bin_name,
	t3.lot_code source_lot_code,
	t8.bin_name dest_bin_name,
	t4.lot_code dest_lot_code,
	nullif(t2.source_stone_size,'NA') source_stone_size,
	nullif(t2.dest_stone_size,'NA') dest_stone_size,
	t2.qty1 mixing_qty1,
	t2.qty2 mixing_qty2,
	t3.cost_price source_cost_price,
	t4.cost_price destination_cost_price,
	t2.qty1 * t3.cost_price source_amount,
	t2.qty1 * t4.cost_price dest_amount
from
	tbl_mixing  t1
	inner join tbl_mixing_det t2 on t1.mixing_id = t2.mixing_id
		and t2.is_deleted = 0
	inner join  tbl_lot t3 on t2.source_lot_id = t3.lot_id
	inner join tbl_lot t4 on t2.dest_lot_id = t4.lot_id
	inner join  tbl_company t5 on t1.company_id = t5.company_id
	inner join  tbl_bin t7 on t2.source_bin_id = t7.bin_id
	inner join  tbl_bin t8 on t2.dest_bin_id = t8.bin_id
	left join  tbl_employee t6 on t1.created_by = t6.employee_id
where
	t1.is_deleted = 0
          and t1.mixing_id in ($P!{i_inv_id})
order by
	t1.mixing_id,
	t1.mixing_id,
	t2.mixing_det_id]]>
	</queryString>
