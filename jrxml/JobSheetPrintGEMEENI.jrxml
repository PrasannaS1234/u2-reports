	<subDataset name="component" uuid="1ea79652-c654-442e-bd83-3ef26908c386">
		<parameter name="i_jew_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[with v_comp as (
	select row_number() over (order by 1) sno,
            tx.* from (
	select
                    row_number() over (order by sc.component_id) recusrive_level,
		c.commodity_name,
		l.lot_code,
		sh.shape_name,
		sc.mm_size,
		sc.grade,
		sc.qty1,
		sc.qty2
	from
		tbl_jewellery t
		inner join tbl_sales_order_component sc on t.sales_order_det_id = sc.sales_order_det_id
			and sc.is_deleted = 0
		inner join tbl_commodity c on sc.commodity_id = c.commodity_id
		left join tbl_lot l on sc.lot_id = l.lot_id
		left join tbl_shape sh on sc.shape_id = sh.shape_id
	where
		t.jew_id in ($P!{i_jew_id}))tx
)
select
	v.*
from
	v_comp v
where
	recusrive_level between 0 and 10]]>
		</queryString>
		<field name="sno" class="java.lang.Long"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="lot_code" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="mm_size" class="java.lang.String"/>
		<field name="grade" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="component_1" uuid="29affe9d-b3f3-4089-b140-43c8c48b781c">
		<parameter name="i_jew_id" class="java.lang.String"/>
		<queryString>
			<![CDATA[with v_comp as (
	select row_number() over (order by 1) sno,
            tx.* from (
	select
                    row_number() over (order by sc.component_id) recusrive_level,
		c.commodity_name,
		l.lot_code,
		sh.shape_name,
		sc.mm_size,
		sc.grade,
		sc.qty1,
		sc.qty2
	from
		tbl_jewellery t
		inner join tbl_sales_order_component sc on t.sales_order_det_id = sc.sales_order_det_id
			and sc.is_deleted = 0
		inner join tbl_commodity c on sc.commodity_id = c.commodity_id
		left join tbl_lot l on sc.lot_id = l.lot_id
		left join tbl_shape sh on sc.shape_id = sh.shape_id
	where
		t.jew_id in ($P!{i_jew_id}))tx
)
select
	v.*
from
	v_comp v
where
	recusrive_level between 11 and 20]]>
		</queryString>
		<field name="sno" class="java.lang.Long"/>
		<field name="recusrive_level" class="java.lang.Long"/>
		<field name="commodity_name" class="java.lang.String"/>
		<field name="lot_code" class="java.lang.String"/>
		<field name="shape_name" class="java.lang.String"/>
		<field name="mm_size" class="java.lang.String"/>
		<field name="grade" class="java.lang.String"/>
		<field name="qty1" class="java.math.BigDecimal"/>
		<field name="qty2" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="i_inv_id" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["'NA'"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\flutter\\jew-trade-service\\src\\main\\resources\\jrxml\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    comp.company_name,
	concat(comp.street, comp.area, comp.city, comp.state, '-', comp.pin_code) comp_address,
	t.jew_id,
	concat(t.jew_type, t.jew_no) job_type_no,
	concat(so.sales_order_type,'-',so.sales_order_no) sales_order_no,
	sd.customer_order_no,
	s.sku_no,
	s.customer_ref_no sku_crn,
	coalesce(s.set_no,'') set_no,
	p.product_type_name,
	c.customer_name,
	sd.customer_order_no,
	f.factory_name,
	so.reference_no so_ref_no,
	concat(u.first_name,' ',u.last_name) so_created_by,
	to_char(so.delivery_date, 'dd-Mon-yyyy') delivery_date,
	to_char(so.sales_order_date, 'dd-Mon-yyyy') sales_order_date,
	ps.product_size,
	col.color_name,
	t.qty,
	t.metal_weight,
	k.karatage_name,
	t.metal1,
	t.stamping_details,
          cd.cad_no,	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',s.company_id,'/sku/',s.sku_id,s.image_url) image_url,
	t.prod_description
from
	tbl_jewellery t
	inner join tbl_sales_order_main so on t.sales_order_id = so.sales_order_id
	inner join tbl_sales_order_det sd on so.sales_order_id = sd.sales_order_id
		and t.sales_order_det_id = sd.sales_order_det_id
		and sd.is_deleted = 0
	inner join tbl_sku s on t.sku_id = s.sku_id
		and s.is_deleted = 0
	inner join tbl_product_type p on s.product_type_id = p.product_type_id
		and p.is_deleted = 0
    inner join tbl_company comp on t.company_id = comp.company_id
	inner join tbl_customer c on so.customer_id = c.customer_id
		and c.is_deleted = 0
          left join tbl_cad_order_det cd on sd.cad_order_det_id = cd.inv_det_id
	    and cd.is_deleted = 0
	left join tbl_user u on so.created_by = u.user_id
	left join tbl_factory f on so.factory_id = f.factory_id
	left join tbl_lot lot on t.metal1 = lot.lot_code
	left join tbl_color col on lot.color_id = col.color_id
	left join tbl_karatage k on lot.karatage_id = k.karatage_id
	left join tbl_product_size ps on t.product_size_id = ps.size_id
where
	(so.sales_order_id) in ($P!{i_inv_id})
order by
	so.sales_order_id,
	 sd.sales_order_det_id]]>
	</queryString>
