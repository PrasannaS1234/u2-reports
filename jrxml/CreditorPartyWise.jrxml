<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CreditorPartywise" pageWidth="1150" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1110" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	grp.company_name,
	grp.party_name,
	sum(grp.inv_amt) 		inv_amt,
	sum(grp.settled_amt)	settled_amt,
	sum(grp.pending_amt) 	pending_amt,
	sum(grp.no_due_amt)		no_due_amt,
	sum(grp.due_amt)		due_amt,
	sum(grp.d030)	d030,
	sum(grp.d3160)	d3160,
	sum(grp.d6190)	d6190,
	sum(grp.d91120)	d91120,
	sum(grp.d121180)	d121180,
	sum(grp.d181365)	d181365,
	sum(grp.gt365)		gt365
from
(
select
	de.company_name,
	de.inv_type_no,
	de.currency,
	de.exchange_rate,
	to_char(de.inv_dt,$P{dateFormat}) inv_dt,
	null	ref_no,
	null	closing_dt,
	null	pn_recv_dt,
	to_char(de.inv_due_dt,$P{dateFormat}) inv_due_dt,
	de.payment_type_name,
	de.base_amt inv_amt,
	de.base_settled_amt settled_amt,
	(de.plus_minus_flag * de.base_pending_amt) pending_amt,
	(case when to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt <= 0 then de.base_pending_amt else 0 end)	no_due_amt,
	(case when to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt > 0 then de.base_pending_amt else 0 end)	due_amt,
	to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt age_days,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 0 and 30 then de.base_pending_amt else 0 end ) 	d030,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 31 and 60 then de.base_pending_amt else 0 end ) 	d3160,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 61 and 90 then de.base_pending_amt else 0 end ) 	d6190,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 91 and 120 then de.base_pending_amt else 0 end ) 	d91120,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 121 and 180 then de.base_pending_amt else 0 end ) 	d121180,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) between 181 and 365 then de.base_pending_amt else 0 end ) 	d181365,
	(case when (to_date($P{toDate}, $P{dateFormat})- de.inv_due_dt) > 365 then de.base_pending_amt else 0 end ) 	gt365,
	de.party_name,
	concat(de.party_name,' (Payment Mode: ', de.payment_type_name,')') report_grp
from
	v_creditors de
where
	de.trans_dt <= to_date($P{toDate}, $P{dateFormat})
 	and (lower(de.party_name) like concat(lower(trim($P!{supplierLike})),'%%'))
) grp
group by
	grp.company_name,
	grp.party_name
order by
	grp.company_name,
	grp.party_name]]>
	</queryString>
