<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PurchaseRegisterBySupplier" pageWidth="1650" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1610" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="0.9982500000000016"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["demo"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="fromDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/02/2022"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="commodityGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierLike" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="supplierId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="lotCodes" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["USD"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
    tcomp.company_name,
    im.inv_id,
    im.inv_type||'-'||im.inv_no inv_type_no,
    to_char(im.inv_dt, $P{dateFormat}) inv_dt,
    to_char(im.inv_due_dt, $P{dateFormat}) inv_due_dt,

    -- Display Currency (UI parameter drives)
    im.currency as currency,

    COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate) exchange_rate,
    im.reference_no,
    tsup.supplier_name,
    prod.lot_code product_no,
    tcomg.commodity_group_name,
    tcom.commodity_name,
    sh.shape_name,
    cut.cut_name,
    col.color_name,
    cla.clarity_name,
    id.uom1,
    id.uom2,
    id.lot_description prod_description,
    id.inv_qty1,
    id.inv_qty2,

    -- Input Rate (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.input_rate / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 4)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.input_rate * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 4)
        else id.input_rate
    end as input_rate,

    -- Input Amount (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.input_amt / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.input_amt * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.input_amt
    end as input_amt,

    id.discount_type,

    -- Discount Value (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.discount_value / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.discount_value * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.discount_value
    end as discount_value,

    -- Cost Price (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.cost_price / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.cost_price * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.cost_price
    end as cost_price,

    -- Base Cost Price (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.cost_price / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.cost_price * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.cost_price
    end as base_cost_price,

    -- OCP Rate (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(0 / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(0 * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else 0
    end as ocp_rate,

    -- OCP Amount (two-way)
    case
        when $P{currency} = 'USD' and im.currency <> 'USD'
            then round(id.inv_qty1 * 0 / COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        when $P{currency} <> 'USD' and im.currency = 'USD'
            then round(id.inv_qty1 * 0 * COALESCE(fn_get_exchange_rate(tcomp.company_id, to_char(im.inv_dt,$P{dateFormat}), $P{dateFormat}, $P{currency}), im.exchange_rate), 2)
        else id.inv_qty1 * 0
    end as ocp_amount,

    null commission_type,
    null commission_value,
    id.cost_price_code,
    prod.mm_size

from
    public.tbl_purchase_invoice_main im
    inner join public.tbl_company tcomp on im.company_id = tcomp.company_id
    inner join public.tbl_purchase_invoice_det id on im.inv_id = id.inv_id
        and id.is_deleted = 0
    inner join public.tbl_supplier tsup on im.supplier_id = tsup.supplier_id
    inner join public.tbl_lot prod on id.lot_id = prod.lot_id
    inner join public.tbl_commodity tcom on prod.commodity_id = tcom.commodity_id
    inner join public.tbl_commodity_group tcomg on tcom.commodity_group_id = tcomg.commodity_group_id
    left join public.tbl_shape sh on prod.shape_id = sh.shape_id
    left join public.tbl_cut cut on prod.cut_id = cut.cut_id
    left join public.tbl_color col on prod.color_id = col.color_id
    left join public.tbl_clarity cla on prod.clarity_id = cla.clarity_id
where
    im.is_deleted = 0
    and im.inv_dt >= to_date($P{fromDate}, $P{dateFormat})
    and im.inv_dt <= to_date($P{toDate}, $P{dateFormat})
    and (cast(tsup.supplier_id  as text) in ($P!{supplierId}) or '-1' in ($P!{supplierId}))
    and (cast(prod.commodity_id as text) in ($P!{commodityId}) or '-1' in ($P!{commodityId}))
    and (cast(prod.commodity_group_id as text) in ($P!{commodityGroupId}) or '-1' in ($P!{commodityGroupId}))
    and (prod.lot_code in ($P!{lotCodes}) or ' ' in ($P!{lotCodes}))
     AND ((im.company_id = $P!{companyId}) or (-1 = $P!{companyId}))
order by
    im.inv_dt,
    im.inv_id;]]>
	</queryString>
