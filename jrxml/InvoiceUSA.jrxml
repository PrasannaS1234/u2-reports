	<subDataset name="Table Dataset 1" uuid="47953aba-163e-4687-97c0-70005d8b17dd">
		<parameter name="invId" class="java.lang.Integer"/>
		<queryString>
			<![CDATA[select
	tp.grp,
	sum(tp.net_wt)	net_wt,
	sum(tp.pcs) pcs,
	sum(tp.unit_amt)		unit_amt
from
(
select
	im.items	grp,
	max(im.cref)	jobno,
	sum(im.total_gross_wt)	net_wt,
	sum(1.0) pcs,
	sum(round(im.total_amount * 0.60,2))		unit_amt
from
	tbl_invoice_summary im
where
	im.inv_id = $P!{invId}
	and im.is_deleted = 0
group by
im.items,
im.cref
) tp group by tp.grp]]>
		</queryString>
		<field name="grp" class="java.lang.String"/>
		<field name="net_wt" class="java.math.BigDecimal"/>
		<field name="pcs" class="java.math.BigDecimal"/>
		<field name="unit_amt" class="java.math.BigDecimal"/>
		<variable name="v_tot_net_wt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{net_wt}]]></variableExpression>
		</variable>
		<variable name="v_tot_pcs" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{pcs}]]></variableExpression>
		</variable>
		<variable name="v_tot_amt" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{unit_amt}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="invId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over(order by im.items,im.style_no,im.cref) sr_no,
	im.cref jobno,
	(im.style_no) styleno,
	concat(im.metal, 'T ', im.items, ' SET WITH DIAMOND') description,
	(total_gross_wt) gross_wt,
	1.0 qty,
	round(im.total_amount * 0.60,2)	unit_price,
	round(im.total_amount * 0.60,2)	unit_amt,
  	'Total Weight  goldt.(gms.)' total_met_desc,
	inv_main.inv_no,
           to_char(inv_main.inv_dt,'DD-Mon-YYYY') inv_dt,
          im.inv_id,
          spellnumericvalue(sum(round(im.total_amount * 0.60,2)) over(), 'USD') words,
	inv_main.customer_name
from
	tbl_invoice_summary im
	inner join tbl_invoice_main inv_main on im.inv_id = inv_main.inv_id
where
	im.inv_id = $P!{invId} order by im.items,im.style_no,im.cref]]>
	</queryString>
	<field name="sr_no" class="java.lang.Long"/>
	<field name="jobno" class="java.lang.String"/>
	<field name="styleno" class="java.lang.String"/>
	<field name="description" class="java.lang.String"/>
	<field name="gross_wt" class="java.math.BigDecimal"/>
	<field name="qty" class="java.math.BigDecimal"/>
	<field name="unit_price" class="java.math.BigDecimal"/>
	<field name="unit_amt" class="java.math.BigDecimal"/>
	<field name="total_met_desc" class="java.lang.String"/>
	<field name="inv_no" class="java.lang.String"/>
	<field name="inv_dt" class="java.lang.String"/>
	<field name="inv_id" class="java.lang.Integer"/>
	<field name="words" class="java.lang.String"/>
	<field name="customer_name" class="java.lang.String"/>
	<variable name="gross_wt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{gross_wt}]]></variableExpression>
	</variable>
	<variable name="qty_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
	<variable name="unit_amt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{unit_amt}]]></variableExpression>
	</variable>
