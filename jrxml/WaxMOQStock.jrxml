	<parameter name="PM_SUB_REPORT_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="i_sku_id" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["7700"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[new String("dd-Mon-yyyy")]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	row_number() over (order by 1) sno,
	t.sku_id,
	t.sku_no,
	m.mould_no,
	pr.product_type_name,
	t.metal_weight metal_wt,
	(COALESCE(wi.wax_wt,0) - COALESCE(wo.wax_wt,0)) wax_wt,
	(COALESCE(wi.wax_pcs,0) - COALESCE(wo.wax_pcs,0)) - t.wax_moq required_qty,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',t.company_id,'/sku/',t.sku_id,t.image_url) image_url,
	case
		when (COALESCE(wi.wax_pcs,0) - COALESCE(wo.wax_pcs,0)) - t.wax_moq < 0 then 'LESS'
		when (COALESCE(wi.wax_pcs,0) - COALESCE(wo.wax_pcs,0)) - t.wax_moq > 0 then 'MORE'
		else 'MATCH'
	end status
from
	tbl_sku t
	inner join tbl_product_type pr on t.product_type_id = pr.product_type_id
	left join (
		select
			t1.sku_id,
			sum(wax_wt) wax_wt,
			sum(wax_pcs) wax_pcs
 		from
			tbl_mfg_wax_inward t1
		where
			t1.is_deleted = 0
		group by
			t1.sku_id
	)wi on t.sku_id = wi.sku_id
	left join (
		select
			t2.sku_id,
			sum(wax_wt) wax_wt,
			sum(wax_pcs) wax_pcs
 		from
			tbl_mfg_wax_outward t2
		where
			t2.is_deleted = 0
		group by
			t2.sku_id
	)wo on t.sku_id = wo.sku_id
	left join(
		select row_number() over (partition by sm.sku_id order by 1) sno, sm.*
		from tbl_sku_mould sm where sm.is_deleted = 0
	)m on t.sku_id = m.sku_id
		and m.sno = 1
	left join(
		select row_number() over (partition by sw.sku_id order by 1) sno, sw.*
		from tbl_sku_wax sw where sw.is_deleted = 0
	)w on t.sku_id = w.sku_id
		and w.sno = 1
where
	t.wax_moq <> 0
	and t.sku_id in ($P!{i_sku_id})]]>
	</queryString>
