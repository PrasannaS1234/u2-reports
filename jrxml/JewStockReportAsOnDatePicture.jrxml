<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JewStockReportAsOnDatePicture" pageWidth="1550" pageHeight="595" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="1510" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isIgnorePagination="true" uuid="c77f7cdd-f3a0-446c-9002-ab96fc3ebcf4">
	<property name="ireport.zoom" value="1.1269722013523675"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="schema" class="java.lang.String">
		<defaultValueExpression><![CDATA["public"]]></defaultValueExpression>
	</parameter>
	<parameter name="ReportPrintDateTime" class="java.lang.String"/>
	<parameter name="ReportPrintedBy" class="java.lang.String"/>
	<parameter name="toDate" class="java.lang.String">
		<defaultValueExpression><![CDATA["01/01/2020"]]></defaultValueExpression>
	</parameter>
	<parameter name="dateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["DD/MM/YYYY"]]></defaultValueExpression>
	</parameter>
	<parameter name="productTypeId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="collectionId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="currency" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="loginCompanyId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="companyName" class="java.lang.String">
		<defaultValueExpression><![CDATA["''"]]></defaultValueExpression>
	</parameter>
	<parameter name="marketId" class="java.lang.String">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="designId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="factoryId" class="java.lang.String">
		<defaultValueExpression><![CDATA["'-1'"]]></defaultValueExpression>
	</parameter>
	<parameter name="binId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
	</parameter>
	<parameter name="designNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="skuNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="jewTypeNo" class="java.lang.String">
		<defaultValueExpression><![CDATA["' '"]]></defaultValueExpression>
	</parameter>
	<parameter name="tenant" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select
	res.company_id,
	res.bin_id,
	res.jew_id,
	concat(jew.jew_type,jew.jew_no) jew_type_no,
	jew.design_no,
	sku.sku_no,
	pt.product_type_name,
	mk.market_name,
	col.collection_name,
	tbin.bin_name,
	res.stock_qty,
	jew.uom,
	round(rt.rate,2) pp_rate,
	round(res.stock_qty * rt.rate,2) pp_amt,
	mlot.lot_code metal,
	ka.karatage_name,
	(coalesce(comp.metal_wt,0)) + (coalesce(comp.dia_wt,0) * 0.2) + (coalesce(comp.cs_wt,0) * 0.2) gross_wt,
	comp.metal_wt,
	comp.dia_wt,
	comp.dia_pcs,
	comp.cs_wt,
	comp.cs_pcs,
	comp.center_stone_shape,
	comp.center_stone_wt,
	comp.center_stone_pcs,
	concat('/home/ubuntu/tekfilo/jewtrade/uploads/',$P{tenant},'comp',res.company_id,'/sku/',jew.sku_id,sku.image_url) image_url
from
(
	select
		tr.company_id,
		tr.bin_id,
		tr.jew_id,
		sum(tr.in_out_flag * tr.qty) stock_qty
	from
		tbl_jew_stock_trans tr
	where
		tr.is_deleted = 0
		and tr.inv_dt <= to_date($P{toDate}, $P{dateFormat})
		and tr.company_id = $P!{loginCompanyId}
	group by
		tr.company_id,
		tr.bin_id,
		tr.jew_id
	having sum(tr.in_out_flag * tr.qty) <> 0
) res
inner join tbl_bin tbin on res.bin_id = tbin.bin_id
	and (tbin.bin_id in ($P!{binId}) or -1 in ($P!{binId}))
inner join tbl_jewellery jew on res.jew_id = jew.jew_id
    and (jew.design_no  in ($P!{designNo}) or ' ' in ($P!{designNo}))
    and (jew.sku_no  in ($P!{skuNo}) or ' ' in ($P!{skuNo}))
    and (concat(jew.jew_type,jew.jew_no) in ($P!{jewTypeNo}) or ' ' in ($P!{jewTypeNo}))
	and (jew.collection_id  in ($P!{collectionId}) or -1 in ($P!{collectionId}))
	and (jew.product_type_id  in ($P!{productTypeId}) or -1 in ($P!{productTypeId}))
	and (jew.market_id  in ($P!{marketId}) or -1 in ($P!{marketId}))
left join tbl_sku sku on jew.sku_id = sku.sku_id
left join tbl_product_type pt on jew.product_type_id = pt.product_type_id
left join tbl_market mk on jew.market_id = mk.market_id
left join tbl_collection col on jew.collection_id = col.collection_id
left join tbl_lot mlot on jew.metal_id = mlot.lot_id
left join tbl_karatage ka on mlot.karatage_id = ka.karatage_id
left join tbl_jew_stock_rate rt on res.jew_id = rt.jew_id
	and res.company_id = rt.company_id
	and rt.is_deleted = 0
left join
	(select
	grp.jew_id,
	sum(case when cg.commodity_group_type = 'METAL' then grp.total_qty1 else 0 end) metal_wt,
	sum(case when cg.commodity_group_type in ('LOOSEDIAMOND','CERTDIAMOND','CVD') then grp.total_qty1 else 0 end) dia_wt,
	sum(case when cg.commodity_group_type in ('LOOSEDIAMOND','CERTDIAMOND','CVD') then grp.total_qty2 else 0 end) dia_pcs,
	sum(case when cg.commodity_group_type not in ('METAL','LOOSEDIAMOND','CERTDIAMOND','CVD') then grp.total_qty1 else 0 end) cs_wt,
	sum(case when cg.commodity_group_type not in ('METAL','LOOSEDIAMOND','CERTDIAMOND','CVD') then grp.total_qty2 else 0 end) cs_pcs,
	string_agg((case when grp.is_center_stone = 1  then sh.shape_name   end)::text, ',') center_stone_shape,
	sum(case when grp.is_center_stone = 1  then grp.total_qty1 else 0 end) center_stone_wt,
	sum(case when grp.is_center_stone = 1  then grp.total_qty2 else 0 end) center_stone_pcs
from tbl_jewellery_component grp
left join tbl_lot tlot on grp.lot_id = tlot.lot_id
left join tbl_commodity tcom on coalesce(tlot.commodity_id,grp.commodity_id) = tcom.commodity_id
	and tcom.commodity_name not in ('Total Cost')
left join tbl_commodity_group cg on tcom.commodity_group_id = cg.commodity_group_id
left join tbl_shape sh on grp.shape_id = sh.shape_id
where grp.is_deleted = 0
group by grp.jew_id) comp on res.jew_id = comp.jew_id]]>
	</queryString>
