				<reportElement stretchType="RelativeToTallestObject" x="566" y="0" width="52" height="16" isPrintWhenDetailOverflows="true" uuid="2aea0b0e-93a9-462c-b273-bdcc64d82a54"/>
				<box leftPadding="2" rightPadding="2">
